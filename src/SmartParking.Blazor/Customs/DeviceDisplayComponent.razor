@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@inject IStringLocalizer<SmartParkingResource> L

@if (IsManager)
{
    <MudItem xs="12" sm="12" md="12">
        <MudText Typo="Typo.caption" Class="text-muted">@L["Devices"]</MudText>

        @if (Devices != null && Devices.Any())
        {
            <MudGrid Style="margin-top:unset !important" Class="mt-2">
                @foreach (var device in Devices)
                {
                    <MudItem Style="padding-top:unset !important" xs="12" sm="6" md="6">
                        <MudTextField T="string"
                                      Value="@(string.IsNullOrWhiteSpace(device) ? "—" : device)"
                                      Disabled="true" />
                    </MudItem>
                }
            </MudGrid>
        }
        else
        {
            <div class="mt-2">—</div>
        }
    </MudItem>
}
else
{
    <MudItem xs="12" sm="6" md="6">
        <MudTextField T="string"
                      Value="@SingleDeviceLabel"
                      Disabled="true"
                      Label="@L["Device"]" />
    </MudItem>
}