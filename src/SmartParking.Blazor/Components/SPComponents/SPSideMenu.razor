@using Microsoft.Extensions.Localization
@using SmartParking.Enums
@using SmartParking.Localization
@using System.Text.Json
@using SmartParking.Permissions.CameraPermissions
@using SmartParking.Permissions.ContactPermissions
@using SmartParking.Permissions.CustomerPermissions
@using SmartParking.Permissions.GaragePermissions
@using SmartParking.Permissions.GarageTransactionPermissions
@using SmartParking.Permissions.InvoicesPermissions
@using SmartParking.Permissions.MyAccount
@using SmartParking.Permissions.OrganizationPermissions
@using SmartParking.Permissions.PackagePermissions
@using SmartParking.Permissions.PaymentsPermissions
@using SmartParking.Permissions.SubsctriptionPermissions
@using SmartParking.Permissions.UnLinkedTransactionPermissions
@using Volo.Abp.Account
@using Volo.Abp.Identity
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Users
@inject IStringLocalizer<SmartParkingResource> L
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject ISnackbar Snackbar
@inject Microsoft.AspNetCore.Identity.SignInManager<Volo.Abp.Identity.IdentityUser> SignInManager
@inject ICurrentTenant currenttenant
@inject ICurrentUser currentuser
@inject IAuthorizationService AuthorizationService


<div class="pt-5">
    <MudDrawerContainer Class="mud-height-full" >
        <MudDrawer Elevation="0" @bind-Open="_open" Fixed="false" Variant="DrawerVariant.Mini" OpenMiniOnHover="true" Class="bg-transparent">
            <MudNavMenu>
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.InsertChartOutlined" Class="text-white">@L["Dashboard"]</MudNavLink>
                @if (AuthorizationService.IsGrantedAnyAsync(MyAccountPermissions.Default).Result)
                {
                    <MudNavLink Href="/view-my-account" Icon="@Icons.Material.Filled.LocationCity">@L["ViewMyAccount"]</MudNavLink>   
                }                
               
                @if (AuthorizationService.IsGrantedAnyAsync(UnLinkedTransactionPermission.Default).Result && currenttenant.Id is null)
                {
                    <MudNavLink Href="/unLinkedTransaction" Icon="@Icons.Material.Filled.Garage">@L["UnLinkedTransaction"]</MudNavLink>
                }    
                @if (AuthorizationService.IsGrantedAnyAsync(CustomerPermissions.Default).Result && currenttenant.Id is null)
                {
                    <MudNavLink Href="/customers" Icon="@Icons.Material.Filled.Man2">@L["Customers"]</MudNavLink>
                }                
                @if (AuthorizationService.IsGrantedAnyAsync(OrganizationPermissions.Default).Result && currenttenant.Id is null)
                {
                    <MudNavLink Href="/organizations" Icon="@Icons.Material.Filled.LocationCity">@L["Organizations"]</MudNavLink>
                }
                @if (AuthorizationService.IsGrantedAnyAsync(SubscriptionPermissions.Default).Result && currenttenant.Id is null)
                {
                    <MudNavLink Href="/subscriptions" Icon="@Icons.Material.Filled.Group">@L["Subscriptions"]</MudNavLink>
                    <MudNavLink Href="/subscriptiontypes" Icon="@Icons.Material.Filled.Group">@L["SubscriptionTypes"]</MudNavLink>
                }
                @if (AuthorizationService.IsGrantedAnyAsync(IdentityPermissions.Users.Default).Result)
                {
                    <MudNavGroup Icon="@Icons.Material.Filled.AdminPanelSettings" Title="@L["Administration"]">
                        @if (AuthorizationService.IsGrantedAnyAsync(IdentityPermissions.Users.Default).Result)
                        {
                        <MudNavLink Href="/users" Icon="@Icons.Material.Filled.Man2">@L["Users"]</MudNavLink>
                        }
                        @if (AuthorizationService.IsGrantedAnyAsync(IdentityPermissions.Roles.Default).Result){
                        <MudNavLink Href="/roles" Icon="@Icons.Material.Filled.Man2">@L["Roles"]</MudNavLink>
                        }
                    </MudNavGroup>
                }
                @if (AuthorizationService.IsGrantedAnyAsync(CustomerPermissions.Default).Result && currenttenant.Id is not null)
                {
                    <MudNavLink Href="/customers" Icon="@Icons.Material.Filled.Man2">@L["OrgCustomers"]</MudNavLink>
                }
                @if (AuthorizationService.IsGrantedAnyAsync(PackagePermissions.Default).Result && currenttenant.Id is not null)
                {
                    <MudNavLink Href="/package" Icon="@Icons.Material.Filled.Subscriptions">@L["Packages"]</MudNavLink>
                }
                @if (AuthorizationService.IsGrantedAnyAsync(InvoicePermission.Default).Result && currenttenant.Id is not null)
                {
                <MudNavLink Href="/invoices" Icon="@Icons.Material.Filled.Assignment">@L["Invoices"]</MudNavLink>
                }
                @if (AuthorizationService.IsGrantedAnyAsync(SubscriptionPermissions.Default).Result && currenttenant.Id is not null)
                {
                    <MudNavLink Href="/subscription" Icon="@Icons.Material.Filled.Group">@L["Organization Subscription"]</MudNavLink>
                }
                @if (AuthorizationService.IsGrantedAnyAsync(GaragePermissions.Default).Result)
                {
                    <MudNavLink Href="/garages" Icon="@Icons.Material.Filled.Garage">@L["Garages"]</MudNavLink>
                }

                @if (AuthorizationService.IsGrantedAnyAsync(CameraPermissions.Default).Result )
                {
                    <MudNavLink Href="/cameras" Icon="@Icons.Material.Filled.CameraAlt">@L["Cameras"]</MudNavLink>
                }
                @if(AuthorizationService.IsGrantedAnyAsync(PaymentsPermission.Default).Result)
                {
                <MudNavLink Href="/payments" Icon="@Icons.Material.Filled.Money">@L["Payments"]</MudNavLink>
                }
                @if (AuthorizationService.IsGrantedAnyAsync(GarageTransactionPermissions.Default).Result)
                {
                <MudNavLink Href="/garageTransactions" Icon="@Icons.Material.Filled.CompareArrows">@L["GarageTransactions"]</MudNavLink>
                }
                @if (currenttenant.Id == null)
                {
                    <MudNavGroup Icon="@Icons.Material.Filled.Assignment" Title="@L["Lookups"]">
                        <MudNavLink Href="/countries" Icon="@Icons.Material.Filled.Public">@L["Countries"]</MudNavLink>
                        <MudNavLink Href="/regions" Icon="@Icons.Material.Filled.Public">@L["Regions"]</MudNavLink>
                        <MudNavLink Href="/states" Icon="@Icons.Material.Filled.Place">@L["States"]</MudNavLink>
                        <MudNavLink Href="/cities" Icon="@Icons.Material.Filled.LocationCity">@L["Cities"]</MudNavLink>
                        <MudNavLink Href="/packagetypes" Icon="@Icons.Material.Filled.AllInbox">@L["PackageTypes"]</MudNavLink>
                        <MudNavLink Href="/plateColors" Icon="@Icons.Material.Filled.BorderColor">@L["PlateColors"]</MudNavLink>
                        <MudNavLink Href="/licenceTypes" Icon="@Icons.Material.Filled.PermIdentity">@L["LicenceTypes"]</MudNavLink>
                        <MudNavLink Href="/vehicleBrands" Icon="@Icons.Material.Filled.DirectionsCar">@L["VehicleBrands"]</MudNavLink>
                        <MudNavLink Href="/vehicleModels" Icon="@Icons.Material.Filled.ElectricCar">@L["VehicleModels"]</MudNavLink>
                        <MudNavLink Href="/Camerabrands" Icon="@Icons.Material.Filled.ElectricCar">@L["CameraBrands"]</MudNavLink>
                        <MudNavLink Href="/CameraModels" Icon="@Icons.Material.Filled.ElectricCar">@L["Cameramodels"]</MudNavLink>
                        <MudNavLink Href="/Cameramaintypes" Icon="@Icons.Material.Filled.ElectricCar">@L["Cameramaintypes"]</MudNavLink>
                    </MudNavGroup>
                }
                <MudNavGroup Icon="@Icons.Material.Filled.Settings" Title="@L["Settings"]" Expanded="false">
                    <MudNavLink Href="/edit-profile">@L["Profile"]</MudNavLink>
                    @if (currenttenant.Id != null && AuthorizationService.IsGrantedAnyAsync(ContactPermissions.Default).Result)
                    {
                        <MudNavLink Href="/contact-data">@L["Contact Data"]</MudNavLink>
                    }
                    
                </MudNavGroup>

            </MudNavMenu>
        <MudButton Variant="Variant.Filled" Class="logout-button rounded-0 mt-20" OnClick="HandleLogout">
                @L["Logout"]
        </MudButton>
            <div class="icon-logout-button mt-20">
                <MudIcon Icon="@Icons.Material.Filled.Logout" />
        </div>
        </MudDrawer>
        <MudButton OnClick="@ToggleDrawer" class="side-menu-toggler" StartIcon="@Icons.Material.Filled.ChevronLeft">
            
        </MudButton>
    </MudDrawerContainer>
</div>

@code
{
    private bool _open = true;
    private bool _expanded = true;
    private void ToggleDrawer() => _open = !_open;

    public  void HandleLogout()
    {
        NavigationManager.NavigateTo("/logOut", true);
    }

}

