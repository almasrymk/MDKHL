@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using Volo.Abp.UI.Navigation
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager NavigationManager
@inject IMenuManager MenuManager

<div class="pt-5">
    <MudDrawerContainer Class="mud-height-full">
        <MudDrawer Elevation="0" @bind-Open="_open" Fixed="false" Variant="DrawerVariant.Mini" OpenMiniOnHover="true" Class="bg-transparent">
            <MudNavMenu>
                @if (_menu != null)
                {
                    @foreach (var item in _menu.Items)
                    {
                        <SPMenuItemRenderer Item="@item" />
                    }
                }
            </MudNavMenu>
            <MudButton Variant="Variant.Filled" Class="logout-button rounded-0 mt-20" OnClick="HandleLogout">
                @L["Logout"]
                <div class="icon-logout-button mt-20">
                    <MudIcon Icon="@Icons.Material.Filled.Logout" />
                </div>
            </MudButton>
        </MudDrawer>
        <MudButton style="z-index: 1001" OnClick="@ToggleDrawer" class="side-menu-toggler" StartIcon="@(_open ? Icons.Material.Filled.ChevronLeft : Icons.Material.Filled.ChevronRight)">
        </MudButton>
    </MudDrawerContainer>
</div>

@code
{
    private bool _open = true;
    private ApplicationMenu? _menu;

    private void ToggleDrawer() => _open = !_open;

    public void HandleLogout()
    {
        NavigationManager.NavigateTo("/logOut", true);
    }

    protected override async Task OnInitializedAsync()
    {
        _menu = await MenuManager.GetMainMenuAsync();
    }
}
