@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@inject IStringLocalizer<SmartParkingResource> L
<div class="pt-5">
    <MudDrawerContainer Class="mud-height-full" >
        <MudDrawer Elevation="0" @bind-Open="_open" Fixed="false" Variant="DrawerVariant.Mini" OpenMiniOnHover="true" Class="bg-transparent">
            <MudNavMenu>
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.InsertChartOutlined" Class="text-white">@L["Dashboard"]</MudNavLink>
                <MudNavLink Href="/my-account" Icon="@Icons.Material.Filled.Group">@L["My Account"]</MudNavLink>
                <MudNavLink Href="/login" Icon="@Icons.Material.Filled.Group">@L["Login"]</MudNavLink>
                <MudNavLink Href="/organizations" Icon="@Icons.Material.Filled.LocationCity">@L["Organizations"]</MudNavLink>
                <MudNavLink Href="/invoices" Icon="@Icons.Material.Filled.Assignment">@L["Invoices"]</MudNavLink>
                <MudNavLink Href="/garages" Icon="@Icons.Material.Filled.Garage">@L["Garages"]</MudNavLink>
                <MudNavLink Href="/cameras" Icon="@Icons.Material.Filled.CameraAlt">@L["Cameras"]</MudNavLink>
                <MudNavLink Href="/customers" Icon="@Icons.Material.Filled.Man2">@L["Customers"]</MudNavLink>
                <MudNavLink Href="/garageTransactions" Icon="@Icons.Material.Filled.CompareArrows">@L["GarageTransactions"]</MudNavLink>
                <MudNavGroup Icon="@Icons.Material.Filled.Assignment" Title="@L["Lookups"]">
                    <MudNavLink Href="/countries" Icon="@Icons.Material.Filled.Public">@L["Countries"]</MudNavLink>
                    <MudNavLink Href="/governorates" Icon="@Icons.Material.Filled.AdminPanelSettings">@L["Governorates"]</MudNavLink>
                    <MudNavLink Href="/cities" Icon="@Icons.Material.Filled.LocationCity">@L["Cities"]</MudNavLink>
                    <MudNavLink Href="/regions" Icon="@Icons.Material.Filled.Public">@L["Regions"]</MudNavLink>
                    <MudNavLink Href="/states" Icon="@Icons.Material.Filled.Place">@L["States"]</MudNavLink>
                    <MudNavLink Href="/packagetypes" Icon="@Icons.Material.Filled.AllInbox">@L["PackageTypes"]</MudNavLink>
                    <MudNavLink Href="/plateColors" Icon="@Icons.Material.Filled.BorderColor">@L["PlateColors"]</MudNavLink>
                    <MudNavLink Href="/licenceTypes" Icon="@Icons.Material.Filled.PermIdentity">@L["LicenceTypes"]</MudNavLink>
                    <MudNavLink Href="/vehicleBrands" Icon="@Icons.Material.Filled.DirectionsCar">@L["VehicleBrands"]</MudNavLink>
                    <MudNavLink Href="/vehicleModels" Icon="@Icons.Material.Filled.ElectricCar">@L["VehicleModels"]</MudNavLink>
                </MudNavGroup>
                <MudNavGroup Icon="@Icons.Material.Filled.Settings" Title="@L["Settings"]" Expanded="false">
                    <MudNavLink Href="/edit-profile">@L["Profile"]</MudNavLink>
                    <MudNavLink Href="/packages">@L["Packages"]</MudNavLink>
                    <MudNavLink Href="/subscription" Icon="@Icons.Material.Filled.Group">subscription</MudNavLink>
                </MudNavGroup>
                <MudNavGroup Icon="@Icons.Material.Filled.Collections" Title="@L["Components"]">
                    <MudNavLink Href="/data-grid" Icon="@Icons.Material.Filled.Group">@L["Data Grid"]</MudNavLink>
                    <MudNavLink Href="/subscription" Icon="@Icons.Material.Filled.Group">@L["Subscription"]</MudNavLink>
                </MudNavGroup>
            </MudNavMenu>
        <MudButton Variant="Variant.Filled" Class="logout-button rounded-0 mt-20">
                Logout
        </MudButton>
            <div class="icon-logout-button mt-20">
                <MudIcon Icon="@Icons.Material.Filled.Logout" />
        </div>
        </MudDrawer>
        <MudButton OnClick="@ToggleDrawer" class="side-menu-toggler">
            <i class="fa fa-chevron-left"></i>
        </MudButton>
    </MudDrawerContainer>
</div>

@code
{
    private bool _open = true;
    private bool _expanded = true;
    private void ToggleDrawer() => _open = !_open;

}

