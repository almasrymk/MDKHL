@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using MudBlazor
@using SmartParking.StringLocalizer
<div class="d-flex align-items-center gap-1">
    <MudIcon Icon="@Icons.Material.Filled.Home" Size="MudBlazor.Size.Small" class="text-white" aria-label="home" />
    <MudBreadcrumbs Items="_items" Class="text-white"></MudBreadcrumbs>
</div>

<style>
    .mud-breadcrumbs {
        padding: 0;
    }

    .mud-breadcrumb-item > a {
        color: white !important;
    }

    .mud-breadcrumb-separator > span {
        color: white !important;
        opacity: 1;
    }
</style>

@code {
    [Inject] private NavigationManager Navigation { get; set; }
    [Inject] private IStringLocalizer<SmartParkingResource> L { get; set; }
    [Parameter] public string URL { get; set; }

    private List<MudBlazor.BreadcrumbItem> _items = new();
    protected override void OnInitialized()
    {
        _items.Clear();
        // Replace "Home" with "Dashboard" using its localization
        _items.Add(new MudBlazor.BreadcrumbItem(L["Dashboard"], href: "/dashboard"));

    }
    private string GetTitleForCurrentUri()
    {
        return BreadCrumbsRoutes.GetCueerntURLRoute(URL);

    }
    protected override void OnParametersSet()
    {
        _items.Clear();
         var result = GetTitleForCurrentUri();
        _items.Add(new MudBlazor.BreadcrumbItem(L[($"{result}")], href: $"/{URL}"));
        


    }


}
