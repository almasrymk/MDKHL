@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@inject IStringLocalizer<SmartParkingResource> L

<div class="modal-wrapper text-center">
    <MudDialog class="text-center">
        <TitleContent >
            <MudText Class="fw-bold">@L["Deletion Process"]</MudText>
        </TitleContent>
        <DialogContent>
            <MudText>@L["Do you wish to Delete This"] @Name @L["...?"]</MudText>
        </DialogContent>
        <DialogActions>
            <MudButton Class="text-light" FullWidth="true" Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Error" OnClick="Submit">@L["Confirm Deletion"]</MudButton>
            <MudButton FullWidth="true" DropShadow="true" Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Dark" OnClick="Cancel">@L["CANCEL"]</MudButton>
        </DialogActions>
    </MudDialog>
</div>



@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public string Name { get; set; }
    

    private void Submit() => MudDialog.Close(DialogResult.Ok(true));

    private void Cancel() => MudDialog.Cancel();
}