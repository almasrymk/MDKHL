@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Enums
@using SmartParking.Localization
@inject IStringLocalizer<SmartParkingResource> L

<MudDialog class="text-center" Style="min-height: 75%;">
        <TitleContent>
            <MudText Class="fw-bold">@Name @L["Report"]</MudText>
        </TitleContent>
        <DialogContent>
            @if (AddCustomerCategory)
            {
                <MudItem sm="12" md="12">
                    <MudSelect T="string"
                    Label="@L["customer category"]"
                    Placeholder=@L["Choose"]
                    HelperText=@L["Helper Text"]
                    Required="true"
                    ValueChanged="GetCategory">
                        @foreach (var category in Enum.GetValues(typeof(CustomerCategoryStatus)).Cast<CustomerCategoryStatus>())
                        {
                            <MudSelectItem Value="@category.ToString()">

                                @category.ToString()
                            </MudSelectItem>
                        }
                    </MudSelect>

                </MudItem>
            }
            @if (QueryText)
            {
                <MudItem sm="8" md="8">
                    <MudTextField @bind-Value="SearchingText"
                    Variant="Variant.Text"
                    Required
                    Class="w-100"
                    Placeholder="@L["Type Here"]"
                    Label="@L["Search"]"
                    RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                </MudItem>
            }
            @if (AddRange)
            {
                <MudItem sm="4">
                    <MudCheckBox T="bool" @bind-Value="InRange" Color="MudBlazor.Color.Primary">@L["InRange"]</MudCheckBox>
                </MudItem>
                @if (InRange)
                {
                <MudItem sm="12" Style="min-height: 100%;">
                            <MudDateRangePicker @ref="_picker" Label="@L["Range"]"  @bind-DateRange="_dateRange" Required="true"
                            AutoClose="true" PickerVariant="MudBlazor.PickerVariant.Dialog">
                                <PickerActions>
                                    <MudButton Class="mr-auto align-self-start" OnClick="@(() => _picker.ClearAsync())">@L["Clear All"]</MudButton>
                                    <MudButton OnClick="@(() => _picker.CloseAsync(false))">@L["Cancel"]</MudButton>
                                    <MudButton Color="MudBlazor.Color.Primary" OnClick="@(() => _picker.CloseAsync())">@L["Ok"]</MudButton>
                                </PickerActions>
                            </MudDateRangePicker>
                    </MudItem>

                }
            }

        </DialogContent>
        <DialogActions>
        <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Submit">@L["CONFIRM"]</MudButton>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
        </DialogActions>
    </MudDialog>



@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }

    [Parameter]
    public string Name { get; set; }
    [Parameter]
    public bool AddRange { get; set; }
    [Parameter]
    public bool QueryText { get; set; }
    [Parameter]
    public bool AddCustomerCategory { get; set; }

    public string SearchingText { get; set; }

    public bool HasBeenOpened { get; set; } = false;


    public CustomerCategoryStatus CustomerCategory { get; set; }

    public bool InRange { get; set; } = false;
    public MudDateRangePicker _picker;
    public DateRange _dateRange = new DateRange(DateTime.Now.Date, DateTime.Now.AddDays(5).Date);

    private void Submit()
    {

        var result = new SPReportResult
        {
            SearchingText = SearchingText,
            InRange = InRange,
            DateRange = _dateRange,
            CustomerCategory = CustomerCategory,
            HasBeenOpened = true
            
        };

        MudDialog.Close(DialogResult.Ok(result));
    }
    private void GetCategory(string customerCategory)
    {
        CustomerCategory = (CustomerCategoryStatus)Enum.Parse(typeof(CustomerCategoryStatus), customerCategory);
        HasBeenOpened = true;
    }


    private void Cancel() {
   
        MudDialog.Cancel();
    }
}