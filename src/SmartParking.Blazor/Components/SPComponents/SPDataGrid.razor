@page "/data-grid"
@using Customs
@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.DataGrid
@using SmartParking.Localization
@using SmartParking.Organizations
@using System.Globalization
@using SmartParking.PDF
@using Volo.Abp.Application.Dtos
@using MudBlazor
@using Volo.Abp.EventBus.Distributed
@inject IOrganizationsAppService OrganizationsAppService
@inject NavigationManager Navigation
@inject IStringLocalizer<SmartParkingResource> L
@inject IGenerateFilesAppService GenerateFilesAppService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IDistributedEventBus _eventBus
<div>
    <MudDataGrid Elevation="0" @ref="dataGrid" T="RowDef" ServerData="ServerReload" Class="bg-transparent custom-data-grid" SortMode="SortMode.Single" Filterable="true">
        <ToolBarContent>
            <div class="d-flex flex-column w-100">
                <div class="w-100 d-flex align-center">
                    @if (OnSearching.HasDelegate && ShowSearching)
                    {
                        <MudTextField Elevation="2" @bind-Value:get="_searchString" @bind-Value:set="OnSearch" Placeholder="@L["Search"]" Adornment="Adornment.End" Immediate="true"
                                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="MudBlazor.Size.Medium" Class="mt-0 data-grid-search"></MudTextField>
                    }

                    @if (OnFiltering.HasDelegate && ShowFiltering)
                    {
                        <div Class="ms-2">
                            <MudIconButton OnClick="OnClickFilter" Icon="@Icons.Material.Filled.FilterAlt" Class="cursor-pointer"></MudIconButton>
                        </div>
                        @if (ClickFilter)
                        {
                            @if (ClickFilter)
{
                            <MudItem xl="2" Class="d-flex align-center gap-2">
                                 <MudButton Class="clear-btn" Variant="Variant.Filled" Color="MudBlazor.Color.Dark" OnClick="CloseFilter">@L["Cancel"]</MudButton>
                                 <MudButton Class="apply-filter-btn" Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="ApplyFilter">@L["Apply Filter"]</MudButton>
                             </MudItem>
}

                        }
                    }

                    <MudItem>
                        @if (ColumnsFilterApply.Count > 0)
                        {
                            <MudGrid Justify="Justify.SpaceBetween" Class=" align-center ">

                                <MudItem Class="d-flex align-center pt-0">
                                    @foreach (var value in ColumnsFilterApply)
                                    {
                                        <MudItem Class="d-flex align-center">
                                            <MudChip Class="custom-chip-filter" T="string">@(value ?? "Select Column is Null")</MudChip>
                                            <MudIconButton Icon="@Icons.Material.Outlined.Close" OnClick="@(()=>ClearItem(value))"></MudIconButton>
                                        </MudItem>
                                    }
                                </MudItem>

                                <MudButton OnClick="ClearAll">@L["Clear All"]</MudButton>

                            </MudGrid>
                        }
                    </MudItem>
                    <MudSpacer />
                    @if (ShowExport)
                    {
                        <MudItem>
                            <MudMenu Class="me-3" Label="@L["Export"]" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.KeyboardArrowDown">

                                <MudMenuItem OnClick="ExportToPDF">@L["PDF"] </MudMenuItem>
                                <MudMenuItem OnClick="ExportToCSV">@L["CSV"]</MudMenuItem>
                                <MudMenuItem OnClick="ExportToExcel">@L["Excel"]</MudMenuItem>
                            </MudMenu>
                        </MudItem>

                    }

                    @if (ShowMenue)
                    {
                        @foreach (var menu in Menus)
                        {
                            @if (@menu.IsMenueColumnVisible)
                            {
                                <MudMenu Dense Label="@L[@menu.Name]" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Class="me-3">
                                    @foreach (var item in menu.Items)
                                    {
                                        <MudMenuItem OnClick="@(()=> HandleMunueColumnVisibility(@item.Label,@item.OnClick))">
                                            <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
                                                <span>@item?.Label</span>
                                                <MudCheckBox T="bool" @bind-Value="@Data.Columns.FirstOrDefault(c => c.DisplayName == @item.Label).IsColumnVisible" />
                                            </div>
                                        </MudMenuItem>
                                    }
                                </MudMenu>

                            }
                            else if (!@menu.IsMenueColumnVisible)
                            {
                                <MudMenu Label="@L[@menu.Name]" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Class="me-3">
                                    @foreach (var item in menu.Items)
                                    {
                                        @if (!item.IsShow)
                                            continue;
                                        <MudMenuItem OnClick="@(()=> HandleMunue(@item.Label,@item.OnClick,menu.IsExport))">@L[@item.Label]</MudMenuItem>
                                    }
                                </MudMenu>
                            }
                        }

                    }

                    @if (OnAdd.HasDelegate && ShowAdd)
                    {
                        <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="@(()=>OnAdd.InvokeAsync())">
                            @L["Add NEW"]
                            <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Size="MudBlazor.Size.Small" Class="ms-1" />
                        </MudButton>
                    }


                </div>
                <div class="mt-3">
                    @if (ClickFilter)
                    {
                        <MudGrid Justify="Justify.SpaceBetween" Class=" align-center w-100  flex-row flex-nowrap">

                            <MudItem sm="12" Class="d-flex flex-row flex-nowrap align-end">
                                <MudItem>
                                    @L["Select Column"]:
                                    <MudSelect Variant="Variant.Outlined" T="string" ValueChanged="OnSelectColumn" Margin="MudBlazor.Margin.Dense" Placeholder="@L["Colmn name"]" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                                        @foreach (var column in Data.Columns)
                                        {
                                            @if (column.IsFilterable)
                                            {

                                                <MudSelectItem Value="@column.PropertyName">@column.DisplayName</MudSelectItem>

                                            }

                                        }
                                    </MudSelect>
                                </MudItem>
                                @if (!SelectedColumn.IsNullOrEmpty() && IsShowValue)

                                {
                                    <MudItem>
                                        @L["Operator"]:
                                        <MudSelect Clearable="true" Variant="Variant.Outlined" @bind-Value="@SelectOperator" Margin="MudBlazor.Margin.Dense" Placeholder="@L["Colmn name"]" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                                            @if (CultureInfo.CurrentCulture.Name == "en")
                                            {
                                                @if (Data.Columns.First(x => x.PropertyName == SelectedColumn).TypeFilter == TypeFilter.Text)
                                                {
                                                    @foreach (var column in StringOperatorEn)
                                                    {
                                                        <MudSelectItem Value="@column">@column.Key</MudSelectItem>
                                                    }
                                                }
                                                else if (Data.Columns.First(x => x.PropertyName == SelectedColumn).TypeFilter == TypeFilter.Date)
                                                {
                                                    @foreach (var column in DateOperatorEn)
                                                    {
                                                        <MudSelectItem Value="@column">@column.Key</MudSelectItem>
                                                    }
                                                }
                                                else if (Data.Columns.First(x => x.PropertyName == SelectedColumn).TypeFilter == TypeFilter.Number)
                                                {
                                                    @foreach (var column in NumberOperatorEn)
                                                    {
                                                        <MudSelectItem Value="@column">@column.Key</MudSelectItem>
                                                    }
                                                }

                                            }
                                            else
                                            {
                                                @if (Data.Columns.First(x => x.PropertyName == SelectedColumn).TypeFilter == TypeFilter.Text)
                                                {
                                                    @foreach (var column in StringOperatorAR)
                                                    {
                                                        <MudSelectItem Value="@column">@column.Key</MudSelectItem>
                                                    }
                                                }
                                                else if (Data.Columns.First(x => x.PropertyName == SelectedColumn).TypeFilter == TypeFilter.Date)
                                                {
                                                    @foreach (var column in DateOperatorAR)
                                                    {
                                                        <MudSelectItem Value="@column">@column.Key</MudSelectItem>
                                                    }
                                                }
                                                else if (Data.Columns.First(x => x.PropertyName == SelectedColumn).TypeFilter == TypeFilter.Number)
                                                {
                                                    @foreach (var column in NumberOperatorAR)
                                                    {
                                                        <MudSelectItem Value="@column">@column.Key</MudSelectItem>
                                                    }
                                                }

                                            }
                                        </MudSelect>
                                    </MudItem>
                                }
                                @if ((SelectOperator.Value != null && SelectOperator.Value != "IsNullOrEmpty") || (!SelectedColumn.IsNullOrEmpty() && Data.Columns.First(x => x.PropertyName == SelectedColumn).TypeFilter != TypeFilter.Date))
                                {
                                    if (!IsShowValue)
                                    {
                                        <MudItem Class="d-flex align-center ms-2">
                                            <MudSelect T="string" @bind-Value="FilterValue" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Placeholder="@L["Value"]" Margin="MudBlazor.Margin.Dense" Variant="Variant.Outlined" T="string">
                                                @foreach (var value in Enum.GetValues(Data.Columns.First(x => x.PropertyName == SelectedColumn).EnumType))
                                                {
                                                    <MudSelectItem Value="value.ToString()">@value.ToString()</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                    }
                                    else if (Data.Columns.First(x => x.PropertyName == SelectedColumn).TypeFilter != TypeFilter.Date)
                                    {
                                        <MudItem>
                                            @L["Value"]:
                                            <MudTextField @bind-Value="FilterValue" Placeholder="@L["Value"]" Variant="Variant.Outlined" Margin="MudBlazor.Margin.Dense" />
                                        </MudItem>
                                    }

                                }

                                @if (SelectOperator.Value != null && (SelectOperator.Value == "GreaterThan" || SelectOperator.Value == "LessThan" || SelectOperator.Value == "LessThanOrEqual" || SelectOperator.Value == "GreaterThanOrEqual") && Data.Columns.First(x => x.PropertyName == SelectedColumn).TypeFilter == TypeFilter.Date)
                                {
                                    <MudItem>
                                        <MudDatePicker Label="@L["Date"]" Editable="true" @bind-Date="@Date" Placeholder="Select Date" />
                                    </MudItem>
                                }
                                @if (SelectOperator.Value != null && SelectOperator.Value == "Between" && Data.Columns.First(x => x.PropertyName == SelectedColumn).TypeFilter == TypeFilter.Date)
                                {
                                    <MudItem>
                                        <MudItem>
                                            <MudDatePicker Label="@L["StartDate"]" Editable="true" @bind-Date="@StartDate" Placeholder="Select Date" />
                                        </MudItem>
                                    </MudItem>
                                    <MudItem>
                                        <MudItem>
                                            <MudDatePicker Label="@L["EndDate"]" Editable="true" @bind-Date="@EndDate" Placeholder="Select Date" />
                                        </MudItem>
                                    </MudItem>
                                }
                            </MudItem>

                            <!--Buttons Filter Button -->

                        </MudGrid>
                    }
                </div>
            </div>
        </ToolBarContent>
        <Columns>


            @foreach (var header in Data.Columns)
            {
                @if (header.Name == "Id" || !header.IsColumnVisible)
                    continue;

                <TemplateColumn>
                    <HeaderTemplate>
                        @header.DisplayName
                        @if (header.IsSortable)
                        {
                            <MudIconButton OnClick="()=> SortTable(header.PropertyName)" Size="MudBlazor.Size.Small" ClickPropagation="_ascending" Icon="@(_ascending ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)">
                            </MudIconButton>
                        }
                    </HeaderTemplate>
                    <CellTemplate>
                        @{
                            var cell = @context.Item.Cells.FirstOrDefault(c => c.Key == header.DisplayName).Value;
                        }
                        @cell
                    </CellTemplate>
                </TemplateColumn>

                @if (Data.Columns.Last().DisplayName == header.DisplayName)
                {
                    @if ((OnClickRowView.HasDelegate && ShowView) || (OnClickCar.HasDelegate && ShowAssignCar) || (OnClickRowEdit.HasDelegate && ShowEdit) || (OnClickRowDelete.HasDelegate && ShowDelete) || (OnClickAssign.HasDelegate && ShowAssign))
                    {
                        <TemplateColumn Title="@L["Actions"]" CellClass="d-flex justify-content-start align-items-center">
                            <CellTemplate>
                                <MudItem Class="d-flex justify-content-start align-items-center">
                                    @if (OnClickRowView.HasDelegate && ShowView)
                                    {
                                        <MudTooltip Text=@L["View Details"] Color=MudBlazor.Color.Primary>

                                        <MudIconButton OnClick="@(e => OnClickRowView.InvokeAsync(context.Item))"
                                                       Icon="@Icons.Material.Filled.Info"
                                                       Variant="Variant.Filled"
                                                       Color="MudBlazor.Color.Primary"
                                                       Size="MudBlazor.Size.Small"
                                                       Class="mx-1" />
                                        </MudTooltip>

                                    }

                                    @if (OnClickCar.HasDelegate && ShowAssignCar && !context.Item.Cells.Any(r => (r.Key.Contains("Status") || r.Key.Contains("الحالة")) && (r.Value.Contains("Deleted") || r.Value.Contains("محذوف"))))
                                    {

                                        <MudIconButton OnClick="@(e => OnClickCar.InvokeAsync(context.Item))"
                                                       Icon="@Icons.Material.Filled.CarRental"
                                                       Variant="Variant.Filled"
                                                       Color="MudBlazor.Color.Secondary"
                                                       Size="MudBlazor.Size.Small"
                                                       Class="mx-1" />

                                    }
                                    @if (OnClickRowEdit.HasDelegate && ShowEdit)
                                    {
                                        <MudTooltip Text=@L["Edit"] Color=MudBlazor.Color.Primary>

                                        <MudIconButton OnClick="@(e => OnClickRowEdit.InvokeAsync(context.Item))"
                                                       Icon="@Icons.Material.Filled.Edit"
                                                       Variant="Variant.Filled"
                                                       Color="MudBlazor.Color.Secondary"
                                                       Size="MudBlazor.Size.Small"
                                                       Class="mx-1" />
                                        </MudTooltip>

                                    }


                                    @if (OnClickAssign.HasDelegate && ShowAssign && !context.Item.Cells.Any(r => (r.Key.Contains("Status") || r.Key.Contains("الحالة")) && (r.Value.Contains("Deleted") || r.Value.Contains("محذوف"))))
                                    {
                                        <MudTooltip Text=@L["Assign"] Color=MudBlazor.Color.Primary>

                                        <MudIconButton OnClick="@(e => OnClickAssign.InvokeAsync(context.Item.Cells[0].Value))"
                                                       Icon="@Icons.Material.Filled.AssignmentTurnedIn"
                                                       Variant="Variant.Filled"
                                                       Color="MudBlazor.Color.Tertiary"
                                                       Size="MudBlazor.Size.Small"
                                                       Class="mx-1" />
                                        </MudTooltip>

                                    }
                                    @if (OnClickButton.HasDelegate && ShowButton)
                                    {
                                        <MudTooltip Text=@L["Permissions"] Color=MudBlazor.Color.Primary>

                                        <MudIconButton OnClick="@(e => OnClickButton.InvokeAsync(context.Item))"
                                                       Icon="@Icons.Material.Filled.AdminPanelSettings"
                                                       Variant="Variant.Filled"
                                                       Color="MudBlazor.Color.Tertiary"
                                                       Size="MudBlazor.Size.Small"
                                                       Class="mx-1" />
                                        </MudTooltip>


                                    }
                                    @if (ShowCustomerTransactionsMethod.HasDelegate && ShowCustomerTransactions)
                                    {
                                        <MudTooltip Text=@L["Export"] Color=MudBlazor.Color.Primary>

                                                <MudIconButton OnClick="@(e => ShowCustomerTransactionsMethod.InvokeAsync(context.Item))"
                                                 Icon="@Icons.Material.Filled.CompareArrows"
                                                    Variant="Variant.Filled"
                                                 Color="MudBlazor.Color.Tertiary"
                                                  Size="MudBlazor.Size.Small"
                                                Class="mx-1" />
                                        </MudTooltip>


                                    }
                                    @if (ShowVehicleTransactionsMethod.HasDelegate && ShowVehicleTransactions)
                                    {
                                        <MudTooltip Text=@L["Export"] Color=MudBlazor.Color.Primary>

                                            <MudIconButton OnClick="@(e => ShowVehicleTransactionsMethod.InvokeAsync(context.Item))"
                                                       Icon="@Icons.Material.Filled.CompareArrows"
                                                       Variant="Variant.Filled"
                                                       Color="MudBlazor.Color.Tertiary"
                                                       Size="MudBlazor.Size.Small"
                                                       Class="mx-1" />
                                        </MudTooltip>


                                    }
                                    @if (OnClickRowDelete.HasDelegate && ShowDelete && !context.Item.Cells.Any(r => (r.Key.Contains("Status") || r.Key.Contains("الحالة")) && (r.Value.Contains("Deleted") || r.Value.Contains("محذوف"))))
                                    {
                                        <MudTooltip Text=@L["Delete"] Color=MudBlazor.Color.Primary>

                                        <MudIconButton OnClick="@(e => OnClickRowDelete.InvokeAsync(context.Item))"
                                                       Icon="@Icons.Material.Filled.Delete"
                                                       Variant="Variant.Filled"
                                                       Color="MudBlazor.Color.Error"
                                                       Size="MudBlazor.Size.Small"
                                                       Class="mx-1" />
                                        </MudTooltip>

                                    }

                                </MudItem>

                            </CellTemplate>
                        </TemplateColumn>
                    }

                }
            }



        </Columns>
        <PagerContent>
            <MudDataGridPager T="RowDef" RowsPerPageString="@L["Rows Per Page"]" />
        </PagerContent>
    </MudDataGrid>

</div>

