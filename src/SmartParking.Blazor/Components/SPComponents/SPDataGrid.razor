@page "/data-grid"
@using Customs
@using SmartParking.Blazor.Components.DataGrid
@using SmartParking.Organizations
@using Volo.Abp.Application.Dtos
@using MudBlazor
@inject IOrganizationsAppService OrganizationsAppService
@inject NavigationManager Navigation

<div>
    <MudDataGrid Elevation="0" @ref="dataGrid" T="RowDef" ServerData="ServerReload" Class="bg-transparent custom-data-grid" MultiSelection="true" SortMode="SortMode.Single" Filterable="true"
                 Hideable="true" >
        <ToolBarContent>
            <MudTextField Elevation="2" @bind-Value:get="_searchString" @bind-Value:set="OnSearch" Placeholder="Search For Organizations" Adornment="Adornment.End" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="MudBlazor.Size.Medium" Class="mt-0 data-grid-search"></MudTextField>
            <MudItem Class="me-2 ">
                <MudButton OnClick="OnClickFilter" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Filter">Filters</MudButton>

            </MudItem>
            <MudItem>
                @if (ClickFilter)
                {
                    <MudGrid Justify="Justify.SpaceBetween" Class=" align-center   flex-row flex-nowrap">

                        <MudItem xl="10" Class="d-flex flex-row flex-nowrap align-center">
                            <MudItem>
                                Select Column:
                                <MudSelect Variant="Variant.Outlined" @bind-Value="@SelectedColumn" Margin="MudBlazor.Margin.Dense" Placeholder="Colmn name" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                                    @foreach (var column in Data.Columns)
                                    {
                                        @if (column.IsFilterable)
                                        {
                                            <MudSelectItem Value="@column.PropertyNmae">@column.DisplayName</MudSelectItem>
                                        }

                                    }
                                </MudSelect>
                            </MudItem>
                            @if (Data.Columns.FirstOrDefault(x => x.PropertyNmae == SelectedColumn).TypeFilter == TypeFilter.Text)
                            {
                                <MudItem>
                                    Operator:
                                    <MudSelect Clearable="true" Variant="Variant.Outlined" @bind-Value="@SelectOperator" Margin="MudBlazor.Margin.Dense" Placeholder="Colmn name" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">

                                        @foreach (var column in StringOperator)
                                        {
                                            <MudSelectItem Value="@column">@column.Key</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                            }
                            @if (SelectOperator.Value != "IsNullOrEmpty")
                            {
                                <MudItem>
                                    Value:
                                    <MudTextField @bind-Value="FilterValue" Placeholder="Value" Variant="Variant.Outlined" />
                                </MudItem>
                            }
                        </MudItem>

                        <!--Buttons Filter Button -->
                        <MudItem xl="2">
                            <MudButton Class="clear-btn" Variant="Variant.Outlined" OnClick="CloseFilter">Cancel</MudButton>
                            <MudButton Class="apply-filter-btn" Variant="Variant.Outlined" OnClick="ApplyFilter">Apply Filter</MudButton>

                        </MudItem>

                    </MudGrid>
                }
            </MudItem>
            <MudSpacer />
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="HandleAdd">
                CREATE NEW
                <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Size="MudBlazor.Size.Small" Class="ms-1" />
            </MudButton>
            <MudItem>
                @if (ColumnsFilterApply.Count > 0)
                {
                    <MudGrid Justify="Justify.SpaceBetween" Class=" align-center ">

                        <MudItem Class="d-flex align-center pt-0">
                            @foreach (var value in ColumnsFilterApply)
                            {
                                <MudItem Class="d-flex align-center">
                                    <MudChip Class="custom-chip-filter" T="string">@(value ?? "Select Column is Null")</MudChip>
                                    <MudIconButton Icon="@Icons.Material.Outlined.Close" OnClick="@(()=>ClearItem(value))"></MudIconButton>
                                </MudItem>

                            }
                        </MudItem>

                        <MudButton OnClick="ClearAll">Clear All</MudButton>

                    </MudGrid>
                }
            </MudItem>
        </ToolBarContent>
        <Columns>
            <SelectColumn />

            @foreach (var header in Data.Columns)
            {
                @if (header.DisplayName == "Id")
                    continue;

                <TemplateColumn DragAndDropEnabled="true" Resizable="true">
                    <HeaderTemplate>
                        @header.DisplayName
                        @if (header.IsSortable)
                        {
                            <MudIconButton OnClick="()=> SortTable(header.PropertyNmae)" Size="MudBlazor.Size.Small" ClickPropagation="_ascending" Icon="@(_ascending ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)">
                            </MudIconButton>
                        }
                    </HeaderTemplate>
                    <CellTemplate>
                        @{
                            var cell = @context.Item.Cells.FirstOrDefault(c => c.Key == header.DisplayName).Value;
                        }
                        @cell
                    </CellTemplate>
                </TemplateColumn>


            }



        </Columns>
        <PagerContent>
            <MudDataGridPager T="RowDef" />
        </PagerContent>
    </MudDataGrid>

</div>