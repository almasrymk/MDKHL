@page "/data-grid"
@using Customs
@using SmartParking.Organizations
@using Volo.Abp.Application.Dtos
@inject IOrganizationsAppService OrganizationsAppService

<div>
    <MudDataGrid Elevation="0" @ref="dataGrid" T="OrganizationDto" ServerData="ServerReload" Class="bg-transparent custom-data-grid" MultiSelection="true" SortMode="SortMode.Multiple" Filterable="true"
                 Hideable="true" RowsPerPage="2" >
        <ToolBarContent>
            <MudTextField Elevation="2" @bind-Value:get="_searchString" @bind-Value:set="OnSearch" Placeholder="Search For Organizations" Adornment="Adornment.End" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="MudBlazor.Size.Medium" Class="mt-0 data-grid-search"></MudTextField>
            <MudSpacer />
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled">
                CREATE NEW
                <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Size="MudBlazor.Size.Small" Class="ms-1"/>
            </MudButton>
        </ToolBarContent>
        <Columns>
            <SelectColumn  />
            <PropertyColumn Property="x => x.Code" Title="Code" Sortable="false" Filterable="false" />
            <PropertyColumn Property="x => x.EnglishName" />
            <PropertyColumn Property="x => x.CountryName"  />
            <PropertyColumn Property="x => x.StateName" />
            <PropertyColumn Property="x => x.CityName" />
            <PropertyColumn Property="x => x.MaxCapacity" />
            <PropertyColumn Property="x => x.NumOfCameras" />
            <PropertyColumn Property="x => x.Status" Title="Status" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="OrganizationDto"  />
        </PagerContent>
    </MudDataGrid>
</div>

@code {
    private IReadOnlyList<OrganizationDto> Organizations = new List<OrganizationDto>();
    private string _searchString;
    private string sort = "Code";
    MudDataGrid<OrganizationDto> dataGrid;
    private Task OnSearch(string text)
    {
        _searchString = text;
        return dataGrid.ReloadServerData();
    }
