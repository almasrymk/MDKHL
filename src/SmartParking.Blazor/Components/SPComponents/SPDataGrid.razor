    private async Task<GridData<OrganizationDto>> ServerReload(GridState<OrganizationDto> state)
    {
        
        PagedAndSortedResultRequestDto input = new PagedAndSortedResultRequestDto()
        {
            MaxResultCount = state.PageSize,
            SkipCount = (state.Page +1 - 1) * state.PageSize,
            Sorting = "Code"
        };
        if (state.SortDefinitions.Count > 0 )
        {
            if (state.SortDefinitions.First().Descending)
            {
                input = new PagedAndSortedResultRequestDto()
                    {
                        MaxResultCount = state.PageSize,
                        SkipCount = (state.Page + 1 - 1) * state.PageSize,
                        Sorting = state.SortDefinitions.First().SortBy + " DESC"
                    };
                sort = state.SortDefinitions.First().SortBy + " DESC";
            }
            else
            {
                input = new PagedAndSortedResultRequestDto()
                    {
                        MaxResultCount = state.PageSize,
                        SkipCount = (state.Page + 1 - 1) * state.PageSize,
                        Sorting = state.SortDefinitions.First().SortBy
                    };
                sort = state.SortDefinitions.First().SortBy;
            }

        }
        
        Console.WriteLine(_searchString);
        var organizations = await OrganizationsAppService.GetListAsync(input);
        if (!_searchString.IsNullOrEmpty())
        {
           var  inputSearch = new PagedAndSortedAndSearchResultRequestDto()
                {
                    MaxResultCount = state.PageSize,
                    SkipCount = (state.Page + 1 - 1) * state.PageSize,
                    Sorting = sort,
                    SearchingTerm = _searchString
                };
            var organizationsSearch =   await OrganizationsAppService.Search(inputSearch);
            return new GridData<OrganizationDto>
                {
                    TotalItems = (int)organizationsSearch.TotalCount,
                    Items = organizationsSearch.Items
                };
        }
        return new GridData<OrganizationDto>
            {
                TotalItems =(int) organizations.TotalCount,
                Items = organizations.Items
            };
    }

}
