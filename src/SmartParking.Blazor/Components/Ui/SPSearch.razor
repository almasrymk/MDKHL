@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@inject IStringLocalizer<SmartParkingResource> L
<MudTextField Elevation="2" @bind-Value:get="searchString" @bind-Value:set="OnSearch" Placeholder="@L["Search"]" Adornment="Adornment.End" Immediate="true"
              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="MudBlazor.Size.Medium" Class="mt-0 data-grid-search"></MudTextField>

@code
{
    [Parameter]
    public EventCallback<string> OnSearch { get; set; }
    [Parameter]
    public string searchString { get; set; } 
}