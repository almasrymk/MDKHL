@using MudBlazor

<MudCard Elevation="0" Class="custom-card">
    <MudCardHeader>
        <MudText Typo="Typo.h6">Payment Details</MudText>
    </MudCardHeader>

    <MudCardContent>
        <MudGrid Spacing="2">

            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Tertiary">
                    Payment No.
                </MudText>
                <MudText Typo="Typo.body1" Class="font-weight-bold">
                    @PaymentNo
                </MudText>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Tertiary">
                    Cashier No.
                </MudText>
                <MudText Typo="Typo.body1">
                    @CashierNo
                </MudText>
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Tertiary">
                    Payment Date
                </MudText>
                <MudText Typo="Typo.body1">
                    @PaymentDate.ToString("MMM dd, yyyy - hh:mm tt")
                </MudText>
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Tertiary">
                    Payment To
                </MudText>

                <MudText Typo="Typo.body1" Class="font-weight-bold">
                    @HotelName
                </MudText>

                <MudText Typo="Typo.body2" Color="MudBlazor.Color.Tertiary">
                    @HotelAddress
                </MudText>
            </MudItem>

        </MudGrid>
    </MudCardContent>
</MudCard>
@code
{
    [Parameter] public string PaymentNo { get; set; } = "PMT-2024-12-15-001";
    [Parameter] public string CashierNo { get; set; } = "CSH-042";
    [Parameter] public DateTime PaymentDate { get; set; } = DateTime.Now;

    [Parameter] public string HotelName { get; set; } = "Madinah Hotel";
    [Parameter] public string HotelAddress { get; set; } = "King Fahd Road, Al Haram District, Madinah, 42311, Saudi Arabia";
}