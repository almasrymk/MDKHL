<MudCard Elevation="0" class="custom-card">
    <MudCardHeader>
        <MudText Typo="Typo.h6">Invoice Details</MudText>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid Spacing="2">

            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Tertiary">Invoice No</MudText>
                <MudText Typo="Typo.body1" Class="font-weight-bold">@InvoiceNo</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Tertiary">Invoice Date</MudText>
                <MudText Typo="Typo.body1">@InvoiceDate.ToString("MMMM dd, yyyy")</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Tertiary">Amount Paid</MudText>
                <MudText Typo="Typo.body1" Class="font-weight-bold">@AmountPaid SAR</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Tertiary">VAT Amount (@VATRate%)</MudText>
                <MudText Typo="Typo.body1">@VATAmount SAR</MudText>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Tertiary">Payment Method</MudText>
                <MudText Typo="Typo.body1">@PaymentMethod</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Tertiary">Duration</MudText>
                <MudText Typo="Typo.body1">@Duration</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Tertiary">Check-in</MudText>
                <MudText Typo="Typo.body1">@CheckInTime.ToString("MMM dd, yyyy - hh:mm tt")</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Tertiary">Check-out</MudText>
                <MudText Typo="Typo.body1">@CheckOutTime.ToString("MMM dd, yyyy - hh:mm tt")</MudText>
            </MudItem>

        </MudGrid>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public string InvoiceNo { get; set; } = "#N/A";
    [Parameter] public DateTime InvoiceDate { get; set; } = DateTime.Now;
    [Parameter] public double AmountPaid { get; set; }
    [Parameter] public double VATAmount { get; set; }
    [Parameter] public int VATRate { get; set; } = 15;
    [Parameter] public string PaymentMethod { get; set; } = "Mada";
    [Parameter] public string Duration { get; set; } = "N/A";
    [Parameter] public DateTime CheckInTime { get; set; } = DateTime.Now;
    [Parameter] public DateTime CheckOutTime { get; set; } = DateTime.Now;
}