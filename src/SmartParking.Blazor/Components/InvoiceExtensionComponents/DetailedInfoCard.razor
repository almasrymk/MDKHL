@using MudBlazor

<div class="p-4">
    <MudText Typo="Typo.h6" Class="fw-bold mb-1">
        @Title
    </MudText>

    <!-- Divider -->
    <MudDivider Class="mb-3" />

    <!-- Row 1 -->
    <MudGrid Justify="Justify.FlexStart"  Spacing="1">
        <MudItem>
            <MudText Style="color:#6A7282;">@Row1Text</MudText>
        </MudItem>
        <MudItem>
            <MudText Class="fw-bold">@Row1Value</MudText>
        </MudItem>
    </MudGrid>

    <!-- Row 2 -->
    <MudGrid Justify="Justify.FlexStart" Spacing="1" Class="mt-2">
        <MudItem>
            <MudText Style="color:#6A7282;">@Row2Text</MudText>
        </MudItem>
        <MudItem>
            <MudText Class="fw-bold">@Row2Value</MudText>
        </MudItem>
    </MudGrid>

    <!-- Row 3 -->
    <MudGrid Justify="Justify.FlexStart" AlignItems="AlignItems.Center" Spacing="1" Class="mt-2">
        <MudItem>
            <MudText Style="color:#6A7282;">@Row3Text</MudText>
        </MudItem>
        <MudItem>
            <MudText Class="fw-bold">@Row3Value</MudText>
        </MudItem>
    </MudGrid>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Title";

    [Parameter] public string Row1Text { get; set; } = "Row 1:";
    [Parameter] public string Row1Value { get; set; } = "Value 1";

    [Parameter] public string Row2Text { get; set; } = "Row 2:";
    [Parameter] public string Row2Value { get; set; } = "Value 2";

    [Parameter] public string Row3Text { get; set; } = "Row 3:";
    [Parameter] public string Row3Value { get; set; } = "Value 3";
}
