@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Currency
@inject IStringLocalizer<SmartParkingResource> L


<MudCard Elevation="0" Class="custom-card">
    <MudCardHeader>
        <MudText Typo="Typo.h6">@L["Summary"]</MudText>
    </MudCardHeader>

    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" Class="d-flex justify-space-between">
                <MudText>@L["Amount"]</MudText>
                <MudText>@((MarkupString)$"{Amount.ToString("F2")} {CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "14px")}")</MudText>
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-space-between">
                <MudText>@L["VAT"] (@VATRate%)</MudText>
                <MudText>@((MarkupString)$"{VATAmount.ToString("F2")} {CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "14px")}")</MudText>
            </MudItem>

            <MudDivider Class="my-1" />

            <MudItem xs="12" Class="d-flex justify-space-between">
                <MudText>@L["Total"]</MudText>
                <MudText>@((MarkupString)$"{TotalAmount.ToString("F2")} {CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "14px")}")</MudText>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-3" />

        <MudButton FullWidth
                   Color="MudBlazor.Color.Primary"
                   Size="MudBlazor.Size.Large"
                   Variant="Variant.Filled"
                   Class="mt-4"
                   Disabled="@(IsLoading || Disabled)"
                   OnClick="ProceedToPayment">
            @if (IsLoading)
            {
                <MudProgressCircular Class="ms-n1" Size="MudBlazor.Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Processing…</MudText>
            }
            else
            {
                <MudText>@L["Checkout"]</MudText>
            }
        </MudButton>

        <MudButton FullWidth
                   Color="MudBlazor.Color.Error"
                   Size="MudBlazor.Size.Large"
                   Variant="Variant.Filled"
                   Class="mt-2"
                   Disabled="@(!Disabled)"
                   OnClick="Cancel">
            <MudText>@L["Cancel"]</MudText>
        </MudButton>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public decimal Amount { get; set; }
    [Parameter] public int VATRate { get; set; }
    [Parameter] public decimal VATAmount { get; set; }
    [Parameter] public decimal TotalAmount { get; set; }
    [Parameter] public EventCallback ProceedToPayment { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }
    /// <summary>When true the button shows a spinner and is disabled.</summary>
    [Parameter] public bool IsLoading { get; set; }
    /// <summary>Allows the parent to disable the button independently of loading state.</summary>
    [Parameter] public bool Disabled { get; set; }
}
<style>
    .payment-option {
        width: 100%;
        margin: 6px auto;
        border: 1px solid #ddd;
        border-radius: 6px;
        box-sizing: border-box;
        transition: all 0.2s ease-in-out;
    }

    .payment-option--selected {
        background-color: #e6f4ff;
        border: 2px solid #1e88e5;
    }


</style>