@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@inject IStringLocalizer<SmartParkingResource> L


<MudCard Elevation="0" Class="custom-card">
    <MudCardHeader>
        <MudText Typo="Typo.h6">@L["Summary"]</MudText>
    </MudCardHeader>

    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" Class="d-flex justify-space-between">
                <MudText>@L["Amount"]</MudText>
                <MudText>@Amount.ToString("F2") SAR</MudText>
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-space-between">
                <MudText>@L["VAT"] (@VATRate%)</MudText>
                <MudText>@VATAmount.ToString("F2") SAR</MudText>
            </MudItem>

            <MudDivider Class="my-1" />

            <MudItem xs="12" Class="d-flex justify-space-between">
                <MudText>@L["Total"]</MudText>
                <MudText>@TotalAmount.ToString("F2") SAR</MudText>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-3" />

        <MudText Typo="Typo.h6">@L["InvoicePaymentMethod"]</MudText>

        <MudRadioGroup T="string"
                       Value="SelectedPaymentMethod"
                       ValueChanged="OnPaymentChanged">
            <MudPaper Class="@PaymentClass("MADA")">
                <MudGrid Justify="Justify.SpaceBetween" Class="pa-2">
                    <MudItem xs="8">
                        <MudRadio Value="@("MADA")">Mada Card</MudRadio>
                    </MudItem>
                    <MudItem xs="4" Class="text-right">
                        <MudImage Src="images/mada.png" Width="50" />
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudPaper Class="@PaymentClass("ApplePay")">
                <MudGrid Justify="Justify.SpaceBetween" Class="pa-2">
                    <MudItem xs="8">
                        <MudRadio Value="@("ApplePay")">Apple Pay</MudRadio>
                    </MudItem>
                    <MudItem xs="4" Class="text-right">
                        <MudImage Src="images/applepay.png" Width="40" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudRadioGroup>

        <MudButton FullWidth
                   Color="MudBlazor.Color.Primary"
                   Size="MudBlazor.Size.Large"
                   Variant="Variant.Filled"
                   Class="mt-4"
                   Disabled="@(IsLoading || Disabled)"
                   OnClick="ProceedToPayment">
            @if (IsLoading)
            {
                <MudProgressCircular Class="ms-n1" Size="MudBlazor.Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Processing…</MudText>
            }
            else
            {
                <MudText>Checkout</MudText>
            }
        </MudButton>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public decimal Amount { get; set; }
    [Parameter] public int VATRate { get; set; }
    [Parameter] public decimal VATAmount { get; set; }
    [Parameter] public decimal TotalAmount { get; set; }
    [Parameter] public string SelectedPaymentMethod { get; set; }
    [Parameter] public EventCallback<string> SelectedPaymentMethodChanged { get; set; }
    [Parameter] public EventCallback ProceedToPayment { get; set; }
    /// <summary>When true the button shows a spinner and is disabled.</summary>
    [Parameter] public bool IsLoading { get; set; }
    /// <summary>Allows the parent to disable the button independently of loading state.</summary>
    [Parameter] public bool Disabled { get; set; }

    private async Task OnPaymentChanged(string value)
    {
        SelectedPaymentMethod = value;
        await SelectedPaymentMethodChanged.InvokeAsync(value);
    }

    private string PaymentClass(string method)
        => $"payment-option {(SelectedPaymentMethod == method ? "payment-option--selected" : "")}";

}
<style>
    .payment-option {
        width: 100%;
        margin: 6px auto;
        border: 1px solid #ddd;
        border-radius: 6px;
        box-sizing: border-box;
        transition: all 0.2s ease-in-out;
    }

    .payment-option--selected {
        background-color: #e6f4ff;
        border: 2px solid #1e88e5;
    }


</style>