<MudCard Elevation="0" Class="custom-card">
    <MudCardHeader>
        <MudText Typo="Typo.h6">Vehicle Images</MudText>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid Justify="Justify.SpaceBetween">
            <MudItem xs="5" sm="5">
                <MudText Typo="Typo.body2" Class="mb-2">Entry Picture</MudText>
                <MudImage Src="@EntryPictureUrl" Alt="Entry Picture" Fluid="true" Style="border-radius: 8px; border: 1px solid #ddd;" />
            </MudItem>

            <MudItem xs="1" sm="1" Class="d-flex justify-center my-3 my-sm-0">
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="MudBlazor.Size.Large" Color="MudBlazor.Color.Dark" />
            </MudItem>

            <MudItem xs="5" sm="5">
                <MudText Typo="Typo.body2" Class="mb-2">Exit Picture</MudText>
                <MudImage Src="@ExitPictureUrl" Alt="Exit Picture" Fluid="true" Style="border-radius: 8px; border: 1px solid #ddd;" />
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public string EntryPictureUrl { get; set; } = "images/default-entry.png";
    [Parameter] public string ExitPictureUrl { get; set; } = "images/default-exit.png";
}