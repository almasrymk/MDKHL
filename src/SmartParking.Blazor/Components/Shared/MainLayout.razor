@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@using SmartParking.Localization
@using Volo.Abp.Localization
@using Volo.Abp.SettingManagement
@inherits LayoutComponentBase;
@inject IStringLocalizer<SmartParkingResource> L
<MudDialogProvider />
<MudSnackbarProvider />
<MudThemeProvider Theme="SPCustomTheme" />
<MudPopoverProvider />

<div class="main-layout-gradient d-flex flex-column">

    <header class="bg-transparent px-5 py-10 d-flex">

        <MudItem Style="width:240px">
            <Image Source="images/logo/logo.png" />
        </MudItem>
        <MudItem Class="text-white d-flex justify-content-between gap-2 flex-1">
            <div class="d-flex flex-column justify-center">
                <h2>
                    @L["Dashboard"]
                </h2>
                <SPBreadcrumb />
            </div>
            <div class="d-flex gap-3 align-center flex-wrap">
                <SPSearch />
                <MudImage src="images/svgs/notification.svg" Width="24" Height="24" />
                <MudImage src="images/svgs/arabic.svg" Width="24" Height="24" />
                <MudMenu Icon="@Icons.Material.Filled.Language" Label="Language">
                    @foreach (var language in _localizationOptions.Value.Languages)
                    {
                        <MudMenuItem OnClick="@(() => ChangeLanguage(language.CultureName))">
                            <MudText>@language.DisplayName</MudText>
                        </MudMenuItem>
                    }
                </MudMenu>
                <div class="d-flex align-center gap-2">
                    <MudAvatar Style="height:49px; width:49px;">
                        <MudImage src="images/avatar.png" Width="49" Height="49" />
                    </MudAvatar>
                    <div>
                        <p class="mb-0">Hello</p>
                        <p class="mb-0 fw-bold">MOHAMED AHMED</p>
                        <Link Class="text-white border-bottom">Profile Details</Link>
                    </div>
                </div>
            </div>
        </MudItem>

    </header>
    <div Class="d-flex me-5 flex-grow-1">
        <SPSideMenu />
        <MudPaper Class="p-3 rounded-be-0 rounded-ts-0 rounded-te-xl rounded-bs-xl w-100 main-layout-paper">
            @Body
        </MudPaper>
    </div>
    <footer class="text-center text-white my-5">
        All Copy Right Reserved for MDKHL 2024 - Access Control for people and vehicles
    </footer>
</div>

@code {
    [Inject] private IOptions<AbpLocalizationOptions> _localizationOptions { get; set; }
    [Inject] private NavigationManager Navigation { get; set; }

    private void ChangeLanguage(string cultureName)
    {

        var uri = "/?culture=" + cultureName + "&ui-culture=" + cultureName;
        Navigation.NavigateTo(uri, forceLoad: true); // Reload the page to apply the language change
    }
    MudTheme SPCustomTheme = new MudTheme()
        {
            PaletteLight = new PaletteLight()
            {
                Primary = "#0D5480",
                Secondary = "#16B7D3",
                GrayLight = "#F2F2F2",
                GrayDark = "#434341",
                WarningLighten = "#CE3333",
                Success = "#28BA24",
                White = "FFFFFF"
            },
        };
}