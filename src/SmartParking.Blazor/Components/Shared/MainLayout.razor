
@using Abp.Web.Http
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@using SmartParking.Blazor.Components.Ui
@using SmartParking.Localization
@using System.Globalization
@using SmartParking.Organizations
@using Volo.Abp.Localization
@using Volo.Abp.MultiTenancy
@using Volo.Abp.SettingManagement
@using Volo.Abp.Users
@inherits LayoutComponentBase;
@inject IStringLocalizer<SmartParkingResource> L
@inject ICurrentUser CurrentUser
@inject ICurrentTenant currenttenant
@inject IOrganizationsAppService OrganizationAppService
<MudDialogProvider />
<MudSnackbarProvider />
<MudThemeProvider Theme="SPCustomTheme" />
<MudPopoverProvider />

<div class="main-layout-gradient d-flex flex-column">

    <header class="bg-transparent px-5 py-10 d-flex">

        <MudItem Style="width:240px">
            <Image Source="images/logo/logo.png" />
        </MudItem>
        <MudItem Class="text-white d-flex justify-content-between gap-2 flex-1">
            <div class="d-flex flex-column justify-center">
                <h2 >
                    @GetTitleForCurrentUri()
                </h2>
                <SPBreadcrumb URL="@CurrentURI" />
            </div>
            <div class="d-flex gap-3 align-center flex-wrap">
                <MudImage Src="images/svgs/notification.svg" Width="24" Height="24" />
                <MudMenu>   
                    <ActivatorContent>
                        <div @onclick="@(() => ChangeLanguage())" class="cursor-pointer">
                            <MudImage src="@LocaleImgSrc()" Width="24" Height="24" Class="cursor-pointer" />
                        </div>
                    </ActivatorContent>
   @*                  <ChildContent>
                        <div @onclick="@(() => ChangeLanguage())" class="cursor-pointer">
                            <MudImage src="@LocaleImgSrc()" Width="24" Height="24" Class="cursor-pointer" />
                        </div>
                    </ChildContent> *@
                </MudMenu>
                <div class="d-flex align-center gap-2">
                    <MudAvatar Style="height:49px; width:49px;">
                        <MudImage Src="@(Picture)" Width="100" Height="100" Class="bg_w_foto" Alt="@L["OrganizationLogo"]" />
                    </MudAvatar>
                    <div>
                        <p class="mb-0">@L["Hello"]</p>
                        <p class="mb-0 fw-bold">@UserName </p>

                        <Link Class="text-white border-bottom text-decoration-none"
                              href=@(currenttenant.Id != null ? "/my-account" : "/edit-profile")>
                            @L["Profile Details"]
                        </Link>
                    </div>
                    </div>
                </div>
            </MudItem>

        </header>
        <div Class="d-flex me-5 flex-grow-1">
            <SPSideMenu />
            <MudPaper Class="p-3 rounded-be-0 rounded-ts-0 rounded-te-xl rounded-bs-xl w-100 main-layout-paper">
                @Body
        </MudPaper>
    </div>
    <footer class="text-center text-white my-5">
        @L["All Copy Right Reserved for MDKHL 2024 - Access Control for people and vehicles"]
    </footer>
</div>

<style>
    .bg_w_foto {
        background: url(images/cities/<?php echo $city_name;
        ?>) no-repeat center center;
        -webkit-background-size: cover;
        -moz-background-size: cover;
        -o-background-size: cover;
        background-size: cover;
    }
</style>
@code {
    [Inject] private IOptions<AbpLocalizationOptions> _localizationOptions { get; set; }
    [Inject] private NavigationManager Navigation { get; set; }
    public string Picture { get; set; } 
    public string CurrentURI { get; set; } 


    private string UserName { get; set; }

    protected async override Task OnInitializedAsync()
    {
        UserName = CurrentUser.Name;
        if (currenttenant.Id == null)
        {
            UserName += " MDKHAL";
            Picture = "images/MDHKL_04.png";
        }
        else
        {

            UserName += " Organization";
            Picture = await OrganizationAppService.GetOrganizationPictureByOrganizationTenant(currenttenant.Id);
            Console.WriteLine(Picture);
        }


         base.OnInitializedAsync();

    }
    protected override void OnParametersSet()
    {
        UpdateUriAndTitle();
    }

    private void UpdateUriAndTitle()
    {
        CurrentURI = Navigation.ToBaseRelativePath(Navigation.Uri);

    }

    private string GetTitleForCurrentUri()
    {
        // Customize titles based on the current URI
        return CurrentURI switch
        {
            "dashboard" => L["Dashboard"],
            "organizations" => L["Organizations"],
            "garages" => L["Garages"],
            "cameras" => @L["Cameras"],
            "cities" => @L["Cities"],
            "contact-data" => @L["Contact Data"],
            "countries" => @L["Countries"],
            "customers" => @L["Customers"],
            "garageTransactions" => @L["GarageTransactions"],
            "invoices" => @L["Invoices"],
            "licencetypes" => @L["LicenceTypes"],
            "subscription" => @L["Organization Subscription"],
            "packages" => @L["Packages"],
            "packagetypes" => @L["PackageTypes"],
            "platecolors" => @L["PlateColors"],
            "regions" => @L["Regions"],
            "states" => @L["States"],
            "subscriptions" => @L["Subscriptions"],
            "subscriptiontypes" => @L["SubscriptionType"],
            "vehiclebrands" => @L["VehicleBrands"],
            "vehiclemodels" => @L["VehicleModel"],
            "profile" => @L["Profile"],
            "customers/register" => @L["Customers"] + "/" + @L["Add NEW"],
            _ => L["Dashboard"] // Default title if no match found
        };
    }
    private void ChangeLanguage()
    {
        Navigation.NavigateTo($"api/SetLanguage?returnUrl={Navigation.Uri}", true);
    }
    private string LocaleImgSrc()
    {
        return CultureInfo.CurrentCulture.Name == "en" ? "images/svgs/arabic.svg" : "images/svgs/english.svg";
    }

    MudTheme SPCustomTheme = new MudTheme()
        {
            PaletteLight = new PaletteLight()
            {
                Primary = "#0D5480",
                Secondary = "#16B7D3",
                GrayLight = "#F2F2F2",
                GrayDark = "#434341",
                WarningLighten = "#CE3333",
                Success = "#28BA24",
                White = "FFFFFF"
            },
        };
}
