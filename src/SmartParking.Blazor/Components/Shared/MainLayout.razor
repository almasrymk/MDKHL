
@using Abp.Web.Http
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@using SmartParking.Blazor.Components.Ui
@using SmartParking.Localization
@using Volo.Abp.Localization
@using Volo.Abp.SettingManagement
@using Volo.Abp.Users
@inherits LayoutComponentBase;
@inject IStringLocalizer<SmartParkingResource> L
@inject ICurrentUser CurrentUser
@inject HttpClient Http
<MudDialogProvider />
<MudSnackbarProvider />
<MudThemeProvider Theme="SPCustomTheme" />
<MudPopoverProvider />

<div class="main-layout-gradient d-flex flex-column">

    <header class="bg-transparent px-5 py-10 d-flex">

        <MudItem Style="width:240px">
            <Image Source="images/logo/logo.png" />
        </MudItem>
        <MudItem Class="text-white d-flex justify-content-between gap-2 flex-1">
            <div class="d-flex flex-column justify-center">
                <h2 >
                    @L["Dashboard"]
                </h2>
                <SPBreadcrumb />
            </div>
            <div class="d-flex gap-3 align-center flex-wrap">
                <SPSearch />
                <MudImage src="images/svgs/notification.svg" Width="24" Height="24" />
                <MudMenu>   
                    <ActivatorContent>
                        <MudImage src="images/svgs/arabic.svg" Width="24" Height="24" />
                    </ActivatorContent>
                    <ChildContent>
                        @foreach (var language in _localizationOptions.Value.Languages.Where(l => l.CultureName == "en" || l.CultureName == "ar"))
                        {
                        <MudMenuItem OnClick="@(() => ChangeLanguage(language.CultureName))" >
                            <MudText>@language.DisplayName</MudText>
                            </MudMenuItem>
                    }
                    </ChildContent>
                </MudMenu>
                <div class="d-flex align-center gap-2">
                    <MudAvatar Style="height:49px; width:49px;">
                        <MudImage src="images/avatar.png" Width="49" Height="49" />
                    </MudAvatar>
                    <div>
                        <p class="mb-0">@L["Hello"]</p>
                        <p class="mb-0 fw-bold">@UserName</p>
                        <Link Class="text-white border-bottom" href="/my-account">@L["Profile Details"]</Link>
                        </div>
                    </div>
                </div>
            </MudItem>

        </header>
        <div Class="d-flex me-5 flex-grow-1">
            <SPSideMenu />
            <MudPaper Class="p-3 rounded-be-0 rounded-ts-0 rounded-te-xl rounded-bs-xl w-100 main-layout-paper">
                @Body
        </MudPaper>
    </div>
    <footer class="text-center text-white my-5">
        @L["All Copy Right Reserved for MDKHL 2024 - Access Control for people and vehicles"]
    </footer>
</div>

@code {
    [Inject] private IOptions<AbpLocalizationOptions> _localizationOptions { get; set; }
    [Inject] private NavigationManager Navigation { get; set; }


    private string UserName { get; set; }

    protected override void OnInitialized()
    {

        UserName = CurrentUser.Name ?? "Guest";

    }
    private async Task ChangeLanguage(string cultureName)
    {

        // Define the data to be sent in the POST request
        var requestData = new Dictionary<string, string>
        {
            { "culture", cultureName },
            { "returnUrl", Navigation.Uri.ToString() }
        };
        Console.WriteLine(Navigation.Uri.ToString());
        // Create a POST request to the API
        var content = new FormUrlEncodedContent(requestData);
        // Post the request to the SetLanguage API
        var response = await Http.PostAsync($"{Navigation.BaseUri.ToString()}api/SetLanguage?culture={cultureName}&returnUrl={Navigation.Uri.ToString()}", null);
        // Check if the response is successful
        if (response.IsSuccessStatusCode)
        {
            // Handle the successful response (e.g., navigate to the return URL)
            var newUrl = response.RequestMessage.RequestUri.ToString();
            Navigation.NavigateTo(newUrl, forceLoad: true);
        }
        else
        {
            // Handle error (optional)
            Console.WriteLine("Failed to set language");
        }
    
      

       // LanguageService.SetLanguage(cultureName);
        // Optionally force a page reload to apply the culture change immediately
        //Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        // var uri = Navigation.Uri.ToString();

        // uri = uri + "?culture=" + cultureName + "&ui-culture=" + cultureName;
        /* avigation.NavigateTo(uri, forceLoad: true); // Reload the page to apply the language change */
    }

    MudTheme SPCustomTheme = new MudTheme()
        {
            PaletteLight = new PaletteLight()
            {
                Primary = "#0D5480",
                Secondary = "#16B7D3",
                GrayLight = "#F2F2F2",
                GrayDark = "#434341",
                WarningLighten = "#CE3333",
                Success = "#28BA24",
                White = "FFFFFF"
            },
        };
}
