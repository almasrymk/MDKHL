@using SmartParking.Localization
@using SmartParking.Units
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SmartParkingResource> L

<div class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
        <MudText Typo="Typo.h6">@L["Details"]</MudText>
       </TitleContent>
  <DialogContent>
      <MudGrid>
   <MudItem sm="6">
                    <MudTextField 
                        ReadOnly="true" 
                        T="string" 
                        InputType="InputType.Text" 
                        @bind-Value="Unit.Code" 
                        Label =@L["Code"]> </MudTextField>
  </MudItem>
   <MudItem sm="6">
                    <MudTextField 
                        ReadOnly="true" 
                        T="int" 
                        InputType="InputType.Text" 
                        @bind-Value="Unit.OwnerSlots"
                        Label=@L["OwnerSlots"]> </MudTextField>
  </MudItem>
   <MudItem sm="6">
                    <MudTextField 
                        ReadOnly="true" 
                        T="int" 
                        InputType="InputType.Text" 
                        @bind-Value="Unit.RenterSlots"
                        Label=@L["RenterSlots"]> </MudTextField>
  </MudItem>
   <MudItem sm="12">
        <MudTextField 
            ReadOnly="true" 
            T="string" 
            InputType="InputType.Text" 
            @bind-Value="Unit.Description"
            Label=@L["Description"]> </MudTextField>
  </MudItem>
 
                <MudItem sm="12" md="12" Class="d-flex justify-content-between">
                    <MudRadioGroup @bind-Value="@Unit.Status" Class="d-flex" ReadOnly = "true">
                        <MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">@L["Status Active"]</MudRadio>
                        <MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Secondary">@L["Status InActive"]</MudRadio>
                    </MudRadioGroup>
                </MudItem>

  </MudGrid>
        </DialogContent>
     <DialogActions>
<MudButton OnClick="Cancel" Variant="Variant.Filled" Color="MudBlazor.Color.Primary">@L["Close"]</MudButton>
       </DialogActions>
  </MudDialog>
</div>

<style>
    .mud-modal 
    {
 border-radius: 0 20px 0 20px;
    }
</style>

@code {
    [Parameter]
 public UnitDto Unit { get; set; } = new UnitDto();
    
    [CascadingParameter]
 private IMudDialogInstance MudDialog { get; set; }

 private void Cancel()
 {
   MudDialog.Cancel();
    }
}
