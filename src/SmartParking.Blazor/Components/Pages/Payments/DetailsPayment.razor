@page "/payments/view/{Id}"
@using Microsoft.Extensions.Localization
@using SmartParking.Invoices
@using SmartParking.Localization
@using System.Globalization
@using SmartParking.Payments
@using Volo.Abp.MultiTenancy
@inject IPaymentWebAppService PaymentWebAppService
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@inject IInvoiceAppService InvoiceAppService
@inject IDialogService DialogService
@inject CurrentTenant currentTenant


<PageTitle>@L["View Details"]</PageTitle>
<div>
    <MudText Typo="Typo.h6" Class="fw-bold">@L["Details"]</MudText>

    <MudForm  Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
        <MudGrid>
            @if (Payment.Customers is not null)
            {


                @if (CultureInfo.CurrentCulture.Name == "ar")
                {
                    <MudItem sm="4">
                        <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Payment.Customers.ArabicName" Label=@L["CustomerName"] />
                    </MudItem>
                }
                else
                {
                    <MudItem sm="4">
                        <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Payment.Customers.FullName" Label=@L["CustomerName"] />
                    </MudItem>
                }

            }
            <MudItem sm="4">
                <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Payment.PaymentNumber " Label=@L["Code"] />
            </MudItem>

            <MudItem sm="4">
                <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="LocalizedPaymentCategory" Label=@L["PaymentCategory"] />
            </MudItem>

                <MudItem sm="4">
                <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="LocalizedPaymentMethod" Label=@L["PaymentMethod"] />
                </MudItem>

                <MudItem sm="4">
                    <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="CreationTime" Label=@L["CreationTime"] />
                </MudItem>

            <MudItem sm="4">
                <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Amount" Label=@L["Amount"] />
            </MudItem>
            <MudItem sm="4">
                <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" Label=@L["PaymentStatus"] @bind-Value="LocalizedPaymentStatus"/>
            </MudItem>


               @if (Payment.Invoice is not null)
                   {
                <MudItem sm="4">
                    <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" Label=@L["Discount"] @bind-Value="AmountDiscount" />
                </MudItem>
                               
                       <MudItem sm="4">
                          <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="LocalizedPaymentInvoiceType " Label=@L["InvoiceType"] />
                       </MudItem>

                <MudItem sm="4">
                    <MudTextField @bind-Value="Payment.Invoice.PlateNumber"
                                  Immediate="true"
                                  Variant="Variant.Text"
                                  Label="@L["PlateNumber"]"
                                  ReadOnly="true" />
                </MudItem>   
                <MudItem sm="4">
                    <MudTextField @bind-Value="Payment.Invoice.TotalHours"
                                  Immediate="true"
                                  Variant="Variant.Text"
                                  Label="@L["Duration"]"
                                  ReadOnly="true" />
                </MudItem>
                <MudItem sm="4">
                    <MudTextField Value="Payment.Invoice.EntranceTime.ToString()"
                                  Immediate="true"
                                  Variant="Variant.Text"
                                  Label="@L["EntranceTime"]"
                                  ReadOnly="true" />
                </MudItem>
                <MudItem sm="4">
                    <MudTextField Value="Payment.Invoice.InvoiceTime.ToString()"
                                  Immediate="true"
                                  Variant="Variant.Text"
                                  Label="@L["ExitTime"]"
                                  ReadOnly="true" />
                </MudItem> 
                <MudItem sm="4">
                    <MudTextField Value="Payment.Invoice.Id"
                                  Immediate="true"
                                  Variant="Variant.Text"
                                  Label="@L["InvoiceId"]"
                                  ReadOnly="true" />
                </MudItem>

                   }                
                @if (Payment.Package is not null)
                {
                    @if (CultureInfo.CurrentCulture.Name == "ar")
                    {
                        <MudItem sm="4">
                            <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Payment.Package.ArabicName " Label=@L["PackageName"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Payment.Package.PackageTypeArabicName " Label=@L["Package Type"] />
                        </MudItem>
                    }
                    else
                    {
                        <MudItem sm="4">
                            <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Payment.Package.EnglishName " Label=@L["PackageName"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Payment.Package.PackageTypeEnglishName " Label=@L["Package Type"] />
                        </MudItem>
                    }

                }             
        </MudGrid>


        <MudItem class="d-flex justify-content-between mt-12">
            <MudButton OnClick="@Back" Variant="Variant.Filled" Color="MudBlazor.Color.Dark">@L["Back"]</MudButton>
            @if (currentTenant is not null && Payment.Invoice is not null)
            {
            <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="@ViewInvoiceDetails">@L["Print"]</MudButton>
            }


        </MudItem>

      
        </MudForm>
</div>
