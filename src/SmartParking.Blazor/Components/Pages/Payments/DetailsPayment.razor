@page "/payments/view/{Id}"
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using System.Globalization
@using SmartParking.Payments
@inject IPaymentWebAppService PaymentWebAppService
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
<PageTitle>@L["View Payment"]</PageTitle>
<div>
    <MudForm  Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
        <MudGrid>
            @if (Payment.Customers is not null)
            {


                @if (CultureInfo.CurrentCulture.Name == "ar")
                {
                    <MudItem sm="4">
                        <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Payment.Customers.ArabicName" Label=@L["CustomerName"] />
                    </MudItem>
                }
                else
                {
                    <MudItem sm="4">
                        <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Payment.Customers.UserName" Label=@L["CustomerName"] />
                    </MudItem>
                }

            }
                <MudItem sm="4">
                    <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Payment.PaymentCategory" Label=@L["PaymentCategory"] />
                </MudItem>

                <MudItem sm="4">
                    <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Payment.PaymentMethod" Label=@L["PaymentMethod"] />
                </MudItem>

                <MudItem sm="4">
                    <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="CreationTime" Label=@L["CreationTime"] />
                </MudItem>

            <MudItem sm="4">
                <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Amount" Label=@L["Amount"] />
            </MudItem>

            <MudItem sm="4">
                <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Payment.Currency" Label=@L["Currency"] />
            </MudItem>
            <MudItem sm="4">
                <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Payment.PaymentStatus" Label=@L["PaymentStatus"] />
            </MudItem>


               @if (Payment.Invoice is not null)
                   {
                       <MudItem sm="4">
                           <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Payment.Invoice.InvoiceNumber " Label=@L["InvoiceNumber"] />
                       </MudItem>                    
                       <MudItem sm="4">
                           <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Payment.Invoice.InvoiceType " Label=@L["InvoiceType"] />
                       </MudItem>                    
                   }                
                @if (Payment.Package is not null)
                {
                    @if (CultureInfo.CurrentCulture.Name == "ar")
                    {
                        <MudItem sm="4">
                            <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Payment.Package.ArabicName " Label=@L["PackageName"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Payment.Package.PackageTypeArabicName " Label=@L["Package Type"] />
                        </MudItem>
                    }
                    else
                    {
                        <MudItem sm="4">
                            <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Payment.Package.EnglishName " Label=@L["PackageName"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Payment.Package.PackageTypeEnglishName " Label=@L["Package Type"] />
                        </MudItem>
                    }

                }             

                
                
            
                </MudGrid>

        <MudItem class="d-flex justify-content-between mt-5">
            <MudButton OnClick="@Back" Variant="Variant.Filled" Color="MudBlazor.Color.Dark">@L["Back"]</MudButton>
        </MudItem>
        </MudForm>
</div>
