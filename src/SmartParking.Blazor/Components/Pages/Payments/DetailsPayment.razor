@page "/payments/view/{Id}"
@using Microsoft.Extensions.Localization
@using SmartParking.Currency
@using SmartParking.CustomerUnitPackages
@using SmartParking.Enums
@using SmartParking.Invoices
@using SmartParking.Localization
@using System.Globalization
@using SmartParking.Payments
@using SmartParking.Payments.PaymentRelations
@using SmartParking.Utilities
@using Volo.Abp.MultiTenancy
@inject IPaymentWebAppService paymentWebAppService
@inject IPaymentAppService paymentAppService
@inject IZatcaTaxInvoiceAppService zatcaTaxInvoiceAppService
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@inject IInvoiceAppService InvoiceAppService
@inject IDialogService DialogService
@inject CurrentTenant currentTenant
@inject IPaymentDetailsAppService PaymentRelationAppService
@inject ICustomerUnitPackageAppService CustomerUnitPackageAppService


<PageTitle>@L["View Details"]</PageTitle>
<div>
    <MudText Typo="Typo.h6" Class="fw-bold">@L["Details"]</MudText>

    <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
        <MudGrid>
            <MudItem sm="4">
                <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" Value="@(Payment!.PaymentNumber ?? "")" Label=@L["Code"] />
            </MudItem>

            @if (Payment.Customers is not null)
            {
                @if (CultureInfo.CurrentCulture.Name == "ar")
                {
                    <MudItem sm="4">
                        <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" Value="Payment.Customers.ArabicName" Label=@L["CustomerName"] />
                    </MudItem>
                }
                else
                {
                    <MudItem sm="4">
                        <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" Value="Payment.Customers.FullName" Label=@L["CustomerName"] />
                    </MudItem>
                }
            }
            <MudItem sm="4">
                <MudTextField ReadOnly="true" T="string" InputType="InputType.Text"Value="@(Payment!.CashierName??"")" Label=@L["CashierName"] />
            </MudItem>
              <MudItem sm="4">
                <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" Value="LocalizedPaymentCategory" Label=@L["PaymentCategory"] />
            </MudItem>
            <MudItem sm="4">
                <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" Value="LocalizedPaymentMethod" Label=@L["PaymentMethod"] />
                </MudItem>
            <MudItem sm="4">
                <div style="display: flex; flex-direction: column; font-weight:bold">
                    <label style="font-size: 0.75rem; margin-bottom: 4px;">
                        @L["Amount"]
                        @((MarkupString)CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "15px"))
                    </label>
                    <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" Value="Amount" />
                </div>
            </MudItem>
            <MudItem sm="4">
                <div style="display: flex; flex-direction: column; font-weight:bold">
                    <label style="font-size: 0.75rem; margin-bottom: 4px;">
                        @L["Discount"]
                        @((MarkupString)CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "15px"))
                    </label>
                    <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" Value="Discount" />
                </div>
            </MudItem>
            <MudItem sm="4">
                <div style="display: flex; flex-direction: column; font-weight:bold">
                    <label style="font-size: 0.75rem; margin-bottom: 4px;">
                        @L["PaymentVat"]
                        @((MarkupString)CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "15px"))
                    </label>
                    <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" Value="Vat" />
                </div>
            </MudItem>
    
            <MudItem sm="4">
                <div style="display: flex; flex-direction: column; font-weight:bold">
                    <label style="font-size: 0.75rem; margin-bottom: 4px;">
                        @L["PaymentTotal"]
                        @((MarkupString)CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "15px"))
                    </label>
                    <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" Value="Total" />
                </div>
            </MudItem>

            @if (Payment.PaymentCategory == PaymentCategory.PaymentParking.ToString())
            {
                <MudItem sm="4">
                    <MudTextField Value="@(Payment?.Invoice?.Id.ToString() ?? "0")"
                                  Immediate="true"
                                  Variant="Variant.Text"
                                  Label="@L["InvoiceId"]"
                                  ReadOnly="true" />
                </MudItem>
                <MudItem sm="4">
                    <MudTextField Value="@(Payment?.Invoice?.TicketId ?? "")"
                                  Immediate="true"
                                  Variant="Variant.Text"
                                  Label="@L["TicketId"]"
                                  ReadOnly="true" />
                </MudItem>
                 <!-- Invoice Type -->
                 <MudItem sm="4">
                     <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" Value="LocalizedPaymentInvoiceType" Label=@L["InvoiceType"] />
                 </MudItem>

                <!-- Plate Number -->
                <MudItem sm="4">
                    <MudTextField @bind-Value="Payment.Invoice.PlateNumber"
                                  Immediate="true"
                                  Variant="Variant.Text"
                                  Label="@L["PlateNumber"]"
                                  ReadOnly="true" />
                </MudItem>

                <!-- Total Hours -->
                <MudItem sm="4">
                    <MudTextField @bind-Value="Payment.Invoice.TotalHours"
                                  Immediate="true"
                                  Variant="Variant.Text"
                                  Label="@L["TotalHours"]"
                                  ReadOnly="true" />
                </MudItem>

                <!-- Entrance Time -->
                <MudItem sm="4">
                    <MudTextField Value="Payment.Invoice.EntranceTime.ToString()"
                                  Immediate="true"
                                  Variant="Variant.Text"
                                  Label="@L["EntranceTime"]"
                                  ReadOnly="true" />
                </MudItem>

                <!-- Exit Time -->
                <MudItem sm="4">
                    <MudTextField Value="Payment.Invoice.InvoiceTime.ToString()"
                                  Immediate="true"
                                  Variant="Variant.Text"
                                  Label="@L["ExitTime"]"
                                  ReadOnly="true" />
                </MudItem>
            }

            <MudItem sm="4">
                <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="CreationTime" Label=@L["CreationTime"] />
            </MudItem>

            <MudItem sm="4">
                <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" Label=@L["PaymentStatus"] @bind-Value="LocalizedPaymentStatus" />
            </MudItem>

            @if (Payment.PaymentCategory == PaymentCategory.Package.ToString())
            {
                @if (CultureInfo.CurrentCulture.Name == "ar")
                {
                    <MudItem sm="4">
                        <MudTextField ReadOnly="true"
                                      T="string"
                                      InputType="InputType.Text"
                                      Value="@(Payment?.customerPackageDto?.PackageArabicName ?? "")"
                                      Label="@L["PackageName"]" />
                    </MudItem>
                    @if (Payment.ArPlateNumber is not null)
                    {
                        <MudItem sm="4">
                            <MudTextField @bind-Value="@Payment!.ArPlateNumber"
                                          Immediate="true"
                                          Variant="Variant.Text"
                                          Label="@L["PlateNumber"]"
                                          ReadOnly="true" />
                        </MudItem>
                    }

                }
                else
                {
                    <MudItem sm="4">
                        <MudTextField ReadOnly="true"
                                      T="string"
                                      InputType="InputType.Text"
                                      Value="@(Payment?.customerPackageDto?.PackageEnglishName ?? "")"
                                      Label="@L["PackageName"]" />
                    </MudItem>

                    @if (Payment.EnPlateNumber is not null)
                    {
                        <MudItem sm="4">
                            <MudTextField @bind-Value="Payment.EnPlateNumber"
                            Immediate="true"
                            Variant="Variant.Text"
                            Label="@L["PlateNumber"]"
                            ReadOnly="true" />
                        </MudItem>
                    }
                }
            }
            @if (Payment.StatusZatca == Enums.Status.Active)
            {
                if (Payment.IsSentZatca == true && "" + Payment.ErrorMessagesZatca != "")
                {
                    <MudItem sm="12">

                        <MudAlert Severity="Severity.Warning" Elevation="4" Dense="true" Class="my-2" Icon="@Icons.Material.Filled.Warning" Variant="Variant.Filled">
                            <strong>@L["SentWithNotesToZatca"]:</strong>
                            <ul>
                                <li>@Payment.ErrorMessagesZatca</li>
                            </ul>
                        </MudAlert>
                    </MudItem>
                }
                if (Payment.IsSentZatca != true)
                {
                    <MudItem sm="12">

                        <MudAlert Severity="Severity.Error" Elevation="4" Dense="true" Class="my-2" Icon="@Icons.Material.Filled.Error" Variant="Variant.Filled">
                            <strong>@L["NotSentToZatca"]:</strong>
                            <ul>
                                <li>@Payment.ErrorMessagesZatca</li>
                            </ul>
                        </MudAlert>
                    </MudItem>
                }
            }
        </MudGrid>

        <MudItem class="d-flex justify-content-between mt-12">
            <MudButton OnClick="@Back" Variant="Variant.Filled" Color="MudBlazor.Color.Dark">@L["Back"]</MudButton>
            @if (Payment.StatusZatca == Enums.Status.Active)
            {
                if (Payment.IsSentZatca != true)
                {
                    <MudButton OnClick="@ResendZatca" Variant="Variant.Filled" Color="MudBlazor.Color.Warning">@L["ResendToZatca"]</MudButton>
                }
            }
            @if (currentTenant is not null )
            {
                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="@ViewInvoiceDetails">@L["Print"]</MudButton>
            }
        </MudItem>
    </MudForm>
</div>
