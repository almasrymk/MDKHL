@using Microsoft.Extensions.Localization
@using SmartParking.Invoices
@using System.Globalization
@using SmartParking.Localization
@inject IStringLocalizer<SmartParkingResource> L
<div class="invoice-body d-flex flex-column justify-content-center">

    <MudGrid Class="mb-4">

        @foreach(var item in _data)
        {
            if (item.Key == "Subscription" || item.Key == "Duration")
            {
                continue;
            }
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.body1">
                    <Strong> @L[item.Key]:</Strong> @item.Value
                </MudText>
            </MudItem>
        }
    </MudGrid>

</div>

<div class=" d-flex justify-content-center align-items-center flex-row col-md-12 " style="background-color: beige; margin-top: 2rem; border-radius: 15px;">
    <div class="col-md-6 d-flex flex-column align-items-center justify-content-center">
        <h5>@L["Subscription"]</h5>
        <h5>@L[_data["Subscription"].ToString()]</h5>
    </div>
    <div class="col-md-6 d-flex flex-column align-items-center justify-content-center">
        <h5>@L["TotalHours"]</h5>
        <h5>@_data["Duration"]</h5>
    </div>
</div>
