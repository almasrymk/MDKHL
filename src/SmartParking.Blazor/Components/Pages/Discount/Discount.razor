@page "/discounts"
@using Microsoft.Extensions.Localization
@using SmartParking.Authentication
@using SmartParking.Discounts
@using SmartParking.KeeperShifts
@using SmartParking.Localization
@using SmartParking.Organizations
@using Volo.Abp.Identity
@using Volo.Abp.MultiTenancy
@using Volo.Abp.PermissionManagement
@inject IDialogService DialogService
@inject IKeeperShiftsAppService KeeperShiftsAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@inject ICurrentTenant currrentTenant
@inject IOrganizationsAppService OrganizationAppService
@inject IDiscountAppService DiscountAppService
@inject IDialogService Dialog

@using Microsoft.AspNetCore.Authorization
<PageTitle>@L["Discount"]</PageTitle>
<MudText Typo="Typo.h5" Class="mb-2">@L["Discount"]</MudText>
<SPDataGrid PageName=@L["Discount"] Data="@itemData" 
