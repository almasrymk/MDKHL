@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.SubscriptionTypes
@using System.Globalization
@using SmartParking.Blazor.Components.Shared
@inject ISubscriptionTypeAppService SubscriptionTypeAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation

<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>		
				<MudText Typo="Typo.h6">@L["Edit"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="editForm">
				<MudGrid>
					<MudItem sm="6">
						<MudTextField @bind-Value="subscriptionType.TypeEn"
									  For="@(() => subscriptionType.TypeEn)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Placeholder=@L["Type Here"]
									  Label=@L["TypeEn"] 
									  RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
					</MudItem>
					<MudItem sm="6">
						<MudTextField @bind-Value="subscriptionType.TypeAr"
									  For="@(() => subscriptionType.TypeAr)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Placeholder=@L["Type Here"]
									  Label=@L["TypeAr"] 
									  RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
					</MudItem>



				</MudGrid>
			</MudForm>



		</DialogContent>

		<DialogActions>
    <DialogActionComponent 
        ButtonOneColor="MudBlazor.Color.Dark" 
        ButtonTwoColor="MudBlazor.Color.Primary" 
        ButtonOneLabel="@L["Back"]" 
        ButtonTwoLabel="@L["Save"]" 
        ButtonOneClick="Cancel" 
        ButtonTwoClick="Save" 
        ButtonOneVariant="MudBlazor.Variant.Filled" 
        ButtonTwoVariant="MudBlazor.Variant.Filled" />
</DialogActions>

	</MudDialog>

</MudItem>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>

