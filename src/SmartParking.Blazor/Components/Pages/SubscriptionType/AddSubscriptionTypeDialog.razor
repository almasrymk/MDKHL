@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.SubscriptionTypes
@inject ISubscriptionTypeAppService SubscriptionTypeAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation


<PageTitle>@L["AddSubscriptionTypes"]</PageTitle>
<MudItem class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["NewSubscriptionType"]</MudText>
        </TitleContent>
        <DialogContent>


            <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                <MudGrid>
                    <MudItem sm="12">
                        <MudTextField @bind-Value="input.Type"
                                      For="@(() => input.Type)"
                                      Immediate="true"
                                      Required
                                      Variant="Variant.Text"
                                      InputType="InputType.Text"
                                      Placeholder=@L["Type Here"]
                                      Label=@L["Type"] />
                    </MudItem>

                    <MudItem sm="9" md="9">


                        <MudRadioGroup @bind-Value="@input.Status" Class="d-inline-flex align-content-center">
                            <div class="d-flex flex-row justify-content-between">
                                <MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">@L["Active"]</MudRadio>
                                <MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Secondary">@L["InActive"]</MudRadio>
                            </div>
                        </MudRadioGroup>
                    </MudItem>
                </MudGrid>
            </MudForm>

        </DialogContent>

        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" Disabled="@(form == null || !form.IsValid)" OnClick="Submit">@L["Create"]</MudButton>
        </DialogActions>
    </MudDialog>

</MudItem>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>

