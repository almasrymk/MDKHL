@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Localization
@using SmartParking.Lookups.VehicleBrand
@using SmartParking.Lookups.VehicleModel
@using System.Globalization
@using SmartParking.Utilities
@using Volo.Abp.Application.Dtos

@inject IVehicleModelsAppService VehicleModelsAppService
@inject IVehicleBrandsAppService VehiclesBrandsAppService
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
<div class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			@if(CultureInfo.CurrentCulture.Name == "en")
			{
				<MudText Typo="Typo.h6">@L["Edit"] @VehicleModel.EnglishName</MudText>
			}
			else
			{
				<MudText Typo="Typo.h6">@L["Edit"] @VehicleModel.ArabicName</MudText>

			}
		</TitleContent>
		<DialogContent>



			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>
					<MudItem sm="6">
						<MudSelect @bind-Value="@VehicleModel.VehiclesBrandId"
						Variant="Variant.Text"
						Label="@L["VehiclesBrand Name"]"
						Placeholder="Choose"
						Required="true"
						Clearable="_clearable">
							@foreach (var vehicleBrand in VehicleBrands)
							{
								@if (CultureInfo.CurrentCulture.Name == "en")
								{
									<MudSelectItem Value="vehicleBrand.Id">@vehicleBrand.EnglishName</MudSelectItem>

								}
								else
								{
									<MudSelectItem Value="vehicleBrand.Id">@vehicleBrand.ArabicName</MudSelectItem>

								}

							}
						</MudSelect>
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="VehicleModel.ArabicName"
						For="@(() => VehicleModel.ArabicName)"
						Immediate="true"
						Label="@L["ArabicName"]" />
					</MudItem>

					<MudItem sm="4">
						<MudTextField @bind-Value="VehicleModel.EnglishName"
						For="@(() => VehicleModel.EnglishName)"
						Immediate="true"
						Required="true"
						Label="@L["EnglishName"]" />
					</MudItem>

					<MudItem sm="6">

						<div class="d-flex flex-column align-items-center px-5 position-relative pb-6">

							<MudImage Src="@ModelPicture" Class="bg_w_foto " Width="150" Height="100" Alt="@L["ModelPicture"]" />
							<MudFileUpload T="IBrowserFile" Accept=".png, .jpg" FilesChanged="OnImageUpload" MaximumFileCount="1">
								<ActivatorContent>
									<MudFab Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.CameraAlt" Size="MudBlazor.Size.Small" Class="rounded-circle" />
								</ActivatorContent>
							</MudFileUpload>
						</div>

					</MudItem>
				</MudGrid>
			</MudForm>

			


		</DialogContent>

		<DialogActions>
			<MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="CancelEdit">@L["Back"]</MudButton>
			<MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="SubmitEdit">@L["Save"]</MudButton>
		</DialogActions>


	</MudDialog>

</div>


<style>
	.mud-modal {
	border-radius: 0 20px 0 20px;
	}
</style>

@code {
	[CascadingParameter]
	private MudDialogInstance MudDialogAdd { get; set; }

	[Parameter] public CreateUpdateVehicleModelDto VehicleModel { get; set; }
	[Parameter]
	public int UpdatedId { get; set; }
	bool _clearable;
	private MudForm form;
	IReadOnlyList<VehicleBrandDto> VehicleBrands = new List<VehicleBrandDto>();
	private string ModelPicture { get; set; }

	private async Task OnImageUpload(IBrowserFile file)
	{
		var imageFile = file;
		if (imageFile != null)
		{
			// Save the image and get the file path
			ModelPicture = await ImageHelper.GetImageBase64Async(imageFile);
			StateHasChanged();
		}
	}
	protected override async Task OnInitializedAsync()
	{
		var result = await VehiclesBrandsAppService.GetListAsync(new PagedAndSortedResultRequestDto
			{
				MaxResultCount = 100,
				SkipCount = (1 - 1) * 100
			});
		VehicleBrands = result.Items.ToList();
		ModelPicture = VehicleModel.Image;
		await base.OnInitializedAsync();
	}

	private async Task SubmitEdit()
	{
		var successedMessage = L["VehicleModelUpdatedSuccessfully"];
		

		try
		{
			VehicleModel.Image = await FileHelper.SaveImageFromBase64Async(ModelPicture, PathHelper.ModelFolder);
			await VehicleModelsAppService.UpdateAsync(UpdatedId, VehicleModel);
			Snackbar.Add(successedMessage, Severity.Success);
			MudDialogAdd.Close(DialogResult.Ok(true));
			await Task.Delay(1000);
			Navigation.NavigateTo("/vehicleModels", true);
		}
		catch (Exception e)
		{
			Snackbar.Add(e.Message, Severity.Error);
		}
	}

	private async Task CancelEdit()
	{
		MudDialogAdd.Cancel();


	}


}
