@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Enums
@using SmartParking.Localization
@using SmartParking.Lookups.PlateColor
@using System.Security.Authentication
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@using Volo.Abp.Validation
@inject IDialogService DialogService
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@inject ISnackbar Snackbar 
@inject IPlateColorsAppService PlateColorsAppService
<PageTitle>@L["New Plate"]</PageTitle>
<div class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Add NEW"]</MudText>
        </TitleContent>
        <DialogContent>
           
                    <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                        <MudGrid>
                           


                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="plateColorDro.ArabicName"
                                              For="@(() => plateColorDro.ArabicName)"
                                              Immediate="true"
                                              Required="true"
                                      Placeholder=@L["Type Here"]
                                      Label="@L["ArabicName"]" />
                            </MudItem>

                            <MudItem sm="4">
                                <MudTextField @bind-Value="plateColorDro.EnglishName"
                                              For="@(() => plateColorDro.EnglishName)"
                                              Immediate="true"
                                              Required="true"
                                      Placeholder=@L["Type Here"]
                                      Label="@L["EnglishName"]" />
                            </MudItem>
                       
                          
                        </MudGrid>
                    </MudForm>
                    @*         </MudPaper>
                    *@
            
        </DialogContent>
        <DialogActions>
            <MudButton Color="MudBlazor.Color.Dark" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" Disabled="@(form == null || !form.IsValid)" OnClick="Submit">@L["Create"]</MudButton>
        </DialogActions>

    </MudDialog>

</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>
