@using Microsoft.Extensions.Localization
@using SmartParking.Cameras
@using SmartParking.Enums
@using SmartParking.Localization
@using SmartParking.Lookups.PlateColor
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@inject IDialogService DialogService
@inject IStringLocalizer<SmartParkingResource> L

<div class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["New Camera"]</MudText>
        </TitleContent>
        <DialogContent>
            <MudGrid>
                <MudItem sm="8">
                    @*         <MudPaper Class="h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">
                    *@
                    <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                        <MudGrid>
                           


                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="plateColorDro.ArabicName"
                                              For="@(() => plateColorDro.ArabicName)"
                                              Immediate="true"
                                              Label="@L["ArabicName"]" />
                            </MudItem>

                            <MudItem sm="4">
                                <MudTextField @bind-Value="plateColorDro.EnglishName"
                                              For="@(() => plateColorDro.EnglishName)"
                                              Immediate="true"
                                              Required="true"
                                              Label="@L["EnglishName"]" />
                            </MudItem>
                       
                          
                        </MudGrid>
                    </MudForm>
                    @*         </MudPaper>
                    *@
                </MudItem>
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudGrid Class="ps-lg-5">

                <MudItem sm="6" md="6">

                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="Submit">@L["Create"]</MudButton>
                </MudItem>
                <MudItem sm="6" md="6">

                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Tertiary" OnClick="Cancel">@L["Cancel"]</MudButton>
                </MudItem>
            </MudGrid>
        </DialogActions>

    </MudDialog>

</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>

@code {
    [Inject] ISnackbar Snackbar { get; set; }
    [Inject] IPlateColorsAppService PlateColorsAppService { get; set; } // Assuming you have a service to handle the camera creation

    private MudForm form;
    private CreateUpdatePlateColorDto plateColorDro = new CreateUpdatePlateColorDto();
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }
    bool _clearable;

    protected override async Task OnInitializedAsync()
    {

        await base.OnInitializedAsync();
    }
    private async Task Submit()
    {
        if (form.IsValid)
        {
            // Call your service to create the camera
            try
            {
                await PlateColorsAppService.CreateAsync(plateColorDro);
            }
            catch (Exception e)
            {
                Snackbar.Add("Fill Requried Items", Severity.Error);
                return;
            }
            Snackbar.Add("PlateColor created successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));

        }
        else
        {
            Snackbar.Add("Fill Requried Items", Severity.Error);
        }
    }
    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
