@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Cameras
@using SmartParking.Enums
@using SmartParking.Garages
@using SmartParking.Localization
@using SmartParking.Lookups.PlateColor
@using System.Security.Authentication
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@using Volo.Abp.Validation
@inject IPlateColorsAppService PlateColorsAppService
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
<PageTitle>@L["Edit PlateColor"]</PageTitle>
@inject NavigationManager Navigation
<div class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["Edit"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>

					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="PlateColor.ArabicName"
									  For="@(() => PlateColor.ArabicName)"
									  Immediate="true" Placeholder=@L["Type Here"]
									  Label=@L["ArabicName"] />
					</MudItem>

					<MudItem sm="4">
						<MudTextField @bind-Value="PlateColor.EnglishName"
									  For="@(() => PlateColor.EnglishName)"
									  Immediate="true"
									  Required="true"
									  Placeholder=@L["Type Here"]
									  Label=@L["EnglishName"] />
					</MudItem>
				</MudGrid>
			</MudForm>



		</DialogContent>
		<DialogActions>
    <DialogActionComponent 
        ButtonOneColor="MudBlazor.Color.Dark"
        ButtonTwoColor="MudBlazor.Color.Primary"
        ButtonOneLabel="@L["Back"]"
        ButtonTwoLabel="@L["Save"]"
        ButtonOneClick="CancelEdit"
        ButtonTwoClick="SubmitEdit"
        ButtonOneVariant="MudBlazor.Variant.Filled"
        ButtonTwoVariant="MudBlazor.Variant.Filled"
    />
</DialogActions>



	</MudDialog>

</div>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>

@code {
	[CascadingParameter]
	private MudDialogInstance MudDialogAdd { get; set; }
	[Parameter] public CreateUpdatePlateColorDto PlateColor { get; set; }
	[Parameter]
	public int UpdatedId { get; set; }
	bool _clearable;
	private MudForm form;

	protected override async Task OnInitializedAsync()
	{
		
		await base.OnInitializedAsync();
	}

	private async Task SubmitEdit()
	{
		var successedMessage = L["PlateColorUpdatedSuccessfully"];
		
		try
		{

			await PlateColorsAppService.UpdateAsync(UpdatedId, PlateColor);
			Snackbar.Add(successedMessage, Severity.Success);
			MudDialogAdd.Close(DialogResult.Ok(true));
			await Task.Delay(1000);
			Navigation.NavigateTo("/plateColors", true);

		}
		catch (AbpValidationException validationException)
		{
			foreach (var validationError in validationException.ValidationErrors)
			{
				SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.VAlIDATION_ERROR]}: {L[validationError.MemberNames.First()]} - {validationError.ErrorMessage}", Severity.Error);
			}
		}
		catch (BusinessException ex)
		{

			SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]} {L[AlertMessages.AlertMessages.UPDATE]} : {ex.Code}", Severity.Error);
		}
		catch (AuthenticationException ex)
		{
			SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]} {L[AlertMessages.AlertMessages.UPDATE]} : {ex.Message} ", Severity.Error);
		}
		catch (Exception ex)
		{

			SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]} {L[AlertMessages.AlertMessages.UPDATE]} : {ex.Message} ", Severity.Error);
		}
	}

	private async Task CancelEdit()
	{
		MudDialogAdd.Cancel();


	}


}
