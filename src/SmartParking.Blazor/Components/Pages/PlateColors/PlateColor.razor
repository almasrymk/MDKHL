@using Microsoft.Extensions.Localization
@using SmartParking.Cameras
@using SmartParking.Localization
@using SmartParking.Lookups.PlateColor
@inject IPlateColorsAppService PlateColorsAppService
@inject IDialogService Dialog
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Mdkhl , admin")]
@page "/platecolors"

<PageTitle>@L["PlateColors"]</PageTitle>
<MudText Typo="Typo.h5" Class="mb-2">@L["PlateColors"]</MudText>

<SPDataGrid PageName=@L["PlateColors"] Data="@itemData" TotalItemsInTable="TotalItem" OnFiltering="HandleFilter" OnClickRowEdit="OnClickRowEdit" OnClickRowView="OnClickRowView" OnPageChanged="FetchTableData" OnSearching="HandleSearch" OnAdd="@(() => CreatePlateColor(_backdropClick))" OnClickRowDelete="OnClickRowDelete"></SPDataGrid>






