
@page "/"
@page "/dashboard"
@using Microsoft.Extensions.Localization
@using MudBlazor.Components.Chart.Models
@using SmartParking.Analysis
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Cutomers
@using SmartParking.Enums
@using SmartParking.Garages
@using SmartParking.Localization
@using SmartParking.Organizations
@using System.Globalization
@using SmartParking.PDF
@using SmartParking.Utilities
@using MudBlazor
@using Volo.Abp.MultiTenancy
@inherits SmartParkingComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<SmartParkingResource> L
@inject ICurrentTenant CurrentTenant
@inject IOrganizationsAppService OrganizationAppService
@inject IGarageAppService GarageAppService
@inject ICustomerAppService CustomerAppService
@inject ICurrentTenant currenttenant
@inject IAnalysisAppService AnalysisAppService
@inject IJSRuntime JSRuntime
@inject IGenerateFilesAppService GenerateFilesAppService
@inject ISnackbar Snackbar

@attribute [Authorize]

<PageTitle>@L["Dashboard"]</PageTitle>

<MudGrid>
    @if (currenttenant.Id == null)
    {
        <SpCardInfo grid="totalGrid"
        Number="@_organizationsCount.ToString()"
        Type="@L["Organizations"]"
        icon=" images/dashboard/organizations.png"></SpCardInfo>



    }  
    <SpCardInfo grid="grid"
    Number="@_garagesCount.ToString()"
    Type="@L["Garages"]"
    icon="images/dashboard/garage.png"></SpCardInfo>
    <SpCardInfo grid="grid"
    Number="@_customersCount.ToString()"
    Type="@L["Customers"]"
    icon="images/dashboard/customers.png"></SpCardInfo>
    @if (currenttenant.Id is not null)
    {
        <SpCardStatistics grid="grid"
        Header="@L["TotalSlots"]"
        HeaderText1="@L["CustomersParking"]"
        BodyText1="@totalOfParking.ToString()"
        HeaderText2="@L["CustomersEmptyParking"]"
        BodyText2="@totalEmptyOfParking.ToString()"></SpCardStatistics>
    }
    <MudItem sm="12" Class="row">
        <MudItem Class="col">
            <SpCardInfo Number="@data[0].ToString()"
                        Type="@L["Customers"]"
                        icon="images/dashboard/customers.png"></SpCardInfo>
        </MudItem>
        <MudItem Class="col">
            <SpCardInfo Number="@data[1].ToString()"
                        Type="@L["Employees"]"
                        icon="images/dashboard/customers.png"></SpCardInfo>
        </MudItem>
        <MudItem Class="col">
           
            <SpCardInfo 
                        Number="@data[2].ToString()"
                        Type="@L["Visitors"]"
                        icon="images/dashboard/customers.png"></SpCardInfo>
        </MudItem>
            @if (currenttenant.Id is null)
            {
            <MudItem Class="col">
                    <SpCardInfo 
                                Number="@data[3].ToString()"
                                Type="@L["NoPackages"]"
                                icon="images/dashboard/customers.png"></SpCardInfo>
            </MudItem>
            }
        
    </MudItem>
    
    



    @if(currenttenant.Id is not null)
    {

        <SpCardDashbard Image="images/dashboard/car.png" Header="@L["Customers"]" 
        HeaderText1="@L["CustomersParking"]" BodyText1="@getNumberOfParking.NumberOfCustomerParking" 
        HeaderText2="@L["CustomersEmptyParking"]" BodyText2="@getNumberOfParking.NumberOfCustomerEmptyParking"
        HandleExport="@( ()=> ExportToExcel(CustomerCategoryStatus.Customer))"
        ExportModel="@L["Excel"]"></SpCardDashbard>

        <SpCardDashbard Image="images/dashboard/car.png" Header="@L["Employees"]" HeaderText1="@L["CustomersParking"]"
        BodyText1="@getNumberOfParking.NumberOfEmployeeParking" 
        HeaderText2="@L["CustomersEmptyParking"]" BodyText2="@getNumberOfParking.NumberOfEmployeeEmptyParking"
        HandleExport="@( ()=> ExportToExcel(CustomerCategoryStatus.Employee))"
        ExportModel="@L["Excel"]"></SpCardDashbard>

        <SpCardDashbard Image="images/dashboard/car.png" Header="@L["Visitors"]" HeaderText1="@L["CustomersParking"]"
        BodyText1="@getNumberOfParking.NumberOfVisitorParking"
        HeaderText2="@L["CustomersEmptyParking"]" BodyText2="@getNumberOfParking.NumberOfVisitorEmptyParking"
        HandleExport="@( ()=> ExportToExcel(CustomerCategoryStatus.Visitor))"
        ExportModel="@L["Excel"]"></SpCardDashbard>



    }
    <SpCardStatistics 
    grid="12"
    Header="@L["CollectedMoneyToday"]"
    HeaderText1="@L["Day"]"
    BodyText1="@Day"
    HeaderText2="@L["Collected"]"
    BodyText2="@collectedMoneyToday.ToString()"
    ></SpCardStatistics>


    <MudItem sm="6">
        <MudPaper class="custom-rounded px-4 py-2 bg-white d-flex gap-2 align-items-center h-100">
            <MudImage Src="images/dashboard/car.png" />
            <div class="d-flex flex-column">
                <div>
                    <MudText Typo="Typo.body2">
                        Car Model
                    </MudText>
                    <MudText Class="fw-bold" Typo="Typo.subtitle1">
                        Toyota Corolla 2021
                    </MudText>
                </div>
                <div>
                    <MudText Typo="Typo.body2">
                        License
                    </MudText>
                    <MudText Class="fw-bold" Typo="Typo.subtitle1">
                        A R S 1234
                    </MudText>
                </div>
                <div>
                    <MudText Typo="Typo.body2">
                        License
                    </MudText>
                    <MudText Class="fw-bold" Typo="Typo.subtitle1">
                        A R S 1234
                    </MudText>
                </div>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem sm="6">
        <MudPaper Class="custom-rounded overflow-hidden h-100">
            <Image Source="images/dashboard/discount.png" Fluid Class="w-100" />
        </MudPaper>
    </MudItem>
    <MudItem sm="6">

        <MudPaper Class="custom-rounded p-3">
            <MudTooltip Text="@msg" Color="MudBlazor.Color.Tertiary" Arrow="true">

                <MudChart ChartType="ChartType.Pie"
                InputData="@data"
                InputLabels="@labels"
                Width="300px"
                Height="300px"
                ChartOptions="@options"
                />
            </MudTooltip>
        </MudPaper>
    </MudItem>
    <MudItem sm="12">
        <MudPaper Class="custom-rounded">
            <MudItem Class="d-flex align-items-start justify-content-end m-3 pt-5">
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Variant="Variant.Filled">
                    <MudMenuItem OnClick="ExportPaymentAnalysisToExcel">@L["Excel"]</MudMenuItem>
                </MudMenu>
            </MudItem>
            <MudChart ChartType="ChartType.Bar" ChartSeries="@Series" @bind-SelectedIndex="index" XAxisLabels="@XAxisLabels" Width="100%" Height="350px"></MudChart>

        </MudPaper>
    </MudItem>

</MudGrid>


@code {


    ChartOptions options = new ChartOptions();
    AnalysisNamesCountDto value = new AnalysisNamesCountDto();
    public EventCallback<string> SelectValueChanged { get; set; }
    private int _organizationsCount;
    private int _garagesCount;
    private int _customersCount;
    private int grid;
    private int totalGrid;
    private GetNumberOfParkingAndEmptyParkingDto getNumberOfParking { get; set; } = new GetNumberOfParkingAndEmptyParkingDto();
    double[] data= { 20,77,100,20};

    string[] labels = { "Customers", "Employees" , "Visitors","NoPackage"};
    string msg;
    private List<OrganizationDto> Organizations = new List<OrganizationDto>();
    public string[] XAxisLabels = { " " };
    private int index = -1; 

    public List<ChartSeries> Series = new List<ChartSeries>();

    private string[] inputLabels { get; set; } = { " " };
    private double[] inputData { get; set; } = { 0 };
    private string? Day = default;
    private double? collectedMoneyToday = default;
    int totalOfParking;
    int totalEmptyOfParking;
    protected async override Task OnInitializedAsync()
    {

        // Fetch the data from backend


        _organizationsCount = await OrganizationAppService.GetOrganizationsCount();
        _garagesCount = await GarageAppService.GetAllGaragesCount();

        var name = CurrentUser.UserName;
        if (currenttenant.Id == null)
        {
            Organizations = await OrganizationAppService.GetAllMobileAsync();
            var organization = Organizations.FirstOrDefault();
            await GetNumberOfParkingAndEmptyAsync(organization.Id);
            var dataForCount = await AnalysisAppService.GetCountOfCustomersAndVisitorsAndEmployeesMdkhl();
            ShowData(dataForCount.totalCountOfCustomers, dataForCount.totalCountOfVisitors, dataForCount.totalCountOfEmployees, dataForCount.totalCountOfNoPackage);
            grid = 4;
            totalGrid = 4;
            _customersCount = await CustomerAppService.GetCountCustomersCountForMDKHL();

            var dataForSeries = await AnalysisAppService.CalculateWeeklyCollectedMoneyMdkhlAsync();
            showDataGraph(dataForSeries.Days, dataForSeries.AllTotalAmounts, dataForSeries.InvoiceTotalAmounts, dataForSeries.PackageTotalAmounts);

            var dataForToday = await AnalysisAppService.CalculateDailyCollectedMoneyMdKhlAsync();
            Day = dataForToday.Day;
            collectedMoneyToday = dataForToday.totalAmounts;
        }
        else
        {
            var organization = await OrganizationAppService.GetOrganizationForCurrentTenatAsync();
            await GetNumberOfParkingAndEmptyAsync(organization.Id);
            var dataForCount = await AnalysisAppService.GetCountOfCustomersAndVisitorsAndEmployeesOrganization(organization.Id);
            ShowData(dataForCount.totalCountOfCustomers, dataForCount.totalCountOfVisitors, dataForCount.totalCountOfEmployees,null);
            grid = 4;
            totalGrid = 6;
            _customersCount = await CustomerAppService.GetCountCustomersCountForOrganization(currenttenant.Id);
            var dataForSeries = await AnalysisAppService.CalculateWeeklyCollectedMoneyOrganizationAsync(organization.Id);
            showDataGraph(dataForSeries.Days, dataForSeries.AllTotalAmounts,dataForSeries.InvoiceTotalAmounts,dataForSeries.PackageTotalAmounts);

            var dataForToday = await AnalysisAppService.CalculateDailyCollectedMoneyOrganizationAsync(organization.Id);
            Day = dataForToday.Day;
            collectedMoneyToday = dataForToday.totalAmounts;
        }

        string[] colors = { "#0D5480", "#16B7D3", "#CE3333" };
        options.ChartPalette = colors;
        options.ShowLegend = true;
        options.LineStrokeWidth = 20;


        //   return await base.OnInitializedAsync();
    }

    private void ShowData(int NumberOfCustomers, int NumberOfVisitors, int NumberOfEmployees , int? NumberOfNoPackage)
    {
        data[0] = NumberOfCustomers;
        data[1] = NumberOfEmployees;
        data[2] = NumberOfVisitors;
        labels[0] = $"{LocalizationHelper.GetLocalizedString("Beneficiaries")} {NumberOfCustomers}";
        labels[1] = $"{LocalizationHelper.GetLocalizedString("Employees")} {NumberOfEmployees}";
        labels[2] = $"{LocalizationHelper.GetLocalizedString("Visitors")} {NumberOfVisitors}";

        if(NumberOfNoPackage is not null)
        {
            data[3] = (double)NumberOfNoPackage;
            labels[3] = $"{LocalizationHelper.GetLocalizedString("NoPackages")} {NumberOfNoPackage}";
        }
          

        

    }

    private async Task GetNumberOfParkingAndEmptyAsync(int organizationId)
    {
        getNumberOfParking = await AnalysisAppService.GetNumberOfParkingSlotsAndEmptySolts(organizationId);
        totalOfParking = getNumberOfParking.NumberOfParking;
        totalEmptyOfParking = getNumberOfParking.NumberOfEmptyParking;


    }

    private void showDataGraph(string[] days, double[] allTotalAmounts, double[] invoiceTotalAmounts, double[] packageTotalAmounts)
    {
        XAxisLabels = days;
        Series = new List<ChartSeries>()
        {
            new ChartSeries() { Name = LocalizationHelper.GetLocalizedString("TotalCollectedMoney"), Data =  allTotalAmounts},
            new ChartSeries() { Name = LocalizationHelper.GetLocalizedString("InvoiceCollectedMoney"), Data =  invoiceTotalAmounts},
            new ChartSeries() { Name = LocalizationHelper.GetLocalizedString("PackageCollectedMoney"), Data =  packageTotalAmounts}
        };
    }


    private async Task ExportData (TableData data )
    {
        var folderName = FileHelper.CreateImageDirectory("Folders/Excel");

        string file = System.IO.Path.Combine(folderName, $"{data.Name}.xlsx");

        await GenerateFilesAppService.ExportToExcel(data, file);

        SnackBar.ShowSnackbar(Snackbar, LocalizationHelper.GetLocalizedString(AlertMessages.AlertMessages.SUCCESS) + " " +
                    LocalizationHelper.GetLocalizedString(AlertMessages.AlertMessages.EXPORT), Severity.Success);

        await Task.Delay(1000);
        await OpenNewBlank($"Folders/Excel/{data.Name}.xlsx");
    }

    private async Task ExportToExcel(CustomerCategoryStatus category)
    {
        try
        {

            TableData data;
            if(currenttenant.Id == null)
            {
                data = await AnalysisAppService.ReortGarageTransactionMdkhlAsync(category);
            }
            else
            {
                data = await AnalysisAppService.ReortGarageTransactionOrganizationAsync(category);
            }

            await ExportData(data);
        }
        catch
        {
            SnackBar.ShowSnackbar(Snackbar, LocalizationHelper.GetLocalizedString(AlertMessages.AlertMessages.FAILED) + " " +
                        LocalizationHelper.GetLocalizedString(AlertMessages.AlertMessages.EXPORT), Severity.Error);
        }


    }
    
    private async Task ExportPaymentAnalysisToExcel()
    {
        try
        {
            TableData data;
            if(currenttenant.Id == null)
            {
                 data = await AnalysisAppService.ReortPaymentCollectedMoneyDailyAndMonthlyMdkhlAsync();
            }
            else
            {
                data = await AnalysisAppService.ReortPaymentCollectedMoneyDailyAndMonthlyOrganizationAsync();
            }
            await ExportData(data);
        }
        catch
        {
            SnackBar.ShowSnackbar(Snackbar, LocalizationHelper.GetLocalizedString(AlertMessages.AlertMessages.FAILED) + " " +
                        LocalizationHelper.GetLocalizedString(AlertMessages.AlertMessages.EXPORT), Severity.Error);
        }


    }
    private async Task OpenNewBlank(string url)
    {

        await JSRuntime.InvokeVoidAsync("window.open", url, "_blank");
    }
    
}