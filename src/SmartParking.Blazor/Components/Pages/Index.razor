@inject MudBlazor.IDialogService DialogService
@page "/"
@page "/dashboard"
@using Microsoft.Extensions.Localization
@using SmartParking.Analysis
@using SmartParking.Cutomers
@using SmartParking.Garages
@using SmartParking.Localization
@using SmartParking.Organizations
@using Volo.Abp.MultiTenancy
@inherits SmartParkingComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<SmartParkingResource> L
@inject ICurrentTenant CurrentTenant
@inject IOrganizationsAppService OrganizationAppService
@inject IGarageAppService GarageAppService
@inject ICustomerAppService CustomerAppService
@inject ICurrentTenant currenttenant
@inject IAnalysisAppService AnalysisAppService

@attribute [Authorize]

<PageTitle>@L["Dashboard"]</PageTitle>

<MudGrid>
    @if (currenttenant.Id == null)
    {
        
    <MudItem sm="@grid">
        <MudPaper class="custom-rounded px-4 py-2 bg-white d-flex justify-content-between align-items-center">
            <div>
                <MudText Class="fw-bold" Typo="Typo.h4">
                    @_organizationsCount
                </MudText>
                <MudText>
                    @L["Organizations"]
                </MudText>
            </div>
            <MudImage Src="images/dashboard/organizations.png" />
        </MudPaper>
    </MudItem>
    }        
    <MudItem sm="@grid">
    
        <MudPaper class="custom-rounded px-4 py-2 bg-white d-flex justify-content-between align-items-center">
            <div>
                <MudText Class="fw-bold" Typo="Typo.h4">
                    @_garagesCount
                </MudText>
                <MudText>
                    @L["Garages"]
                </MudText>
            </div>
            <MudImage Src="images/dashboard/garage.png" />
        </MudPaper>
    </MudItem>
    <MudItem sm="@grid">
        <MudPaper class="custom-rounded px-4 py-2 bg-white d-flex justify-content-between align-items-center">
            <div>
                <MudText Class="fw-bold" Typo="Typo.h4">
                    @_customersCount
                </MudText>
                <MudText>
                    @L["Customers"]
                </MudText>
            </div>
            <MudImage Src="images/dashboard/customers.png" />
        </MudPaper>
    </MudItem>
    <MudItem sm="6">
        <MudPaper class="custom-rounded px-4 py-2 bg-white d-flex gap-2 align-items-center h-100">
            <MudImage Src="images/dashboard/car.png" />
            <div class="d-flex flex-column">
                <div>
                    <MudText Typo="Typo.body2">
                        Car Model
                    </MudText>
                    <MudText Class="fw-bold" Typo="Typo.subtitle1">
                        Toyota Corolla 2021
                    </MudText>
                </div>
                <div>
                    <MudText Typo="Typo.body2">
                        License
                    </MudText>
                    <MudText Class="fw-bold" Typo="Typo.subtitle1">
                        A R S 1234
                    </MudText>
                </div>
                <div>
                    <MudText Typo="Typo.body2">
                        License
                    </MudText>
                    <MudText Class="fw-bold" Typo="Typo.subtitle1">
                        A R S 1234
                    </MudText>
                </div>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem sm="6">
        <MudPaper Class="custom-rounded overflow-hidden h-100">
            <Image Source="images/dashboard/discount.png" Fluid Class="w-100" />
        </MudPaper>
    </MudItem>
    <MudItem sm="4">
        @if (currenttenant.Id == null)
        {
            
        <MudPaper Class="custom-rounded p-3">
            <MudSelect T="string"
                       ValueChanged="ChangeSelect"
                       Placeholder="@L[ "Choose"]"
                       AdornmentColor="MudBlazor.Color.Primary"
                       Class="mb-3" 
                       Immediate="true"
                       Value="_pieChartValue"
            
            >
                <MudSelectItem Value="@("OrganizationsCustomers")">Organizations Customers</MudSelectItem>
                <MudSelectItem Value="@("PackagesOrganizations")">Packages Organizations</MudSelectItem>
            </MudSelect>
            <MudTooltip Text="@msg" Color="MudBlazor.Color.Tertiary" Arrow="true">

                <MudChart 
                    ChartType="ChartType.Pie" 
                    InputData="@data" 
                    InputLabels="@labels" 
                    Width="300px" 
                    Height="300px" 
                    ChartOptions="@options"
                    SelectedIndexChanged="handleindexChartChange"
                    
                    
                    
                    />
          </MudTooltip>
            </MudPaper>

        }
        else
        {
            <MudPaper Class="custom-rounded p-3">
                <MudTooltip Text="@msg" Color="MudBlazor.Color.Tertiary" Arrow="true">

                    <MudChart ChartType="ChartType.Pie"
                              InputData="@data"
                              InputLabels="@labels"
                              Width="300px"
                              Height="300px"
                              ChartOptions="@options"
                              />
                </MudTooltip>
            </MudPaper>

        }
    </MudItem>
    <MudItem sm="8">
        <MudPaper Class="custom-rounded p-3">
            <MudChart ChartType="ChartType.Bar" ChartSeries="@Series" @bind-SelectedIndex="_barIndex" XAxisLabels="@XAxisLabels" Width="100%"></MudChart>
        </MudPaper>
    </MudItem>
</MudGrid>


@code {


    ChartOptions options = new ChartOptions();
    AnalysisNamesCountDto value = new AnalysisNamesCountDto();
    public EventCallback<string> SelectValueChanged { get; set; }



    private int _organizationsCount;
    private int _garagesCount;
    private int _customersCount;
    private int grid;
    private string _pieChartValue = "OrganizationsCustomers";

    double[] data= { 20,77,35};
    private int _index = -1;
    string[] labels = { "Carlos","Robert","Chevorlet"} ;
    string msg;


    protected async override Task OnInitializedAsync()
    {
         _organizationsCount = await OrganizationAppService.GetOrganizationsCount();
         _garagesCount = await GarageAppService.GetAllGaragesCount();



        if (currenttenant.Id == null)
        {
            var result = await AnalysisAppService.GetNumberOfCustomerForOrganizations();
            value.Count = result.Count;
            value.Names = result.Names;
            data = value.Count.ToArray();
            labels = value.Names.ToArray();

            grid = 4;
             _customersCount = await CustomerAppService.GetCountCustomersCountForMDKHL();
        }
        else
        {
            grid = 6;
            _customersCount = await CustomerAppService.GetCountCustomersCountForOrganization(currenttenant.Id);

        }

        string[] colors = { "#0D5480", "#16B7D3", "#CE3333" };
        options.ChartPalette = colors;
        options.ShowLegend = true;
        options.LineStrokeWidth = 10;


        //   return await base.OnInitializedAsync();
    }



    private async Task ChangeSelect(string PieChartValue)
    {
        _pieChartValue = PieChartValue;

        if (PieChartValue == "OrganizationsCustomers")
        {
            var result = await AnalysisAppService.GetNumberOfCustomerForOrganizations();
            value.Count = result.Count;
            value.Names = result.Names;

        }
        else if (PieChartValue == "PackagesOrganizations")
        {

            var result = await AnalysisAppService.GetPackageAndNumberOfOrganizationsThatSubscribed();
            value.Count = result.Count;
            value.Names = result.Names;

        }
        data = value.Count.ToArray();
        labels = value.Names.ToArray();

    }

    public void handleindexChartChange (int index) {
        if (index != -1)
        {
            if (_pieChartValue == "OrganizationsCustomers")
            {

                msg = "Customers in organization " + labels[index]+ " are " + data[index].ToString();
            }
            else if (_pieChartValue == "PackagesOrganizations")
            {
                
                msg = "Organizations in Package " + labels[index] + " are " + data[index].ToString();

            }

        }

    }
    private int _barIndex = -1;
    public List<ChartSeries> Series = new List<ChartSeries>()
    {
        new ChartSeries() {  Data = new double[] { 40, 20, 25, 27, 46, 60, 48 } },
        new ChartSeries() {  Data = new double[] { 19, 24, 35, 13, 28, 15, 13 } },
    };
    public string[] XAxisLabels = { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
}