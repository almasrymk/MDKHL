
@page "/"
@page "/dashboard"
@using Microsoft.Extensions.Localization
@using SmartParking.Analysis
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Cutomers
@using SmartParking.Enums
@using SmartParking.Garages
@using SmartParking.Helpers
@using SmartParking.Localization
@using SmartParking.Organizations
@using System.Globalization
@using SmartParking.PDF
@using SmartParking.Utilities
@using MudBlazor
@using Volo.Abp.MultiTenancy
@inherits SmartParkingComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<SmartParkingResource> L
@inject ICurrentTenant CurrentTenant
@inject IOrganizationsAppService OrganizationAppService
@inject IGarageAppService GarageAppService
@inject ICustomerAppService CustomerAppService
@inject ICurrentTenant currenttenant
@inject IAnalysisAppService AnalysisAppService
@inject IJSRuntime JSRuntime
@inject IGenerateFilesAppService GenerateFilesAppService
@inject ISnackbar Snackbar

@attribute [Authorize]

<PageTitle>@L["Dashboard"]</PageTitle>

<MudGrid>
    @if (currenttenant.Id == null)
    {
        <SpCardInfo grid="totalGrid"
        Number="@_organizationsCount.ToString()"
        Type="@L["Organizations"]"
        icon=" images/dashboard/organizations.png"></SpCardInfo>



    }  
    <SpCardInfo grid="grid"
    Number="@_garagesCount.ToString()"
    Type="@L["Garages"]"
    icon="images/dashboard/garage.png"></SpCardInfo>

    <SpCardInfo grid="grid"
    Number="@_customersCount.ToString()"
    Type="@L["Customers"]"
    icon="images/dashboard/customers.png"></SpCardInfo>
    @if (currenttenant.Id is not null)
    {
        <SpCardStatistics grid="grid"
        Header="@L["TotalSlots"]"
        HeaderText1="@L["CustomersParking"]"
        BodyText1="@totalOfParking.ToString()"
        HeaderText2="@L["CustomersEmptyParking"]"
        BodyText2="@totalEmptyOfParking.ToString()"></SpCardStatistics>
    }
    <MudItem sm="12" Class="row">
        <MudItem Class="col">
            <SpCardInfo Number="@data[0].ToString()"
                        Type="@L["Beneficiaries"]"
                        icon="images/dashboard/customers.png"></SpCardInfo>
        </MudItem>
        <MudItem Class="col">
            <SpCardInfo Number="@data[1].ToString()"
                        Type="@L["Employees"]"
                        icon="images/dashboard/customers.png"></SpCardInfo>
        </MudItem>
        <MudItem Class="col">
           
            <SpCardInfo 
                        Number="@data[2].ToString()"
                        Type="@L["Visitors"]"
                        icon="images/dashboard/customers.png"></SpCardInfo>
        </MudItem>
            @if (currenttenant.Id is null)
            {
            <MudItem Class="col">
                    <SpCardInfo 
                                Number="@data[3].ToString()"
                                Type="@L["NoPackages"]"
                                icon="images/dashboard/customers.png"></SpCardInfo>
            </MudItem>
            }
        
    </MudItem>
    
    



    @if(currenttenant.Id is not null)
    {

        <SpCardDashbard Image="images/dashboard/car.png" Header="@L["Customers"]" 
        HeaderText1="@L["CustomersParking"]" BodyText1="@getNumberOfParking.NumberOfCustomerParking" 
        HeaderText2="@L["Reserved"]" BodyText2="@getNumberOfParking.NumberOfCustomerReservedParking"
        HandleExport="@( ()=> ExportToExcel(CustomerCategoryStatus.Customer))"
        ExportModel="@L["Excel"]"></SpCardDashbard>

        <SpCardDashbard Image="images/dashboard/car.png" Header="@L["Employees"]" HeaderText1="@L["CustomersParking"]"
        BodyText1="@getNumberOfParking.NumberOfEmployeeParking" 
        HeaderText2="@L["Reserved"]" BodyText2="@getNumberOfParking.NumberOfEmployeeReservedParking"
        HandleExport="@( ()=> ExportToExcel(CustomerCategoryStatus.Employee))"
        ExportModel="@L["Excel"]"></SpCardDashbard>

        <SpCardDashbard Image="images/dashboard/car.png" Header="@L["Visitors"]" HeaderText1="@L["CustomersParking"]"
        BodyText1="@getNumberOfParking.NumberOfVisitorParking"
        HeaderText2="@L["Reserved"]" BodyText2="@getNumberOfParking.NumberOfVistiorReservedParking"
        HandleExport="@( ()=> ExportToExcel(CustomerCategoryStatus.Visitor))"
        ExportModel="@L["Excel"]"></SpCardDashbard>



    }
    <SpCardStatistics 
    grid="12"
    Header="@L["CollectedMoneyToday"]"
    HeaderText1="@L["Day"]"
    BodyText1="@Day"
    HeaderText2="@L["Collected"]"
    BodyText2=@collectedMoneyToday
    ></SpCardStatistics>

    <MudItem sm="6">
        <MudPaper class="custom-rounded px-4 py-2 bg-white d-flex gap-2 align-items-center h-100">
            <MudImage Src="images/dashboard/car.png" />
            <div class="d-flex flex-column">
                <div>
                    <MudText Typo="Typo.body2">
                        Car Model
                    </MudText>
                    <MudText Class="fw-bold" Typo="Typo.subtitle1">
                        Toyota Corolla 2021
                    </MudText>
                </div>
                <div>
                    <MudText Typo="Typo.body2">
                        License
                    </MudText>
                    <MudText Class="fw-bold" Typo="Typo.subtitle1">
                        A R S 1234
                    </MudText>
                </div>
                <div>
                    <MudText Typo="Typo.body2">
                        License
                    </MudText>
                    <MudText Class="fw-bold" Typo="Typo.subtitle1">
                        A R S 1234
                    </MudText>
                </div>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem sm="6">
        <MudPaper Class="custom-rounded overflow-hidden h-100">
            <Image Source="images/dashboard/discount.png" Fluid Class="w-100" />
        </MudPaper>
    </MudItem>
    <div style="display: flex; gap: 16px; width: 100%; padding: 16px; box-sizing: border-box;">
        <MudItem sm="5" Style="flex: 0 0 40%; display: flex; flex-direction: column; height: 100%; padding: 16px; margin: 0;">
            <MudPaper Style="height: 100%; padding: 16px; margin: 0; display: flex; flex-direction: column; justify-content: space-between;">
                <MudTooltip Text="@msg" Color="MudBlazor.Color.Tertiary" Arrow="true">
                    <MudChart ChartType="ChartType.Pie"
                              InputData="@data"
                              InputLabels="@labels"
                              Width="300px"
                              Height="300px"
                              ChartOptions="@options" />
                </MudTooltip>
            </MudPaper>
        </MudItem>

        <MudItem sm="7" Style="flex: 0 0 60%; display: flex; flex-direction: column; height: 100%; padding: 16px; margin: 0;">
            <MudPaper Style="height: 100%; padding: 16px; margin: 0; display: flex; flex-direction: column; justify-content: space-between;">
                <MudItem Style="display: flex; align-items: flex-start; justify-content: flex-end;">
                </MudItem>
                @if (Series != null && Series.Any(s => s.Data != null && s.Data.Any(d => d > 0))) 
                {
                  @if (CultureInfo.CurrentCulture.Name == "en")               
                  {
                      <MudItem Style="margin-left: 32px;font-size: 12px; margin-bottom: 4px;">
                      @L["SAR"]
                      </MudItem>
                  }
                  else
                  {
                      <MudItem Style="text-align:left ; font-size: 12px; margin-bottom: 4px;">
                          @L["SAR"]
                      </MudItem>

                  }
                }
                <MudChart ChartType="ChartType.Bar"
                          ChartSeries="@Series"
                          @bind-SelectedIndex="index"
                          XAxisLabels="@XAxisLabels"
                          Width="100%"
                          Height="300px"
                          Style="max-width: 100%; margin: 0 auto;" />
            </MudPaper>
        </MudItem>

    </div>

</MudGrid>