
@page "/"
@page "/dashboard"
@using Microsoft.Extensions.Localization
@using MudBlazor.Components.Chart.Models
@using SmartParking.Analysis
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Cutomers
@using SmartParking.Enums
@using SmartParking.Garages
@using SmartParking.Localization
@using SmartParking.Organizations
@using System.Globalization
@using SmartParking.PDF
@using SmartParking.Utilities
@using MudBlazor
@using Volo.Abp.MultiTenancy
@inherits SmartParkingComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<SmartParkingResource> L
@inject ICurrentTenant CurrentTenant
@inject IOrganizationsAppService OrganizationAppService
@inject IGarageAppService GarageAppService
@inject ICustomerAppService CustomerAppService
@inject ICurrentTenant currenttenant
@inject IAnalysisAppService AnalysisAppService
@inject IJSRuntime JSRuntime
@inject IGenerateFilesAppService GenerateFilesAppService
@inject ISnackbar Snackbar

@attribute [Authorize]

<PageTitle>@L["Dashboard"]</PageTitle>

<MudGrid>
    @if (currenttenant.Id == null)
    {

        <MudItem sm="@grid">
            <MudPaper class="custom-rounded px-4 py-2 bg-white d-flex justify-content-between align-items-center">
                <div>
                    <MudText Class="fw-bold" Typo="Typo.h4">
                        @_organizationsCount
                    </MudText>
                    <MudText>
                        @L["Organizations"]
                    </MudText>
                </div>
                <MudImage Src="images/dashboard/organizations.png" />
            </MudPaper>
        </MudItem>
    }        
    <MudItem sm="@grid">

        <MudPaper class="custom-rounded px-4 py-2 bg-white d-flex justify-content-between align-items-center">
            <div>
                <MudText Class="fw-bold" Typo="Typo.h4">
                    @_garagesCount
                </MudText>
                <MudText>
                    @L["Garages"]
                </MudText>
            </div>
            <MudImage Src="images/dashboard/garage.png" />
        </MudPaper>
    </MudItem>

    <MudItem sm="@grid">
        <MudPaper class="custom-rounded px-4 py-2 bg-white d-flex justify-content-between align-items-center">
            <div>
                <MudText Class="fw-bold" Typo="Typo.h4">
                    @_customersCount
                </MudText>
                <MudText>
                    @L["Customers"]
                </MudText>
            </div>
            <MudImage Src="images/dashboard/customers.png" />
        </MudPaper>
    </MudItem>
    @if(currenttenant.Id is not null)
    {
        <MudItem sm="4">
            <MudPaper class="custom-rounded px-4 py-2 bg-white d-flex align-items-start justify-content-between">
                <MudImage Src="images/dashboard/car.png" Class="me-3" />
                <div>

                    <MudItem Class="d-flex align-items-center">
                        
                          
                        <MudText Class="fw-bold" Typo="Typo.h6">
                            @L["Customers"]
                        </MudText>
                    </MudItem>

                    <MudText >
                        @L["CustomersParking"] @getNumberOfParking.NumberOfCustomerParking
                    </MudText>
                    <MudText>
                        @L["CustomersEmptyParking"] @getNumberOfParking.NumberOfCustomerEmptyParking
                    </MudText>
                </div>
               
                <MudItem >
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Variant="Variant.Filled">
                        <MudMenuItem OnClick="@( ()=> ExportToExcel(CustomerCategoryStatus.Customer))">@L["Excel"]</MudMenuItem>
                    </MudMenu>
                </MudItem>
            </MudPaper>

        </MudItem>
        <MudItem sm="4">
            <MudPaper class="custom-rounded px-4 py-2 bg-white d-flex justify-content-between align-items-start">
                <MudImage Src="images/dashboard/car.png"  Class="me-3"/>
                <div>

                    <MudItem Class="d-flex align-items-center">
                        <MudText Class="fw-bold" Typo="Typo.h6">
                             @L["Employees"]
                         </MudText>
                    </MudItem>

                    <MudText >
                        @L["CustomersParking"] @getNumberOfParking.NumberOfEmployeeParking
                    </MudText>
                    <MudText>
                        @L["CustomersEmptyParking"] @getNumberOfParking.NumberOfEmployeeEmptyParking
                    </MudText>
                </div>
              
                <MudItem>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Variant="Variant.Filled">
                        <MudMenuItem OnClick="@( ()=> ExportToExcel(CustomerCategoryStatus.Employee))">@L["Excel"]</MudMenuItem>
                    </MudMenu>
                </MudItem>
            </MudPaper>
        </MudItem>

        <MudItem sm="4">
            <MudPaper class="custom-rounded px-4 py-2 bg-white d-flex justify-content-between align-items-start">
                <MudImage Src="images/dashboard/car.png" Class="me-3"/>

                <div>
                    <MudItem Class=" d-flex align-items-center">
                    <MudText Class="fw-bold" Typo="Typo.h6">
                        @L["Visitors"]
                    </MudText>
                    </MudItem>
                    <MudText >
                        @L["CustomersParking"] @getNumberOfParking.NumberOfVisitorParking
                    </MudText>
                    <MudText>
                        @L["CustomersEmptyParking"] @getNumberOfParking.NumberOfVisitorEmptyParking
                    </MudText>
                </div>
                <MudItem>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Variant="Variant.Filled">
                        <MudMenuItem OnClick="@( ()=> ExportToExcel(CustomerCategoryStatus.Visitor))">@L["Excel"]</MudMenuItem>
                    </MudMenu>
                </MudItem>
            </MudPaper>
        </MudItem>
    }
    <MudItem sm="12">
        <MudPaper class="custom-rounded px-4 py-2 bg-white d-flex justify-content-between align-items-center">
            <div>
                <MudText Class="fw-bold" Typo="Typo.h6">
                    @L["CollectedMoneyToday"]
                </MudText>
                <MudText>
                    @L["Day"] @Day
                </MudText>
                <MudText>
                    @L["Collected"] @collectedMoneyToday
                </MudText>
            </div>
            @*  <MudImage Src="images/dashboard/car.png" /> *@
        </MudPaper>
    </MudItem>

    <MudItem sm="6">
        <MudPaper class="custom-rounded px-4 py-2 bg-white d-flex gap-2 align-items-center h-100">
            <MudImage Src="images/dashboard/car.png" />
            <div class="d-flex flex-column">
                <div>
                    <MudText Typo="Typo.body2">
                        Car Model
                    </MudText>
                    <MudText Class="fw-bold" Typo="Typo.subtitle1">
                        Toyota Corolla 2021
                    </MudText>
                </div>
                <div>
                    <MudText Typo="Typo.body2">
                        License
                    </MudText>
                    <MudText Class="fw-bold" Typo="Typo.subtitle1">
                        A R S 1234
                    </MudText>
                </div>
                <div>
                    <MudText Typo="Typo.body2">
                        License
                    </MudText>
                    <MudText Class="fw-bold" Typo="Typo.subtitle1">
                        A R S 1234
                    </MudText>
                </div>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem sm="6">
        <MudPaper Class="custom-rounded overflow-hidden h-100">
            <Image Source="images/dashboard/discount.png" Fluid Class="w-100" />
        </MudPaper>
    </MudItem>
    <MudItem sm="6">
        @if (currenttenant.Id == null)
        {

            <MudPaper Class="custom-rounded p-3">

                <MudSelect T="int"
                ValueChanged="ChangeSelect"
                Placeholder="@L[ "Choose"]"
                AdornmentColor="MudBlazor.Color.Primary"
                Class="mb-3" 
                Immediate="true"
                >
                    <MudSelectItem Value="0" Disabled>

                        @L["Choose"]
                    </MudSelectItem>
                    @foreach (var organization in Organizations)
                    {
                        if (organization.Status != Status.Active)
                            continue;
                        <MudSelectItem  Value="@organization.Id">

                            @organization.EnglishName
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudTooltip Text="@msg" Color="MudBlazor.Color.Tertiary" Arrow="true">

                    <MudChart 
                    ChartType="ChartType.Pie" 
                    InputData="@data" 
                    InputLabels="@labels" 
                    Width="300px" 
                    Height="300px" 
                    ChartOptions="@options"




                    />
                </MudTooltip>
            </MudPaper>

        }
        else
        {
            <MudPaper Class="custom-rounded p-3">
                <MudTooltip Text="@msg" Color="MudBlazor.Color.Tertiary" Arrow="true">

                    <MudChart ChartType="ChartType.Pie"
                    InputData="@data"
                    InputLabels="@labels"
                    Width="300px"
                    Height="300px"
                    ChartOptions="@options"
                    />
                </MudTooltip>
            </MudPaper>

        }
    </MudItem>
    <MudItem sm="12">
        <MudPaper Class="custom-rounded">
            <MudItem Class="d-flex align-items-start justify-content-end m-3 pt-5">
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Variant="Variant.Filled">
                    <MudMenuItem OnClick="@( ()=> ExportToExcel(CustomerCategoryStatus.Employee))">@L["Excel"]</MudMenuItem>
                </MudMenu>
            </MudItem>
            <MudChart ChartType="ChartType.Bar" ChartSeries="@Series" @bind-SelectedIndex="index" XAxisLabels="@XAxisLabels" Width="100%" Height="350px"></MudChart>

        </MudPaper>
    </MudItem>

</MudGrid>


@code {


    ChartOptions options = new ChartOptions();
    AnalysisNamesCountDto value = new AnalysisNamesCountDto();
    public EventCallback<string> SelectValueChanged { get; set; }
    private int _organizationsCount;
    private int _garagesCount;
    private int _customersCount;
    private int grid;
    private GetNumberOfParkingAndEmptyParkingDto getNumberOfParking { get; set; } = new GetNumberOfParkingAndEmptyParkingDto();
    double[] data= { 20,77};

    string[] labels = { "Parking", "EmptyParking" };
    string msg;
    private List<OrganizationDto> Organizations = new List<OrganizationDto>();
    public string[] XAxisLabels = { " " };
    private int index = -1; 

    public List<ChartSeries> Series = new List<ChartSeries>();

    private string[] inputLabels { get; set; } = { " " };
    private double[] inputData { get; set; } = { 0 };
    private string? Day = default;
    private double? collectedMoneyToday = default;
    protected async override Task OnInitializedAsync()
    {

        // Fetch the data from backend


        _organizationsCount = await OrganizationAppService.GetOrganizationsCount();
        _garagesCount = await GarageAppService.GetAllGaragesCount();

        var name = CurrentUser.UserName;
        if (currenttenant.Id == null)
        {
            Organizations = await OrganizationAppService.GetAllMobileAsync();
            var organization = Organizations.FirstOrDefault();
            var total = await AnalysisAppService.GetNumberOfParkingSlotsAndEmptySolts(organization.Id);
            ShowData(total.NumberOfParking, total.NumberOfEmptyParking);
            grid = 4;
            _customersCount = await CustomerAppService.GetCountCustomersCountForMDKHL();

            var dataForSeries = await AnalysisAppService.CalculateWeeklyCollectedMoneyMdkhlAsync();
            showDataGraph(dataForSeries.Days, dataForSeries.TotalAmounts);

            var dataForToday = await AnalysisAppService.CalculateDailyCollectedMoneyMdKhlAsync();
            Day = dataForToday.Day;
            collectedMoneyToday = dataForToday.totalAmounts;
        }
        else
        {
            var organization = await OrganizationAppService.GetOrganizationForCurrentTenat();
            await ChangeSelect(organization.Id);

            grid = 6;
            _customersCount = await CustomerAppService.GetCountCustomersCountForOrganization(currenttenant.Id);
            var dataForSeries = await AnalysisAppService.CalculateWeeklyCollectedMoneyOrganizationAsync(organization.Id);
            showDataGraph(dataForSeries.Days, dataForSeries.TotalAmounts);

            var dataForToday = await AnalysisAppService.CalculateDailyCollectedMoneyOrganizationAsync(organization.Id);
            Day = dataForToday.Day;
            collectedMoneyToday = dataForToday.totalAmounts;
        }

        string[] colors = { "#0D5480", "#16B7D3", "#CE3333" };
        options.ChartPalette = colors;
        options.ShowLegend = true;
        options.LineStrokeWidth = 20;


        //   return await base.OnInitializedAsync();
    }

    private void ShowData(int NumberOfParking, int NumberOfEmptyParking)
    {
        data[0] = NumberOfParking;
        data[1] = NumberOfEmptyParking;

        labels[0] = $"{LocalizationHelper.GetLocalizedString("Parking")} {NumberOfParking}";
        labels[1] = $"{LocalizationHelper.GetLocalizedString("EmptyParking")} {NumberOfEmptyParking}";
    }

    private async Task ChangeSelect(int Value)
    {
        getNumberOfParking = await AnalysisAppService.GetNumberOfParkingSlotsAndEmptySolts(Value);
        ShowData(getNumberOfParking.NumberOfParking, getNumberOfParking.NumberOfEmptyParking);

    }

    private void showDataGraph(string[] days, double[] totalAmounts)
    {
        XAxisLabels = days;
        Series = new List<ChartSeries>()
        {
            new ChartSeries() { Name = LocalizationHelper.GetLocalizedString("CollectedMoney"), Data =  totalAmounts}
        };
    }

    

    private async Task ExportToExcel(CustomerCategoryStatus category)
    {
        try
        {
            var folderName = FileHelper.CreateImageDirectory("Folders/Excel");
            TableData data;
            if(currenttenant.Id == null)
            {
                 data = await AnalysisAppService.ReortGarageTransactionMdkhlAsync(category);
            }
            else
            {
                data = await AnalysisAppService.ReortGarageTransactionOrganizationAsync(category);
            }
            
            string file = System.IO.Path.Combine(folderName, $"{data.Name}.xlsx");

            await GenerateFilesAppService.ExportToExcel(data, file);

            SnackBar.ShowSnackbar(Snackbar, LocalizationHelper.GetLocalizedString(AlertMessages.AlertMessages.SUCCESS) + " " +
                        LocalizationHelper.GetLocalizedString(AlertMessages.AlertMessages.EXPORT), Severity.Success);

            await Task.Delay(1000);
            await OpenNewBlank($"Folders/Excel/{data.Name}.xlsx");
        }
        catch
        {
            SnackBar.ShowSnackbar(Snackbar, LocalizationHelper.GetLocalizedString(AlertMessages.AlertMessages.FAILED) + " " +
                        LocalizationHelper.GetLocalizedString(AlertMessages.AlertMessages.EXPORT), Severity.Error);
        }


    }
    private async Task OpenNewBlank(string url)
    {

        await JSRuntime.InvokeVoidAsync("window.open", url, "_blank");
    }
    
}