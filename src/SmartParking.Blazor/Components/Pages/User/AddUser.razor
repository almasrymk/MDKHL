@page "/add-user"
@using Abp.Application.Navigation
@using SmartParking.Authentication
@using SmartParking.Enums
@using SmartParking.Organizations
@inject IOrganizationsAppService OrganizationAppService
@inject ISnackbar Snackbar
@inject IUsersAppService UsersAppService
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using Volo.Abp.Data
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Users
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager NavigationManager
@inject ICurrentUser currrentUser
@inject ICurrentTenant currrentTenant
@inject IRoleAppService RoleAppService
@inject IDialogService DialogService


<PageTitle>@L["CREATE NEW"]</PageTitle>
<div class="modal-wrapper">
        <h3 Color="fw-bold">@L["CREATE NEW"]</h3>

        <MudForm Model="userCreate" Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">


                <MudGrid Class="mt-2">
                    <MudItem sm="6" md="6">
                    <MudTextField @bind-Value="userCreate.Name"
                              For="@(() => userCreate.Name)"
                                      Variant="Variant.Text"
                                      Required
                                      Class="w-100"
                                      Placeholder="@L["Type Here"]"
                                      Label="@L["Name"]"
                              RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>
                    <MudItem sm="6" md="6">
                    <MudTextField @bind-Value="userCreate.Email"
                              For="@(() => userCreate.Email)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Placeholder="@L["Type Here"]"
                              Label="@L["Email"]" />
                    </MudItem>
                          
                    <MudItem sm="6" md="6">
                    <MudTextField @ref="textField"
                                   @bind-Value="userCreate.PhoneNumber"
                                   For="@(() => userCreate.PhoneNumber)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      OnBlur="HandleBlur"
                                      Placeholder="@L["Type Here"]"
                                      Label="@L["PhoneNumber"]"
                                      Required
                              RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>
            <MudItem sm="6" Class="d-inline-flex">
                <MudItem Class="d-flex flex-row justify-content-between">
                    <MudRadioGroup @bind-Value="@userCreate.IdentificationTypes"
                                   Class="d-inline-flex align-content-center">
                        <MudRadio Value="@(Enums.IdentificationTypes.NationalID)" Color="MudBlazor.Color.Primary">@L["NationalId"]</MudRadio>
                        <MudRadio Value="@(Enums.IdentificationTypes.Passport)" Color="MudBlazor.Color.Primary">@L["Passport"]</MudRadio>
                    </MudRadioGroup>
                </MudItem>
            </MudItem>

            <MudItem sm="6">
                <MudTextField T="string" Placeholder="@L["Type Here"]" 
                              Label="@L["NationalId"]" @bind-Value="userCreate.NationalId" />
            </MudItem>
            

                @if (currrentTenant.Id is null)
                {
                <MudItem sm="6">
                    <MudRadioGroup Required="false" T="bool"  ValueChanged="IsMdkhlSelect">
                            <MudRadio Value="true"  Color="MudBlazor.Color.Primary">@L["admin"]</MudRadio>
                            <MudRadio Value="false" Color="MudBlazor.Color.Primary">@L["mdkhl"]</MudRadio>
                        </MudRadioGroup>
                </MudItem>
                }
                <MudItem sm="6">
                <MudCheckBox @bind-Value="@userCreate.IsCustomer" Color="MudBlazor.Color.Primary">@L["ISCustomer"]</MudCheckBox>
                </MudItem>
                
                    @if (IsOrganization)
                    {

                        <MudItem sm="6" md="6">
                    <MudSelect ValueChanged="SelectOrganization" T="int"
                                       Label="@L["OrganizationName"]"
                                       Placeholder="@L[ "Choose"]"
                                       HelperText=@L["Helper Text"]
                                       Required>
                        <MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
                                @foreach (var organization in Organizations)
                                {
                                   if (organization.Status != Status.Active)
                                       continue;
                                    <MudSelectItem T="int" Value="@organization.Id">

                                        @organization.EnglishName
                                    </MudSelectItem>
                                }
                            </MudSelect>

                        </MudItem>
                    }
                @if (IsSelectOrganization)
                    {
                        <MudItem sm="6" md="6">
                            <MudSelect @bind-Value="@role"
                                Label="@L["UserRole"]"
                                Placeholder="@L[ "Choose"]"
                                HelperText=@L["Helper Text"]
                                Required>

                                    @foreach (var role in Roles)
                                    {

                                    <MudSelectItem Value="@role">
                                        @role.Name
                                    </MudSelectItem>

                                        }
                            </MudSelect>

                        </MudItem>
                    }
            
                    <MudItem sm="12" md="12">


                        <MudRadioGroup @bind-Value="@userCreate.IsActive" Class="d-inline-flex align-content-center">
                            <div class="d-flex flex-row justify-content-between">
                                <MudRadio Value="true" Color="MudBlazor.Color.Primary">@L["Status Active"]</MudRadio>
                                <MudRadio Value="false" Color="MudBlazor.Color.Secondary">@L["Status InActive"]</MudRadio>
                            </div>
                        </MudRadioGroup>
                    </MudItem>

                </MudGrid>
                <MudItem sm="12" Class="mt-5">

                    <div class="d-flex justify-content-between "> 
                       <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="SubmitCreate">@L["Create"]</MudButton>
                       <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="CancelAdd">@L["Back"]</MudButton>
                    </div>
                </MudItem>

        </MudForm>


      
</div>
