@page "/add-user"
@using Abp.Application.Navigation
@using SmartParking.Authentication
@using SmartParking.Enums
@using SmartParking.Organizations
@inject IOrganizationsAppService OrganizationAppService
@inject ISnackbar Snackbar
@inject IUsersAppService UsersAppService
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Users
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager NavigationManager
@inject ICurrentUser currrentUser
@inject ICurrentTenant currrentTenant

<PageTitle>@L["Add New User"]</PageTitle>
<div class="modal-wrapper">



    <MudForm Model="userCreate" Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                <MudGrid>
                    <MudItem sm="6" md="6">
                    <MudTextField @bind-Value="userCreate.Name"
                              For="@(() => userCreate.Name)"
                                      Variant="Variant.Text"
                                      Required
                                      Class="w-100"
                                      Placeholder="@L["Type Here"]"
                                      Label="@L["Name"]" />
                    </MudItem>
                    <MudItem sm="6" md="6">
                    <MudTextField @bind-Value="userCreate.Email"
                              For="@(() => userCreate.Email)"
                                      Variant="Variant.Text"
                                      Required
                                      Class="w-100"
                                      Placeholder="@L["Type Here"]"
                              Label="@L["Email"]" />
                    </MudItem>
                          
                    <MudItem sm="6" md="6">
                    <MudTextField @bind-Value="userCreate.PhoneNumber"
                              For="@(() => userCreate.PhoneNumber)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Placeholder="@L["Type Here"]"
                                      Label="@L["PhoneNumber"]"/>
                    </MudItem>
                   
                    @if (currrentUser.IsInRole(Enums.RolesType.Mdkhl.ToString()) || currrentUser.IsInRole("admin"))
                    {

                        <MudItem sm="12" md="12">
                        <MudSelect @bind-Value="@userCreate.OrganizationId"
                                       Label="@L["OrganizationName"]"
                                       Placeholder="@L[ "Choose"]"
                                       HelperText=@L["Helper Text"]
                                       Required>

                                @foreach (var organization in Organizations)
                                {
                                    <MudSelectItem T="int" Value="@organization.Id">

                                        @organization.EnglishName
                                    </MudSelectItem>
                                }
                            </MudSelect>

                        </MudItem>
                    }
                    @if (currrentUser.IsInRole(Enums.RolesType.Organization.ToString()) || currrentUser.IsInRole(Enums.RolesType.OrganizationEmployee.ToString()))
                    {
                        <MudItem sm="12" md="12">
                            <MudSelect @bind-Value="@userRole"
                                           Label="@L["user role"]"
                                           Placeholder="@L[ "Choose"]"
                                           HelperText=@L["Helper Text"]
                                           Required>

                                @foreach (var role in Enum.GetValues(typeof(RolesType)))
                                    {
                                        if (role.ToString() == Enums.RolesType.MdkhlEmployee.ToString() || role.ToString() == Enums.RolesType.Mdkhl.ToString())
                                            continue;
                                         <MudSelectItem Value="@role.ToString()">
                                            @role.ToString()
                                        </MudSelectItem>
                                    }
                                </MudSelect>

                        </MudItem>                
                     }

            @if (currrentUser.IsInRole(Enums.RolesType.Mdkhl.ToString()) || currrentUser.IsInRole(Enums.RolesType.MdkhlEmployee.ToString()) || currrentUser.IsInRole("admin"))
                    {
                        <MudItem sm="12" md="12">
                            <MudSelect @bind-Value="@userRole"
                                           Label="@L["user role"]"
                                           Placeholder="@L[ "Choose"]"
                                           HelperText=@L["Helper Text"]
                                           Required>

                                @foreach (var role in Enum.GetValues(typeof(RolesType)))
                                    {
                                    <MudSelectItem Value="@role.ToString()">

                                            @role.ToString()
                                        </MudSelectItem>
                                    }
                                </MudSelect>

                        </MudItem>                
                     }

            
                    <MudItem sm="9" md="9">


                <MudRadioGroup @bind-Value="@userCreate.IsActive" Class="d-inline-flex align-content-center">
                            <div class="d-flex flex-row justify-content-between">
                                <MudRadio Value="true" Color="MudBlazor.Color.Primary">@L["Status Active"]</MudRadio>
                                <MudRadio Value="false" Color="MudBlazor.Color.Secondary">@L["Status InActive"]</MudRadio>
                            </div>
                        </MudRadioGroup>
                    </MudItem>

                </MudGrid>
                <MudItem sm="4" Class="mt-5">

                    <div class="d-flex justify-content-between ">
                        @* <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Dark" OnClick="Cancel">@L["Cancel"]</MudButton> *@
                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Disabled="@(form == null || !form.IsValid)" OnClick="SubmitCreate">@L["Create"]</MudButton>
                    </div>
                </MudItem>
            </MudForm>

      
</div>
