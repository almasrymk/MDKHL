@using Microsoft.Extensions.Localization
@using SmartParking.Authentication
@using SmartParking.Localization
@inject IStringLocalizer<SmartParkingResource> L
@inject IUsersAppService UsersAppService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IRoleAppService RoleAppService

<PageTitle>@L["Update User"]</PageTitle>

<div class="modal-wrapper">
    <MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Update User"]</MudText>
        </TitleContent>
        <DialogContent>
            <MudForm Class="flex-grow-1 mt-4 h-100 w- p-3 d-flex flex-column w-100 h-100 main-layout-paper" Model="updateUserDto">
                <MudGrid>
                    <MudItem sm="6">
                        <MudTextField T="string" Placeholder="@L["Type Here"]" @bind-Value="updateUserDto.Name" Label="@L["Name"]" Required />
                    </MudItem>
                    <MudItem sm="6">
                        <MudTextField T="string" Placeholder="@L["Type Here"]" @bind-Value="updateUserDto.Email" Label="@L["Email"]" Required />
                    </MudItem>
                    <MudItem sm="6">
                        <MudTextField T="string" Placeholder="@L["Type Here"]" InputType="InputType.Telephone" Label="@L["MobileNumber"]" @bind-Value="updateUserDto.PhoneNumber" Required />
                    </MudItem>  
                    <MudItem sm="6" md="6">
                        
                            <div class="d-flex flex-row justify-content-between">
                                <MudCheckBox  @bind-Value="@updateUserDto.ISNoRole" Color="MudBlazor.Color.Primary">@L["NoRole"]</MudCheckBox>
                            </div>
                        
                    </MudItem>
                    @if (!updateUserDto.ISNoRole)
                    {
                        <MudItem sm="6" md="6">
                            <MudSelect @bind-Value="@roleId"
                                       Label="@L["UserRole"]"
                                       Placeholder="@L[ "Choose"]"
                                       HelperText=@L["Helper Text"]
                                       Required>

                                @foreach (var role in Roles)
                                {

                                    <MudSelectItem Value="@role.Id.ToString()">
                                        @role.Name
                                    </MudSelectItem>

                                }
                            </MudSelect>

                        </MudItem>
                        <MudItem sm="6" md="6">
                            <MudRadioGroup @bind-Value="@updateUserDto.IsActive" Class="d-inline-flex align-content-center">
                                <div class="d-flex flex-row justify-content-between">
                                    <MudRadio Value="true" Color="MudBlazor.Color.Primary">@L["Status Active"]</MudRadio>
                                    <MudRadio Value="false" Color="MudBlazor.Color.Secondary">@L["Status InActive"]</MudRadio>
                                </div>
                            </MudRadioGroup>
                        </MudItem>
                    }
                </MudGrid>
            </MudForm>
        </DialogContent>
        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="CancelEdit">@L["Back"]</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="SubmitEdit">@L["Save"]</MudButton>
        </DialogActions>

    </MudDialog>

</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>