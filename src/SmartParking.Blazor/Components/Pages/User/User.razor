@page "/users"
@using Microsoft.Extensions.Localization
@using SmartParking.Authentication
@using SmartParking.Localization
@using SmartParking.Organizations
@using Volo.Abp.Identity
@using Volo.Abp.MultiTenancy
@using Volo.Abp.PermissionManagement
@inject IDialogService DialogService
@inject IUsersAppService UsersAppService
@inject IRoleAppService RoleAppService
@inject IAuthenticationAppService AuthenticationAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@inject ICurrentTenant currrentTenant
@inject IPermissionManager PermissionManager
@inject IOrganizationsAppService OrganizationAppService
@inject IAuthorizationService AuthorizationService
@using Microsoft.AspNetCore.Authorization
@using Volo.Abp.BlazoriseUI.Components.ObjectExtending
@using Volo.Abp.Identity.Localization
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@inherits AbpCrudPageBase<IIdentityUserAppService, IdentityUserDto, Guid, GetIdentityUsersInput, IdentityUserCreateDto, IdentityUserUpdateDto>


<PageTitle>@L["Users"]</PageTitle>
<MudText Typo="Typo.h5" Class="mb-2">@L["Users"]</MudText>

<SPDataGrid PageName=@L["Users"] Data="@itemData" Menus="@MenuDatas" 
                                            ShowButton="AuthorizationService.IsGrantedAsync(IdentityPermissions.Users.ManagePermissions).Result"
                                            ShowMenue="!CurrentTenant.Id.HasValue" OnAdd="HandleAdd" ShowFiltering="false" OnClickRowDelete="OnClickRowDelete"
                                            ShowDelete="AuthorizationService.IsGrantedAsync(IdentityPermissions.Users.Delete).Result"
                                            ShowAdd="AuthorizationService.IsGrantedAsync(IdentityPermissions.Users.Create).Result" 
                                            ShowEdit ="AuthorizationService.IsGrantedAsync(IdentityPermissions.Users.Update).Result" OnClickRowView="HandleView" TotalItemsInTable="TotalItem" OnFiltering="HandleFilter" ShowAssign="false" OnClickRowEdit="HandleEdit" OnClickButton="AddPermission" OnPageChanged="FetchTableData" OnSearching="FetchTableData"></SPDataGrid>



<PermissionManagementModal @ref="PermissionManagementModal" />