@using Microsoft.Extensions.Localization
@using SmartParking.Authentication
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Enums
@using SmartParking.Localization
@using System.Globalization
@using SmartParking.Organizations
@using Volo.Abp.Identity
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Users
@inject NavigationManager Navigation
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject ICurrentUser currrentUser
@inject IUsersAppService UsersAppService
@inject ICurrentTenant currentTenant
@inject IOrganizationsAppService OrganizationAppService
@inject IRoleAppService RolesAppService

<PageTitle>@L["Assign Role"]</PageTitle>

<div class="modal-wrapper">
	<MudDialog class="mud-modal" Style="min-width:fit-content !important">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["Assign Role"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>
					<MudItem sm="12" md="12">
						<MudSelect T="string"
						ValueChanged="ChooseRole"
						Label="@L["UserRole"]"
						Placeholder="@L[ "Choose"]"
						HelperText=@L["Helper Text"]
						Required>
							@foreach (var role in identityRoles)
							{
								<MudSelectItem Value="role.Id.ToString()">
									@role.Name
								</MudSelectItem>
							}

						</MudSelect>

					</MudItem>



				</MudGrid>
			</MudForm>



		</DialogContent>
		<DialogActions>
			<MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="CancelEdit">@L["Back"]</MudButton>
			<MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="SubmitAssign">@L["Assign"]</MudButton>
		</DialogActions>

	</MudDialog>

</div>

<style>
	.mud-modal {
	border-radius: 0 20px 0 20px;
	}
</style>

@code {
	private MudForm form;
	[CascadingParameter]
	private MudDialogInstance MudDialogAdd { get; set; }
	[Parameter] 
	public Guid Id { get; set; }
	private Guid userRoleId { get; set; }
	private List<IdentityRoleDto> identityRoles { get; set; } = new();

	protected override async Task OnInitializedAsync()
	{
		identityRoles = await RolesAppService.GetListByTenant(currentTenant.Id);
		await base.OnInitializedAsync();
	}


	private async Task SubmitAssign()
	{
	
		try
		{

			 await RolesAppService.AssignRole(Id, userRoleId);
			SnackBar.ShowSnackbar(Snackbar, LocalizationHelper.GetLocalizedString(AlertMessages.AlertMessages.SUCCESS) + " " +
				LocalizationHelper.GetLocalizedString(AlertMessages.AlertMessages.ADD) + " " +
				LocalizationHelper.GetLocalizedString("Role"), Severity.Success);

			MudDialogAdd.Close(DialogResult.Ok(true));
			Navigation.NavigateTo("/users");

		}
		catch (Exception ex)
		{

			SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.ADD]} {L[AlertMessages.AlertMessages.FAILED]}: {ex.Message} ", Severity.Error);
		}
	}

	private async Task CancelEdit()
	{
		MudDialogAdd.Cancel();
	}
	private async Task ChooseRole(string Value)
	{
		userRoleId = Guid.Parse(Value);
	}


}
