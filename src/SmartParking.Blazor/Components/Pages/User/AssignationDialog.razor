@using Microsoft.Extensions.Localization
@using SmartParking.Authentication
@using SmartParking.Enums
@using SmartParking.Localization
@using System.Globalization
@using SmartParking.Organizations
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Users
@inject NavigationManager Navigation
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject ICurrentUser currrentUser
@inject IUsersAppService UsersAppService
@inject ICurrentTenant currentTenant
@inject IOrganizationsAppService OrganizationAppService

<PageTitle>@L["Assign Role"]</PageTitle>

<div class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["Assign Role"]</MudText>
		</TitleContent>
		<DialogContent>



			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>
					@if (currentTenant.Id is null)
					{
						<MudItem sm="12" md="12">
							<MudSelect @bind-Value="@userRole"
							Label="@L["UserRole"]"
							Placeholder="@L[ "Choose"]"
							HelperText=@L["Helper Text"]
							Required>

								@foreach (var role in Enum.GetValues(typeof(RolesType)))
								{

									<MudSelectItem Value="@role.ToString()">
										@role.ToString()
									</MudSelectItem>

								}
							</MudSelect>

						</MudItem>
					}
					@if ((userRole != RolesType.Mdkhl.ToString() || userRole != RolesType.MdkhlEmployee.ToString())&&userRole!=null)
					{

						<MudItem sm="12" md="12">
							<MudSelect @bind-Value="OrganizationId"
									   Label="@L["OrganizationName"]"
									   Placeholder="@L[ "Choose"]"
									   HelperText=@L["Helper Text"]
									   Required>

								@foreach (var organization in Organizations)
								{
									if (organization.Status != Status.Active)
										continue;


									<MudSelectItem T="int" Value="@organization.Id">

										@organization.EnglishName
									</MudSelectItem>
								}
							</MudSelect>

						</MudItem>
					}




				</MudGrid>
			</MudForm>



		</DialogContent>
		<DialogActions>
			<MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="CancelEdit">@L["Back"]</MudButton>
			<MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="SubmitEdit">@L["Assign"]</MudButton>
		</DialogActions>

	</MudDialog>

</div>

<style>
	.mud-modal {
	border-radius: 0 20px 0 20px;
	}
</style>

@code {
	private MudForm form;
	[CascadingParameter]
	private MudDialogInstance MudDialogAdd { get; set; }
	[Parameter] 
	public Guid Id { get; set; }
	private int OrganizationId { get; set; }
	private string userRole { get; set; }
	private List<OrganizationDto> Organizations = new List<OrganizationDto>();


	protected async override Task OnInitializedAsync()
	{
		if (currrentUser.IsInRole(Enums.RolesType.Mdkhl.ToString()) || currrentUser.IsInRole("admin"))
		{

			Organizations = await OrganizationAppService.GetAllMobileAsync();

		}
	}


	private async Task SubmitEdit()
	{
		var validationErrorMessage = L["PleaseFixTheValidationErrors"];
		var successedMessage = L["Role Added to User Successfully"];

		try
		{


			var garage = await UsersAppService.AssignRoleToUser(Id, userRole);

			Snackbar.Add($"{successedMessage}", Severity.Success);
			MudDialogAdd.Close(DialogResult.Ok(true));
			Navigation.NavigateTo("/users");

		}
		catch (Exception e)
		{
			Snackbar.Add($"{validationErrorMessage}: {e.Message}", Severity.Error);
		}
	}

	private async Task CancelEdit()
	{
		MudDialogAdd.Cancel();
	}


}
