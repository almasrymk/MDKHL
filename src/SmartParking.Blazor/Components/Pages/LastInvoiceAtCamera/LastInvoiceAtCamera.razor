@using Microsoft.Extensions.Localization
@using SmartParking.BarrierAppService
@using SmartParking.Blazor.Components.Pages.Invoices
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Cameras
@using SmartParking.Currency
@using SmartParking.Discounts
@using SmartParking.Enums
@using SmartParking.GarageTransactions
@using SmartParking.Invoices
@using SmartParking.Localization
@using System.Globalization
@using SmartParking.Mobile.Keepers
@using SmartParking.OpeningGate
@using SmartParking.Organizations
@using SmartParking.Payments
@using SmartParking.Permissions.CheckoutPermissions
@using SmartParking.Shifts
@using SmartParking.Utilities
@using SmartParking.Watchers
@page "/lastinvoice"
@inject IInvoiceAppService InvoiceAppService
@inject IKeeperAppService KeeperAppService
@inject IStringLocalizer<SmartParkingResource> L
@inject IPaymentAppService PaymentAppService
@inject ISnackbar Snackbar
@inject IGarageTransactionsAppService GarageTransactionAppService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IDiscountAppService DiscountAppService
@inject IAuthorizationService AuthorizationService
@inject IOrganizationsAppService OrganizationAppService
@inject IOpenGateFactoryService OpenGateFactoryService
@inject IWatcherAppService WatcherAppService
@inject IShiftZoneActionAppService ShiftZoneActionAppService

<PageTitle>@L["LastInvoice"]</PageTitle>
<MudGrid>

	<MudItem sm="12" Class="d-flex  flex-column flex-sm-row align-center justify-content-between">

		<MudItem sm="7" xs="12" Class="d-flex justify-content-between">
			<MudText Typo="Typo.h6" Class="fw-bold mb-0">@L["LastInvoice"]</MudText>

			<MudButton Variant="Variant.Filled"
					   Class="mx-3"
					   Color="MudBlazor.Color.Inherit"
					   OnClick="Refresh">
				<MudIcon Icon="@Icons.Material.Filled.Refresh" />
			</MudButton>
		</MudItem>

		<MudItem sm="5" xs="12" Class="d-flex justify-content-between">
			<MudSelect T="string"
					   Label="@L["DeviceId"]"
					   Dense="true"
					   Class="flex-grow-0"
					   OnOpen="(async()=> await OpenFilteredWatchers())"
					   @bind-Value="SelectedDeviceId">
				@foreach (var watcher in _filteredWatchersByShiftZone)
				{
					<MudSelectItem T="string" Value="@watcher.WatcherCode">
						@watcher.WatcherName
					</MudSelectItem>
				}
			</MudSelect>
			<MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Inherit" OnClick="OpenGate">
				<svg xmlns="http://www.w3.org/2000/svg" version="1.0" width="25.000000pt" height="22.000000pt" viewBox="0 0 244.000000 235.000000" preserveAspectRatio="xMidYMid meet">
					<g transform="translate(0.000000,235.000000) scale(0.100000,-0.100000)" fill="#000000" stroke="none">
						<path d="M586 2289 c-18 -14 -26 -30 -26 -52 0 -28 63 -95 635 -667 l635 -635 0 -378 0 -377 240 0 240 0 0 395 c0 388 0 395 -20 395 -15 0 -20 7 -20 25 l0 25 -163 0 -163 0 -630 631 c-346 347 -641 637 -656 645 -35 18 -40 18 -72 -7z m1664 -1439 l0 -60 -180 0 -180 0 0 60 0 60 180 0 180 0 0 -60z" />
						<path d="M480 1119 c-57 -23 -91 -63 -171 -203 l-82 -144 -27 20 c-37 27 -94 16 -137 -28 -38 -37 -41 -56 -13 -84 16 -16 33 -20 82 -20 l63 0 -3 -276 c-4 -334 -12 -314 120 -314 122 0 128 4 128 90 l0 70 435 0 435 0 0 -70 c0 -86 6 -90 124 -90 135 0 129 -17 124 316 l-3 274 52 0 c78 0 103 13 103 53 0 74 -134 127 -176 70 -8 -12 -26 12 -84 114 -100 174 -106 182 -164 209 -51 24 -52 24 -416 23 -215 0 -375 -4 -390 -10z m765 -78 c31 -19 155 -222 155 -254 0 -16 -37 -17 -524 -17 -329 0 -527 4 -531 10 -10 17 126 241 160 261 28 17 57 19 370 19 314 0 342 -2 370 -19z m-783 -482 c45 -10 61 -21 111 -73 33 -33 54 -62 48 -64 -7 -2 -50 1 -96 8 -94 13 -196 57 -255 109 l-35 30 87 1 c48 0 111 -5 140 -11z m1018 -20 c-72 -63 -171 -101 -300 -115 l-64 -7 33 42 c72 90 117 109 271 110 l95 0 -35 -30z m-390 -214 l0 -45 -215 0 -215 0 0 45 0 45 215 0 215 0 0 -45z" />
						<path d="M1740 100 l0 -30 330 0 330 0 0 30 0 30 -330 0 -330 0 0 -30z" />
					</g>
				</svg>
			</MudButton>
		</MudItem>

	</MudItem>

	<MudItem sm="12" Class=" d-flex flex-column flex-sm-row">
		<MudItem sm="7" xs="12" Class="d-flex flex-column flex-sm-column">
			<MudItem sm="12" Class="d-flex flex-row mb-4  flex-sm-columnjustify-content-center">
				<CarImageDetails Date="@(Invoice.EntranceTime.HasValue? Invoice.EntranceTime.Value : DateTime.Now)" Image="@Invoice?.EntryTransactionImage" Title="@L["EntranceImage"]" />
				<MudItem sm="2" Class="d-flex align-items-center">
					<MudIcon Icon="@(CultureInfo.CurrentCulture.Name == "en" ? Icons.Material.Filled.ArrowForward : Icons.Material.Filled.ArrowBack)" />
				</MudItem>
				<CarImageDetails Date="@(Invoice.InvoiceTime.HasValue? Invoice.InvoiceTime.Value : DateTime.Now)" Image="@Invoice?.ExitTransactionImage" Title="@L["ExitImage"]" />


			</MudItem>
			<div class="mx-3">
				<LastInvoiceOnGateDetails Key="@L["InvoiceId"]" Value="@(Invoice?.InvoiceId.ToString())" />
				<LastInvoiceOnGateDetails Key="@L["PlateNumber"]" Value="@(Invoice?.PlateNumber)" />
				<LastInvoiceOnGateDetails Key="@L["OrganizationName"]" Value="@(CultureInfo.CurrentCulture.Name == "en" ? Invoice?.OrganizationEnglishName : Invoice?.OrganizationArabicName)" />
				<LastInvoiceOnGateDetails Key="@L["GarageName"]" Value="@(CultureInfo.CurrentCulture.Name == "en" ? Invoice?.GarageEnglishName : Invoice?.GarageArabicName)" />
				<LastInvoiceOnGateDetails Key="@L["CustomerName"]" Value="@(CultureInfo.CurrentCulture.Name == "en" ? Invoice?.CustomerEnName : Invoice?.CustomerArName)" />
				<LastInvoiceOnGateDetails Key="@($"{L["TotalHours"]} ({L["Hour"]})")" Value="@Invoice?.TotalHours.ToString()" />
				<LastInvoiceOnGateDetails CurrencyKey="@((MarkupString)$"{L["Price"]}{CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "15px")}")"
										  Value="@InvoicePrice.ToString()"   />
			</div>

		</MudItem>

		<a href="" target="_blank" id="openLink" style="display:none;"></a>

		<PriceSummaryComponent OnValueSelected="HandleAddDiscount" OnSelectPaymentMethod="OnSelectPaymentMethod" ComponentSize="5" ConfirmSize="12" InvoicePrice="@Invoice?.InvoicePrice" IsPaying="isPaying" IsPaid="Invoice?.InvoiceType == InvoiceType.Paid.ToString()" Cancel="Cancel" PayInvoice="PayInvoice" PaymentMethod="@PaymentMethod" NoInvoice="NoInvoice" ShowOpenGate="true" OpenGate="OpenGate" HasConfirmPermission="@(AuthorizationService.IsGrantedAsync(CheckoutPermissions.Confirm).Result)" />
	</MudItem>
</MudGrid>