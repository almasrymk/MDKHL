@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Pages.Invoices
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Cameras
@using SmartParking.Enums
@using SmartParking.GarageTransactions
@using SmartParking.Invoices
@using SmartParking.Localization
@using System.Globalization
@using SmartParking.Organizations
@using SmartParking.Payments
@using SmartParking.Utilities
@page "/lastinvoice"
@inject IInvoiceAppService InvoiceAppService
@inject IStringLocalizer<SmartParkingResource> L
@inject IPaymentAppService PaymentAppService
@inject ISnackbar Snackbar
@inject IInvoiceUtilityAppService InvoiceUtility
@inject NavigationManager Navigation
<PageTitle>@L["LastInvoice"]</PageTitle>
<MudGrid>

	<MudItem sm="7" Class="d-flex flex-column">
		@{
			if (Invoice is null)
			{
				<p>@L["No invoice found."]</p>
				return;
			}
		}
		<MudText Typo="Typo.h6" Class="fw-bold mb-4">@L["LastInvoice"]</MudText>

		<MudItem sm="12" Class="d-flex flex-row mb-4">
			<CarImageDetails Date="@(Invoice.EntranceTime.HasValue ?Invoice.EntranceTime.Value : DateTime.Now)" Image="@Invoice?.EntryTransactionImage" Title="@L["EntranceImage"]" />
			<MudItem sm="2" Class="d-flex align-items-center">
				<MudIcon Icon="@(CultureInfo.CurrentCulture.Name=="en"?Icons.Material.Filled.ArrowForward:Icons.Material.Filled.ArrowBack)" />
			</MudItem>
			<CarImageDetails Date="@(Invoice.InvoiceTime.HasValue ?Invoice.InvoiceTime.Value : DateTime.Now)" Image="@Invoice?.ExitTransactionImage" Title="@L["ExitImage"]" />


		</MudItem>
		<LastInvoiceOnGateDetails Key="@L["InvoiceId"]" Value="@(Invoice?.InvoiceId.ToString())" />
		<LastInvoiceOnGateDetails Key="@L["PlateNumber"]" Value="@(Invoice?.PlateNumber)" />
		<LastInvoiceOnGateDetails Key="@L["OrganizationName"]" Value="@(CultureInfo.CurrentCulture.Name=="en"?Invoice?.OrganizationEnglishName:Invoice?.OrganizationArabicName)" />
		<LastInvoiceOnGateDetails Key="@L["GarageName"]" Value="@(CultureInfo.CurrentCulture.Name=="en"?Invoice?.GarageEnglishName:Invoice?.GarageArabicName)" />
		<LastInvoiceOnGateDetails Key="@L["CustomerName"]" Value="@(CultureInfo.CurrentCulture.Name=="en"?Invoice?.CustomerEnName:Invoice?.CustomerArName)" />
		<LastInvoiceOnGateDetails Key="@L["TotalHours"]" Value="@Invoice?.TotalHours.ToString()" />
		<LastInvoiceOnGateDetails Key="@L["Price"]" Value="@Invoice?.InvoicePrice.ToString()" />

	</MudItem>


	<PriceSummaryComponent ComponentSize="5" ConfirmSize="6" InvoicePrice="@Invoice?.InvoicePrice" IsPaid="Invoice.InvoiceType==InvoiceType.Paid.ToString()" PayInvoice="PayInvoice" ShowOpenGate="true" OpenGate="OpenGate" />
</MudGrid>

@code {
	private InvoiceDto Invoice  = new InvoiceDto();


	protected override async Task OnInitializedAsync()
	{
		try{

			Invoice = await InvoiceAppService.GetLatestInvoiceForOrganization();
		}catch(Exception ex){
			SnackBar.ShowSnackbar(Snackbar,ex.Message , MudBlazor.Severity.Warning);
			await Task.Delay(500);
			Navigation.NavigateTo("/", true);
		}

	}
	private async Task PayInvoice(){

		var paymentChekout = new PaymentCheckoutRequestDto
		{
			OrganizationId = Invoice.OrganizationId,
			PaymentCategory = Invoice.IsPackage ? PaymentCategory.Package : PaymentCategory.PaymentParking,
			InvoiceId = Invoice.Id,
			PaymentMethod = PaymentMethod.Cash,
			Amount = Math.Round((Invoice.InvoicePrice + (Invoice.InvoicePrice * 0.15m)), 2),
			CustomerId = Invoice.CustomerId
		};
		var payment = await PaymentAppService.CreateCheckoutInvoicePaymentWebAsync(paymentChekout);
		if (payment != null)
		{
			SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.SUCCESS]} {L[AlertMessages.AlertMessages.ADD]}", MudBlazor.Severity.Success);
			await Task.Delay(500);
			await OpenGate();
		}
	}
	private async Task OpenGate(){
		try{
			var result =await InvoiceUtility.SendRequestToOpenGate(Invoice.GarageTransactionExitId);
			if(result==true){
				SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.SUCCESS]} {L["OpenGate"]}", MudBlazor.Severity.Success);
				await Task.Delay(1000);
				Navigation.Refresh(true);
			}else{
				SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]} {L["OpenGate"]}", MudBlazor.Severity.Error);

			}
		}catch(Exception ex){
			SnackBar.ShowSnackbar(Snackbar, ex.Message, MudBlazor.Severity.Error);
		}
	}
}
