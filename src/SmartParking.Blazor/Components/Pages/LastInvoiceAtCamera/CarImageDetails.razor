 <MudItem sm="5" Class="flex-column">
	<MudText>@Title</MudText>
	<Div Class="mt-4 zoom-container"
		 @onmousemove="SetZoomOrigin"
		 @onmouseleave="ResetZoom">
    <MudImage 
    Src="@Image" 
	Width="300"
    Height="300" 
    Class="bg_w_foto mt-5" 
    onerror="this.src='images/garages/car_placeholder.jpg'"
    Style="@ComputedStyle" />
	</Div>
	<MudText Class="mt-5">@Date.ToString()</MudText>
</MudItem>

<style>
	.zoom-container {
		position: relative;
		display: inline-block;
		overflow: hidden;
		width: 250px; /* Container width */
		height: 250px; /* Container height */
		cursor: zoom-in;
	}

		.zoom-container img {
			width: 100%;
			height: 100%;
			transition: transform 0.3s ease, transform-origin 0.3s ease;
			transform: scale(1);
		}

		.zoom-container:hover img {
			transform: scale(1.5); /* Adjust the scale for zoom level */
		}
</style>