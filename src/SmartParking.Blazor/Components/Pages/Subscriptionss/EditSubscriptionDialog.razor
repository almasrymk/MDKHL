@using Microsoft.Extensions.Localization
@using SmartParking.Enums
@using SmartParking.Localization
@using SmartParking.SubscriptionTypes
@using SmartParking.Subscriptions
@inject ISubscriptionAppService SubscriptionAppService
@inject ISubscriptionTypeAppService SubscriptionTypeAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
<PageTitle>@L["EditSubscription"]</PageTitle>


<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["UpdateSubscription"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="editForm">
				<MudGrid>



                    <MudItem sm="6">
                        <MudTextField @bind-Value="subscription.ArabicName"
                                      For="@(() => subscription.ArabicName)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="@L["Arabic Name"]"
                                      InputType="InputType.Text"
                                      Required="true" />
                    </MudItem>

                    <MudItem sm="6">
                        <MudTextField @bind-Value="subscription.EnglishName"
                                      For="@(() => subscription.EnglishName)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="@L["English Name"]"
                                      InputType="InputType.Text"
                                      Required="true" />
                    </MudItem>

                    <MudItem sm="6">
                        <MudTextField @bind-Value="subscription.SubscriptionDescription"
                                      For="@(() => subscription.SubscriptionDescription)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="@L["SubscriptionDescription"]"
                                      InputType="InputType.Text"
                                      Required="true" />
                    </MudItem>
                    <MudItem sm="6">
                        <MudTextField @bind-Value="subscription.SubscriptionPrice"
                                      For="@(() => subscription.SubscriptionPrice)"
                                      Immediate="true"
                                      Label="@L["SubscriptionPrice"]"
                                      InputType="InputType.Number"
                                      Required="true" />
                    </MudItem>
                    <MudItem sm="6">
                        <MudDatePicker @bind-Date="_activateDate"
                                       Variant="Variant.Text"
                                       Label="@L["ActivationDate"]"
                                       Required="true"
                                       ShowToolbar="false"
                                       Placeholder="@L["ChooseYourDate"]"
                                       IsDateDisabledFunc="@((DateTime dt) => dt.Date < DateTime.Today)" />
                    </MudItem>
                    <MudItem sm="6">
                        <MudDatePicker @bind-Date="_inActivateDate"
                                       Variant="Variant.Text"
                                       Label="@L["InActivationDate"]"
                                       Required="true"
                                       Placeholder="@L["ChooseYourDate"]"
                                       ShowToolbar="false"
                                       IsDateDisabledFunc="@((DateTime dt) => dt.Date < DateTime.Today)" />
                    </MudItem>
                    <MudItem sm="6">
                        <MudTextField @bind-Value="subscription.NumberOfCustomers"
                                      For="@(() => subscription.NumberOfCustomers)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Placeholder=@L["Type Here"]
                                      InputType="InputType.Number"
                                      Label="@L["NumberOfCustomers"]"
                                      Required="true" />
                    </MudItem>

                    <MudItem sm="6">
                        <MudTextField @bind-Value="subscription.NumberOfOrganizations"
                                      For="@(() => subscription.NumberOfCustomers)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Placeholder="@L["Type Here"]"
                                      InputType="InputType.Number"
                                      Label="@L["NumberOfOrganizations"]"
                                      Required="true" />
                    </MudItem>
                    <MudItem sm="6">
                        <MudTextField @bind-Value="subscription.NumberOfCameras"
                                      For="@(() => subscription.NumberOfCameras)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      InputType="InputType.Number"
                                      Placeholder=@L["Type Here"]
                                      Label="@L["NumberOfCameras"]"
                                      Required="true" />
                    </MudItem>
                    <MudItem sm="6">
                        <MudTextField @bind-Value="subscription.NumbersOfGarages"
                                      For="@(() => subscription.NumbersOfGarages)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Placeholder=@L["Type Here"]
                                      InputType="InputType.Number"
                                      Label="@L["NumbersOfGarages"]"
                                      Required="true" />
                    </MudItem>
                    <MudItem sm="6">
                        <MudTextField @bind-Value="subscription.NumberOfMobileCustomers"
                                      For="@(() => subscription.NumberOfMobileCustomers)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Placeholder="@L["Type Here"]"
                                      InputType="InputType.Number"
                                      Label="@L["NumberOfMobileCustomers"]"
                                      Required="true" />
                    </MudItem>
                    <MudItem sm="6">
                        <MudTextField @bind-Value="subscription.SubscriptionSlotNumber"
                                      For="@(() => subscription.SubscriptionSlotNumber)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Placeholder="@L["Type Here"]"
                                      InputType="InputType.Number"
                                      Label="@L["SubscriptionSlotNumber"]"
                                      Required="true" />
                    </MudItem>
                   

                    <MudItem sm="6">
                        <MudSelect Variant="Variant.Text"
                                   Label="@L["SubscriptionTypes"]"
                                   Placeholder="@L["Choose"]"
                                   Clearable="true"
                                   Required="true"
                                   AnchorOrigin="Origin.TopCenter"
                                   TransformOrigin="Origin.TopCenter"
                                   @bind-Value="subscription.SubscriptionTypeId">

                            @foreach (var subscription in subscriptions)
                            {
                                <MudSelectItem Value="@subscription.Id">@subscription.SubscriptionType</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>


                    <MudItem sm="6" Class="d-inline-flex justify-content-center">
                        <MudItem Class="d-flex flex-row justify-content-between">
                            <MudRadioGroup @bind-Value="@subscription.Status" Class="d-inline-flex align-content-center">
                                <MudRadio Value="@(SubscriptionStatus.Active)" Color="MudBlazor.Color.Primary">@L["Status Active"]</MudRadio>
                                <MudRadio Value="@(SubscriptionStatus.Inactive)" Color="MudBlazor.Color.Secondary">@L["Status InActive"]</MudRadio>
                                <MudRadio Value="@(SubscriptionStatus.Draft)" Color="MudBlazor.Color.Warning">@L["Status Draft"]</MudRadio>
                            </MudRadioGroup>
                        </MudItem>
                    </MudItem>

				</MudGrid>
			</MudForm>



		</DialogContent>

        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Save">@L["Edit"]</MudButton>
        </DialogActions>
	</MudDialog>

</MudItem>


<style>
	.mud-modal
	{
		border-radius: 0 20px 0 20px;
	}
</style>