@page "/my-account"
@layout Shared.ProfileLayout
<PageTitle>My Account</PageTitle>
<MudGrid>
    <MudItem sm="8">
        <MudPaper Class="h-100 p-3  w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">
            <h3 Color="fw-bold">Main Data</h3>
        </MudPaper>
    </MudItem>
    <MudItem sm="4">
        <MudPaper Class="h-100 p-3  w-100 h-100 main-layout-paper d-flex flex-column justify-content-between" Style="background-color: #F2F2F2;">
            <div class="d-flex justify-content-between align-items-center">
                <MudText>My Profile</MudText>
                <MudLink Underline="Underline.Always">Edit Profile</MudLink>
            </div>
            <div class="d-flex flex-column align-content-center gap-4 p-5">
                <MudImage Src="images/profile-avatar.png" Class="rounded-circle"/>
                <div class="d-flex flex-column align-items-center">
                    <MudText Class="fw-bold">Ahmed Mohamed</MudText>
                    <MudText>A.Mohamed@mdkhl.com</MudText>
                </div>
            </div>
            <MudGrid Class="mt-3">
                <MudItem sm="6">
                    <MudPaper class="text-center p-2">
                        <MudLink Color="MudBlazor.Color.Dark">Garages</MudLink>
                    </MudPaper>
                </MudItem>
                <MudItem sm="6">
                    <MudPaper class="text-center p-2">
                        <MudLink Color="MudBlazor.Color.Dark">Subscriptions</MudLink>
                    </MudPaper>
                </MudItem>

                <MudItem sm="6">
                    <MudPaper class="text-center p-2">
                        <MudLink Color="MudBlazor.Color.Dark">Categories</MudLink>

                    </MudPaper>
                </MudItem>
                <MudItem sm="6">
                    <MudPaper class="text-center p-2">
                        <MudLink Color="MudBlazor.Color.Dark">Packages</MudLink>

                    </MudPaper>
                </MudItem>

                <MudItem sm="6">
                    <MudPaper class="text-center p-2">
                        <MudLink Color="MudBlazor.Color.Dark">Users</MudLink>
                    </MudPaper>
                </MudItem>
                <MudItem sm="6">
                    <MudPaper class="text-center p-2">
                        <MudLink Color="MudBlazor.Color.Dark">Contact Data</MudLink>
                    </MudPaper>
                </MudItem>

            </MudGrid>
        </MudPaper>
    </MudItem>

</MudGrid>
@code {

}
