@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups.LicenceType
@inject ILicenceTypesAppService LicenceTypesAppService
@inject IDialogService Dialog
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Mdkhl , admin")]
@page "/licencetypes"

<PageTitle>@L["LicenceTypes"]</PageTitle>

<MudText Typo="Typo.h5" Class="mb-2">@L["LicenceTypes"]</MudText>

<SPDataGrid PageName=@L["LicenceTypes"] Data="@itemData" TotalItemsInTable="TotalItem" OnFiltering="HandleFilter" OnClickRowEdit="OnClickRowEdit" OnClickRowView="OnClickRowView" OnPageChanged="FetchTableData" OnSearching="FetchTableData" OnAdd="@(() => CreateLicenceType(_backdropClick))" OnClickRowDelete="OnClickRowDelete"></SPDataGrid>

