@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Localization
@using SmartParking.Lookups.LicenceType
@using SmartParking.Lookups.PlateColor
@using System.Globalization
@using SmartParking.Utilities
@using System.Security.Authentication
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@using Volo.Abp.Validation
@inject IDialogService DialogService
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
<PageTitle>@L["New LicenceType"]</PageTitle>
<div class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["New LicenceType"]</MudText>
        </TitleContent>
        <DialogContent>
           
                    <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                        <MudGrid>

                            <MudItem sm="6">
                                <MudSelect @bind-Value="@licenceTypeDto.PlateColorId"
                                           Variant="Variant.Text"
                                           Label="@L["PlateColor Name"]"
                                   Placeholder=@L["Choose"]
                                   HelperText=@L["Helper Text"]
                                   Required="true"
                                           Clearable="_clearable"
                                   RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))">
                            <MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
                                    @foreach (var platecolor in plateColors)
                                    {
                                        @if (CultureInfo.CurrentCulture.Name == "en")
                                        {
                                            <MudSelectItem Value="platecolor.Id">@platecolor.EnglishName</MudSelectItem>
                                        }
                                        else
                                        {
                                            <MudSelectItem Value="platecolor.Id">@platecolor.ArabicName</MudSelectItem>
                                        }

                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="licenceTypeDto.ArabicName"
                                              For="@(() => licenceTypeDto.ArabicName)"
                                              Immediate="true"
                                              Required="true"
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                                      Placeholder=@L["Type Here"]
                                              Label="@L["ArabicName"]" />
                            </MudItem>

                            <MudItem sm="4">
                                <MudTextField @bind-Value="licenceTypeDto.EnglishName"
                                              For="@(() => licenceTypeDto.EnglishName)"
                                              Immediate="true"
                                              Required="true"
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                                      Placeholder=@L["Type Here"]
                                      Label="@L["EnglishName"]" />
                            </MudItem>
                    <MudItem sm="6">

                        <div class="d-flex flex-column align-items-center px-5 position-relative pb-6">

                            <MudImage Src="@Picture" Class="bg_w_foto " Width="150" Height="100" Alt="@L["Picture"]" />
                            <MudFileUpload T="IBrowserFile" Accept=".png, .jpg" FilesChanged="OnImageUpload" MaximumFileCount="1">
                                <ActivatorContent>
                                    <MudFab Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.CameraAlt" Size="MudBlazor.Size.Small" Class="rounded-circle" />
                                </ActivatorContent>
                            </MudFileUpload>
                        </div>
                    </MudItem>

                        </MudGrid>
                    </MudForm>
                 
        </DialogContent>
        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled"  OnClick="Submit">@L["Create"]</MudButton>
        </DialogActions>

    </MudDialog>

</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>

@code {
    [Inject] ISnackbar Snackbar { get; set; }
    [Inject] ILicenceTypesAppService LicenceTypesAppService { get; set; } 
    [Inject] IPlateColorsAppService  PlateColorsAppService { get; set; }
    IReadOnlyList<PlateColorDto> plateColors = new List<PlateColorDto>();

    private MudForm form;
    private CreateUpdateLicenceTypeDto licenceTypeDto = new CreateUpdateLicenceTypeDto();
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }
    bool _clearable;
    private string Picture { get; set; }
    protected override async Task OnInitializedAsync()
    {
        var result = await PlateColorsAppService.GetListAsync(new PagedAndSortedResultRequestDto
            {
                MaxResultCount = 100,
                SkipCount = (1 - 1) * 100
            });
        plateColors = result.Items.ToList();
        await base.OnInitializedAsync();
    }
    private async Task OnImageUpload(IBrowserFile file)
    {
        var imageFile = file;
        if (imageFile != null)
        {
            // Save the image and get the file path
            Picture = await ImageHelper.GetImageBase64Async(imageFile);
            StateHasChanged();
        }
    }
    private async Task Submit()
    {
      
        try
        {
        licenceTypeDto.Image = await FileHelper.SaveImageFromBase64Async(Picture, PathHelper.LicenceTypeFolder);
            await LicenceTypesAppService.CreateAsync(licenceTypeDto);
            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.SUCCESS]} {L[AlertMessages.AlertMessages.ADD]} {licenceTypeDto.ArabicName}", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
            await Task.Delay(1000);
            Navigation.NavigateTo("/licenceTypes", true);
        }
        
        catch (AbpValidationException validationException)
        {
            foreach (var validationError in validationException.ValidationErrors)
            {
                SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.VAlIDATION_ERROR]}: {L[validationError.MemberNames.First()]} - {validationError.ErrorMessage}", Severity.Error);
            }
        }
        catch (BusinessException ex)
        {

            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]} {L[AlertMessages.AlertMessages.ADD]} : {ex.Code}", Severity.Error);
        }
        catch (AuthenticationException ex)
        {
            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]} {L[AlertMessages.AlertMessages.ADD]} : {ex.Message} ", Severity.Error);
        }
        catch (Exception ex)
        {

            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]} {L[AlertMessages.AlertMessages.ADD]} : {ex.Message} ", Severity.Error);
        }
           
    }
    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
