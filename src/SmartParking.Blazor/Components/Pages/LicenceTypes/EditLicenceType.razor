@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Localization
@using SmartParking.Lookups.LicenceType
@using SmartParking.Lookups.PlateColor
@using SmartParking.Utilities
@using SmartParking.Vehicles.LookUps
@using System.Globalization
@using System.Security.Authentication
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@using Volo.Abp.Validation
@inject IPlateColorsAppService PlateColorsAppService
@inject ILicenceTypesAppService LicenceTypesAppService
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@L["Edit LicenceType"]</PageTitle>
<div class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>			
				<MudText Typo="Typo.h6">@L["Edit"]</MudText>
		</TitleContent>
		<DialogContent>



			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>
					<MudItem sm="6">
						<MudSelect @bind-Value="@LicenceType.PlateColorId"
						Variant="Variant.Text"
						Label="@L["PlateColor Name"]"
						Placeholder=@L["Choose"]
						HelperText=@L["Helper Text"]
						Required="true"
								   RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
						Clearable="_clearable">
							@foreach (var platecolor in plateColors)
							{
								@if (CultureInfo.CurrentCulture.Name == "en")
								{
									<MudSelectItem Value="platecolor.Id">@platecolor.EnglishName</MudSelectItem>

								}
								else
								{
									<MudSelectItem Value="platecolor.Id">@platecolor.ArabicName</MudSelectItem>

								}
							}
						</MudSelect>
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="LicenceType.ArabicName"
						For="@(() => LicenceType.ArabicName)"
						Immediate="true"
						Placeholder=@L["Type Here"]
						Label="@L["ArabicName"]" 
						Required
									  RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
					</MudItem>

					<MudItem sm="6">
						<MudTextField @bind-Value="LicenceType.EnglishName"
						For="@(() => LicenceType.EnglishName)"
						Immediate="true"
						Required="true"
						Placeholder=@L["Type Here"]
						Label="@L["EnglishName"]"
									  RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
					</MudItem>
					<MudItem sm="6">

						<div class="d-flex flex-column align-items-center px-5 position-relative pb-6">

							<MudImage Src="@Picture" Class="bg_w_foto " Width="150" Height="100" Alt="@L["ModelPicture"]" />
							<MudFileUpload T="IBrowserFile" Accept=".png, .jpg" FilesChanged="OnImageUpload" MaximumFileCount="1">
								<ActivatorContent>
									<MudFab Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.CameraAlt" Size="MudBlazor.Size.Small" Class="rounded-circle" />
								</ActivatorContent>
							</MudFileUpload>
						</div>

					</MudItem>
				</MudGrid>
			</MudForm>



		</DialogContent>
			<DialogActions>
    <DialogActionComponent 
        ButtonOneColor="MudBlazor.Color.Dark"
        ButtonTwoColor="MudBlazor.Color.Primary"
        ButtonOneLabel="@L["Back"]"
        ButtonTwoLabel="@L["Save"]"
        ButtonOneClick="CancelEdit"
        ButtonTwoClick="SubmitEdit"
        ButtonOneVariant="MudBlazor.Variant.Filled"
        ButtonTwoVariant="MudBlazor.Variant.Filled"
    />
</DialogActions>

	</MudDialog>

</div>


<style>
	.mud-modal {
	border-radius: 0 20px 0 20px;
	}
</style>
