@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Localization
@using SmartParking.Lookups.LicenceType
@using SmartParking.Lookups.PlateColor
@using SmartParking.Utilities
@using SmartParking.Vehicles.LookUps
@using System.Globalization
@using Volo.Abp.Application.Dtos
@inject IPlateColorsAppService PlateColorsAppService
@inject ILicenceTypesAppService LicenceTypesAppService
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@L["Edit LicenceType"]</PageTitle>
<div class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			@if(CultureInfo.CurrentCulture.Name == "en")
			{
				<MudText Typo="Typo.h6">@L["Edit"] @LicenceType.EnglishName</MudText>

			}
			else
			{
				<MudText Typo="Typo.h6">@L["Edit"] @LicenceType.ArabicName</MudText>

			}
		</TitleContent>
		<DialogContent>



			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>
					<MudItem sm="6">
						<MudSelect @bind-Value="@LicenceType.PlateColorId"
						Variant="Variant.Text"
						Label="@L["PlateColor Name"]"
						Placeholder=@L["Choose"]
						HelperText=@L["Helper Text"]
						Required="true"
						Clearable="_clearable">
							@foreach (var platecolor in plateColors)
							{
								@if (CultureInfo.CurrentCulture.Name == "en")
								{
									<MudSelectItem Value="platecolor.Id">@platecolor.EnglishName</MudSelectItem>

								}
								else
								{
									<MudSelectItem Value="platecolor.Id">@platecolor.ArabicName</MudSelectItem>

								}
							}
						</MudSelect>
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="LicenceType.ArabicName"
						For="@(() => LicenceType.ArabicName)"
						Immediate="true"
						Placeholder=@L["Type Here"]
						Label="@L["ArabicName"]" />
					</MudItem>

					<MudItem sm="4">
						<MudTextField @bind-Value="LicenceType.EnglishName"
						For="@(() => LicenceType.EnglishName)"
						Immediate="true"
						Required="true"
						Placeholder=@L["Type Here"]
						Label="@L["EnglishName"]" />
					</MudItem>
					<MudItem sm="6">

						<div class="d-flex flex-column align-items-center px-5 position-relative pb-6">

							<MudImage Src="@Picture" Class="bg_w_foto " Width="150" Height="100" Alt="@L["ModelPicture"]" />
							<MudFileUpload T="IBrowserFile" Accept=".png, .jpg" FilesChanged="OnImageUpload" MaximumFileCount="1">
								<ActivatorContent>
									<MudFab Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.CameraAlt" Size="MudBlazor.Size.Small" Class="rounded-circle" />
								</ActivatorContent>
							</MudFileUpload>
						</div>

					</MudItem>
				</MudGrid>
			</MudForm>



		</DialogContent>
		<DialogActions>
			<MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="CancelEdit">@L["Back"]</MudButton>
			<MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="SubmitEdit">@L["Save"]</MudButton>
		</DialogActions>


	</MudDialog>

</div>


<style>
	.mud-modal {
	border-radius: 0 20px 0 20px;
	}
</style>

@code {
	[CascadingParameter]
	private MudDialogInstance MudDialogAdd { get; set; }

	[Parameter] public CreateUpdateLicenceTypeDto LicenceType { get; set; }
	[Parameter]
	public int UpdatedId { get; set; }
	bool _clearable;
	bool IsPictureChanged;
	private MudForm form;
	IReadOnlyList<PlateColorDto> plateColors = new List<PlateColorDto>();
	private string Picture { get; set; }

	private async Task OnImageUpload(IBrowserFile file)
	{
		var imageFile = file;
		if (imageFile != null)
		{
			// Save the image and get the file path
			Picture = await ImageHelper.GetImageBase64Async(imageFile);
			IsPictureChanged = true;
			StateHasChanged();
		}
	}

	protected override async Task OnInitializedAsync()
	{
		var result = await PlateColorsAppService.GetListAsync(new PagedAndSortedResultRequestDto
			{
				MaxResultCount = 100,
				SkipCount = (1 - 1) * 100
			});
		plateColors = result.Items.ToList();
		Picture = LicenceType.Image;
		
		await base.OnInitializedAsync();
	}

	private async Task SubmitEdit()
	{
		var successedMessage = L["LicenceTypeUpdatedSuccessfully"];
		
		try
		{
			if (IsPictureChanged)
				LicenceType.Image = await FileHelper.SaveImageFromBase64Async(Picture, PathHelper.LicenceTypeFolder);
			await LicenceTypesAppService.UpdateAsync(UpdatedId, LicenceType);
			Snackbar.Add(successedMessage, Severity.Success);
			MudDialogAdd.Close(DialogResult.Ok(true));
			await Task.Delay(1000);
			Navigation.NavigateTo("/licenceTypes", forceLoad: true);
		}
		catch (Exception e)
		{
			Snackbar.Add(e.Message, Severity.Error);
		}
	}

	private async Task CancelEdit()
	{
		MudDialogAdd.Cancel();


	}


}
