@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups.LicenceType
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
<PageTitle>@L["View LicenceType"]</PageTitle>
<div class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["Details"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="LicenceType.ArabicName"
									  For="@(() => LicenceType.ArabicName)"
									  Immediate="true"
									  Disabled=true
									  Label="@L["ArabicName"]" />
					</MudItem>
					<MudItem sm="4">
						<MudTextField @bind-Value="LicenceType.EnglishName"
									  For="@(() => LicenceType.EnglishName)"
									  Immediate="true"
									  Disabled=true
									  Label="@L["EnglishName"]" />
					</MudItem>
					<MudItem sm="12">

						<div class="d-flex flex-column align-items-center px-5 position-relative pb-6">

							<MudImage Src="@LicenceType.Image" Class="bg_w_foto " Width="150" Height="100" Alt="@L["Picture"]" />

						</div>
					</MudItem>
				</MudGrid>
			</MudForm>



		</DialogContent>
		<DialogActions>
			<MudButton Color="MudBlazor.Color.Dark" Variant="Variant.Filled" OnClick="OnCloseViewOnly">@L["Back"]</MudButton>
		</DialogActions>

	</MudDialog>

</div>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>

@code {
	[CascadingParameter]
	private MudDialogInstance MudDialogAdd { get; set; }
	[Parameter] public CreateUpdateLicenceTypeDto LicenceType { get; set; }

	bool _clearable;
	private MudForm form;

	protected override async Task OnInitializedAsync()
	{

		await base.OnInitializedAsync();
	}



	private void OnCloseViewOnly()
	{
		MudDialogAdd.Cancel();

	}

}
