@using Microsoft.Extensions.Localization
@using SmartParking.Enums
@using SmartParking.Localization
@using SmartParking.SubscriptionTypes
@using SmartParking.Subscriptions
@using System.Globalization
@inject ISubscriptionAppService SubscriptionAppService
@inject ISubscriptionTypeAppService SubscriptionTypeAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
<PageTitle>@L["AddSubscription"]</PageTitle>

<div >
<MudItem class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["NewSubscription"]</MudText>
        </TitleContent>
        <DialogContent>


            <MudForm Class=" flex-grow-1 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                <MudGrid>

                   <MudItem sm="6" Class="pt-0">
                        <MudTextField @bind-Value="input.EnglishName"
                                          For="@(() => input.EnglishName)"
                                          Immediate="true"
                                          Variant="Variant.Text"
                                          Placeholder=@L["Type Here"]
                                          Label="@L["EnglishName"]"
                                          InputType="InputType.Text"
                                          Required="true" 
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                   </MudItem>
                    <MudItem sm="6"
                             Class="pt-0">
                        <MudTextField @bind-Value="input.ArabicName"
                                      For="@(() => input.ArabicName)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                          Placeholder=@L["Type Here"]
                                          Label="@L["ArabicName"]"
                                      InputType="InputType.Text"
                                      Required="true"
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>
                        <MudItem sm="6">
                            <MudSelect Variant="Variant.Text"
                                       Label="@L["SubscriptionType"]"
                                       Placeholder="@L["Choose"]"
                                       Clearable="true"
                                       @bind-Value="input.SubscriptionTypeId">

                                <MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
                                @foreach (var subscription in subscriptions)
                                {
                                    @if (subscription.Status != Status.Active)
                                        continue;
                                    if(CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="subscription.Id">@subscription.SubscriptionTypeEn</MudSelectItem>

                                    }
                                    else
                                    {
                                        <MudSelectItem Value="subscription.Id">@subscription.SubscriptionTypeAr</MudSelectItem>

                                    }
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem sm="6">
                            <MudTextField @bind-Value="input.SubscriptionPrice"
                                          For="@(() => input.SubscriptionPrice)"
                                          Immediate="true"
                                          Placeholder=@L["Type Here"]
                                          Label="@L["SubscriptionPrice"]"
                                          InputType="InputType.Text"
                                          Required="true" 
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                        </MudItem>
                        <MudItem sm="6">
                            <MudNumericField T="int"
                                             @bind-Value="@(BoundNumberOfParkingSlots=maximumNumberOfParkingSlots?UnlimitedMaximumNumber:BoundNumberOfParkingSlots)"
                                             Immediate="true"
                                             Variant="Variant.Text"
                                             Placeholder=@L["Type Here"]
                                             HideSpinButtons
                                             Min="0"
                                             Disabled="maximumNumberOfParkingSlots"
                                             Required="maximumNumberOfParkingSlots"
                                             Label="@L["ParkingSlot"]" 
                                             RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                        </MudItem>
                        <MudItem sm="6">
                            <MudTextField @bind-Value="input.SubscriptionSlotNumber"
                                          For="@(() => input.SubscriptionSlotNumber)"
                                          Immediate="true"
                                          Variant="Variant.Text"
                                          Placeholder=@L["Type Here"]
                                          InputType="InputType.Text"
                                          Label="@L["SubscriptionSlotNumber"]"
                                          Required="true" 
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                        </MudItem>
                    <MudItem sm="12">
                        <MudTextField @bind-Value="input.SubscriptionDescription"
                                      For="@(() => input.SubscriptionDescription)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Placeholder="@L["Type Here"]"
                                      Label="@L["SubscriptionDescription"]"
                                      InputType="InputType.Text"
                                      Required="true"
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>

                     
                    <MudDivider Style="border-top:1px solid #505254; margin:50px 0px;" />
                        <MudItem sm="6">
                            <MudNumericField T="int"
                                             @bind-Value="@(BoundNumberOfCustomers=maximumNumberOfCustomers?UnlimitedMaximumNumber:BoundNumberOfCustomers)"
                                             Immediate="true"
                                             Variant="Variant.Text"
                                             Placeholder="@L["Type Here"]"
                                             Label="@L["NumberOfCustomers"]"
                                             HideSpinButtons
                                             Min="0"
                                             Disabled="maximumNumberOfCustomers"
                                             Required="maximumNumberOfCustomers" 
                                             RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                        </MudItem>
                        <MudItem sm="6">
                            <MudSwitch Label="@L["UnlimitedCustomers"]"
                                       LabelPosition="LabelPosition.Start"
                                       @bind-Value="maximumNumberOfCustomers"
                                       Color="MudBlazor.Color.Primary"
                                       />
                        </MudItem>
                     
                     
                        <MudItem sm="6">

                            <MudNumericField T="int"
                                             @bind-Value="@( BoundNumberOfCameras=maximumNumberOfCameras?UnlimitedMaximumNumber:BoundNumberOfCameras)"
                                             Immediate="true"
                                             Variant="Variant.Text"
                                             Placeholder=@L["Type Here"]
                                             Label="@L["NumberOfCameras"]"
                                             HideSpinButtons
                                             Min="0"
                                             Disabled="maximumNumberOfCameras"
                                             Required="maximumNumberOfCameras" 
                                             RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />

                        </MudItem>


                        <MudItem sm="6">
                            <MudSwitch 
                                Label="@L["UnlimitedCameras"]"
                                LabelPosition="LabelPosition.Start"
                                       @bind-Value="maximumNumberOfCameras"
                                       Color="MudBlazor.Color.Primary" />

                        </MudItem>

                        <MudItem sm="6">

                            <MudNumericField T="int"
                                             @bind-Value="@( BoundNumberOfGarages=maximumNumberOfGarages?UnlimitedMaximumNumber:BoundNumberOfGarages)"
                                             Immediate="true"
                                             Variant="Variant.Text"
                                             Placeholder=@L["Type Here"]
                                             Label="@L["NumbersOfGarages"]"
                                             HideSpinButtons
                                             Min="0"
                                             Disabled="maximumNumberOfGarages"
                                             Required="maximumNumberOfGarages" 
                                             RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                        </MudItem>

                        <MudItem sm="6">
                            <MudSwitch 
                                Label="@L["UnlimitedGarages"]"
                                LabelPosition="LabelPosition.Start"
                                       @bind-Value="maximumNumberOfGarages"
                                       Color="MudBlazor.Color.Primary" />
                        </MudItem>

                        <MudItem sm="6">
                            <MudNumericField T="int"
                                             @bind-Value="@(BoundNumberOfUsers=maximumNumberOfUsers?UnlimitedMaximumNumber:BoundNumberOfUsers)"
                                             Immediate="true"
                                             Variant="Variant.Text"
                                             Placeholder=@L["Type Here"]
                                             Label="@L["NumberOfUsers"]"
                                             HideSpinButtons
                                             Min="0"
                                             Disabled="maximumNumberOfUsers"
                                             Required="maximumNumberOfUsers" 
                                             RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                        </MudItem>

                        <MudItem sm="6">
                            <MudSwitch Label="@L["UnlimitedUsers"]"
                                LabelPosition="LabelPosition.Start"
                                       @bind-Value="maximumNumberOfUsers"
                                Color="MudBlazor.Color.Primary" />
                        </MudItem>

                       

                    <MudDivider Style="border-top:1px solid #505254; margin:50px 0px;" />
                    
                            <MudItem sm="4">
                                <MudDatePicker @bind-Date="_activateDate"
                                               @bind-value="_activateDate"
                                               Variant="Variant.Text"
                                               Placeholder=@L["Will Be Generated Automatically"]
                                               Label="@L["ActivationDate"]"
                                               Disabled
                                               IsDateDisabledFunc="@((DateTime dt) => dt.Date < DateTime.Today)"
                                               ShowToolbar="false" />
                            </MudItem>
                     
                            <MudItem sm="4">
                            <MudDatePicker @bind-Date="_inActivateDate"
                                           @bind-value="_inActivateDate"
                                           Variant="Variant.Text"
                                           Placeholder=@L["Will Be Generated Automatically"]
                                           Label="@L["InActivationDate"]"
                                           Disabled
                                           ShowToolbar="false"
                                           IsDateDisabledFunc="@((DateTime dt) => dt.Date < DateTime.Today)" />
                        </MudItem>
                        
                        
                        <MudItem sm="4">
                            <MudDatePicker @bind-Date="_creationDate"
                                           @bind-value="_creationDate"
                                           Variant="Variant.Text"
                                           Placeholder=@L["Will Be Generated Automatically"]
                                           Label="@L["CreationDate"]"
                                           Disabled
                                           ShowToolbar="false"
                                           IsDateDisabledFunc="@((DateTime dt) => dt.Date < DateTime.Today)" />
                        </MudItem>


                    </MudGrid>
            </MudForm>

        </DialogContent>

        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled"  OnClick="Submit">@L["SaveAsDraft"]</MudButton>
        </DialogActions>

    </MudDialog>

</MudItem>
</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
        width:auto;
    }
</style>
