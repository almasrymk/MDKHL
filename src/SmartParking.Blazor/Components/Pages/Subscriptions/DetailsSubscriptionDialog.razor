@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Localization
@using SmartParking.SubscriptionTypes
@using SmartParking.Subscriptions
@using System.Globalization
@inject ISubscriptionAppService SubscriptionAppService
@inject ISubscriptionTypeAppService SubscriptionTypeAppService
@inject IStringLocalizer<SmartParkingResource> L
<PageTitle>@L["SubscriptionDetails"]</PageTitle>

<div>
<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxHeigth="85vh" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@subscription.EnglishName</MudText>
		</TitleContent>
		<DialogContent>

			<MudForm Class="flex-grow-1  p-3 d-flex flex-column w-100 h-100 main-layout-paper">
				<MudGrid>    
					<MudItem sm="6" Class="pt-0">
						<MudTextField @bind-Value="subscription.ArabicName"
									  For="@(() => subscription.ArabicName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["ArabicName"]"
									  Disabled />
					</MudItem>
					<MudItem sm="6" Class="pt-0">
						<MudTextField @bind-Value="subscription.EnglishName"
									  For="@(() => subscription.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["EnglishName"]"
									  Disabled />
					</MudItem>
						@if (CultureInfo.CurrentCulture.Name == "en")
						{
							<MudItem sm="6">
						<MudTextField @bind-Value="subscription.SubscriptionTypeEn"
									  For="@(() => subscription.SubscriptionTypeEn)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["SubscriptionType"]"
									  Disabled />
							</MudItem>

												
						}
						else
						{
							<MudItem sm="6">
								<MudTextField @bind-Value="subscription.SubscriptionTypeAr"
											  For="@(() => subscription.SubscriptionTypeAr)"
											  Immediate="true"
											  Variant="Variant.Text"
											  Label="@L["SubscriptionType"]"
											  Disabled />
							</MudItem>

						}
				
					<MudItem sm="6">
						<MudTextField @bind-Value="subscription.SubscriptionPrice"
									  For="@(() => subscription.SubscriptionPrice)"
									  Immediate="true"
									  Disabled
									  Label="@L["SubscriptionPrice"]" />
					</MudItem>


					<MudItem sm="6">
						<MudTextField @bind-Value="subscription.SubscriptionDescription"
									  For="@(() => subscription.SubscriptionDescription)"
									  Immediate="true"
									  Class="w-100"
									  Lines="2"
									  Variant="Variant.Text"
									  Label="@L["SubscriptionDescription"]"
									  Disabled />
					</MudItem>
					<MudItem sm="6">
						<MudTextField @bind-Value="subscription.Status"
									  For="@(() => subscription.Status)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["SubscriptionStatus"]"
									  Disabled />
					</MudItem>
					<MudItem sm="6">
						<MudTextField @bind-Value="subscription.CreationTime"
									  For="@(() => subscription.CreationTime)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["CreationTime"]"
									  Disabled />
					</MudItem>
					
					<MudItem sm="6">
						<MudTextField @bind-Value="subscription.ActivationDate"
									  For="@(() => subscription.ActivationDate)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["ActivationDate"]"
									  Disabled />
					</MudItem>
					
					<MudItem sm="6">
						<MudTextField @bind-Value="subscription.InActivationDate"
									  For="@(() => subscription.InActivationDate)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["InActivationDate"]"
									  Disabled />
					</MudItem>
					<MudItem sm="4">
						<MudTextField @bind-Value="subscription.SubscriptionSlotNumber"
									  For="@(() => subscription.SubscriptionSlotNumber)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["SubscriptionSlotNumber"]"
									  Disabled />
					</MudItem>					
					<MudItem sm="4">
						<MudTextField @bind-Value="subscription.NumberOfUsers"
									  For="@(() => subscription.NumberOfUsers)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["NumberOfCustomers"]"
									  Disabled />
					</MudItem>
					
					<MudItem sm="4">
						<MudTextField @bind-Value="subscription.NumbersOfGarages"
									  For="@(() => subscription.NumbersOfGarages)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["NumbersOfGarages"]"
									  Disabled />
					</MudItem>
					<MudItem sm="4">
						<MudTextField @bind-Value="subscription.NumberOfCameras"
									  For="@(() => subscription.NumberOfCameras)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["NumberOfCameras"]"
									  Disabled />
					</MudItem>
					<MudItem sm="4">
						<MudTextField @bind-Value="subscription.NumberOfCustomers"
									  For="@(() => subscription.NumberOfCustomers)"
									  Immediate="true"
									  Variant="Variant.Text"
										  Label="@L["NumberOfCustomers"]"
									  Disabled />


						</MudItem>
						<MudItem sm="4">
							<MudTextField Disabled Label=@L["ParkingSlots"] @bind-Value="subscription.ParkingSlot" Variant="Variant.Text" />

						</MudItem>
				

					
				</MudGrid>
			</MudForm>



		</DialogContent>

		<DialogActions>
			<MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
		</DialogActions>
	</MudDialog>

</MudItem>
</div>

<style>
	.mud-modal
	{
		border-radius: 0 20px 0 20px;
		overflow: auto;
		height:100vh;
	}
</style>
