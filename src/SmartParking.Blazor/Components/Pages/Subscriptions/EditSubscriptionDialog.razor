@using Microsoft.Extensions.Localization
@using SmartParking.Enums
@using SmartParking.Localization
@using SmartParking.SubscriptionTypes
@using SmartParking.Subscriptions
@using System.Globalization
@inject ISubscriptionAppService SubscriptionAppService
@inject ISubscriptionTypeAppService SubscriptionTypeAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
<PageTitle>@L["EditSubscription"]</PageTitle>

<div>
<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>          
                <MudText Typo="Typo.h6">@L["Edit"]</MudText>
            </TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1  p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="editForm">
				<MudGrid>

                    <MudItem sm="6" Class="pt-0">
                            <MudTextField @bind-Value="subscription.EnglishName"
                                          For="@(() => subscription.EnglishName)"
                                          Immediate="true"
                                          Variant="Variant.Text"
                                          Label="@L["EnglishName"]"
                                          InputType="InputType.Text"
                                          Required="true" 
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>


                    <MudItem sm="6" Class="pt-0">
                        <MudTextField @bind-Value="subscription.ArabicName"
                                      For="@(() => subscription.ArabicName)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="@L["ArabicName"]"
                                      InputType="InputType.Text"
                                      Required="true"
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>

                    
                        <MudItem sm="6">
                            <MudSelect Variant="Variant.Text"
                                       Label="@L["SubscriptionType"]"
                                       Placeholder="@L["Choose"]"
                                       Clearable="true"
                                       @bind-Value="subscription.SubscriptionTypeId">

                                @foreach (var subscription in subscriptions)
                                {
                                   
                                    if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="subscription.Id">@subscription.SubscriptionTypeEn</MudSelectItem>

                                    }
                                    else
                                    {
                                        <MudSelectItem Value="subscription.Id">@subscription.SubscriptionTypeAr</MudSelectItem>

                                    }
                                }
                            </MudSelect>
                        </MudItem>

                    <MudItem sm="6">
                        <MudTextField @bind-Value="subscription.SubscriptionPrice"
                                      For="@(() => subscription.SubscriptionPrice)"
                                      Immediate="true"
                                      Label="@L["SubscriptionPrice"]"
                                      InputType="InputType.Text"
                                      Required="true"
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>
                        <MudItem sm="6">
                            <MudTextField @bind-Value="subscription.ParkingSlot"
                                          For="@(() => subscription.ParkingSlot)"
                                          Immediate="true"
                                          Variant="Variant.Text"
                                          Placeholder="@L["Type Here"]"
                                          InputType="InputType.Text"
                                          Label="@L["ParkingSlot"]"
                                          Required="true" 
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                        </MudItem>
                        <MudItem sm="6">
                            <MudTextField @bind-Value="subscription.SubscriptionSlotNumber"
                                          For="@(() => subscription.SubscriptionSlotNumber)"
                                          Immediate="true"
                                          Variant="Variant.Text"
                                          Placeholder="@L["Type Here"]"
                                          InputType="InputType.Text"
                                          Label="@L["SubscriptionSlotNumber"]"
                                          Required="true" 
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                        </MudItem>
                        <MudItem sm="12">
                            <MudTextField @bind-Value="subscription.SubscriptionDescription"
                                          For="@(() => subscription.SubscriptionDescription)"
                                          Immediate="true"
                                          Variant="Variant.Text"
                                          Label="@L["SubscriptionDescription"]"
                                          InputType="InputType.Text"
                                          Required="true" 
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                        </MudItem>

                        <MudDivider Style="border-top:1px solid #505254; margin:50px 0px;" />

                    <MudItem sm="8">
                        <MudTextField @bind-Value="subscription.NumberOfUsers"
                                          For="@(() => subscription.NumberOfUsers)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Placeholder=@L["Type Here"]
                                      InputType="InputType.Text"
                                      Label="@L["NumberOfUsers"]"
                                      Required="true"
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>

                  
                    <MudItem sm="8">
                        <MudTextField @bind-Value="subscription.NumberOfCameras"
                                      For="@(() => subscription.NumberOfCameras)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      InputType="InputType.Text"
                                      Placeholder=@L["Type Here"]
                                      Label="@L["NumberOfCameras"]"
                                      Required="true"
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>
                    <MudItem sm="8">
                        <MudTextField @bind-Value="subscription.NumbersOfGarages"
                                      For="@(() => subscription.NumbersOfGarages)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Placeholder=@L["Type Here"]
                                      InputType="InputType.Text"
                                      Label="@L["NumbersOfGarages"]"
                                      Required="true"
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>
                    <MudItem sm="8">
                        <MudTextField @bind-Value="subscription.NumberOfCustomers"
                                      For="@(() => subscription.NumberOfCustomers)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Placeholder="@L["Type Here"]"
                                      InputType="InputType.Text"
                                       Label="@L["NumberOfCustomers"]"
                                      Required="true"
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>
                        @if(subscription.Status == SubscriptionStatus.Active)
                        {
                            <MudItem sm="6">
                                <MudDatePicker Variant="Variant.Text"
                                               Class="w-100"
                                               @bind-Date="ActivationDate"
                                               Disabled
                                               Label="@L["ActivationDate"]" />
                            </MudItem>
                        }
                        @if(subscription.Status == SubscriptionStatus.Inactive)
                        {
                            <MudItem sm="6">
                                <MudDatePicker Variant="Variant.Text"
                                               Class="w-100"
                                               @bind-Date="InActivationDate"
                                               Disabled
                                               Label="@L["InActivationDate"]" />
                            </MudItem>
                        }

                      
                    <MudItem sm="12" Class="d-inline-flex justify-content-center">
                        <MudItem Class="d-flex flex-row justify-content-between">
                            <MudRadioGroup @bind-Value="@subscription.Status" Class="d-inline-flex align-content-center">
                                <MudRadio Value="@(SubscriptionStatus.Active)" Color="MudBlazor.Color.Primary">@L["Status Active"]</MudRadio>
                                <MudRadio Value="@(SubscriptionStatus.Inactive)" Color="MudBlazor.Color.Secondary">@L["Status InActive"]</MudRadio>
                            </MudRadioGroup>
                        </MudItem>
                    </MudItem>

				</MudGrid>
			</MudForm>



		</DialogContent>

        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
                <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Save">@L["Save"]</MudButton>
        </DialogActions>
	</MudDialog>

</MudItem>
</div>

<style>
	.mud-modal
	{
		border-radius: 0 20px 0 20px;
	}
</style>