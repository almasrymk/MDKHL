@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Currency
@using SmartParking.Enums
@using SmartParking.Localization
@using SmartParking.SubscriptionTypes
@using SmartParking.Subscriptions
@using System.Globalization
@using SmartParking.Validations
@inject ISubscriptionAppService SubscriptionAppService
@inject ISubscriptionTypeAppService SubscriptionTypeAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
<PageTitle>@L["EditSubscription"]</PageTitle>

<div>
<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>          
                <MudText Typo="Typo.h6">@L["Edit"]</MudText>
            </TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1  p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="editForm">
				<MudGrid>

                    <MudItem sm="6" Class="pt-0">
                            <MudTextField @bind-Value="subscription.EnglishName"
                                          For="@(() => subscription.EnglishName)"
                                          Immediate="true"
                                          Variant="Variant.Text"
                                          Label="@L["EnglishName"]"
                                          InputType="InputType.Text"
                                          Required="true" 
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>


                    <MudItem sm="6" Class="pt-0">
                        <MudTextField @bind-Value="subscription.ArabicName"
                                      For="@(() => subscription.ArabicName)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="@L["ArabicName"]"
                                      InputType="InputType.Text"
                                      Required="true"
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>

                    
                        <MudItem sm="6">
                            <MudSelect Variant="Variant.Text"
                                       Label="@L["SubscriptionType"]"
                                       Placeholder="@L["Choose"]"
                                       Clearable="true"
                                       @bind-Value="subscription.SubscriptionTypeId">

                                @foreach (var subscription in subscriptions)
                                {
                                   
                                    if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="subscription.Id">@subscription.SubscriptionTypeEn</MudSelectItem>

                                    }
                                    else
                                    {
                                        <MudSelectItem Value="subscription.Id">@subscription.SubscriptionTypeAr</MudSelectItem>

                                    }
                                }
                            </MudSelect>
                        </MudItem>

                    <MudItem sm="6">
                         <div style="display: flex; flex-direction: column;">
                                <label style="font-size: 0.75rem; margin-bottom: 4px;">
                                    @L["SubscriptionPrice"]
                                    @((MarkupString)CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "15px"))
                                </label>
                        <MudNumericField @bind-Value="subscription.SubscriptionPrice"
                                      For="@(() => subscription.SubscriptionPrice)"
                                      Immediate="true"
                                      Min="0" 
                                      HideSpinButtons="true"
                                      class="@(CultureInfo.CurrentCulture.Name=="ar" ? "custom-numeric-field" : "")"                                       
                                      Required="true"
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                            </div>
                    </MudItem>
                        <MudItem sm="6">
                            <MudNumericField @bind-Value="subscription.ParkingSlot"
                                          For="@(() => subscription.ParkingSlot)"
                                          Immediate="true"
                                          Min="0" 
                                          HideSpinButtons="true"
                                          class="@(CultureInfo.CurrentCulture.Name=="ar" ? "custom-numeric-field" : "")"                                           
                                          Variant="Variant.Text"
                                          Placeholder="@L["Type Here"]"
                                          Label="@L["ParkingSlot"]"
                                          Required="true" 
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                        </MudItem>
                        <MudItem sm="6">
                            <MudNumericField @bind-Value="subscription.SubscriptionSlotNumber"
                                          For="@(() => subscription.SubscriptionSlotNumber)"
                                          Immediate="true"
                                          Variant="Variant.Text"
                                          Min="0" 
                                          HideSpinButtons="true"
                                          class="@(CultureInfo.CurrentCulture.Name=="ar" ? "custom-numeric-field" : "")"                                           
                                          Placeholder="@L["Type Here"]"
                                          InputType="InputType.Text"
                                          Label="@L["SubscriptionSlotNumber"]"
                                          Required="true" 
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                        </MudItem>
                        <MudItem sm="12">
                            <MudTextField @bind-Value="subscription.SubscriptionDescription"
                                          For="@(() => subscription.SubscriptionDescription)"
                                          Immediate="true"
                                          Variant="Variant.Text"
                                          Label="@L["SubscriptionDescription"]"
                                          InputType="InputType.Text"
                                          Required="true" 
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                        </MudItem>

                        <MudDivider Style="border-top:1px solid #505254; margin:50px 0px;" />

                        <MudItem sm="6">
                            <MudNumericField @bind-Value="@(BoundNumberOfCustomers=maximumNumberOfCustomers?UnlimitedMaximumNumber:BoundNumberOfCustomers)"
                                          For="@(() => subscription.NumberOfCustomers)"
                                          Immediate="true"
                                           Variant="Variant.Text"
                                           Min="0" 
                                           HideSpinButtons="true"
                                           class="@(CultureInfo.CurrentCulture.Name=="ar" ? "custom-numeric-field" : "")"                                           Placeholder="@L["Type Here"]"
                                           Label="@L["NumberOfCustomersSub"]"
                                           Disabled="maximumNumberOfCustomers"
                                           Required="maximumNumberOfCustomers"
                                           RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                        </MudItem>
                        <MudItem sm="6">
                            <MudSwitch Label="@L["UnlimitedCustomersSub"]"
                                       LabelPosition="LabelPosition.Start"
                                       @bind-Value="maximumNumberOfCustomers"
                                       Color="MudBlazor.Color.Primary" />
                        </MudItem>
                  
                    <MudItem sm="6">
                            <MudNumericField @bind-Value="@(BoundNumberOfCameras=maximumNumberOfCameras?UnlimitedMaximumNumber:BoundNumberOfCameras)"
                                      For="@(() => subscription.NumberOfCameras)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Placeholder=@L["Type Here"]
                                      Label="@L["NumberOfCameras"]"
                                      Min="0" 
                                      HideSpinButtons="true"
                                      class="@(CultureInfo.CurrentCulture.Name=="ar" ? "custom-numeric-field" : "")"                                       Disabled="maximumNumberOfCameras"
                                      Required="maximumNumberOfCameras"
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>
                        <MudItem sm="6">
                            <MudSwitch Label="@L["UnlimitedCameras"]"
                                       LabelPosition="LabelPosition.Start"
                                       @bind-Value="maximumNumberOfCameras"
                                       Color="MudBlazor.Color.Primary" />

                        </MudItem>
                    <MudItem sm="6">
                            <MudNumericField @bind-Value="@(BoundNumberOfGarages=maximumNumberOfGarages?UnlimitedMaximumNumber:BoundNumberOfGarages)"
                                             For="@(() => BoundNumberOfGarages)"
                                             Immediate="true"
                                             Variant="Variant.Text"
                                             Placeholder=@L["Type Here"]
                                             Label="@L["NumbersOfGarages"]"
                                             Min="0" 
                                             HideSpinButtons="true"
                                             class="@(CultureInfo.CurrentCulture.Name=="ar" ? "custom-numeric-field" : "")"                                           Disabled="maximumNumberOfGarages"
                                             Required="maximumNumberOfGarages"
                                             RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>
                        <MudItem sm="6">
                            <MudSwitch Label="@L["UnlimitedGarages"]"
                                       LabelPosition="LabelPosition.Start"
                                       @bind-Value="maximumNumberOfGarages"
                                       Color="MudBlazor.Color.Primary" />
                        </MudItem>
                 


                        <MudItem sm="6">
                            <MudNumericField @bind-Value="@(BoundNumberOfUsers=maximumNumberOfUsers?UnlimitedMaximumNumber:BoundNumberOfUsers)"
                                          For="@(() => BoundNumberOfUsers)"
                                          Immediate="true"
                                          Variant="Variant.Text"
                                          Placeholder=@L["Type Here"]
                                          Label="@L["NumbersOfUsers"]"
                                          Min="0" 
                                          HideSpinButtons="true"
                                          class="@(CultureInfo.CurrentCulture.Name=="ar" ? "custom-numeric-field" : "")"                                           Disabled="maximumNumberOfUsers"
                                          Required="maximumNumberOfUsers"
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                        </MudItem>
                        <MudItem sm="6">
                            <MudSwitch Label="@L["UnlimitedUsers"]"
                                       LabelPosition="LabelPosition.Start"
                                       @bind-Value="maximumNumberOfUsers"
                                       Color="MudBlazor.Color.Primary" />
                        </MudItem>
                   
                        @if(subscription.Status == SubscriptionStatus.Active)
                        {
                            <MudItem sm="6">
                                <MudDatePicker Variant="Variant.Text"
                                               Class="w-100"
                                               @bind-Date="ActivationDate"
                                               Disabled
                                               Label="@L["ActivationDate"]" />
                            </MudItem>
                        }
                        @if(subscription.Status == SubscriptionStatus.Inactive)
                        {
                            <MudItem sm="6">
                                <MudDatePicker Variant="Variant.Text"
                                               Class="w-100"
                                               @bind-Date="InActivationDate"
                                               Disabled
                                               Label="@L["InActivationDate"]" />
                            </MudItem>
                        }

                      
                    <MudItem sm="12" Class="d-inline-flex justify-content-center">
                        <MudItem Class="d-flex flex-row justify-content-between">
                            <MudRadioGroup T="SubscriptionStatus" ValueChanged="@((SubscriptionStatus newStatus) => OnStatusChanged(newStatus))" Value="subscription.Status" Class="d-inline-flex align-content-center">
                                <MudRadio Value="@(SubscriptionStatus.Active)" Color="MudBlazor.Color.Primary">@L["Status Active"]</MudRadio>
                                <MudRadio Value="@(SubscriptionStatus.Inactive)" Color="MudBlazor.Color.Secondary">@L["Status InActive"]</MudRadio>
                            </MudRadioGroup>
                        </MudItem>
                    </MudItem>

				</MudGrid>
			</MudForm>



		</DialogContent>

        <DialogActions>
    <DialogActionComponent 
        ButtonOneLabel="@L["Back"]" 
        ButtonOneClick="Cancel" 
        ButtonOneVariant="MudBlazor.Variant.Filled"
        ButtonOneColor="MudBlazor.Color.Dark"
        ButtonTwoColor="MudBlazor.Color.Primary"
        ButtonTwoLabel="@L["Save"]" 
        ButtonTwoClick="Save" 
        ButtonTwoVariant="MudBlazor.Variant.Filled"
    />
</DialogActions>

	</MudDialog>

</MudItem>
</div>

<style>
	.mud-modal
	{
		border-radius: 0 20px 0 20px;
	}
</style>