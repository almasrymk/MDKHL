@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Localization
@using SmartParking.Lookups.CameraBrands
@using SmartParking.Lookups.CameraMainType
@using System.Globalization
@using System.Security.Authentication
@using Volo.Abp
@using Volo.Abp.Validation
@inject IDialogService DialogService
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
<div class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Edit"]</MudText>
        </TitleContent>
        <DialogContent>

            <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                <MudGrid>



                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="cameraMainType.ArabicName"
                                      For="@(() => cameraMainType.ArabicName)"
                                      Immediate="true"
                                      Required="true"
                                      Placeholder="@L["Type Here"]"
                                      Label="@L["ArabicName"]" 
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>

                    <MudItem sm="4">
                        <MudTextField @bind-Value="cameraMainType.EnglishName"
                                      For="@(() => cameraMainType.EnglishName)"
                                      Immediate="true"
                                      Required="true"
                                      Placeholder="@L["Type Here"]"
                                      Label="@L["EnglishName"]"
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>
                    <MudItem sm="6">
                        <MudSelect @bind-Value="@cameraMainType.CameraBrandId"
                                   Variant="Variant.Text"
                                   Label="@L["BrandName"]"
                                   HelperText=@L["Helper Text"]
                                   Placeholder=@L["Choose"]
                                   Required="true"
                                   RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                                   Clearable="_clearable">
                            @foreach (var vehicleBrand in CameraBrands)
                            {
                                @if (CultureInfo.CurrentCulture.Name == "en")
                                {
                                    <MudSelectItem Value="vehicleBrand.Id">@vehicleBrand.EnglishName</MudSelectItem>
                                }
                                else
                                {
                                    <MudSelectItem Value="vehicleBrand.Id">@vehicleBrand.ArabicName</MudSelectItem>
                                }

                            }
                        </MudSelect>
                    </MudItem>

                </MudGrid>
            </MudForm>

        </DialogContent>
        					<DialogActions>
    <DialogActionComponent 
        ButtonOneColor="MudBlazor.Color.Dark"
        ButtonTwoColor="MudBlazor.Color.Primary"
        ButtonOneLabel="@L["Back"]"
        ButtonTwoLabel="@L["Save"]"
        ButtonOneClick="Cancel"
        ButtonTwoClick="Submit"
        ButtonOneVariant="MudBlazor.Variant.Filled"
        ButtonTwoVariant="MudBlazor.Variant.Filled"
    />
</DialogActions>


    </MudDialog>

</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>

@code {
    [Inject] ISnackbar Snackbar { get; set; }
    [Inject] ICameraMainTypeAppService CameraMainTypesAppService { get; set; }
    [Inject] ICameraBrandAppService CameraBrandAppService { get; set; }

    private MudForm form;
    [Parameter]
    public CreateUpdateCameraMainTypeDto cameraMainType { get; set; } = new CreateUpdateCameraMainTypeDto();
    [Parameter]
    public int Id { get; set; }
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }
    bool _clearable;
    IList<CameraBrandDto> CameraBrands = new List<CameraBrandDto>();

    protected override async Task OnInitializedAsync()
    {
        CameraBrands = await CameraBrandAppService.GetAllCameraBrandsAsync();
        await base.OnInitializedAsync();
    }
    private async Task Submit()
    {
       
        try
        {
            await CameraMainTypesAppService.UpdateAsync(Id, cameraMainType);
            SnackBar.ShowSnackbar(Snackbar, $"{cameraMainType.ArabicName} {L[AlertMessages.AlertMessages.UPDATE]} {L[AlertMessages.AlertMessages.SUCCESS]}", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
            Navigation.NavigateTo("/Cameramaintypes", true);
        }
        catch (AbpValidationException validationException)
        {
            foreach (var validationError in validationException.ValidationErrors)
            {
                SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.VAlIDATION_ERROR]}: {L[validationError.MemberNames.First()]} - {validationError.ErrorMessage}", Severity.Error);
            }
        }
        catch (BusinessException ex)
        {

            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]} {L[AlertMessages.AlertMessages.UPDATE]} : {ex.Code}", Severity.Error);
        }
        catch (AuthenticationException ex)
        {
            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]} {L[AlertMessages.AlertMessages.UPDATE]} : {ex.Message} ", Severity.Error);
        }
        catch (Exception ex)
        {

            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]} {L[AlertMessages.AlertMessages.UPDATE]} : {ex.Message} ", Severity.Error);
        }



    }
    private void Cancel()
    {
        MudDialog.Cancel();
    }
}