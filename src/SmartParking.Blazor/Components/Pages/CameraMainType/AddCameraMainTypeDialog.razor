@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Localization
@using SmartParking.Lookups.CameraBrands
@using System.Globalization
@using SmartParking.Lookups.CameraMainType
@using System.Security.Authentication
@using Volo.Abp
@using Volo.Abp.Validation
@inject IDialogService DialogService
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ICameraMainTypeAppService CameraMainTypesAppService
@inject ICameraBrandAppService CameraBrandAppService
<div class="modal-wrapper">
    <MudDialog class="mud-modal" Style="min-width:fit-content !important">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Add NEW"]</MudText>
        </TitleContent>
        <DialogContent>
            <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                <MudGrid>
                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="cameraMainType.ArabicName"
                        For="@(() => cameraMainType.ArabicName)"
                        Immediate="true"
                        Required="true"
                        Placeholder="@L["Type Here"]"
                        Label="@L["ArabicName"]"
                        RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>

                    <MudItem sm="4">
                        <MudTextField @bind-Value="cameraMainType.EnglishName"
                        For="@(() => cameraMainType.EnglishName)"
                        Immediate="true"
                        Required="true"
                        Placeholder="@L["Type Here"]"
                        Label="@L["EnglishName"]"
                        RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>
                    <MudItem sm="6">
                        <MudSelect @bind-Value="@cameraMainType.CameraBrandId"
                        Variant="Variant.Text"
                        Label="@L["BrandName"]"
                        HelperText=@L["Helper Text"]
                        Placeholder=@L["Choose"]
                        Required="true"
                        RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                        Clearable="_clearable">
                            <MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
                            @foreach (var vehicleBrand in CameraBrands)
                            {
                                @if (CultureInfo.CurrentCulture.Name == "en")
                                {
                                    <MudSelectItem Value="vehicleBrand.Id">@vehicleBrand.EnglishName</MudSelectItem>
                                }
                                else
                                {
                                    <MudSelectItem Value="vehicleBrand.Id">@vehicleBrand.ArabicName</MudSelectItem>
                                }

                            }
                        </MudSelect>
                    </MudItem>

                </MudGrid>
            </MudForm>

        </DialogContent>
                           <DialogActions> 
    <DialogActionComponent 
        ButtonOneColor="MudBlazor.Color.Dark" 
        ButtonTwoColor="MudBlazor.Color.Primary" 
        ButtonOneLabel="@L["Back"]" 
        ButtonTwoLabel="@L["Create"]" 
        ButtonOneClick="Cancel" 
        ButtonTwoClick="Submit" 
        ButtonOneVariant="MudBlazor.Variant.Filled" 
        ButtonTwoVariant="MudBlazor.Variant.Filled" 
    /> 
</DialogActions>



    </MudDialog>

</div>

<style>
    .mud-modal {
    border-radius: 0 20px 0 20px;
    }
</style>
