@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.Governorate
@using Volo.Abp.Application.Dtos
@inject ICountriesAppService CountriesAppService
@inject IStringLocalizer<SmartParkingResource> L
<PageTitle>@L["CountriesDetails"]</PageTitle>

<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
				<MudText Typo="Typo.h6">@L["CountryDetails"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" >
				<MudGrid>
					<MudItem sm="6">
						<MudTextField @bind-Value="country.ArabicName"
									  For="@(() => country.ArabicName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["Arabic Name"]"
									  Disabled/>
					</MudItem>

					<MudItem sm="6">
						<MudTextField @bind-Value="country.EnglishName"
									  For="@(() => country.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["English Name"]"
									  Disabled />
					</MudItem>
					<MudItem sm="6">
						<MudTextField @bind-Value="country.ArabicCapital"
									  For="@(() => country.ArabicCapital)"
									  Immediate="true"
									  Disabled
									  Label="@L["Arabic Capital"]" />
					</MudItem>
					<MudItem sm="6">
						<MudTextField @bind-Value="country.EnglishCapital"
									  For="@(() => country.EnglishCapital)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["English Capital"]"
									  Disabled />
					</MudItem>

				</MudGrid>
			</MudForm>



		</DialogContent>

		<DialogActions>
				<MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
		</DialogActions>
	</MudDialog>

</MudItem>



@code {



	[CascadingParameter] MudDialogInstance MudDialog { get; set; }
	[Parameter] public CountryDto country { get; set; } = new CountryDto();


	private void Cancel()
	{
		MudDialog.Cancel();
	}
}

<style>
	.mud-modal 
	{
		border-radius: 0 20px 0 20px;
	}
</style>

