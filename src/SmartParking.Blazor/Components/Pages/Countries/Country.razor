@page "/countries"
@using Customs
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups
@using Volo.Abp.Application.Dtos
@inherits AbpCrudPageBase<ICountriesAppService, CountryDto, int, PagedAndSortedResultRequestDto, CreateUpdateCountryDto>
@inject IDialogService DialogService
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
<PageTitle>@L["Countries"]</PageTitle>


<h3>@L["Countries"]</h3>

<SPDataGrid PageName="Countries" Data="@itemData" TotalItemsInTable="TotalItem" OnFiltering="HandleFilter" OnClickRowEdit="OnClickRowEdit" OnClickRowView="OnClickRowView" OnPageChanged="FetchTableData" OnSearching="HandleSearch" OnAdd="CreateCountry" OnClickRowDelete="OnClickRowDelete" />
