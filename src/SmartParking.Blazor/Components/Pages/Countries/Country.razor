@page "/countries"
@using AutoMapper
@using Customs
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups
@using Volo.Abp.Application.Dtos
@inherits AbpCrudPageBase<ICountriesAppService, CountryDto, int, PagedAndSortedResultRequestDto, CreateUpdateCountryDto>
@inject IDialogService DialogService
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IMapper  Mapper
@attribute [Authorize(Roles = "Mdkhl , admin")]
<PageTitle>@L["Countries"]</PageTitle>


<MudText Typo="Typo.h5" Class="mb-2">@L["Countries"]</MudText>

<SPDataGrid PageName=@L["Countries"] Data="@itemData" TotalItemsInTable="TotalItem" OnFiltering="HandleFilter" OnClickRowEdit="OnClickRowEdit" OnClickRowView="OnClickRowView" OnPageChanged="FetchTableData" OnSearching="HandleSearch" OnAdd="CreateCountry" OnClickRowDelete="OnClickRowDelete" />
