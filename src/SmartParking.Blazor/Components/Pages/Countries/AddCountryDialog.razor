@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.Governorate
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@inject ICountriesAppService CountriesAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
<PageTitle>@L["AddCountries"]</PageTitle>

<MudItem class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
                <MudText Typo="Typo.h6">@L["NewCountry"]</MudText>
        </TitleContent>
        <DialogContent>
            <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                <MudGrid>
                    <MudItem sm="6" >
                        <MudTextField @bind-Value="input.ArabicName"
                                      For="@(() => input.ArabicName)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="@L["Arabic Name"]"
                                      InputType="InputType.Text"
                                      Placeholder="@L["EnterYourArabicName"]" />
                    </MudItem>

                    <MudItem sm="6" >
                        <MudTextField @bind-Value="input.EnglishName"
                                      For="@(() => input.EnglishName)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="@L["English Name"]"
                                      InputType="InputType.Text"
                                      Placeholder="@L["EnterYourEnglishName"]" />
                    </MudItem>
                    <MudItem sm="6" >
                        <MudTextField @bind-Value="input.ArabicCapital"
                                      For="@(() => input.ArabicCapital)"
                                      Immediate="true"
                                      Label="@L["Arabic Capital"]" 
                                      InputType="InputType.Text" 
                                      Placeholder="@L["EnterYourArabicCapital"]" />
                    </MudItem>
                    <MudItem sm="6" >
                        <MudTextField @bind-Value="input.EnglishCapital"
                                      For="@(() => input.EnglishCapital)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="@L["English Capital"]"
                                      InputType="InputType.Text" 
                                      Placeholder="@L["EnterYourEnglishCapital"]" />
                    </MudItem>
                    <MudItem sm="6" >
                        <MudTextField @bind-Value="input.Notes"
                                      For="@(() => input.Notes)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="@L["Notes"]"
                                      InputType="InputType.Text" 
                                      Placeholder="@L["EnterYourNotes"]" />
                    </MudItem>
                  
                </MudGrid>
            </MudForm>

        </DialogContent>

        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Submit">@L["Create"]</MudButton>
        </DialogActions>
    </MudDialog>

</MudItem>

<style>
    .mud-modal 
    {
        border-radius: 0 20px 0 20px;
    }
</style>
