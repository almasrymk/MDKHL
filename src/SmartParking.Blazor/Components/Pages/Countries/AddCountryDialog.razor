@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@using SmartParking.Blazor.Components.Shared
@inject ICountriesAppService CountriesAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
<PageTitle>@L["AddCountries"]</PageTitle>

<MudItem class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
                <MudText Typo="Typo.h6">@L["Add NEW"]</MudText>
        </TitleContent>
        <DialogContent>
            <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                <MudGrid>
                    <MudItem sm="6" >
                        <MudTextField @bind-Value="createUpdateCountryDto.ArabicName"
                                      For="@(() => createUpdateCountryDto.ArabicName)"
                                      Immediate="true"
                                      Required
                                      Variant="Variant.Text"
                                      Label="@L["ArabicName"]"
                                      InputType="InputType.Text"
                                      Placeholder="@L["Type Here"]" 
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>

                    <MudItem sm="6" >
                        <MudTextField @bind-Value="createUpdateCountryDto.EnglishName"
                                      For="@(() => createUpdateCountryDto.EnglishName)"
                                      Immediate="true"
                                      Required
                                      Variant="Variant.Text"
                                      Label="@L["EnglishName"]"
                                      InputType="InputType.Text"
                                      Placeholder="@L["Type Here"]" 
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>
                    <MudItem sm="6" >
                        <MudTextField @bind-Value="createUpdateCountryDto.ArabicCapital"
                                      For="@(() => createUpdateCountryDto.ArabicCapital)"
                                      Immediate="true"
                                      Required
                                      Label="@L["Arabic Capital"]" 
                                      InputType="InputType.Text" 
                                      Placeholder="@L["Type Here"]" 
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>
                    <MudItem sm="6" >
                        <MudTextField @bind-Value="createUpdateCountryDto.EnglishCapital"
                                      For="@(() => createUpdateCountryDto.EnglishCapital)"
                                      Immediate="true"
                                      Required
                                      Variant="Variant.Text"
                                      Label="@L["English Capital"]"
                                      InputType="InputType.Text" 
                                      Placeholder="@L["Type Here"]" 
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>
                
                  
                </MudGrid>
            </MudForm>

        </DialogContent>

       <DialogActions>
    <DialogActionComponent 
        ButtonOneColor="MudBlazor.Color.Dark"
        ButtonTwoColor="MudBlazor.Color.Primary"
        ButtonOneLabel="@L["Back"]"
        ButtonTwoLabel="@L["Create"]"
        ButtonOneClick="Cancel"
        ButtonTwoClick="Submit"
        ButtonOneVariant="MudBlazor.Variant.Filled"
        ButtonTwoVariant="MudBlazor.Variant.Filled" />
</DialogActions>

    </MudDialog>

</MudItem>

<style>
    .mud-modal 
    {
        border-radius: 0 20px 0 20px;
    }
</style>
