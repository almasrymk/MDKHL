@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.Governorate
@using Volo.Abp.Application.Dtos
@inject ICountriesAppService CountriesAppService
@inject IStringLocalizer<SmartParkingResource> L
<PageTitle>@L["EditCountries"]</PageTitle>

<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
				<MudText Typo="Typo.h6">@L["UpdateCountry"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="editForm">
				<MudGrid>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="country.ArabicName"
									  For="@(() => country.ArabicName)"
									  Immediate="true"
									  Variant="Variant.Text"
								      Label="@L["Arabic Name"]" />
					</MudItem>

					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="country.EnglishName"
									  For="@(() => country.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									 Label="@L["English Name"]" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="country.ArabicCapital"
									  For="@(() => country.ArabicCapital)"
									  Immediate="true"
									  Label="@L["Arabic Capital"]" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="country.EnglishCapital"
									  For="@(() => country.EnglishCapital)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["English Capital"]" />
					</MudItem>

				</MudGrid>
			</MudForm>



		</DialogContent>

		<DialogActions>
			<MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
			<MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Save">@L["Edit"]</MudButton>
		</DialogActions>
	</MudDialog>

</MudItem>

@code {



	[CascadingParameter] MudDialogInstance MudDialog { get; set; }
	[Parameter] public CountryDto country { get; set; } = new CountryDto();
	private MudForm editForm;
	bool _clearable;

	

	private async Task Save()
	{
		await editForm.Validate();
		if (editForm.IsValid)
		{

			// Create the input object for update
			var input = new CreateUpdateCountryDto
			{
					ArabicName = country.ArabicName,
					EnglishName = country.EnglishName,
					ArabicCapital = country.ArabicCapital,
					EnglishCapital = country.EnglishCapital,
					Notes = country.Notes,
			};

			// Call the update method
			await CountriesAppService.UpdateAsync(country.Id, input);

			// Close the dialog with a success result
			MudDialog.Close(DialogResult.Ok(true));
		}
	}


	private void Cancel()
	{
		MudDialog.Cancel();
	}
}



<style>
	.mud-modal 
	{
		border-radius: 0 20px 0 20px;
	}
</style>

