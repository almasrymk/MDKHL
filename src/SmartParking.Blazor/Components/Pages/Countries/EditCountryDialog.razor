@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups
@using System.Globalization
@using SmartParking.Blazor.Components.Shared
@using Volo.Abp.Application.Dtos
@inject ICountriesAppService CountriesAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
<PageTitle>@L["EditCountries"]</PageTitle>

<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
			<TitleContent>
				<MudText Typo="Typo.h6">@L["Edit"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="editForm">
				<MudGrid>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="country.ArabicName"
									  For="@(() => country.ArabicName)"
									  Immediate="true"
									  Variant="Variant.Text"
								      Label="@L["ArabicName"]" 
									  Required
									  RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
					</MudItem>

					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="country.EnglishName"
									  For="@(() => country.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									 Label="@L["EnglishName"]" 
									 Required
									  RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="country.ArabicCapital"
									  For="@(() => country.ArabicCapital)"
									  Immediate="true"
									  Label="@L["Arabic Capital"]" 
									  Required
									  RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="country.EnglishCapital"
									  For="@(() => country.EnglishCapital)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["English Capital"]" 
									  Required
									  RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
					</MudItem>

				</MudGrid>
			</MudForm>



		</DialogContent>

		<DialogActions>
    <DialogActionComponent 
        ButtonOneColor="MudBlazor.Color.Dark"
        ButtonTwoColor="MudBlazor.Color.Primary"
        ButtonOneLabel="@L["Back"]"
        ButtonTwoLabel="@L["Save"]"
        ButtonOneClick="Cancel"
        ButtonTwoClick="Save"
        ButtonOneVariant="MudBlazor.Variant.Filled"
        ButtonTwoVariant="MudBlazor.Variant.Filled" />
</DialogActions>

	</MudDialog>

</MudItem>

<style>
	.mud-modal 
	{
		border-radius: 0 20px 0 20px;
	}
</style>

