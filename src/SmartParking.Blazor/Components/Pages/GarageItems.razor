@page "/garage-items"
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@inject IStringLocalizer<SmartParkingResource> L


<MudGrid>
    <MudItem xs="12" sm="6" md="4" lg="2">
        <MudPaper Class="d-flex justify-content-center align-items-center p-4">
            <MudImage Src="images/garages/garages.png" />
        </MudPaper>
        <div class="d-flex align-items-center mt-2 justify-content-between ps-2">
            <MudText Class="fw-bold" Typo="Typo.h6">
                @L["Garages"]
            </MudText>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
        </div>
    </MudItem>
    <MudItem xs="12" sm="6" md="4" lg="2">
        <MudPaper Class="d-flex justify-content-center align-items-center p-4">
            <MudImage Src="images/garages/cameras.png" />
        </MudPaper>
        <div class="d-flex align-items-center mt-2 justify-content-between ps-2">
            <MudText Class="fw-bold" Typo="Typo.h6">
                @L["Cameras"]
            </MudText>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
        </div>
    </MudItem>
    <MudItem xs="12" sm="6" md="4" lg="2">
        <MudPaper Class="d-flex justify-content-center align-items-center p-4">
            <MudImage Src="images/garages/packages.png" />
        </MudPaper>
        <div class="d-flex align-items-center mt-2 justify-content-between ps-2">
            <MudText Class="fw-bold" Typo="Typo.h6">
                @L["Packages"]
            </MudText>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
        </div>
    </MudItem>
</MudGrid>

@code {

}
