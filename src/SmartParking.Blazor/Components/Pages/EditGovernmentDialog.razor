@using SmartParking.Lookups
@using SmartParking.Lookups.Governorate
@using Volo.Abp.Application.Dtos
@inject IGovernorateAppService GovernorateAppService

<MudDialog Visible="_editGovernmentDialogVisible" Style="background-color:aquamarine;">
    <TitleContent>
        <MudText Typo="Typo.h6">New Government</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm Model="@editingModel" @ref="@_editForm" ValidationDelay="0">
            <MudCardContent>
                <MudTextField @bind-Value="editingModel.ArabicName"
                              For="@(() => editingModel.ArabicName)"
                              Immediate="true"
                              Label="ArabicName" 
                              />
                              
                <MudTextField @bind-Value="editingModel.EnglishName"
                              For="@(() => editingModel.EnglishName)"
                              Immediate="true"
                              Label="EnglishName" />

                <MudTextField @bind-Value="editingModel.ArabicCapital"
                              For="@(() => editingModel.ArabicCapital)"
                              Immediate="true"
                              Label="ArabicCapital" />

                <MudTextField @bind-Value="editingModel.EnglishCapital"
                              For="@(() => editingModel.EnglishCapital)"
                              Immediate="true"
                              Label="EnglishCapital" />

                <MudTextField @bind-Value="editingModel.Notes"
                              For="@(() => editingModel.Notes)"
                              Immediate="true"
                              Label="Notes" />


                 <MudSelect @bind-Value="@editingModel" Label="Country" Placeholder="Please Select">

                @foreach (var country in countries)
                {
                <MudSelectItem Value="@country.Id">
                @country.Name
                </MudSelectItem>
                }
                </MudSelect>

                

            </MudCardContent>

        </MudForm>
    </DialogContent>
     <DialogActions>
        <MudButton OnClick="CloseEditGovernmnetModal">Cancel</MudButton>
    <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="UpdateGovernmentAsync">Edit</MudButton>
    </DialogActions> 
</MudDialog>

@code
{
    public CreateUpdateGovernorateDto editingModel = new CreateUpdateGovernorateDto();
    public IReadOnlyList<GovernorateDto> items = Array.Empty<GovernorateDto>();
    public IReadOnlyList<CountryLookupDto> countries = Array.Empty<CountryLookupDto>();

    private MudForm _editForm;

    private bool _editGovernmentDialogVisible;

    private void CloseEditGovernmnetModal()
    {
        _editGovernmentDialogVisible = false;
    }

    private int editingGovernmentId { get; set; }

    
    private async Task UpdateGovernmentAsync()
    {
        var input = new PagedAndSortedResultRequestDto();

        if (_editForm.IsValid)
        {
            await GovernorateAppService.UpdateAsync(editingGovernmentId,editingModel);
            _editGovernmentDialogVisible = false;
            items = (await GovernorateAppService.GetListAsync(input)).Items;
        }
    }

    private async Task GetCountryLookupAsync()
    {
        countries = (await GovernorateAppService.GetCountryLookupAsync()).Items;

    }
   

}

