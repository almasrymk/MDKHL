<SPDataGrid PageName="vehicleBrands" Data="@itemData" TotalItemsInTable="TotalItem" OnFiltering="HandleFilter" OnClickRowEdit="OnClickRowEdit" OnClickRowView="OnClickRowView" OnPageChanged="FetchTableData" OnSearching="HandleSearch" OnAdd="@(() => CreateVehicleBrand(_backdropClick))" OnClickRowDelete="OnClickRowDelete"></SPDataGrid>






