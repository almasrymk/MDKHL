@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups.PlateColor
@using SmartParking.Lookups.VehicleBrand
@inject IVehicleBrandsAppService VehicleBrandsAppService
@inject IDialogService Dialog
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@page "/vehicleBrands"

<PageTitle>@L["VehicleBrands"]</PageTitle>
<MudText Typo="Typo.h5" Class="mb-2">@L["VehicleBrands"]</MudText>

<SPDataGrid PageName=@L["VehicleBrands"] Data="@itemData" TotalItemsInTable="TotalItem" OnFiltering="HandleFilter" OnClickRowEdit="OnClickRowEdit" OnClickRowView="OnClickRowView" OnPageChanged="FetchTableData" OnSearching="HandleSearch" OnAdd="@(() => CreateVehicleBrand(_backdropClick))" OnClickRowDelete="OnClickRowDelete"></SPDataGrid>






