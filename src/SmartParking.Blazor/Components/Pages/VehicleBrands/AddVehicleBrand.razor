@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Localization
@using SmartParking.Lookups.VehicleBrand
@using System.Security.Authentication
@using Volo.Abp
@using Volo.Abp.Validation
@inject IDialogService DialogService
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@inject ISnackbar Snackbar 
@inject IVehicleBrandsAppService VehicleBrandsAppService 
<div class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Add NEW"]</MudText>
        </TitleContent>
        <DialogContent>
           
                    <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                        <MudGrid>



                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="vehicleBrandDro.ArabicName"
                                              For="@(() => vehicleBrandDro.ArabicName)"
                                              Immediate="true"
                                              Required="true"
                                      Placeholder="@L["Type Here"]"
                                              Label="@L["ArabicName"]"
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                            </MudItem>

                            <MudItem sm="4">
                                <MudTextField @bind-Value="vehicleBrandDro.EnglishName"
                                              For="@(() => vehicleBrandDro.EnglishName)"
                                              Immediate="true"
                                              Required="true"
                                      Placeholder="@L["Type Here"]"
                                      Label="@L["EnglishName"]" 
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                            </MudItem>


                        </MudGrid>
                    </MudForm>
           
        </DialogContent>
                <DialogActions> 
    <DialogActionComponent 
        ButtonOneColor="MudBlazor.Color.Dark" 
        ButtonTwoColor="MudBlazor.Color.Primary" 
        ButtonOneLabel="@L["Back"]" 
        ButtonTwoLabel="@L["Create"]" 
        ButtonOneClick="Cancel" 
        ButtonTwoClick="Submit" 
        ButtonOneVariant="MudBlazor.Variant.Filled" 
        ButtonTwoVariant="MudBlazor.Variant.Filled" 
    /> 
</DialogActions>


    </MudDialog>

</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>