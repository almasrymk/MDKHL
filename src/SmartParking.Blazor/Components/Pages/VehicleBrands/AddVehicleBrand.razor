@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Localization
@using SmartParking.Lookups.VehicleBrand
@using System.Security.Authentication
@using Volo.Abp
@using Volo.Abp.Validation
@inject IDialogService DialogService
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
<div class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Add NEW"]</MudText>
        </TitleContent>
        <DialogContent>
           
                    <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                        <MudGrid>



                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="vehicleBrandDro.ArabicName"
                                              For="@(() => vehicleBrandDro.ArabicName)"
                                              Immediate="true"
                                              Required="true"
                                      Placeholder="@L["Type Here"]"
                                              Label="@L["ArabicName"]"
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                            </MudItem>

                            <MudItem sm="4">
                                <MudTextField @bind-Value="vehicleBrandDro.EnglishName"
                                              For="@(() => vehicleBrandDro.EnglishName)"
                                              Immediate="true"
                                              Required="true"
                                      Placeholder="@L["Type Here"]"
                                      Label="@L["EnglishName"]" 
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                            </MudItem>


                        </MudGrid>
                    </MudForm>
           
        </DialogContent>
                <DialogActions> 
    <DialogActionComponent 
        ButtonOneColor="MudBlazor.Color.Dark" 
        ButtonTwoColor="MudBlazor.Color.Primary" 
        ButtonOneLabel="@L["Back"]" 
        ButtonTwoLabel="@L["Create"]" 
        ButtonOneClick="Cancel" 
        ButtonTwoClick="Submit" 
        ButtonOneVariant="MudBlazor.Variant.Filled" 
        ButtonTwoVariant="MudBlazor.Variant.Filled" 
    /> 
</DialogActions>


    </MudDialog>

</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>

@code {
    [Inject] ISnackbar Snackbar { get; set; }
    [Inject] IVehicleBrandsAppService VehicleBrandsAppService { get; set; } // Assuming you have a service to handle the camera creation

    private MudForm form;
    private CreateUpdateVehicleBrandDto vehicleBrandDro = new CreateUpdateVehicleBrandDto();
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }
    bool _clearable;

    protected override async Task OnInitializedAsync()
    {

        await base.OnInitializedAsync();
    }
    private async Task Submit()
    {
       
            try
            {
                await VehicleBrandsAppService.CreateAsync(vehicleBrandDro);
            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.SUCCESS]} {L[AlertMessages.AlertMessages.ADD]} {vehicleBrandDro.ArabicName}", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                Navigation.NavigateTo("/vehicleBrands", true);
            }
      
        catch (AbpValidationException validationException)
        {
            foreach (var validationError in validationException.ValidationErrors)
            {
                SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.VAlIDATION_ERROR]}: {L[validationError.MemberNames.First()]} - {validationError.ErrorMessage}", Severity.Error);
            }
        }
        catch (BusinessException ex)
        {

            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]} {L[AlertMessages.AlertMessages.ADD]} : {ex.Code}", Severity.Error);
        }
        catch (AuthenticationException ex)
        {
            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]} {L[AlertMessages.AlertMessages.ADD]} : {ex.Message} ", Severity.Error);
        }
        catch (Exception ex)
        {

            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]} {L[AlertMessages.AlertMessages.ADD]} : {ex.Message} ", Severity.Error);
        }


      
    }
    private void Cancel()
    {
        MudDialog.Cancel();
    }
}