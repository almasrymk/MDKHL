@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups.VehicleBrand
@inject IDialogService DialogService
@inject IStringLocalizer<SmartParkingResource> L

<div class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["New Camera"]</MudText>
        </TitleContent>
        <DialogContent>
           
                    <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                        <MudGrid>



                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="vehicleBrandDro.ArabicName"
                                              For="@(() => vehicleBrandDro.ArabicName)"
                                              Immediate="true"
                                              Required="true"
                                              Label="@L["ArabicName"]" />
                            </MudItem>

                            <MudItem sm="4">
                                <MudTextField @bind-Value="vehicleBrandDro.EnglishName"
                                              For="@(() => vehicleBrandDro.EnglishName)"
                                              Immediate="true"
                                              Required="true"
                                              Label="@L["EnglishName"]" />
                            </MudItem>


                        </MudGrid>
                    </MudForm>
           
        </DialogContent>
        <DialogActions>
                        <div class="overflow-hidden px-5 w-100">

            <MudGrid >

                <MudItem sm="6" md="6">

                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="Submit">@L["Create"]</MudButton>
                </MudItem>
                <MudItem sm="6" md="6">

                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Tertiary" OnClick="Cancel">@L["Cancel"]</MudButton>
                </MudItem>
            </MudGrid>
            </div>

        </DialogActions>

    </MudDialog>

</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>

@code {
    [Inject] ISnackbar Snackbar { get; set; }
    [Inject] IVehicleBrandsAppService VehicleBrandsAppService { get; set; } // Assuming you have a service to handle the camera creation

    private MudForm form;
    private CreateUpdateVehicleBrandDto vehicleBrandDro = new CreateUpdateVehicleBrandDto();
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }
    bool _clearable;

    protected override async Task OnInitializedAsync()
    {

        await base.OnInitializedAsync();
    }
    private async Task Submit()
    {
        if (form.IsValid)
        {
            // Call your service to create the camera
            try
            {
                await VehicleBrandsAppService.CreateAsync(vehicleBrandDro);
            }
            catch (Exception e)
            {
                Snackbar.Add("Fill Requried Items", Severity.Error);
                return;
            }
            Snackbar.Add("VehicleBrand created successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));

        }
        else
        {
            Snackbar.Add("Fill Requried Items", Severity.Error);
        }
    }
    private void Cancel()
    {
        MudDialog.Cancel();
    }
}