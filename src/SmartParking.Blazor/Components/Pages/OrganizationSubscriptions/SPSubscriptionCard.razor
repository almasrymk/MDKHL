@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Subscriptions
@using Volo.Abp.Application.Dtos
@inject ISubscriptionAppService SubscriptionsAppService
@inject IStringLocalizer<SmartParkingResource> L


    @foreach (var subscription in subscriptions.Items)
    {
    if (subscription.Status != Enums.SubscriptionStatus.Active)
        continue;
    <MudItem sm="12" md="6" lg="3">
                <MudText Color="MudBlazor.Color.Primary" Class="fw-bold" Align="Align.Center" Typo="Typo.h6">@subscription.EnglishName</MudText>
                <div class="subscription-card">
                    <div class="d-flex flex-column gap-1 text-white align-items-center subscription-circle">
                        <div class="price">
                            <MudText>@L["SAR"]</MudText>
                            <MudText Class="fw-bold" Typo="Typo.h5">@subscription.SubscriptionPrice</MudText>
                            <MudText>@subscription.SubscriptionType</MudText>
                        </div>

                    </div>
                    <ul class="d-flex flex-column gap-2">
                        <li class="d-flex align-items-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.CheckBox" Color="MudBlazor.Color.Primary" Title=@L["Favorite"] />
                            <MudText>@subscription.NumberOfOrganizations @L["Organizations"]</MudText>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.CheckBox" Color="MudBlazor.Color.Primary" Title=@L["Favorite"] />
                            <MudText>@subscription.NumbersOfGarages @L["Garages"]</MudText>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.CheckBox" Color="MudBlazor.Color.Primary" Title=@L["Favorite"] />
                            <MudText>@subscription.NumberOfUsers @L["Customers"]</MudText>
                        </li>
                    </ul>
                    <MudButton Variant="Variant.Filled" FullWidth="true" class="mx-3 mt-5" Color="MudBlazor.Color.Primary">@L["Checkout"]</MudButton>
                </div>
        </MudItem>
    }





