@using SmartParking.Lookups
@using SmartParking.Lookups.Governorate
@using Volo.Abp.Application.Dtos
@inject IGovernorateAppService GovernorateAppService
<div class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">Update Government</MudText>
		</TitleContent>
		<DialogContent>



			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="editForm">
				<MudGrid>
					


					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="governorate.ArabicName"
									  For="@(() => governorate.ArabicName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="ArabicName" />
					</MudItem>

					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="governorate.EnglishName"
									  For="@(() => governorate.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="EnglishName" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="governorate.ArabicCapital"
									  For="@(() => governorate.ArabicCapital)"
									  Immediate="true"
									  Disabled=true
									  Label="ArabicCapital" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="governorate.EnglishCapital"
									  For="@(() => governorate.EnglishCapital)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="EnglishCapital" />
					</MudItem>
					
						<MudItem sm="6">
							<MudSelect @bind-Value="@governorate.CountryId"
									   Variant="Variant.Text"
									   Label="Country"
									   Placeholder="Please Select"
									   Clearable="_clearable"
									   AnchorOrigin="Origin.TopCenter"
									   TransformOrigin="Origin.TopCenter">

								@foreach (var country in countries)
								{
									<MudSelectItem Value="country.Id">@country.EnglishName</MudSelectItem>
								}
							</MudSelect>
						</MudItem>
				</MudGrid>
			</MudForm>



		</DialogContent>

		<DialogActions>
			<MudButton OnClick="Cancel">Cancel</MudButton>
			<MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Save">Edit</MudButton>
		</DialogActions>
	</MudDialog>

</div>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>

@code {
	[CascadingParameter] MudDialogInstance MudDialog { get; set; }
	[Parameter] public GovernorateDto governorate { get; set; } = new GovernorateDto();
	public IReadOnlyList<CountryLookupDto> countries { get; set; } = new List<CountryLookupDto>();
	private MudForm editForm;
	bool _clearable;

	protected override async Task OnInitializedAsync()
	{
		var result = await GovernorateAppService.GetCountryLookupAsync(new PagedAndSortedResultRequestDto
			{
				MaxResultCount = 100,
				SkipCount = (1 - 1) * 100
			});
		countries = result.Items.ToList();
	}

	private async Task Save()
	{
		await editForm.Validate();
		if (editForm.IsValid)
		{

			// Create the input object for update
			var input = new CreateUpdateGovernorateDto
				{
					ArabicName = governorate.ArabicName,
					EnglishName = governorate.EnglishName,
					ArabicCapital = governorate.ArabicCapital,
					EnglishCapital = governorate.EnglishCapital,
					Notes = governorate.Notes,
					CountryId = governorate.CountryId,
					

				};

			// Call the update method
			await GovernorateAppService.UpdateAsync(governorate.Id, input);

			// Close the dialog with a success result
			MudDialog.Close(DialogResult.Ok(true));
		}
	}


	private void Cancel()
	{
		MudDialog.Cancel();
	}
}



