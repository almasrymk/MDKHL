@using SmartParking.Lookups
@using SmartParking.Lookups.Governorate
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@inject IGovernorateAppService GovernorateAppService
@inject ISnackbar Snackbar


<div class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">New Government</MudText>
        </TitleContent>
        <DialogContent>
           
                
                    <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                        <MudGrid>
                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="input.ArabicName"
                                      For="@(() => input.ArabicName)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="ArabicName" />
                    </MudItem>

                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="input.EnglishName"
                                      For="@(() => input.EnglishName)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="EnglishName" />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="input.ArabicCapital"
                                      For="@(() => input.ArabicCapital)"
                                      Immediate="true"
                                      Label="ArabicCapital" />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="input.EnglishCapital"
                                      For="@(() => input.EnglishCapital)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="EnglishCapital" />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="input.Notes"
                                      For="@(() => input.Notes)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="Notes" />
                    </MudItem>
                    <MudItem sm="6">
                        <MudSelect @bind-Value="@input.CountryId"
                                   Variant="Variant.Text"
                                   Label="Country"
                                   Placeholder="Please Select"
                                   Clearable="_clearable"
                                   AnchorOrigin="Origin.TopCenter" 
                                   TransformOrigin="Origin.TopCenter">
                            @foreach (var country in countries)
                            {
                                <MudSelectItem Value="country.Id">@country.EnglishName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                        </MudGrid>
                    </MudForm>
                   
        </DialogContent>

        <DialogActions>
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Submit">Create</MudButton>
        </DialogActions>
    </MudDialog>

</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>

@code {

    private MudForm form;
    public CreateUpdateGovernorateDto input = new CreateUpdateGovernorateDto();
    public IReadOnlyList<CountryLookupDto> countries = new List<CountryLookupDto>();

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }
    bool _clearable;

    protected override async Task OnInitializedAsync()
    {
        var result = await GovernorateAppService.GetCountryLookupAsync();
        countries = result;
    }
    private async Task Submit()
    {
        if (form.IsValid)
        {
            // Call your service to create the camera
            try
            {
                await GovernorateAppService.CreateAsync(input);
            }
            catch (UserFriendlyException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
                return;
            }
            Snackbar.Add("Governorate created successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));

        }
        else
        {
            Snackbar.Add("Please fix the validation errors.", Severity.Error);
        }
    }
    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
