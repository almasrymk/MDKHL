@page "/goverments"
@using Customs
@using SmartParking.Lookups
@using Volo.Abp.Application.Dtos
@inherits AbpCrudPageBase<IGovernorateAppService, GovernorateDto, int, PagedAndSortedResultRequestDto, CreateUpdateGovernorateDto>
@inject IDialogService Dialog



<MudItem>
    <MudDataGrid Elevation="0" Class="bg-transparent custom-data-grid" T="GovernorateDto" MultiSelection="true" Items="governorates" SortMode="SortMode.Multiple" Filterable="true">
        <ToolBarContent>
           
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="@(() => OpenCreateGovernmentDialog(_backdropClick))">
                
                CREATE NEW
                <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Size="MudBlazor.Size.Small" Class="ms-1" />
            </MudButton>
        </ToolBarContent>
        <Columns>
            <SelectColumn T="GovernorateDto" />
            <PropertyColumn Property="x => x.ArabicName" Title="Government Arabic Name"  />
            <PropertyColumn Property="x => x.EnglishName" Title="Government English Name" />
            <PropertyColumn Property="x => x.CountryArabicName" Title="Country Arabic Name"  />
            <PropertyColumn Property="x => x.CountryEnglishName" Title="Country English Name"  />
            <TemplateColumn Title="Actions">
                <CellTemplate>
                  
                        <MudButton Variant="Variant.Text" Color="MudBlazor.Color.Primary" OnClick="@(() => OpenEditGovernmentDialog(context.Item))">
                            <MudIcon Icon="@Icons.Material.Filled.Edit" />
                            Edit
                        </MudButton>
                    
                </CellTemplate>
            </TemplateColumn>

        </Columns>
        <PagerContent>
            <MudDataGridPager T="GovernorateDto" />
        </PagerContent>
    </MudDataGrid>
</MudItem>

