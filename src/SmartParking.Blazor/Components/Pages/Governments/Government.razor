@page "/goverments"
@using Customs
@using SmartParking.Lookups
@using Volo.Abp.Application.Dtos
@inherits AbpCrudPageBase<IGovernorateAppService, GovernorateDto, int, PagedAndSortedResultRequestDto, CreateUpdateGovernorateDto>
@inject IDialogService DialogService;


<MudItem>
    <MudDataGrid Elevation="0" Class="bg-transparent custom-data-grid" T="GovernorateDto" MultiSelection="true" Items="items" SortMode="SortMode.Multiple" Filterable="true" >
        <ToolBarContent>
           @*  <MudTextField Elevation="2" @bind-Value="_searchString" Placeholder="Search For Organizations" Adornment="Adornment.End" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="MudBlazor.Size.Medium" Class="mt-0 data-grid-search"></MudTextField>
            <MudSpacer /> *@
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="@(() => OpenCreateGovernmentModal(_backdropClick))">
                
                CREATE NEW
                <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Size="MudBlazor.Size.Small" Class="ms-1" />
            </MudButton>
        </ToolBarContent>
        <Columns>
            <SelectColumn T="GovernorateDto" />
            <PropertyColumn Property="x => x.ArabicName" Title="Government Arabic Name"  />
            <PropertyColumn Property="x => x.EnglishName" />
            <PropertyColumn Property="x => x.CountryArabicName" Title="Country Arabic Name"  />
            <PropertyColumn Property="x => x.CountryEnglishName" Title="Country English Name"  />
          <TemplateColumn Title="Actions">
            
                    <MudButton Color="MudBlazor.Color.Secondary" Variant="Variant.Text" OnClick="@(() => OpenEditGovernmentModal(_backdropClick))">
                Edit
            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="MudBlazor.Size.Small" />
            </MudButton>
        
        </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="GovernorateDto" />
        </PagerContent>
    </MudDataGrid>
</MudItem>

