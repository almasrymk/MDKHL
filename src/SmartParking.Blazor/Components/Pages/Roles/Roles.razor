@page "/roles"
@using Microsoft.Extensions.Localization
@using SmartParking.Authentication
@using SmartParking.Blazor.Components.Pages.User
@using SmartParking.Localization
@using SmartParking.Organizations
@using SmartParking.Permissions.IdentityPermissions
@using Volo.Abp.Identity
@using Volo.Abp.MultiTenancy
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ICurrentTenant currrentTenant
@inject IOrganizationsAppService OrganizationsAppService
@inject IRoleAppService RoleAppService
@inherits AbpCrudPageBase<IIdentityRoleAppService, IdentityRoleDto, Guid, GetIdentityRolesInput, IdentityRoleCreateDto, IdentityRoleUpdateDto>




<PageTitle>@L["Roles"]</PageTitle>
<MudText Typo="Typo.h5" Class="mb-2">@L["Roles"]</MudText>

<SPDataGrid PageName=@L["Roles"] Data="@itemData"  
            ShowView="AuthorizationService.IsGrantedAsync(CustomIdentityPermissions.Roles.ViewPermissions).Result"
            OnClickRowView="HandleView"ShowButton="AuthorizationService.IsGrantedAsync(IdentityPermissions.Roles.ManagePermissions).Result"
            ShowDelete ="AuthorizationService.IsGrantedAsync(IdentityPermissions.Roles.Delete).Result"
            ShowAdd="AuthorizationService.IsGrantedAsync(IdentityPermissions.Roles.Create).Result" 
            ShowEdit="AuthorizationService.IsGrantedAsync(IdentityPermissions.Roles.Update).Result"
TotalItemsInTable="TotalItem" OnPageChanged="FetchTableData" OnSearching="HandleSearch" />

<ViewPermissionRoleModal @ref="ViewPermissionRolesManagementModal" />

