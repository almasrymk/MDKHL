@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups.CameraBrands
@using SmartParking.Lookups.CameraModel
@using System.Globalization
@inject IDialogService DialogService
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
<div class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["New CameraModel"]</MudText>
        </TitleContent>
        <DialogContent>

            <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                <MudGrid>



                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="cameraModel.ArabicName"
                                      For="@(() => cameraModel.ArabicName)"
                                      Immediate="true"
                                      Required="true"
                                      Placeholder="@L["Type Here"]"
                                      Label="@L["ArabicName"]" />
                    </MudItem>

                    <MudItem sm="4">
                        <MudTextField @bind-Value="cameraModel.EnglishName"
                                      For="@(() => cameraModel.EnglishName)"
                                      Immediate="true"
                                      Required="true"
                                      Placeholder="@L["Type Here"]"
                                      Label="@L["EnglishName"]" />
                    </MudItem>
                    <MudItem sm="6">
                        <MudSelect @bind-Value="@cameraModel.CameraBrandId"
                                   Variant="Variant.Text"
                                   Label="@L["CamerBrandName"]"
                                   HelperText=@L["Helper Text"]
                                   Placeholder=@L["Choose"]
                                   Required="true"
                                   Clearable="_clearable">
                            <MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
                            @foreach (var vehicleBrand in CameraBrands)
                            {
                                @if (CultureInfo.CurrentCulture.Name == "en")
                                {
                                    <MudSelectItem Value="vehicleBrand.Id">@vehicleBrand.EnglishName</MudSelectItem>
                                }
                                else
                                {
                                    <MudSelectItem Value="vehicleBrand.Id">@vehicleBrand.ArabicName</MudSelectItem>
                                }

                            }
                        </MudSelect>
                    </MudItem>

                </MudGrid>
            </MudForm>

        </DialogContent>
        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" Disabled="@(form == null || !form.IsValid)" OnClick="Submit">@L["Create"]</MudButton>
        </DialogActions>


    </MudDialog>

</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>

@code {
    [Inject] ISnackbar Snackbar { get; set; }
    [Inject] ICameraModelAppService CameraModelsAppService { get; set; } 
    [Inject] ICameraBrandAppService CameraBrandAppService { get; set; } 

    private MudForm form;
    private CreateUpdateCameraModelDto cameraModel = new CreateUpdateCameraModelDto();
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }
    bool _clearable;
    IList<CameraBrandDto> CameraBrands = new List<CameraBrandDto>();

    protected override async Task OnInitializedAsync()
    {
        CameraBrands = await CameraBrandAppService.GetAllCameraBrandsAsync();
        await base.OnInitializedAsync();
    }
    private async Task Submit()
    {
        var successedMessage = L["CameraModelCreatedSuccessfully"];
        var errorMessage = L["FillRequriedItems"];
        var validationErrorMessage = L["PleaseFixTheValidationErrors"];
        if (form.IsValid)
        {
            // Call your service to create the camera
            try
            {
                await CameraModelsAppService.CreateAsync(cameraModel);
                Snackbar.Add(successedMessage, Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                Navigation.NavigateTo("/Cameramodels", true);
            }
            catch (Exception e)
            {
                Snackbar.Add(errorMessage, Severity.Error);
                return;
            }


        }
        else
        {
            Snackbar.Add(errorMessage, Severity.Error);
        }
    }
    private void Cancel()
    {
        MudDialog.Cancel();
    }
}