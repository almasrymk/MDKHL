@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Localization
@using SmartParking.Lookups.CameraBrands
@using SmartParking.Lookups.CameraModel
@using System.Globalization
@inject IDialogService DialogService
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
<div class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Edit CameraModel"]</MudText>
        </TitleContent>
        <DialogContent>

            <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                <MudGrid>



                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="cameraModel.ArabicName"
                                      For="@(() => cameraModel.ArabicName)"
                                      Immediate="true"
                                      Required="true"
                                      Placeholder="@L["Type Here"]"
                                      Label="@L["ArabicName"]" 
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>

                    <MudItem sm="4">
                        <MudTextField @bind-Value="cameraModel.EnglishName"
                                      For="@(() => cameraModel.EnglishName)"
                                      Immediate="true"
                                      Required="true"
                                      Placeholder="@L["Type Here"]"
                                      Label="@L["EnglishName"]" 
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>
                    <MudItem sm="6">
                        <MudSelect @bind-Value="@cameraModel.CameraBrandId"
                                   Variant="Variant.Text"
                                   Label="@L["BrandName"]"
                                   HelperText=@L["Helper Text"]
                                   Placeholder=@L["Choose"]
                                   Required="true"
                                   RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                                   Clearable="_clearable">
                            @foreach (var vehicleBrand in CameraBrands)
                            {
                                @if (CultureInfo.CurrentCulture.Name == "en")
                                {
                                    <MudSelectItem Value="vehicleBrand.Id">@vehicleBrand.EnglishName</MudSelectItem>
                                }
                                else
                                {
                                    <MudSelectItem Value="vehicleBrand.Id">@vehicleBrand.ArabicName</MudSelectItem>
                                }

                            }
                        </MudSelect>
                    </MudItem>

                </MudGrid>
            </MudForm>

        </DialogContent>
        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Submit">@L["Create"]</MudButton>
        </DialogActions>


    </MudDialog>

</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>

@code {
    [Inject] ISnackbar Snackbar { get; set; }
    [Inject] ICameraModelAppService CameraModelsAppService { get; set; }
    [Inject] ICameraBrandAppService CameraBrandAppService { get; set; }

    private MudForm form;
    [Parameter]
    public CreateUpdateCameraModelDto cameraModel { get; set; } = new CreateUpdateCameraModelDto();
    [Parameter]
    public int Id { get; set; }
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }
    bool _clearable;
    IList<CameraBrandDto> CameraBrands = new List<CameraBrandDto>();

    protected override async Task OnInitializedAsync()
    {
        CameraBrands = await CameraBrandAppService.GetAllCameraBrandsAsync();
        await base.OnInitializedAsync();
    }
    private async Task Submit()
    {
       
        try
        {
            await CameraModelsAppService.UpdateAsync(Id,cameraModel);
            SnackBar.ShowSnackbar(Snackbar, $"{cameraModel.ArabicName} {L[AlertMessages.AlertMessages.UPDATE]} {L[AlertMessages.AlertMessages.SUCCESS]}", Severity.Success);
            await Task.Delay(1000);
            MudDialog.Close(DialogResult.Ok(true));
            Navigation.NavigateTo("/Cameramodels", true);
        }
        
        catch (Exception ex)
        {

            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.DELETE]} {L[AlertMessages.AlertMessages.FAILED]}: {ex.Message} ", Severity.Error);
        }


       
    }
    private void Cancel()
    {
        MudDialog.Cancel();
    }
}