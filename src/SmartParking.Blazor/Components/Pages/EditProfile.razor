@page "/edit-profile"
@layout Shared.ProfileLayout
<PageTitle>Edit Profile</PageTitle>
<div class="w-100">
    <MudPaper Class="p-5 d-flex flex-column align-items-center justify-content-center w-100 main-layout-paper" Style="background-color: #F2F2F2;">
        <MudForm Class="d-flex flex-column gap-4">
            <div class="d-flex flex-column align-items-center px-5 position-relative pb-6">
                <MudImage Src="images/profile-avatar.png" />
                <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles" Class="position-absolute bottom-0">
                    <ActivatorContent>
                        <MudFab Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.CameraAlt" Size="MudBlazor.Size.Medium" Class="rounded-circle" />
                    </ActivatorContent>
                </MudFileUpload>
            </div>

            <MudTextField T="string" Placeholder="Type your Email or Phone Number here" Label="Name" />
            <MudTextField T="string" Placeholder="Type your Email or Phone Number here" Label="Email" />
            <MudTextField T="string" Placeholder="Type your Email or Phone Number here" Label="Phone" />
            <div class="d-flex align-items-center gap-3 mt-4">
                <MudButton Color="MudBlazor.Color.Dark" Variant="Variant.Filled" Href="/change-password">CHANGE PASSWORD</MudButton>
                <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled">SAVE CHANGES</MudButton>
            </div>
        </MudForm>
    </MudPaper>
</div>
@code {
    IList<IBrowserFile> _files = new List<IBrowserFile>();
    private void UploadFiles(IBrowserFile file)
    {
        _files.Add(file);
        //TODO upload the files to the server
    }
}
