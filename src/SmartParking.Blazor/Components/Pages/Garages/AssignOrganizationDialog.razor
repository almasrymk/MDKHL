@using Microsoft.Extensions.Localization
@using SmartParking.Garages
@using SmartParking.Localization
@using SmartParking.Organizations
@using SmartParking.OrganizationsGarages
@using Volo.Abp.Application.Dtos
@inject IOrganizationsAppService OrganizationsAppService
@inject IGarageAppService GaragesAppService

@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar

<div class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["Assign Organization"]</MudText>
		</TitleContent>
		<DialogContent>



			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>
					<MudItem sm="12" md="12">
						<MudSelect @bind-Value="@Garage.OrganizationId"
								   Variant="Variant.Text"
								   Label="@L["Organization Name"]"
								   Placeholder="Choose"
								   Clearable="_clearable"
								   FullWidth="true">
							@foreach (var org in Organizations)
							{
								<MudSelectItem Value="org.Id">@org.EnglishName</MudSelectItem>
							}
						</MudSelect>
					</MudItem>




				</MudGrid>
			</MudForm>



		</DialogContent>
		<DialogActions>
			<div class="overflow-hidden px-5 w-100">


				<MudGrid>
					<MudItem sm="6" md="6">

						<MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="SubmitEdit">@L["Assign"]</MudButton>
					</MudItem>
					<MudItem sm="6" md="6">

						<MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Tertiary" OnClick="CancelEdit">@L["Cancel"]</MudButton>
					</MudItem>
				</MudGrid>
			</div>

		</DialogActions>

	</MudDialog>

</div>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>

@code {
	[CascadingParameter]
	private MudDialogInstance MudDialogAdd { get; set; }
	[Parameter] public CreateUpdateGarageDto Garage { get; set; }
	[Parameter]
	public int UpdatedId { get; set; }
	public List<OrganizationDto> Organizations { get; set; } = new List<OrganizationDto>();
	bool _clearable;
	private MudForm form;

	protected override async Task OnInitializedAsync()
	{
		var result = await OrganizationsAppService.GetListAsync(new PagedAndSortedResultRequestDto
			{
				MaxResultCount = 100,
				SkipCount = (1 - 1) * 100
			});
		Organizations = result.Items.ToList();
		await base.OnInitializedAsync();
	}

	private async Task SubmitEdit()
	{
		try
		{

			//await GarageAppService.UpdateAsync(UpdatedId, Garage);
			await GaragesAppService.UpdateAsync(UpdatedId, Garage);
			Snackbar.Add("Garage assigned to organization Successfully", Severity.Success);
			MudDialogAdd.Close(DialogResult.Ok(true));

		}
		catch (Exception e)
		{
			Snackbar.Add(e.Message, Severity.Error);
		}
	}

	private async Task CancelEdit()
	{
		MudDialogAdd.Cancel();


	}


}
