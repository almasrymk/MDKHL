@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Garages
@using SmartParking.Localization
@using SmartParking.Organizations
@using SmartParking.OrganizationsGarages
@using System.Globalization
@using Volo.Abp.Application.Dtos
@inject IOrganizationsAppService OrganizationsAppService
@inject IGarageAppService GaragesAppService
@inject NavigationManager Navigation
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar

<PageTitle>@L["Assign"] @L["To"] @L["Organization"]</PageTitle>

<div class="modal-wrapper">
	<MudDialog class="mud-modal" Style="min-width:fit-content !important">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["Assign"] @L["To"] @L["Organization"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>
					<MudItem sm="12" md="12">
						<MudSelect @bind-Value="@Garage.OrganizationId"
								   Variant="Variant.Text"
								   Label="@L["OrganizationName"]"
								   Placeholder=@L["Choose"]
								   HelperText=@L["Helper Text"]
								   Clearable="_clearable"
								   FullWidth="true">
							@foreach (var org in Organizations)
							{
								if (org.Status != Enums.Status.Active)
									continue;
								if (CultureInfo.CurrentCulture.Name == "en")
								{
									<MudSelectItem T="int" Value="@org.Id">

										@org.EnglishName
									</MudSelectItem>
								}
								else
								{

									<MudSelectItem T="int" Value="@org.Id">

										@org.ArabicName
									</MudSelectItem>
								}
							}
						</MudSelect>
					</MudItem>
				</MudGrid>
			</MudForm>
		</DialogContent>
		<DialogActions>
    <DialogActionComponent 
        ButtonOneColor="MudBlazor.Color.Dark"
        ButtonOneLabel="@L["Back"]" 
        ButtonOneClick="CancelEdit" 
        ButtonOneVariant="MudBlazor.Variant.Filled"
        ButtonTwoColor="MudBlazor.Color.Primary"
        ButtonTwoLabel="@L["Assign"]" 
        ButtonTwoClick="SubmitEdit" 
        ButtonTwoVariant="MudBlazor.Variant.Filled"
    />
</DialogActions>
	</MudDialog>

</div>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>
