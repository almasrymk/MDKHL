@page "/garages"
@using Customs
@using SmartParking.Garages
@using FluentValidation
@using Enums
@using SmartParking.Organizations
@inject IDialogService DialogService
@inject IGarageAppService GarageAppService
@inject IOrganizationsAppService OrganizationAppService
@inject ISnackbar Snackbar


<h3>Garages</h3>

<div>
    <MudDataGrid Elevation="0" Class="bg-transparent custom-data-grid" T="GarageDto" MultiSelection="true" Items="@Garages" SortMode="SortMode.Multiple" Filterable="true"
                 Hideable="true" >
        <ToolBarContent>
            <MudTextField Elevation="2" Placeholder="Search For Organizations" Adornment="Adornment.End" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="MudBlazor.Size.Medium" Class="mt-0 data-grid-search"></MudTextField>
            <MudSpacer />
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="CreateGarage">
                CREATE NEW
                <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Size="MudBlazor.Size.Small" Class="ms-1" />
            </MudButton>
        </ToolBarContent>
        <Columns>
            <SelectColumn T="GarageDto" />
            <PropertyColumn Property="x => x.Code" Title="Garage Code" Sortable="false" Filterable="false" />
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <PropertyColumn Property="x => x.MaxCapacity" Title="Max Capacity" />
            <PropertyColumn Property="x => x.ClosingHours" Title="Closing Hours" />
            <PropertyColumn Property="x => x.Status" Title="Status" />
            <TemplateColumn Title="Actions">
                <CellTemplate >

                    <MudMenu Icon="@Icons.Material.Filled.Settings">
                        <MudMenuItem OnClick="@(e => OnClickRowEdit(context.Item))">Edit</MudMenuItem>
                        <MudMenuItem OnClick="@(e => OnClickRowView(context.Item))">View Details</MudMenuItem>
                        <MudMenuItem>Delete</MudMenuItem>
                    </MudMenu>
                </CellTemplate>

            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="GarageDto" />
        </PagerContent>
    </MudDataGrid>
</div>

<div class="modal-wrapper">

    <MudDialog Class="mud-modal" Visible="updateModal">
        <TitleContent>
            <MudText Typo="Typo.h6">Update Garage for @createUpdateGarage.Name</MudText>
        </TitleContent>
       <DialogContent>
        <MudGrid>
            <MudItem Class="w-100">

                @*         <MudPaper Class="h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">

                *@
                <MudForm Model="createUpdateGarage" Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
                    <MudGrid>
                        <MudItem sm="6" md="6">
                            <MudTextField @bind-Value="createUpdateGarage.Name"
                                          For="@(() => createUpdateGarage.Name)"
                                          Variant="Variant.Text"
                                          Class="w-100"
                                          Label="Garage name"
                                           />
                        </MudItem>
                        <MudItem sm="6" md="6">
                            <MudTextField @bind-Value="createUpdateGarage.MaxCapacity"
                                          For="@(() => createUpdateGarage.MaxCapacity)"
                                          Variant="Variant.Text"
                                          Class="w-100"
                                          Immediate="true"
                                          Label="Garage Max Capacity"
                                           />
                        </MudItem>
                        <MudItem sm="6" md="6">
                            <MudTextField @bind-Value="createUpdateGarage.Code"
                                          For="@(() => createUpdateGarage.Code)"
                                          Variant="Variant.Text"
                                          Class="w-100"
                                          Label="Garage Code"
                                          Disabled  />
                        </MudItem>
                        <MudItem sm="6" md="6">
                                <MudTimePicker @bind-Time="_time"
                                               
                                               Variant="Variant.Text"
                                               Class="w-100"
                                               Label="Closing Hours" />
                        </MudItem>

                        <MudItem sm="6" md="6" >

                             <MudRadioGroup @bind-Value="@createUpdateGarage.Status" >
                                 <div Class="d-flex flex row justify-content-between">


                                    <MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">Active</MudRadio>
                                    <MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Secondary">InActive</MudRadio>
                                    <MudRadio Value="@(Enums.Status.Deleted)" Color="MudBlazor.Color.Warning">Deleted</MudRadio>
                                 </div>
                            </MudRadioGroup>
                         </MudItem>
                        @*         </MudPaper>

                        *@
                    </MudGrid>
                </MudForm>
            </MudItem>
      </MudGrid>
    </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Class="ml-auto" OnClick="@(async () => await SubmitEdit())">update</MudButton>
        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Tertiary" Class="ml-auto" OnClick="@(async () => await CancelEdit())">Cancel</MudButton>
    </DialogActions>
</MudDialog>
</div>

<div class="modal-wrapper">
    <MudDialog Class="mud-modal" Visible="viewModal">
        
        <TitleContent>
            <MudText Typo="Typo.h6">Details for Garage @View.Name</MudText>
        </TitleContent>
        <DialogContent >
            <MudGrid >
                <MudItem Class="w-100">

                    @*         <MudPaper Class="h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">

                    *@
                    <MudForm Model="View" Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
                        <MudGrid>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="View.Name"
                                              For="@(() => View.Name)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              ReadOnly="true"
                                              Label="Garage name" 
                                              Disabled 
                                              />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="View.MaxCapacity"
                                              For="@(() => View.MaxCapacity)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              Immediate="true"
                                              Label="Garage Max Capacity" 
                                              Disabled
                                              />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="View.Code"
                                              For="@(() => View.Code)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              Immediate="true"
                                              Label="Garage Code" 
                                              Disabled
                                              />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="View.ClosingHours"
                                              For="@(() => View.ClosingHours)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              Immediate="true"
                                              Label="Closing Hours" 
                                              Disabled
                                              />
                            </MudItem>
                            <MudItem sm="6" md="6" Class="d-flex justify-content-center align-items-center">
                                <MudTextField @bind-Value="View.Status"
                                              For="@(() => View.Status)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              Immediate="true"
                                              Label="Status" 
                                              Disabled
                                              />

                            </MudItem>


                          
                        </MudGrid>
                    </MudForm>

                    @*         </MudPaper>

                    *@
                </MudItem>
            </MudGrid>
        </DialogContent>

        <DialogActions>
            <MudButton OnClick="OnCloseViewOnly">Cancel</MudButton>
        </DialogActions>
    </MudDialog>



</div>


<div class="modal-wrapper">

<MudDialog Class="mud-modal" Visible="createModal">
        <TitleContent>
            <MudText Typo="Typo.h6">New Garage</MudText>
        </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem Class="w-100">

                @*         <MudPaper Class="h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">

                *@
                <MudForm Model="createUpdateGarage" Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
                    <MudGrid>
                        <MudItem sm="6" md="6">
                            <MudTextField @bind-Value="createUpdateGarage.Name"
                                          For="@(() => createUpdateGarage.Name)"
                                          Variant="Variant.Text"
                                          Class="w-100"
                                          Label="Garage name" />
                        </MudItem>
                        <MudItem sm="6" md="6">
                            <MudTextField @bind-Value="createUpdateGarage.MaxCapacity"
                                          For="@(() => createUpdateGarage.MaxCapacity)"
                                          Variant="Variant.Text"
                                          Class="w-100"
                                          Immediate="true"
                                          Label="Garage Max Capacity" />
                        </MudItem>
                        <MudItem sm="6" md="6">
                            <MudTextField @bind-Value="createUpdateGarage.Code"
                                          For="@(() => createUpdateGarage.Code)"
                                          Variant="Variant.Text"
                                          Class="w-100"
                                              Label="Will Be Automatically created"
                                          ReadOnly="true" />
                        </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTimePicker @bind-Time="_time"
                                               Variant="Variant.Text"
                                               Class="w-100"
                                               Label="Closing Hours" />
                            </MudItem>
                            <MudItem sm="12" md="12">
                                <MudSelect @bind-Value="@createUpdateGarage.OrganizationId" Label="Organization Id" Placeholder="Please Select">

                                    @foreach (var organization in Organizations)
                                    {
                                        <MudSelectItem T="int" Value="@organization.Id">
                                            @organization.EnglishName
                                        </MudSelectItem>
                                    }
                                </MudSelect>

                            </MudItem>


                        <MudItem sm="6" md="6" >
                                <div Class="d-flex flex row justify-content-between">

                                <MudRadioGroup @bind-Value="@createUpdateGarage.Status">
                                    <MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">Active</MudRadio>
                                    <MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Secondary">InActive</MudRadio>
                                    <MudRadio Value="@(Enums.Status.Deleted)" Color="MudBlazor.Color.Warning">Deleted</MudRadio>
                                </MudRadioGroup>
                            </div>
                        </MudItem>
                        @*         </MudPaper>

                        *@
                    </MudGrid>
                </MudForm>
            </MudItem>
        </MudGrid>
    </DialogContent>
        <DialogActions>
        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Class="ml-auto" OnClick="@(() =>  SubmitCreate())">Create</MudButton>
        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Tertiary" Class="ml-auto" OnClick="@( () => CancelCreate())">Cancel</MudButton>
    </DialogActions>
</MudDialog>
</div>



<style>

    .mud-modal 
    {
        border-radius: 0 20px 0 20px;
    }
</style>