@page "/garages"
@using Customs
@using Microsoft.Extensions.Localization
@using SmartParking.Garages
@using FluentValidation
@using Enums
@using SmartParking.Localization
@using SmartParking.Organizations
@using SmartParking.OrganizationsGarages
@using SmartParking.Permissions.GaragePermissions
@using Volo.Abp.Application.Dtos
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Users
@inject IDialogService DialogService
@inject IGarageAppService GarageAppService
@inject IOrganizationsAppService OrganizationAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@inject ICurrentUser currentUser
@inject ICurrentTenant currentTenant
@inherits AbpCrudPageBase<IGarageAppService, GarageDto, int, PagedAndSortedResultRequestDto, CreateUpdateGarageDto>
<PageTitle>@L["Garages"]</PageTitle>
<div class="d-flex flex-row justify-content-between">


<MudText Typo="Typo.h5" Class="mb-2">@L["Garages"]</MudText>
	<div Class="flex-column">
		<div class="@(showOrganizationView ? "visible" : "hidden")">
			<MudText>@L["Total Garage Can be added"] : @MaxiumumNumberOfGarageAllowedToBeAdded</MudText>
			<MudText>@L["ActiveGarages"] : @ActiveGarages</MudText>
		</div>
		<div class="@(showOrganizationView ? "hidden" : "visible")">
			<MudText>@L["SumOfParkingSlotsOfActiveGarage"] : @SumOfAllMaximumCapacityforActiveGarages</MudText>
			<MudText>@L["Active"] : @ActiveGarages</MudText>
		</div>
	</div>
</div>


<SPDataGrid PageName=@L["Garages"] Data="@itemData" Menus="@MenuDatas" ShowMenue="!CurrentTenant.Id.HasValue" ShowAssign="ViewAssign" ShowAdd="HasCreatePermission" ShowEdit="HasUpdatePermission" ShowDelete="HasDeletePermission" TotalItemsInTable="TotalItem" OnFiltering="HandleFilter" OnClickRowEdit="OnClickRowEdit" OnClickRowView="OnClickRowView" OnPageChanged="FetchTableData" OnSearching="FetchTableData" OnAdd="CreateGarage" OnClickRowDelete="OnClickRowDelete" OnClickAssign="AssignOrganization"></SPDataGrid>
<style>
	.visible {
		display: block;
	}

	.hidden {
		display: none;
	}
</style>