@page "/garages"
@using Customs
@using Microsoft.Extensions.Localization
@using SmartParking.Garages
@using FluentValidation
@using Enums
@using SmartParking.Localization
@using SmartParking.Organizations
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Users
@inject IDialogService DialogService
@inject IGarageAppService GarageAppService
@inject IOrganizationsAppService OrganizationAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@inject ICurrentUser currentUser
@inject ICurrentTenant currentTenant

<PageTitle>@L["Garages"]</PageTitle>

<div class="d-flex flex-row justify-content-between">


<MudText Typo="Typo.h5" Class="mb-2">@L["Garages"]</MudText>

	@if (currentUser.IsInRole(Enums.RolesType.Organization.ToString()) || currentUser.IsInRole(Enums.RolesType.OrganizationEmployee.ToString()) || currentTenant.Id != null)
	{
		
		<div class="flex-column">
			<MudText>@L["Total Garage Can be added"] : @MaxiumumNumberOfGarageAllowedToBeAdded </MudText>
			<MudText>@L["ActiveGarages"] : @ActiveGarages </MudText>
		</div>
	}
	else
	{
		<div class="flex-column">
			<MudText>@L["SumOfParkingSlotsOfActiveGarage"] : @SumOfAllMaximumCapacityforActiveGarages </MudText>
			<MudText>@L["Active"] : @ActiveGarages </MudText>
		</div>
	
	}
</div>


<SPDataGrid PageName=@L["Garages"] Data="@itemData" ShowAssign="ViewAssign" TotalItemsInTable="TotalItem" OnFiltering="HandleFilter" OnClickRowEdit="OnClickRowEdit" OnClickRowView="OnClickRowView" OnPageChanged="FetchTableData" OnSearching="HandleSearch" OnAdd="CreateGarage" OnClickRowDelete="OnClickRowDelete" OnClickAssign="AssignOrganization"></SPDataGrid>

