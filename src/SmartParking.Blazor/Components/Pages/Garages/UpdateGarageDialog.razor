
@using SmartParking.Garages
@inject ISnackbar Snackbar
@inject IGarageAppService GarageAppService
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using System.Globalization
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation

<PageTitle>@L["Update Garage"]</PageTitle>
<div class="modal-wrapper">

    <MudDialog Class="mud-modal" >
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Edit"]</MudText>
        </TitleContent>
        <DialogContent>
         
                    <MudForm Model="Garage" Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
                        <MudGrid>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="Garage.NameEn"
                                              For="@(() => Garage.NameEn)"
                                              Required
                                              Variant="Variant.Text"
                                              Placeholder="@L["Type Here"]"
                                              Class="w-100"
                                              Label="@L["GarageNameEn"]" />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="Garage.NameAr"
                                              For="@(() => Garage.NameAr)"
                                              Required
                                              Variant="Variant.Text"
                                              Placeholder="@L["Type Here"]"
                                              Class="w-100"
                                              Label="@L["GarageNameAr"]" />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudNumericField @bind-Value="Garage.MaxCapacity"
                                              For="@(() => Garage.MaxCapacity)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              Required
                                              Min="0"
                                              Max="9999"
                                              HideSpinButtons="true"
                                              Immediate="true"
                                              Placeholder="@L["Type Here"]" 
                                              Label="@L["Garage Max Capacity"]" />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="Garage.Code"
                                              For="@(() => Garage.Code)"
                                              Variant="Variant.Text"
                                              ReadOnly="true"
                                              Class="w-100"
                                              Placeholder="@L["Type Here"]"
                                              Label="@L["Garage Code"]"
                                               />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTimePicker @bind-Time="_time"
                                               Editable="true"
                                               Required
                                               AmPm="true"
                                               PickerVariant="PickerVariant.Dialog"
                                               TimeFormat="h:mm tt"
                                               Variant="Variant.Text"
                                               Class="w-100"
                                               Placeholder="@L["Type Here"]"
                                               Label="@L["Closing Hours"]" />
                            </MudItem>

                            <MudItem sm="6" md="6">

                                <MudRadioGroup @bind-Value="@Garage.Status" >
                                    <div Class="d-flex flex-row justify-content-between">


                                        <MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">@L["Status Active"]</MudRadio>
                                        <MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Secondary">@L["Status InActive"]</MudRadio>
                                    </div>
                                </MudRadioGroup>
                            </MudItem>
                            @*         </MudPaper>

                            *@
                        </MudGrid>
                    </MudForm>
              
        </DialogContent>
        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="CancelEdit">@L["Back"]</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="SubmitEdit">@L["Save"]</MudButton>
        </DialogActions>
    </MudDialog>
</div>

<style>

    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>