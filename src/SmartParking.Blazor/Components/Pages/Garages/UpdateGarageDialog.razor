
@using SmartParking.Garages
@inject ISnackbar Snackbar
@inject IGarageAppService GarageAppService
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@inject IStringLocalizer<SmartParkingResource> L

<div class="modal-wrapper">

    <MudDialog Class="mud-modal" >
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Update Garage for"] @Garage.Name</MudText>
        </TitleContent>
        <DialogContent>
            <MudGrid>
                <MudItem Class="w-100">

                    @*         <MudPaper Class="h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">

                    *@
                    <MudForm Model="Garage" Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
                        <MudGrid>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="Garage.Name"
                                              For="@(() => Garage.Name)"
                                              Variant="Variant.Text"
                                              Placeholder="@L["Type Here"]"
                                              Class="w-100"
                                              Label="@L["Garage Name"]" />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="Garage.MaxCapacity"
                                              For="@(() => Garage.MaxCapacity)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              Immediate="true"
                                              Placeholder="@L["Type Here"]" 
                                              Label="@L["Garage Max Capacity"]" />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="Garage.Code"
                                              For="@(() => Garage.Code)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              Placeholder="@L["Type Here"]"
                                              Label="@L["Garage Code"]"
                                              Disabled />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTimePicker @bind-Time="_time"
                                               Editable="true"
                                               Variant="Variant.Text"
                                               Class="w-100"
                                               Placeholder="@L["Type Here"]"
                                               Label="@L["Closing Hours"]" />
                            </MudItem>

                            <MudItem sm="6" md="6">

                                <MudRadioGroup @bind-Value="@Garage.Status" >
                                    <div Class="d-flex flex-row justify-content-between">


                                        <MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">@L["Status Active"]</MudRadio>
                                        <MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Secondary">@L["Status InActive"]</MudRadio>
                                        <MudRadio Value="@(Enums.Status.Deleted)" Color="MudBlazor.Color.Warning">@L["Status Deleted"]</MudRadio>
                                    </div>
                                </MudRadioGroup>
                            </MudItem>
                            @*         </MudPaper>

                            *@
                        </MudGrid>
                    </MudForm>
                </MudItem>
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <div class="overflow-hidden px-5 w-100">


            <MudGrid >
                <MudItem sm="6" md="6">

                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary"  OnClick="@(async () => await SubmitEdit())">@L["Update"]</MudButton>
                </MudItem>
                <MudItem sm="6" md="6">

                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Tertiary" OnClick="@(async () => await CancelEdit())">@L["Cancel"]</MudButton>
                </MudItem>
            </MudGrid>
            </div>

        </DialogActions>
    </MudDialog>
</div>

<style>

    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>