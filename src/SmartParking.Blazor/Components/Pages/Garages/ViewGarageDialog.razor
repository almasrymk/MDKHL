
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@inject IStringLocalizer<SmartParkingResource> L

<PageTitle>@L["Details for Garage"]</PageTitle>
<div class="modal-wrapper">
    <MudDialog Class="mud-modal">

        <TitleContent>
            <MudText Typo="Typo.h6">@L["Details for Garage"] @Garage.Name</MudText>
        </TitleContent>
        <DialogContent>
            <MudGrid>
                <MudItem Class="w-100">

                    @*         <MudPaper Class="h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">

                    *@
                    <MudForm Model="Garage" Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
                        <MudGrid>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="Garage.Name"
                                              For="@(() => Garage.Name)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              ReadOnly="true"
                                              Placeholder="@L["Type Here"]"
                                              Label="@L["Garage Name"]"
                                              Disabled />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="Garage.MaxCapacity"
                                              For="@(() => Garage.MaxCapacity)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              Immediate="true"
                                              Placeholder="@L["Type Here"]"
                                              Label="@L["Garage Max Capacity"]"
                                              Disabled />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="Garage.Code"
                                              For="@(() => Garage.Code)"
                                              Variant="Variant.Text"
                                              Placeholder="@L["Type Here"]"
                                              Class="w-100"
                                              Immediate="true"
                                              Label="@L["Garage Code"]"
                                              Disabled />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="Garage.ClosingHours"
                                              For="@(() => Garage.ClosingHours)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              Immediate="true"
                                              Placeholder="@L["Type Here"]"
                                              Label="@L["Closing Hours"]"
                                              Disabled />
                            </MudItem>
                            <MudItem sm="6" md="6" >
                                <MudTextField @bind-Value="Garage.Status"
                                              For="@(() => Garage.Status)"
                                              Variant="Variant.Text"
                                              Placeholder="@L["Type Here"]"
                                              Class="w-100"
                                              Immediate="true"
                                              Label="@L["Status"]"
                                              Disabled />

                            </MudItem>



                        </MudGrid>
                    </MudForm>

                    @*         </MudPaper>

                    *@
                </MudItem>
            </MudGrid>
        </DialogContent>


        <DialogActions>
                        <div class="overflow-hidden px-5 w-100">

            <MudGrid >
                  <MudItem sm="6" md="6" >

                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Tertiary" OnClick="OnCloseViewOnly">@L["Cancel"]</MudButton>
                  </MudItem>
              </MudGrid>
            </div>

        </DialogActions>
    </MudDialog>



</div>


<style>

    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>