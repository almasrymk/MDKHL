
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@inject IStringLocalizer<SmartParkingResource> L

<PageTitle>@L["Details for Garage"]</PageTitle>
<div class="modal-wrapper">
    <MudDialog Class="mud-modal">

        <TitleContent>
            <MudText Typo="Typo.h6">@L["Details for Garage"] @Garage.Name</MudText>
        </TitleContent>
        <DialogContent>
            
                    <MudForm Model="Garage" Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
                        <MudGrid>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="Garage.Name"
                                              For="@(() => Garage.Name)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              ReadOnly="true"
                                              Placeholder="@L["Type Here"]"
                                              Label="@L["Garage Name"]"
                                               />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="Garage.MaxCapacity"
                                              For="@(() => Garage.MaxCapacity)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              Immediate="true"
                                              Placeholder="@L["Type Here"]"
                                              Label="@L["Garage Max Capacity"]"
                                               />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="Garage.Code"
                                              For="@(() => Garage.Code)"
                                              Variant="Variant.Text"
                                              Placeholder="@L["Type Here"]"
                                              Class="w-100"
                                              Immediate="true"
                                              Label="@L["Garage Code"]"
                                               />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="Garage.ClosingHours"
                                              For="@(() => Garage.ClosingHours)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              Immediate="true"
                                              Placeholder="@L["Type Here"]"
                                              Label="@L["Closing Hours"]"
                                               />
                            </MudItem>
                            <MudItem sm="6" md="6" >
                                <MudTextField @bind-Value="Garage.Status"
                                              For="@(() => Garage.Status)"
                                              Variant="Variant.Text"
                                              Placeholder="@L["Type Here"]"
                                              Class="w-100"
                                              Immediate="true"
                                              Label="@L["Status"]"
                                               />

                            </MudItem>



                        </MudGrid>
                    </MudForm>

        </DialogContent>


        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="OnCloseViewOnly">@L["Back"]</MudButton>
        </DialogActions>
    </MudDialog>



</div>


<style>

    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>