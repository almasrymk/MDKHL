
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using System.Globalization
@inject IStringLocalizer<SmartParkingResource> L

<PageTitle>@L["Details for Garage"]</PageTitle>
<div class="modal-wrapper">
    <MudDialog Class="mud-modal">

        <TitleContent>
            <MudText Typo="Typo.h6">@L["Details for Garage"]</MudText>
        </TitleContent>
        <DialogContent>
            
                    <MudForm Model="Garage" Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
                        <MudGrid>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="Garage.NameEn"
                                              For="@(() => Garage.NameEn)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              ReadOnly="true"
                                              Placeholder="@L["Type Here"]"
                                              Label="@L["GarageNameEn"]"
                                               />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="Garage.NameAr"
                                              For="@(() => Garage.NameAr)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              ReadOnly="true"
                                              Placeholder="@L["Type Here"]"
                                              Label="@L["GarageNameAr"]"
                                               />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="Garage.MaxCapacity"
                                              For="@(() => Garage.MaxCapacity)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              Immediate="true"
                                              Placeholder="@L["Type Here"]"
                                              Label="@L["Garage Max Capacity"]"
                                               />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="Garage.Code"
                                              For="@(() => Garage.Code)"
                                              Variant="Variant.Text"
                                              Placeholder="@L["Type Here"]"
                                              Class="w-100"
                                              Immediate="true"
                                              Label="@L["Garage Code"]"
                                               />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="Garage.ClosingHours"
                                              For="@(() => Garage.ClosingHours)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              Immediate="true"
                                              Placeholder="@L["Type Here"]"
                                              Label="@L["Closing Hours"]"
                                               />
                            </MudItem>
                    <MudItem sm="6" md="6">
                        <Label>@L["Status"]</Label>
                        <Div Style=@($"background-color: {(Garage.Status.ToString()=="Active" ? "#b8efb0" : "#f20707")};border:none;color:{(Garage.Status.ToString()=="Active" ? "#2c5e45" : "#820707")};border-radius:0.4rem;height:2rem;display:flex;justify-content:center;align-items:center;")>
                            @if (Garage.Status.ToString() == "Active")
                            {
                                <MudText>@L["Active"]</MudText>
                            }
                            else if (Garage.Status.ToString() == "Inactive")
                            {
                                <MudText>
                                    @L["InActive"]
                                </MudText>
                            }
                            else
                            {

                                <MudText>
                                    @L["Deleted"]
                                </MudText>
                            }

                        </Div>

                    </MudItem>



                        </MudGrid>
                    </MudForm>

        </DialogContent>


        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="OnCloseViewOnly">@L["Back"]</MudButton>
        </DialogActions>
    </MudDialog>



</div>


<style>

    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>