
@using SmartParking.Garages
@using SmartParking.Organizations
@inject IOrganizationsAppService OrganizationAppService
@inject ISnackbar Snackbar
@inject IGarageAppService GarageAppService
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@inject IStringLocalizer<SmartParkingResource> L


<div class="modal-wrapper">

    <MudDialog Class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Add New Garage"]</MudText>
        </TitleContent>
        <DialogContent>
           
                    <MudForm Model="createUpdateGarage" Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
                        <MudGrid>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="createUpdateGarage.Name"
                                              For="@(() => createUpdateGarage.Name)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              Placeholder="@L["Type Here"]"
                                              Label="@L["Garage Name"]" />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="createUpdateGarage.MaxCapacity"
                                              For="@(() => createUpdateGarage.MaxCapacity)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              Immediate="true"
                                              Placeholder="@L["Type Here"]"
                                              Label="@L["Garage Max Capacity"]" />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="createUpdateGarage.Code"
                                              For="@(() => createUpdateGarage.Code)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              Placeholder="@L["Will Be Automatically Created"]"
                                              Label="@L["Garage Code"]"
                                              ReadOnly="true" />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTimePicker @bind-Time="_time"
                                               @bind-Value="_time"
                                               Variant="Variant.Text"
                                               Class="w-100"
                                               Placeholder="@L["Type Here"]"
                                               Label="@L["Closing Hours"]" />
                            </MudItem>
                            <MudItem sm="12" md="12">
                                <MudSelect @bind-Value="@createUpdateGarage.OrganizationId" Label="@L["OrganizationName"]" Placeholder="@L[ "Choose"]">

                                    @foreach (var organization in Organizations)
                                    {
                                        <MudSelectItem T="int" Value="@organization.Id">
                                            @organization.EnglishName
                                        </MudSelectItem>
                                    }
                                </MudSelect>

                            </MudItem>

                            <MudItem sm="6" md="6" Class="d-inline-flex justify-content-center">
                              <div Class="d-flex flex-row justify-content-between">


                                    <MudRadioGroup @bind-Value="@createUpdateGarage.Status" Class="d-inline-flex align-content-center">
                                        <div Class="d-flex flex-row justify-content-between">
                                            <MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">@L["Status Active"]</MudRadio>
                                            <MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Secondary">@L["Status InActive"]</MudRadio>
                                            <MudRadio Value="@(Enums.Status.Deleted)" Color="MudBlazor.Color.Warning">@L["Status Deleted"]</MudRadio>
                                        </div>
                                </MudRadioGroup>
                              </div>
                            </MudItem>

                            @*         </MudPaper>

                            *@
                        </MudGrid>
                    </MudForm>
              
        </DialogContent>
        <DialogActions >
                        <div class="overflow-hidden px-5 w-100">

            <MudGrid >

                <MudItem sm="6" md="6">

                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="@(() =>  SubmitCreate())">@L["Save"]</MudButton>
                </MudItem>
                <MudItem sm="6" md="6">

                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Tertiary" OnClick="@( () => CancelCreate())">@L["Cancel"]</MudButton>
                </MudItem>
            </MudGrid>
            </div>

        </DialogActions>
    </MudDialog>
</div>



<style>

    .mud-modal
    {
        border-radius: 0 20px 0 20px;
    }
</style>
