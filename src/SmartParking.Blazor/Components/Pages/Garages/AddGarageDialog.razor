
@using Abp.Application.Navigation
@using SmartParking.Garages
@using SmartParking.Organizations
@inject IOrganizationsAppService OrganizationAppService
@inject ISnackbar Snackbar
@inject IGarageAppService GarageAppService
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using System.Globalization
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Users
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager NavigationManager
@inject ICurrentUser currrentUser
@inject ICurrentTenant currrentTenant

<PageTitle>@L["Add New Garage"]</PageTitle>
<div class="modal-wrapper">

    <MudDialog Class="mud-modal" Style="min-width:fit-content !important">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Add New Garage"]</MudText>
        </TitleContent>
        <DialogContent>

            <MudForm Model="createUpdateGarage" Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                        <MudGrid>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="createUpdateGarage.NameEn"
                                              For="@(() => createUpdateGarage.NameEn)"
                                              Variant="Variant.Text"
                                              Required
                                              Class="w-100"
                                              Placeholder="@L["Type Here"]"
                                              Label="@L["EnGarageName"]" />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="createUpdateGarage.NameAr"
                                              For="@(() => createUpdateGarage.NameAr)"
                                              Variant="Variant.Text"
                                              Required
                                              Class="w-100"
                                              Placeholder="@L["Type Here"]"
                                              Label="@L["ArGarageName"]" />
                            </MudItem>
                    @if (currrentUser.IsInRole(Enums.RolesType.Mdkhl.ToString()) || currrentUser.IsInRole("admin"))
                    {
                        <MudItem sm="6">
                            <MudSelect T="int"
                                       Variant="Variant.Text"
                                       Label=@L["Organizations"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       Required
                                       @bind-Value="createUpdateGarage.OrganizationId">
                                <MudSelectItem Value="0"></MudSelectItem>
                                @foreach (var organization in Organizations)
                                {
                                    if (organization.Status != Enums.Status.Active)
                                        continue;


                                    if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="organization.Id">@organization.EnglishName</MudSelectItem>
                                    }
                                    else
                                    {
                                        <MudSelectItem Value="organization.Id">@organization.ArabicName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </MudItem>



                    }
                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="createUpdateGarage.Code"
                                      For="@(() => createUpdateGarage.Code)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Placeholder="@L["Will Be Automatically Created"]"
                                      Label="@L["Garage Code"]"
                                      ReadOnly="true" />
                    </MudItem>

                    <MudItem sm="6" md="6">
                        <MudNumericField 
                                         For="@(() => createUpdateGarage.MaxCapacity)"
                                         Variant="Variant.Text"
                                         Class="w-100"
                                         Validation="@(new Func<int, string>(validateNumber))"
                                         HideSpinButtons="true"
                                         T="int"
                                         Placeholder="@L["Type Here"]"
                                         Label="@L["Garage Max Capacity"]"
                                         ValueChanged="HandleMaxCapacityChange" />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudNumericField Variant="Variant.Text"
                                         Class="w-100"
                                         T="int"
                                         Validation="@(new Func<int, string>(validateNumber))"
                                         HideSpinButtons="true"
                                         Value="createUpdateGarage.MaxSlotsForCustomers"
                                         Placeholder="@L["Type Here"]"
                                         Label="@L["Max Slots For Customers"]"
                                         ValueChanged="HandleCustomerSlotsChange" />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudNumericField Value="createUpdateGarage.MaxSlotsForEmployess"
                                         Variant="Variant.Text"
                                         Class="w-100"
                                         Validation="@(new Func<int, string>(validateNumber))"
                                         HideSpinButtons="true"
                                         T="int"
                                         Placeholder="@L["Type Here"]"
                                         Label="@L["Max Slots For Employees"]"
                                         ValueChanged="HandleEmployeeSlotsChange" />
                    </MudItem>
                   
                    <MudItem sm="6" md="6">
                        <MudNumericField Value="createUpdateGarage.MaxSlotsForFree"
                                         Variant="Variant.Text"
                                         Class="w-100"
                                         Validation="@(new Func<int, string>(validateNumber))"
                                         HideSpinButtons="true"
                                         T="int"
                                         Placeholder="@L["Type Here"]"
                                         Label="@L["Max Slots For Free"]"
                                         ValueChanged="HandleFreeSlotsChange" />
                    </MudItem>


                           
                            <MudItem sm="4" md="4">
                                <MudTimePicker @bind-Time="_time"
                                               @bind-Value="_time"
                                               Required
                                               AmPm="true" 
                                               PickerVariant="PickerVariant.Dialog" 
                                               TimeFormat="h:mm tt"
                                               Variant="Variant.Text"
                                               Class="w-100"
                                               Placeholder="@L["Type Here"]"
                                               Label="@L["Closing Hours"]" />
                            </MudItem>
                    

                    

                            <MudItem sm="8" md="8">


                                <MudRadioGroup @bind-Value="@createUpdateGarage.Status" Class="d-inline-flex align-content-center">
                                     <div class="d-flex flex-row justify-content-between">
                                            <MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">@L["Status Active"]</MudRadio>
                                            <MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Secondary">@L["Status InActive"]</MudRadio>
                                    </div>
                                </MudRadioGroup>
                            </MudItem>

                          
                        </MudGrid>
                    </MudForm>
              
        </DialogContent>
        <DialogActions>

                    <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="CancelCreate">@L["Back"]</MudButton>
                    <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" Disabled="@(form == null || !form.IsValid)" OnClick="SubmitCreate">@L["Add"]</MudButton>
        </DialogActions>
    </MudDialog>
</div>



<style>

    .mud-modal
    {
        border-radius: 0 20px 0 20px;
    }
</style>
@code {

}
