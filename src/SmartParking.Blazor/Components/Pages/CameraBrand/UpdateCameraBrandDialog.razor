@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Localization
@using SmartParking.Lookups.CameraBrands
@using SmartParking.LookupsAppServices
@using System.Security.Authentication
@using Volo.Abp
@using Volo.Abp.Validation
@inject ICameraBrandAppService CameraBrandsAppService
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
<PageTitle>@L["Edit CameraBrand"]</PageTitle>
<div class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["Edit"]</MudText>
		</TitleContent>
		<DialogContent>



			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>

					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="CameraBrand.ArabicName"
									  For="@(() => CameraBrand.ArabicName)"
									  Immediate="true"
									  Required="true"
									  Label="@L["ArabicName"]"
									  RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
					</MudItem>

					<MudItem sm="4">
						<MudTextField @bind-Value="CameraBrand.EnglishName"
									  For="@(() => CameraBrand.EnglishName)"
									  Immediate="true"
									  Required="true"
									  Label="@L["EnglishName"]" 
									  RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
					</MudItem>
				</MudGrid>
			</MudForm>



		</DialogContent>

					<DialogActions>
    <DialogActionComponent 
        ButtonOneColor="MudBlazor.Color.Dark"
        ButtonTwoColor="MudBlazor.Color.Primary"
        ButtonOneLabel="@L["Back"]"
        ButtonTwoLabel="@L["Save"]"
        ButtonOneClick="CancelEdit"
        ButtonTwoClick="SubmitEdit"
        ButtonOneVariant="MudBlazor.Variant.Filled"
        ButtonTwoVariant="MudBlazor.Variant.Filled"
    />
</DialogActions>

	</MudDialog>

</div>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>

