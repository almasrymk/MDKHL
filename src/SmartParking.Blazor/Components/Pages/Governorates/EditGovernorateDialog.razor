@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.Governorate
@using Volo.Abp.Application.Dtos
@inject IGovernorateAppService GovernorateAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
<PageTitle>@L["EditGovernorates"]</PageTitle>


<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["UpdateGovernorate"]</MudText>
		</TitleContent>
		<DialogContent>



			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="editForm">
				<MudGrid>
					


					<MudItem sm="6">
						<MudTextField @bind-Value="governorate.ArabicName"
									  For="@(() => governorate.ArabicName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["Arabic Name"]"
									  InputType="InputType.Text" />
					</MudItem>

					<MudItem sm="6" >
						<MudTextField @bind-Value="governorate.EnglishName"
									  For="@(() => governorate.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["English Name"]"
									  InputType="InputType.Text" />
					</MudItem>
					<MudItem sm="6" >
						<MudTextField @bind-Value="governorate.ArabicCapital"
									  For="@(() => governorate.ArabicCapital)"
									  Immediate="true"
									  Label="@L["Arabic Capital"]"
									  InputType="InputType.Text" />
					</MudItem>
					<MudItem sm="6">
						<MudTextField @bind-Value="governorate.EnglishCapital"
									  For="@(() => governorate.EnglishCapital)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["English Capital"]"
									  InputType="InputType.Text" />
					</MudItem>


						<MudItem sm="6">
							<MudSelect @bind-Value="@governorate.CountryId"
									   Variant="Variant.Text"
									   Label="@L["Governorate"]"
                                   Placeholder=@L["Choose"]
                                   HelperText=@L["Helper Text"]
									   Clearable="_clearable"
									   AnchorOrigin="Origin.TopCenter"
									   TransformOrigin="Origin.TopCenter" >

							@foreach (var country in countries)
							{
								<MudSelectItem Value="country.Id">@country.EnglishName</MudSelectItem>
							}
						</MudSelect>
					</MudItem>
					
						
				</MudGrid>
			</MudForm>



		</DialogContent>

		<DialogActions>
			<MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
			<MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Save">@L["Edit"]</MudButton>
		</DialogActions>
	</MudDialog>

</MudItem>


<style>
	.mud-modal 
	{
		border-radius: 0 20px 0 20px;
	}
</style>

