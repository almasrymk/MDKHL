@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.Governorate
@using Volo.Abp.Application.Dtos
@inject IGovernorateAppService GovernorateAppService
@inject IStringLocalizer<SmartParkingResource> L
<PageTitle>@L["GovernoratesDetails"]</PageTitle>

<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@governorate.EnglishName</MudText>
		</TitleContent>
		<DialogContent>



			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" >
				<MudGrid>



					<MudItem sm="6">
						<MudTextField @bind-Value="governorate.ArabicName"
									  For="@(() => governorate.ArabicName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["Arabic Name"]"
									  Disabled/>
					</MudItem>

					<MudItem sm="6" >
						<MudTextField @bind-Value="governorate.EnglishName"
									  For="@(() => governorate.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["English Name"]"
									  Disabled/>
					</MudItem>
					<MudItem sm="6" >
						<MudTextField @bind-Value="governorate.ArabicCapital"
									  For="@(() => governorate.ArabicCapital)"
									  Immediate="true"
									  Disabled
									  Label="@L["Arabic Capital"]" />
					</MudItem>
					<MudItem sm="6" >
						<MudTextField @bind-Value="governorate.EnglishCapital"
									  For="@(() => governorate.EnglishCapital)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["English Capital"]"
									  Disabled/>
					</MudItem>

					<MudItem sm="6">
						<MudTextField @bind-Value="governorate.CountryEnglishName"
									  For="@(() => governorate.CountryEnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["Country English Name"]"
									  Disabled />
					</MudItem>
					
				</MudGrid>
			</MudForm>



		</DialogContent>

		<DialogActions>
			<MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
		</DialogActions>
	</MudDialog>

</MudItem>


<style>
	.mud-modal 
	{
		border-radius: 0 20px 0 20px;
	}
</style>
