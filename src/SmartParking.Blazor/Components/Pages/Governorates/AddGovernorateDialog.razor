@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.Governorate
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@inject IGovernorateAppService GovernorateAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
<PageTitle>@L["AddGovernorates"]</PageTitle>

<div class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["NewGovernorate"]</MudText>
        </TitleContent>
        <DialogContent>
           
                
                    <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                        <MudGrid>
                    <MudItem sm="6">
                        <MudTextField @bind-Value="input.ArabicName"
                                      For="@(() => input.ArabicName)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Placeholder="@L["ُEnterYourArabicName"]"
                                      Label="@L["Arabic Name"]"
                                      InputType="InputType.Text" />
                    </MudItem>

                    <MudItem sm="6">
                        <MudTextField @bind-Value="input.EnglishName"
                                      For="@(() => input.EnglishName)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Placeholder="@L["EnterYourEnglishName"]"
                                      Label="@L["English Name"]"
                                      InputType="InputType.Text" />
                    </MudItem>
                    <MudItem sm="6" >
                        <MudTextField @bind-Value="input.ArabicCapital"
                                      For="@(() => input.ArabicCapital)"
                                      Immediate="true"
                                      Placeholder="@L["EnterYourArabicCapital"]"
                                      Label="@L["Arabic Capital"]"
                                      InputType="InputType.Text" />
                    </MudItem>
                    <MudItem sm="6">
                        <MudTextField @bind-Value="input.EnglishCapital"
                                      For="@(() => input.EnglishCapital)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Placeholder="@L["EnterYourEnglishCapital"]"
                                      Label="@L["English Capital"]"
                                      InputType="InputType.Text" />
                    </MudItem>
                    <MudItem sm="6">
                        <MudTextField @bind-Value="input.Notes"
                                      For="@(() => input.Notes)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Placeholder="@L["EnterYourNotes"]"
                                      InputType="InputType.Text"
                                      Label="@L["Notes"]" />
                    </MudItem>
                    <Countrylookups SelectValueChanged="SelectCountry"></Countrylookups>
                        </MudGrid>
                    </MudForm>
                   
        </DialogContent>

        <DialogActions>
            <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Submit">@L["Create"]</MudButton>
        </DialogActions>
    </MudDialog>

</div>



@code {

    private MudForm form;
    public CreateUpdateGovernorateDto input = new CreateUpdateGovernorateDto();
    public IReadOnlyList<CountryLookupDto> countries = new List<CountryLookupDto>();
    private int CountrySelectValue { get; set; }

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }
    bool _clearable;


    private void SelectCountry(string country)
    {
        CountrySelectValue =int.Parse(country);
    }
    protected override async Task OnInitializedAsync()
    {
        var result = await GovernorateAppService.GetCountryLookupAsync();
        countries = result;
    }
    private async Task Submit()
    {
        var successedMessage = L["GovernorateCreatedSuccessfully"];
        var errorMessage = L["PleaseFixTheValidationErrors"];
        if (form.IsValid)
        {
            // Call your service to create the camera
            try
            {
                CreateUpdateGovernorateDto createUpdateGovernorate = new CreateUpdateGovernorateDto()
                {
                        ArabicName = input.ArabicName,
                        EnglishName = input.EnglishName,
                        ArabicCapital = input.ArabicCapital,
                        EnglishCapital = input.EnglishCapital,
                        Notes = input.Notes,
                        CountryId = CountrySelectValue,
                };
                await GovernorateAppService.CreateAsync(createUpdateGovernorate);
            }
            catch (UserFriendlyException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
                return;
            }
            Snackbar.Add(successedMessage, Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));

        }
        else
        {
            Snackbar.Add(errorMessage, Severity.Error);
        }
    }
    private void Cancel()
    {
        MudDialog.Cancel();
    }
}

<style>
    .mud-modal 
    {
        border-radius: 0 20px 0 20px;
    }
</style>
