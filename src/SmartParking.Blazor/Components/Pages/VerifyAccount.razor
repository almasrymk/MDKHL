@page "/verify-account"
@layout Shared.AuthLayout
@using Microsoft.Extensions.Localization
@using SmartParking.Authentication
@using SmartParking.Localization
@inject IStringLocalizer<SmartParkingResource> L
@inject IAuthenticationAppService AuthenticationAppService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar




<PageTitle>@L["Verify account"]</PageTitle>

<h2>@L["Verify account"]</h2>
<MudText Class="w-50 text-center">
    @L["we send the OTP to"] <a >
        <MudTextField T="string"  Typo="Typo.h6"
        Label=@L["Mobile/User Name"] @bind-Value="Email" />

    </a>
</MudText>
<MudButton Class="mx-auto w-50 my-5" Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Send">@L["Send"]</MudButton>



<MudText Class="w-50 text-center">

    @L["enter the code bellow to verify account"]
</MudText>
<div>
    <MudForm @ref="otpForm">
        <MudGrid Justify="Justify.Center" Class="my-5">
            <MudItem xs="2">
                <MudNumericField @bind-Value="firstIndex"
                HideSpinButtons="true"
                MaxLength="1"
                Variant="Variant.Text"
                Typo="Typo.h5"
                />
            </MudItem>
            <MudItem xs="2">
                <MudNumericField @bind-Value="secondIndex"
                HideSpinButtons="true"
                MaxLength="1"
                Variant="Variant.Text"
                Typo="Typo.h5"
                />
            </MudItem> 
            <MudItem xs="2">
                <MudNumericField @bind-Value="thirdIndex"
                HideSpinButtons="true"
                MaxLength="1"
                Variant="Variant.Text"
                Typo="Typo.h5"
                />
            </MudItem> 
            <MudItem xs="2">
                <MudNumericField @bind-Value="fourttIndex"
                HideSpinButtons="true"
                MaxLength="1"
                Variant="Variant.Text"
                Typo="Typo.h5"
                />
            </MudItem>


        </MudGrid>
        <MudText Class="text-center my-5">@L["Didn't receive the code .."]<MudLink href="#" Color="MudBlazor.Color.Dark" Underline="Underline.Always" Class="fw-bold" OnClick="Send">@L["Resend"]</MudLink></MudText>
        <MudButton Class="mx-auto w-50 mt-7" Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Submit">@L["VERIFY"]</MudButton>
    </MudForm>
</div>
<MudText Class="text-center mt-5">@L["WrongEmail"] <MudLink Color="MudBlazor.Color.Dark" Underline="Underline.Always" Href="/Account/Login" Class="fw-bold">@L["Back"]</MudLink ></MudText>
@code {
    public string Email;
    private int firstIndex, thirdIndex, secondIndex, fourttIndex;
    private MudForm otpForm;


    private async void Send(){

        try{
          var result=await AuthenticationAppService.GenerateOTPForUser(Email);
        }catch(Exception ex){
            Snackbar.Add(ex.Message, Severity.Error);

        }
    }
    private async void Submit(){
        string OTP = "";
        OTP += firstIndex+secondIndex+thirdIndex+fourttIndex;
        
       var result = await AuthenticationAppService.VerifyOtp(Email, OTP);
       if(result){
            Snackbar.Add("OTP Verified correctly", Severity.Success);
            await Task.Delay(1000);
            Navigation.NavigateTo("/change-password");
       }
       else{
            Snackbar.Add("OTP Is Incorrect", Severity.Error);
             firstIndex=thirdIndex=secondIndex=fourttIndex=0;
       }

    }
}