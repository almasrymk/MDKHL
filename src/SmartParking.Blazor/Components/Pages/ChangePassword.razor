@page "/change-password"
@layout Shared.AuthLayout

<PageTitle>Change password</PageTitle>

<MudContainer Class="d-flex justify-content-center my-5">
    <MudForm Class="d-flex flex-column gap-3 w-75">
        <MudTextField T="string" Placeholder="Type your old password here" Label="Old Password" InputType="@GetInputType("oldPassword")" Adornment="Adornment.End" AdornmentIcon="@GetPasswordInputIcon("oldPassword")" OnAdornmentClick="@(() => TogglePasswordVisibility("oldPassword"))" AdornmentAriaLabel="Show Password" />
        <MudTextField T="string" Placeholder="Type your new password here" Label="New Password" InputType="@GetInputType("newPassword")" Adornment="Adornment.End" AdornmentIcon="@GetPasswordInputIcon("newPassword")" OnAdornmentClick="@(() => TogglePasswordVisibility("newPassword"))" AdornmentAriaLabel="Show Password" />
        <MudTextField T="string" Placeholder="Retype your new password here" Label="Confirm New Password" InputType="@GetInputType("confirmPassword")" Adornment="Adornment.End" AdornmentIcon="@GetPasswordInputIcon("confirmPassword")" OnAdornmentClick="@(() => TogglePasswordVisibility("confirmPassword"))" AdornmentAriaLabel="Show Password" />
        
        <MudButton Class="mt-4 w-50 mx-auto" ButtonType="MudBlazor.ButtonType.Submit" Variant="Variant.Filled" Color="MudBlazor.Color.Primary" FullWidth="false">LOGIN</MudButton>
    </MudForm>

</MudContainer>



@code {
    bool isShow;
    Dictionary<string, bool> passwordVisibility = new Dictionary<string, bool>();
    InputType GetInputType(string fieldId)
    {
        return passwordVisibility.ContainsKey(fieldId) && passwordVisibility[fieldId] ? InputType.Text : InputType.Password;
    }
    string GetPasswordInputIcon(string fieldId)
    {
        return passwordVisibility.ContainsKey(fieldId) && passwordVisibility[fieldId] ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    void TogglePasswordVisibility(string fieldId)
    {
        if (passwordVisibility.ContainsKey(fieldId))
        {
            passwordVisibility[fieldId] = !passwordVisibility[fieldId];
        }
        else
        {
            passwordVisibility[fieldId] = true;
        }
    }
}

