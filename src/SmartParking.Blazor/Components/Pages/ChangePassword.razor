@page "/change-password"
@using Volo.Abp.Account
@layout Shared.AuthLayout

<PageTitle>Change Password</PageTitle>

<MudContainer Class="d-flex justify-content-center my-5">
    <MudForm @ref="form" OnValidSubmit="@HandleValidSubmit" Class="d-flex flex-column gap-3 w-75">
        <MudTextField T="string" Placeholder="Type your old password here" Label="Old Password"
                      @bind-Value="OldPassword" InputType="@GetInputType("oldPassword")"
                      Adornment="Adornment.End" AdornmentIcon="@GetPasswordInputIcon("oldPassword")"
                      OnAdornmentClick="@(() => TogglePasswordVisibility("oldPassword"))"
                      AdornmentAriaLabel="Show Password" Required="true" />

        <MudTextField T="string" Placeholder="Type your new password here" Label="New Password"
                      @bind-Value="NewPassword" InputType="@GetInputType("newPassword")"
                      Adornment="Adornment.End" AdornmentIcon="@GetPasswordInputIcon("newPassword")"
                      OnAdornmentClick="@(() => TogglePasswordVisibility("newPassword"))"
                      AdornmentAriaLabel="Show Password" Required="true" />

        <MudTextField T="string" Placeholder="Retype your new password here" Label="Confirm New Password"
                      @bind-Value="ConfirmPassword" InputType="@GetInputType("confirmPassword")"
                      Adornment="Adornment.End" AdornmentIcon="@GetPasswordInputIcon("confirmPassword")"
                      OnAdornmentClick="@(() => TogglePasswordVisibility("confirmPassword"))"
                      AdornmentAriaLabel="Show Password" Required="true" />

        <MudButton Class="mt-4 w-50 mx-auto" 
                   Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="@(() =>  HandleValidSubmit())">CHANGE PASSWORD</MudButton>
    </MudForm>
</MudContainer>

@code {
    private MudForm form;
    private string OldPassword { get; set; }
    private string NewPassword { get; set; }
    private string ConfirmPassword { get; set; }

    Dictionary<string, bool> passwordVisibility = new Dictionary<string, bool>();

    // Inject the ProfileAppService and ISnackbar
    [Inject] private IProfileAppService ProfileAppService { get; set; }
    [Inject] private ISnackbar Snackbar { get; set; }

    InputType GetInputType(string fieldId)
    {
        return passwordVisibility.ContainsKey(fieldId) && passwordVisibility[fieldId] ? InputType.Text : InputType.Password;
    }

    string GetPasswordInputIcon(string fieldId)
    {
        return passwordVisibility.ContainsKey(fieldId) && passwordVisibility[fieldId] ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    void TogglePasswordVisibility(string fieldId)
    {
        if (passwordVisibility.ContainsKey(fieldId))
        {
            passwordVisibility[fieldId] = !passwordVisibility[fieldId];
        }
        else
        {
            passwordVisibility[fieldId] = true;
        }
    }

    async Task HandleValidSubmit()
    {
        // Ensure the form is validated before proceeding
        await form.Validate();
        if (!form.IsValid)
        {
            Snackbar.Add("Please fill in all fields correctly.", Severity.Warning);
            return;
        }

        // Ensure new passwords match
        if (NewPassword != ConfirmPassword)
        {
            Snackbar.Add("New Password and Confirm Password do not match!", Severity.Error);
            return;
        }

        var input = new ChangePasswordInput
            {
                CurrentPassword = OldPassword,
                NewPassword = NewPassword
            };

        try
        {
            await ProfileAppService.ChangePasswordAsync(input);
            Snackbar.Add("Password changed successfully!", Severity.Success);
            
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error changing password: {ex.Message}", Severity.Error);
        }
    }
}
