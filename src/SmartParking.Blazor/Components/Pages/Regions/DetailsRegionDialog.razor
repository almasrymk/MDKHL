@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.Governorate
@using SmartParking.Lookups.Region
@using Volo.Abp.Application.Dtos
@inject IRegionAppService RegionAppService
@inject IGovernorateAppService GovernorateAppService
@inject IStringLocalizer<SmartParkingResource> L
<PageTitle>@L["RegionsDetails"]</PageTitle>

<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
				<MudText Typo="Typo.h6">@L["RegionDetails"]</MudText>
		</TitleContent>
		<DialogContent>

			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" >
				<MudGrid>

					<MudItem sm="6">
						<MudTextField @bind-Value="region.ArabicName"
									  For="@(() => region.ArabicName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["Arabic Name"]"
									  Disabled/>
					</MudItem>

					<MudItem sm="6">
						<MudTextField @bind-Value="region.EnglishName"
									  For="@(() => region.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["English Name"]"
									  Disabled/>
					</MudItem>

					<MudItem sm="6">
						<MudSelect @bind-Value="@region.CountryId"
								   Variant="Variant.Text"
								   Label="@L["Country"]"
								   Placeholder="@L["Choose"]"
								   AnchorOrigin="Origin.TopCenter"
								   TransformOrigin="Origin.TopCenter"
								   Disabled>

							@foreach (var country in countries)
							{
								<MudSelectItem Value="country.Id">@country.EnglishName</MudSelectItem>
							}
						</MudSelect>
					</MudItem>


					<MudItem sm="6">
						<MudTextField @bind-Value="region.Status"
									  For="@(() => region.Status)"
									  Immediate="true"
									  Disabled
									  Label="@L["Status"]" />
					</MudItem>

				</MudGrid>
			</MudForm>



		</DialogContent>

		<DialogActions>
			<MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
		</DialogActions>
	</MudDialog>

</MudItem>


<style>
	.mud-modal 
	{
		border-radius: 0 20px 0 20px;
	}
</style>
