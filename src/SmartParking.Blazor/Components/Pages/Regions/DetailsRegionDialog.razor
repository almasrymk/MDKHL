@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.Region
@using System.Globalization
@using Volo.Abp.Application.Dtos
@inject IRegionAppService RegionAppService
@inject ICountriesAppService CountriesAppService
@inject IStringLocalizer<SmartParkingResource> L
<PageTitle>@L["RegionsDetails"]</PageTitle>

<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["Details"]</MudText>
		</TitleContent>
		<DialogContent>

			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" >
				<MudGrid>

					<MudItem sm="6">
						<MudTextField @bind-Value="region.ArabicName"
						For="@(() => region.ArabicName)"
						Immediate="true"
						Variant="Variant.Text"
						Label="@L["ArabicName"]"
						Disabled/>
					</MudItem>

					<MudItem sm="6">
						<MudTextField @bind-Value="region.EnglishName"
						For="@(() => region.EnglishName)"
						Immediate="true"
						Variant="Variant.Text"
						Label="@L["EnglishName"]"
						Disabled/>
					</MudItem>

					@if (CultureInfo.CurrentCulture.Name == "en")
					{
						<MudItem sm="6">
							<MudTextField @bind-Value="region.CountryEnglishName"
							For="@(() => region.CountryEnglishName)"
							Immediate="true"
							Disabled
							Label="@L["Country"]" />
						</MudItem>
					}
					else
					{
						<MudItem sm="6">
							<MudTextField @bind-Value="region.CountryArabicName"
										  For="@(() => region.CountryArabicName)"
										  Immediate="true"
										  Disabled
										  Label="@L["Country"]" />
						</MudItem>
					}

					<MudItem sm="6">
						<MudTextField @bind-Value="region.Status"
									  For="@(() => region.Status)"
									  Immediate="true"
									  Disabled
									  Label="@L["Status"]" />
					</MudItem>

				</MudGrid>
			</MudForm>



		</DialogContent>

		<DialogActions>
			<MudButton Color="MudBlazor.Color.Dark" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
		</DialogActions>
	</MudDialog>

</MudItem>


<style>
	.mud-modal 
	{
		border-radius: 0 20px 0 20px;
	}
</style>
