@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.Governorate
@using SmartParking.Lookups.Region
@using Volo.Abp.Application.Dtos
@inject IRegionAppService RegionAppService
@inject IGovernorateAppService GovernorateAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
<PageTitle>@L["EditRegions"]</PageTitle>

<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
				<MudText Typo="Typo.h6">@L["UpdateRegion"]</MudText>
		</TitleContent>
		<DialogContent>

			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="editForm">
				<MudGrid>

					<MudItem sm="6">
						<MudTextField @bind-Value="region.ArabicName"
									  For="@(() => region.ArabicName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["Arabic Name"]" />
					</MudItem>

					<MudItem sm="6">
						<MudTextField @bind-Value="region.EnglishName"
									  For="@(() => region.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
								      Label="@L["English Name"]" />
					</MudItem>

						<MudItem sm="6">
							<MudSelect @bind-Value="@region.CountryId"
									   Variant="Variant.Text"
									   Label="@L["Country"]"
									   Placeholder="@L["Choose"]"
									   AnchorOrigin="Origin.TopCenter"
									   TransformOrigin="Origin.TopCenter" >

							@foreach (var country in countries)
							{
								<MudSelectItem Value="country.Id">@country.EnglishName</MudSelectItem>
							}
						</MudSelect>
					</MudItem>


					<MudItem sm="6" Class="d-inline-flex justify-content-center">
						<MudItem Class="d-flex flex-row justify-content-between">
							<MudRadioGroup @bind-Value="@region.Status" Class="d-inline-flex align-content-center">
								<MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">Active</MudRadio>
								<MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Secondary">InActive</MudRadio>
								<MudRadio Value="@(Enums.Status.Deleted)" Color="MudBlazor.Color.Warning">Deleted</MudRadio>
							</MudRadioGroup>
						</MudItem>
					</MudItem>

				</MudGrid>
			</MudForm>



		</DialogContent>

		<DialogActions>
			<MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
			<MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Save">@L["Edit"]</MudButton>
		</DialogActions>
	</MudDialog>

</MudItem>

<style>
	.mud-modal 
	{
		border-radius: 0 20px 0 20px;
	}
</style>
