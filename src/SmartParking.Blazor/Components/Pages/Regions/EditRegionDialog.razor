@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.Region
@using System.Globalization
@using Volo.Abp.Application.Dtos
@inject IRegionAppService RegionAppService
@inject ICountriesAppService CountriesAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
<PageTitle>@L["EditRegions"]</PageTitle>

<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
				<MudText Typo="Typo.h6">@L["Edit"]</MudText>
		</TitleContent>
		<DialogContent>

			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
				<MudGrid>

					<MudItem sm="6">
						<MudTextField @bind-Value="region.ArabicName"
									  For="@(() => region.ArabicName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Placeholder=@L["Type Here"]
									  Label=@L["ArabicName"] />
					</MudItem>

					<MudItem sm="6">
						<MudTextField @bind-Value="region.EnglishName"
									  For="@(() => region.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Placeholder=@L["Type Here"]
									  Label=@L["EnglishName"] />
					</MudItem>

					<MudItem sm="6">
						<MudSelect Variant="Variant.Text"
								   Label="@L["Country"]"
								   Placeholder="@L["Choose"]"
								   Clearable="true"
								   @bind-Value="region.CountryId">
							@foreach (var country in countries)
							{
								@if (CultureInfo.CurrentCulture.Name == "en")
								{
									<MudSelectItem Value="country.Id">@country.EnglishName</MudSelectItem>

								}
								else
								{
									<MudSelectItem Value="country.Id">@country.ArabicName</MudSelectItem>

								}
							}
						</MudSelect>
					</MudItem>

					<MudItem sm="6" Class="d-inline-flex justify-content-center">
						<MudItem Class="d-flex flex-row justify-content-between">
							<MudRadioGroup @bind-Value="@region.Status" Class="d-inline-flex align-content-center">
								<MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">@L["Active"]</MudRadio>
								<MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Secondary">@L["InActive"]</MudRadio>
								
							</MudRadioGroup>
						</MudItem>
					</MudItem>

				</MudGrid>
			</MudForm>



		</DialogContent>

		<DialogActions>
    <DialogActionComponent 
        ButtonOneColor="MudBlazor.Color.Dark"
        ButtonTwoColor="MudBlazor.Color.Primary"
        ButtonOneLabel="@L["Back"]"
        ButtonTwoLabel="@L["Save"]"
        ButtonOneClick="Cancel"
        ButtonTwoClick="Save"
        ButtonOneVariant="MudBlazor.Variant.Filled"
        ButtonTwoVariant="MudBlazor.Variant.Filled" />
</DialogActions>

	</MudDialog>

</MudItem>

<style>
	.mud-modal 
	{
		border-radius: 0 20px 0 20px;
	}
</style>
