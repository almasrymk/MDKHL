@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.Region
@using System.Globalization
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@inject IRegionAppService RegionAppService
@inject ICountriesAppService CountriesAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
<PageTitle>@L["AddRegions"]</PageTitle>
@inject NavigationManager Navigation

<MudItem class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
                <MudText Typo="Typo.h6">@L["Add NEW"]</MudText>
        </TitleContent>
        <DialogContent>
            <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" >
                <MudGrid>
                    <MudItem sm="6">
                        <MudTextField @bind-Value="input.ArabicName"
                                      For="@(() => input.ArabicName)"
                                      Immediate="true"
                                      Required
                                      Variant="Variant.Text"
                                      Placeholder=@L["Type Here"]
                                      InputType="InputType.Text"
                                      Label="@L["ArabicName"]" />
                    </MudItem>

                    <MudItem sm="6">
                        <MudTextField @bind-Value="input.EnglishName"
                                      For="@(() => input.EnglishName)"
                                      Immediate="true"
                                      Required
                                      Variant="Variant.Text"
                                      Placeholder=@L["Type Here"]
                                      InputType="InputType.Text"
                                          Label="@L["EnglishName"]" />
                    </MudItem>
 
                    <MudItem sm="6">
                        <MudSelect Variant="Variant.Text"
                                   Label="@L["Country"]"
                                   Placeholder="@L["Choose"]"
                                   Clearable="true"
                                   @bind-Value="input.CountryId">
                            <MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
                            @foreach (var country in countries)
                            {
                                @if (CultureInfo.CurrentCulture.Name == "en")
                                {
                                    <MudSelectItem Value="country.Id">@country.EnglishName</MudSelectItem>

                                }
                                else
                                {
                                    <MudSelectItem Value="country.Id">@country.ArabicName</MudSelectItem>

                                }
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem sm="6" Class="d-flex justify-content-center">
                        <MudItem Class="d-flex flex-row justify-content-between">
                            <MudRadioGroup @bind-Value="@input.Status" Class="d-inline-flex align-content-center">
                                <MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">@L["Active"]</MudRadio>
                                <MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Secondary">@L["Status InActive"]</MudRadio>
                            </MudRadioGroup>
                        </MudItem>
                    </MudItem>
                </MudGrid>
            </MudForm>

        </DialogContent>


        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4}")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Submit">@L["Create"]</MudButton>
        </DialogActions>
    </MudDialog>

</MudItem>



<style>
    .mud-modal 
    {
        border-radius: 0 20px 0 20px;
    }
</style>