@page "/regions"
@using Customs
@using SmartParking.Lookups
@using SmartParking.Lookups.Region
@using Volo.Abp.Application.Dtos
@inherits AbpCrudPageBase<IRegionAppService, RegionDto, int, PagedAndSortedResultRequestDto, CretaeUpdateRegionDto>
@inject IDialogService Dialog



<MudItem>
    <MudDataGrid Elevation="0" Class="bg-transparent custom-data-grid" T="RegionDto" MultiSelection="true" Items="regions" SortMode="SortMode.Multiple" Filterable="true">
        <ToolBarContent>

            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="@(() => OpenCreateRegionDialog(_backdropClick))">

                CREATE NEW
                <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Size="MudBlazor.Size.Small" Class="ms-1" />
            </MudButton>
        </ToolBarContent>
        <Columns>
            <SelectColumn T="RegionDto" />
            <PropertyColumn Property="x => x.ArabicName" Title="Region Arabic Name" />
            <PropertyColumn Property="x => x.EnglishName" Title="Region English Name" />
            <PropertyColumn Property="x => x.Status" Title="Region Status" />

            <TemplateColumn Title="Actions">
                <CellTemplate>
                    <MudItem Class="d-flex justify-content-center align-items-center">
                        <MudIconButton OnClick="@(() => OpenDetailsRegionDialog(context.Item))"
                                       Icon="@Icons.Material.Filled.Info"
                                       Variant="Variant.Filled"
                                       Color="MudBlazor.Color.Primary"
                                       Size="MudBlazor.Size.Small"
                                       Class="mx-1" />
                        <MudIconButton OnClick="@(() => OpenEditRegionDialog(context.Item))"
                                       Icon="@Icons.Material.Filled.Edit"
                                       Variant="Variant.Filled"
                                       Color="MudBlazor.Color.Secondary"
                                       Size="MudBlazor.Size.Small"
                                       Class="mx-1" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Variant="Variant.Filled"
                                       Color="MudBlazor.Color.Error"
                                       Size="MudBlazor.Size.Small"
                                       Class="mx-1" />
                    </MudItem>

                </CellTemplate>
            </TemplateColumn>

        </Columns>
        <PagerContent>
            <MudDataGridPager T="RegionDto" />
        </PagerContent>
    </MudDataGrid>
</MudItem>

