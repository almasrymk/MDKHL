@using Microsoft.Extensions.Localization
@using SmartParking.Currency
@using SmartParking.Localization
@using SmartParking.Packages
@using System.Globalization
@using SmartParking.UnitPackages
@inject IPackagesAppService PackagesAppService

@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar

<PageTitle>@L["View Package"]</PageTitle>

<div class="modal-wrapper">
	<MudDialog class="mud-modal" style="min-height:fit-content !important">
		<TitleContent>
            <MudText Typo="Typo.h6">@L["Details"]</MudText>
		</TitleContent>
		<DialogContent>



			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>


                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="Package.Package.ArabicName"
                                      For="@(() => Package.Package.ArabicName)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Disabled='true'
                                      Label=@L["ArabicName"] />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="Package.Package.EnglishName"
                                      For="@(() => Package.Package.EnglishName)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Disabled='true'
                                      Label=@L["EnglishName"] />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <div style="display: flex; flex-direction: column;">
                            <label style="font-size: 0.75rem; margin-bottom: 4px; color: rgba(0, 0, 0, 0.38); cursor: default;">
                                @L["Price"]
                                @((MarkupString)CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "15px"))
                            </label>
                            <MudTextField @bind-Value="Package.Package.Price"
                                          For="@(() => Package.Package.Price)"
                                          Variant="Variant.Text"
                                          Class="w-100"
                                          Disabled="true"
                                          HideSpinButtons="true" />
                        </div>
                    </MudItem>



                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="Package.Package.DurationOfPackage"
                                         Variant="Variant.Text"                                        
                                         HideSpinButtons="true"
                                         Disabled="true"
                                         Class="w-100"
                                         Label=@L["PackageDuration"] />
                    </MudItem>

                    <MudItem sm="6" md="6">
                        <MudTextField Value="CustomerCategory"
                                      Immediate="true"
                                      Disabled=true
                                      Label=@L["customer category"] />
                    </MudItem>

                        <MudItem sm="6" md="6">
                            <MudTextField Variant="Variant.Text"
                                           Class="w-100"
                                           Value="Package.Package.ActivationDate"
                                           Disabled
                                           Label="@L["ActivationDate"]" />
                        </MudItem>

                        <MudItem sm="6" md="6">
                            <MudTextField Variant="Variant.Text"
                                           Class="w-100"
                                           Value="Package.Package.DectivationDate"
                                           Disabled
                                           Label="@L["DectivationDate"]" />
                        </MudItem>
                

                    @if(Package.Package.Published == true)
                    {
                        <MudItem sm="6" md="6">
                            <MudTextField T="string"
                                          Text="@(24+L["Hour"])"
                                          Immediate="true"
                                          Disabled=true
                                          Label=@L["Published"] />
                        </MudItem>

                        <MudItem sm="6" md="6">
                            <MudTextField Value="@L[$"{Package.Package.Status.ToString()}"]"
                                          Immediate="true"
                                          Disabled=true
                                          Label=@L["Status"] />
                        </MudItem>

                    }
                    else
                    {
                        <MudItem sm="4" md="4">
                            <MudTextField @bind-Value="Package.Package.PublishFrom"
                                          For="@(() => Package.Package.PublishFrom)"
                                          Immediate="true"
                                          Disabled=true
                                          Label=@L["Publish From"] />
                        </MudItem>
                        <MudItem sm="4" md="4">
                            <MudTextField @bind-Value="Package.Package.PublishTo"
                                          For="@(() => Package.Package.PublishTo)"
                                          Immediate="true"
                                          Disabled=true
                                          Label=@L["Publish To"] />
                        </MudItem>
                        <MudItem sm="4" md="4">
                            <MudTextField Value="@L[$"{Package.Package.Status.ToString()}"]"
                                          Immediate="true"
                                          Disabled=true
                                          Label=@L["Status"] />
                        </MudItem>


                    }
               

                    <MudItem sm="12">
                       @*  <MudText>@L["Description"]</MudText> *@
                        <label style="font-size: 0.75rem; margin-bottom: 4px; color: rgba(0, 0, 0, 0.38); cursor: default;">
                            @L["Description"]
                        </label>
                        <MudTextField @bind-Value="Package.Package.Description"
                                      For="@(() => Package.Package.Description)"
                                      Variant="Variant.Outlined"
                                      Class="w-100"
                                      Lines="5"
                                      Disabled='true'
                                      />

                    </MudItem>

                    
                   

				</MudGrid>

                <MudGrid>
                   <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="Package.NumberOfVehicles"
                                      For="@(() => Package.NumberOfVehicles)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Disabled='true'
                                      Label=@L["NumberOfVehicles"] />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="Package.NumberOfSlots"
                                      For="@(() => Package.NumberOfSlots)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Disabled='true'
                                      Label=@L["NumberOfSlots"] />
                    </MudItem>
                </MudGrid>

			</MudForm>

            

		</DialogContent>
        <DialogActions>
            <MudButton Color="MudBlazor.Color.Dark" Variant="Variant.Filled" OnClick="OnCloseViewOnly">@L["Back"]</MudButton>
        </DialogActions>

	</MudDialog>

</div>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }
    [Parameter] public UnitPackageDto Package { get; set; }
    [Parameter]
    public int UpdatedId { get; set; }
    [Parameter]
    public string CustomerCategory { get; set; }
    
    bool _clearable;
    private MudForm form;

   
    protected override async Task OnInitializedAsync()
    {
        
        await base.OnInitializedAsync();
	}



	private void OnCloseViewOnly()
	{
		MudDialog.Cancel();

	}

}
