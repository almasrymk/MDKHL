@using SmartParking.Blazor.Components.Shared
@using SmartParking.Blazor.Components.Shared.Components
@using SmartParking.Blazor.Components.Shared.Utilities
@using SmartParking.Blazor.Components.State
@using SmartParking.Currency
@using SmartParking.Enums
@using SmartParking.Lookups
@using SmartParking.Packages
@using SmartParking.Organizations
@using SmartParking.Blazor.Components.Shared
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.UnitPackages
@using SmartParking.Utilities
@using SmartParking.Validations
@using System.Globalization
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Validation
@inject IPackagesAppService packagesAppService
@inject IOrganizationsAppService organizationAppService
@inject IPackageTypesAppService packageTypesAppService
@inject IStringLocalizer<SmartParkingResource> L
@inject ICurrentTenant CurrentTenant
@inject NavigationManager NavigationManager


<PageTitle>@L["New Package"]</PageTitle>
<div class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Add NEW"]</MudText>
        </TitleContent>
        <DialogContent>

            <MudForm Class="flex-grow-1 mt-2 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Model="createUpdatePackage" @ref="form">
                <MudGrid>
                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="createUpdatePackage.ArabicName"
                        For="@(() => createUpdatePackage.ArabicName)"
                        Variant="Variant.Text"
                        Class="w-100"
                        Placeholder=@L["Type Here"]
                        Required="true"
                        RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                        Label=@L["ArabicName"] />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="createUpdatePackage.EnglishName"
                        For="@(() => createUpdatePackage.EnglishName)"
                        Variant="Variant.Text"
                        Required="true"
                        RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                        Class="w-100"
                        Placeholder=@L["Type Here"]
                        Label=@L["EnglishName"] />
                    </MudItem>

                    <MudItem sm="6" md="6">
                        <MudSelect 
                            T="PackageCategoryTypes"
                        Value="@createUpdatePackage.PackageCategoryType"
                        ValueChanged="OnPackageTypeChanged"
                        Label="@L["PackageType"]" 
                        HelperText=@L["Helper Text"] 
                        Placeholder=@L["Choose"]
                        Required ="true" 
                        RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))">

                            @foreach (var type in Enum.GetValues(typeof(PackageCategoryTypes)).Cast<PackageCategoryTypes>())
                            {
                                if (CultureInfo.CurrentCulture.Name == "en")
                                {
                                     <MudSelectItem  Value="@type">
                                         @L[type.ToString()]
                                     </MudSelectItem>
                                }
                                else{
                                    <MudSelectItem Value="@type">
                                        @L[type.ToString()]
                                    </MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudSelect @bind-Value="createUpdatePackage.CustomerCategory"
                                   Label="@L["customer category"]"
                                   Placeholder="@L["Choose"]"
                                   HelperText=@L["Helper Text"]
                                   RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                                   Required>

                            @foreach (var category in Enum.GetValues(typeof(CustomerCategoryStatus)).Cast<CustomerCategoryStatus>())
                            {
                                <MudSelectItem Value="@category">
                                    @category.ToString()
                                </MudSelectItem>
                            }
                        </MudSelect>

                    </MudItem>
                    @if(createUpdatePackage.PackageCategoryType != PackageCategoryTypes.CustomPackage)
                    {
                        
                          <MudItem sm="6" md="6">
                        <div style="display: flex; flex-direction: column;">
                            <label style="font-size: 0.75rem; margin-bottom: 4px;">
                                @L["Price"]
                                @((MarkupString)CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "15px"))
                            </label>

                            <MudNumericField @bind-Value="createUpdatePackage.Price"
                                             For="@(() => createUpdatePackage.Price)"
                                             Variant="Variant.Text"
                                             Required="true"
                                             RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                                             HideSpinButtons="true"
                                             class="@(CultureInfo.CurrentCulture.Name == "ar" ? "custom-numeric-field" : "")" />
                        </div>
                    </MudItem>
                    }
                    @if (CurrentTenant.Id == null)
                    {
                        <MudItem sm="6">
                            <MudSelect T="string"
                                       Class="custom-placeholder"
                                       Variant="Variant.Text"
                                       Label=@L["Organizations"]
                                       HelperText=@L["Helper Text"]
                                       Required
                                       Placeholder="@L[ "Choose"]"
                                       RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                                       @bind-Value="OrganizationId">

                                @foreach (var organization in _organizations)
                                {
                                    if (organization.Status != Enums.Status.Active)
                                        continue;

                                    if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="organization.Id.ToString()">@organization.EnglishName</MudSelectItem>
                                    }
                                    else
                                    {
                                        <MudSelectItem Value="organization.Id.ToString()">@organization.ArabicName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </MudItem>

                    }
                    @if (createUpdatePackage.PackageCategoryType == PackageCategoryTypes.CustomPackage){

                        <CustomPackageComponent CustomPackageUiDto="CustomPackageUiDto" />

                    }
                    else
                    {
                        <NormalPackageComponent IsDurationDisabled="IsDurationDisabled" createUpdatePackage="NormalPackageUiDto" />
          
                    }
                    <MudItem sm="12">
                        <label style="font-size: 0.75rem; margin-bottom: 4px;">
                            @L["Description"]
                        </label>
                        <MudTextField @bind-Value="createUpdatePackage.Description"
                        For="@(() => createUpdatePackage.Description)"
                        Variant="Variant.Outlined"
                        Class="w-100"
                        Required="true"
                        RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                        Lines="5"
                        Placeholder=@L["Type Here"]
                       />
                    </MudItem>

                    

                </MudGrid>
                    
                <MudGrid>
                    <MudItem sm="6" md="6">
                        <label style="font-size: 0.75rem; margin-bottom: 4px;">
                            @L["NumberOfSlots"]
                        </label>
                        <MudTextField @bind-Value="createUpdateUnitPackage.NumberOfSlots"
                        For="@(() => createUpdateUnitPackage.NumberOfSlots)"
                        Variant="Variant.Outlined"
                        Class="w-100"
                        Required="true"
                        RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                        />

                    </MudItem>

                    <MudItem sm="6" md="6">
                        <label style="font-size: 0.75rem; margin-bottom: 4px;">
                            @L["NumberOfVehicles"]
                        </label>
                        <MudTextField @bind-Value="createUpdateUnitPackage.NumberOfVehicles"
                        For="@(() => createUpdateUnitPackage.NumberOfVehicles)"
                        Variant="Variant.Outlined"
                        Class="w-100"
                        Required="true"
                        RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                        />
                    </MudItem>
                </MudGrid>

            </MudForm>

        </DialogContent>
        <DialogActions>
            <DialogActionComponent 
            ButtonOneColor="MudBlazor.Color.Dark" 
            ButtonTwoColor="MudBlazor.Color.Primary" 
            ButtonOneLabel="@L["Back"]" 
            ButtonTwoLabel="@L["SaveAsDraft"]" 
            ButtonOneClick="Cancel" 
            ButtonTwoClick="Submit" 
            ButtonOneVariant="MudBlazor.Variant.Filled" 
            ButtonTwoVariant="MudBlazor.Variant.Filled" />
        </DialogActions>


    </MudDialog>

</div>

<style>
    .mud-modal 
    {
    border-radius: 0 20px 0 20px;
    }

    .custom-numeric-field input {
    display: flex;
    text-align: end;
    width: 100%; /* Equivalent to w-100 in Bootstrap */
    }

    .custom-placeholder .mud-disabled {
    color: gray !important; /* Change this to your desired placeholder color */
    }

</style>

@code 
{
    [Inject] ISnackbar Snackbar { get; set; }
    [Inject] IUnitPackageAppService PackagesAppService { get; set; } // Assuming you have a service to handle the camera creation

    private MudForm form;
    private CreateUpdatePackageDto createUpdatePackage = new CreateUpdatePackageDto();
    private CreateUpdateUnitPackageDto createUpdateUnitPackage = new CreateUpdateUnitPackageDto();
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }
    private string OrganizationId { get; set; }
    bool _clearable;
    private List<OrganizationDto> _organizations = new List<OrganizationDto>();
    private string CustomerCategory { get; set; }
    private PagedResultDto<OrganizationDto> organizationsList { get; set; } = new();
    private CustomPackageUiDto CustomPackageUiDto { get; set; } = new();
    private NormalPackagePropertiesDto NormalPackageUiDto { get; set; } = new();

    private bool IsDurationDisabled { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        organizationsList = await organizationAppService.GetListAsync(new PagedAndSortedResultRequestDto());
        _organizations = organizationsList.Items.ToList();
        if(CurrentTenant.Id!=null){
            var id = await organizationAppService.GetOrganizationIdByTenant(CurrentTenant.Id);
            OrganizationId = id.ToString();
        }
        IsDurationDisabled = false;
        await base.OnInitializedAsync();
    }
    private void OnPackageTypeChanged(PackageCategoryTypes value)
    {
        createUpdatePackage.PackageCategoryType = value;
        var result = PackageExtension.OnPackageTypeChanged(value);
        CustomPackageUiDto.DurationOfPackage = NormalPackageUiDto .DurationOfPackage= result.PackageDuration;
        IsDurationDisabled = result.IsDurationDisabled;
    }


    private async Task Submit()
    {
        createUpdatePackage.OrganizationId = int.Parse(OrganizationId);
        if (CurrentTenant.Id == null)
        {
            createUpdatePackage.TenantId = _organizations.FirstOrDefault(x => x.Id == createUpdatePackage.OrganizationId).TenantId;

        }
        else
        {
            createUpdatePackage.TenantId = CurrentTenant.Id;
        }

        try
        {
            BlazorPackageValidations.MapToCreateUpdatePackage(
                createUpdatePackage,
                CustomPackageUiDto,
                NormalPackageUiDto,
                Snackbar);
            createUpdatePackage.Published = createUpdatePackage.Published || PackageValidations.CheckPackageTimeValiditity(createUpdatePackage.PublishFrom, createUpdatePackage.PublishTo);
            createUpdatePackage.PackageStatus = SubscriptionStatus.Draft;
            createUpdatePackage.Status = Status.Inactive;
            createUpdateUnitPackage.Package = createUpdatePackage;

            await PackagesAppService.CreateAsync(createUpdateUnitPackage);
            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.SUCCESS]} {L[AlertMessages.AlertMessages.ADD]} {createUpdatePackage.ArabicName}", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (AbpValidationException validationException)
        {
            foreach (var validationError in validationException.ValidationErrors)
            {
                SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.VAlIDATION_ERROR]}: {L[validationError.MemberNames.First()]} - {validationError.ErrorMessage}", Severity.Error);
            }
        }
        catch (BusinessException ex)
        {
            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]} {L[AlertMessages.AlertMessages.ADD]} : {ex.Message}", Severity.Error);
        }
        catch (Exception ex)
        {
            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]} {L[AlertMessages.AlertMessages.ADD]} : {ex.Message} ", Severity.Error);
        }
    }
    private void Cancel()
    {
        MudDialog.Cancel();
    }

   
}
