@using SmartParking.Packages
<div class="invoice-body d-flex flex-column justify-content-between">
    <h4>
        This is the receipt for payment of This is the receipt for payment of  @($"{Math.Round((Package.Price + (Package.Price * 0.15m)), 2)} ") SAR

    </h4>
    <div class="row">
        <div class="col-md-6 d-flex flex-column">
        </div>
        <div class="col-md-6 d-flex flex-column align-items-center">
            <strong>Hotel Name:</strong><p> @Package.OrganizationArabicName</p>
        </div>
        <div class="col-md-6 d-flex flex-column align-items-center">
            <strong>Hotel Address:</strong>
            <p> @OrganizationAddress</p>
        </div>
        <div class="col-md-6 d-flex flex-column">
            <strong>Package Category:</strong> <p>@Package.CustomerCategory</p>
        </div>
        <div class="col-md-6 d-flex flex-column align-items-center">
            <strong> Description:</strong><p>@Package.Description </p>
        </div>
    </div>
</div>

<div class=" d-flex justify-content-center align-items-center flex-row" style="background-color: beige; margin-top: 2rem; border-radius: 15px;">
    <div class="col-md-4 d-flex flex-column align-items-center justify-content-center">
        <h5>Subscription</h5>
        <h5>Package</h5>
    </div>
    <div class="col-md-4 d-flex flex-column align-items-center justify-content-center">
        <h5>Interval</h5>
        <h5>@Package.DurationOfPackage.ToString() Day (s)</h5>
    </div>
</div>


@code {
    [Parameter] public PackageDto? Package { get; set; }
    [Parameter] public string OrganizationAddress { get; set; }



}
