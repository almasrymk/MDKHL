@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Packages
@using System.Globalization
@inject IStringLocalizer<SmartParkingResource> L

<div class="invoice-body d-flex flex-column justify-content-center">

    <div class="row d-flex justify-content-center">
        <div class="col-md-6">
            <p>
                <strong>@L["OrganizationNameInvoicePopUp"]:</strong>
                @if (CultureInfo.CurrentCulture.Name == "ar")
                {
                    @OrganizationArabicName
                }
                else
                {
                    @OrganizationEnglishName
                }
            </p>
        </div>
        <div class="col-md-6">
            <p>
                <strong>@L["PlateNumber"]:</strong>
                @(CultureInfo.CurrentCulture.Name == "ar" ? Package.ArPlateNumber : Package.EnPlateNumber)
            </p>
        </div>
    </div>

    <div class="row d-flex justify-content-center mt-2">
        <div class="col-md-12 text-center">
            <p><strong>@L["OrganizationAddressInvoicePopUp"]:</strong> @OrganizationAddress</p>
        </div>
    </div>

    <div class="row d-flex justify-content-center mt-2">
        <div class="col-md-6">
            <p><strong>@L["PackageCode"]:</strong> @Package.PackageCode.ToString()</p>
        </div>

        <div class="col-md-6">
            <p>
                <strong>@L["Date"]:</strong>     @(Package.ActivationDateOfPackage.HasValue
                                ? Package.ActivationDateOfPackage.Value.ToString("dd/MM/yyyy")
                                : L["NoDate"])
            </p>
        </div>
    </div>

</div>

<div class=" d-flex justify-content-center align-items-center flex-row col-md-12 " style="background-color: beige; margin-top: 2rem; border-radius: 15px;">
    <div class="col-md-6 d-flex flex-column align-items-center justify-content-center">
        <h5>@L["Subscription"]</h5>
        <h5>@L["Package"]</h5>
    </div>
    <div class="col-md-6 d-flex flex-column align-items-center justify-content-center">
        <h5>@L["Duration"]</h5>
        <h5>@Package.DurationOfPackage @L["Days"]</h5>
    </div>
</div>