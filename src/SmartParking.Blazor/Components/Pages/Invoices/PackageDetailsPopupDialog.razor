@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Packages
@using System.Globalization
@inject IStringLocalizer<SmartParkingResource> L

<div class="invoice-body d-flex flex-column justify-content-center">

    <div class="row ">
        <div class="col-md-12 d-flex justify-content-center ">

            <div class="col-md-7">
                <p><strong>@L["Cashier No"]:</strong>
                  @CashierName
                </p>
            </div>

            <div class="col-md-5">
                <p><strong>@L["OrganizationNameInvoicePopUp"]:</strong>
                    @if(CultureInfo.CurrentCulture.Name== "ar")
                      {
                        @OrganizationArabicName
                      }
                      else
                      {
                        @OrganizationEnglishName
                      }
                      
                  </p>
            </div>
        </div>
        <div class="col-md-12 d-flex justify-content-center " >

            <div class="col-md-7">
                <p><strong>@L["OrganizationAddressInvoicePopUp"]:</strong> @OrganizationAddress</p>
            </div>         
            <div class="col-md-5">
            <p><strong>@L["PlateNumber"]:</strong> @Package.EnPlateNumber</p>
            </div>
        </div>
        <div class="col-md-12 d-flex justify-content-center ">
                <div class="col-md-7">
            <p><strong>@L["ActivationDate"]: </strong> @Package.ActivationDateOfPackage.ToString()</p>
                </div>

                <div class="col-md-5">
            <p><strong>@L["ExpiryDate"]:</strong> @Package.ExpiryDate.ToString()</p>
                </div>
        </div>
    </div>
</div>


<div class=" d-flex justify-content-center align-items-center flex-row col-md-12 " style="background-color: beige; margin-top: 2rem; border-radius: 15px;">
    <div class="col-md-6 d-flex flex-column align-items-center justify-content-center">
        <h5>@L["Subscription"]</h5>
        <h5>@L["Package"]</h5>
    </div>
    <div class="col-md-6 d-flex flex-column align-items-center justify-content-center">
        <h5>@L["Duration"]</h5>
        <h5>@Package.DurationOfPackage @L["Days"]</h5>
    </div>
</div>