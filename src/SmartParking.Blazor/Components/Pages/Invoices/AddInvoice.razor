@page "/invoices/add"
@using Microsoft.Extensions.Localization
@using SmartParking.Garages
@using SmartParking.Invoices
@using SmartParking.Localization
@using SmartParking.Organizations
@using SmartParking.Vehicles
@using System.Globalization
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@inject IInvoiceAppService InvoiceAppService
@inject IOrganizationsAppService OrganizationAppService
@inject IGarageAppService GarageAppService
@inject IVehiclesAppService VehiclesAppService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@layout Shared.ProfileLayout

<PageTitle>@L["AddInvoices"]</PageTitle>




<MudItem>
    <MudGrid>
        <MudItem sm="8">
            <MudPaper Class="h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">
                <MudText Typo="Typo.h6" Class="fw-bold">@L["Invoices"]</MudText>
                <MudForm Class="flex-grow-1 mt-4" @ref="form">
                    <MudGrid>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="input.InvoiceNumber" Placeholder=@L["Type Here"] Label=@L["InvoiceNumber"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="int" InputType="InputType.Number" @bind-Value="input.TotalHours" Placeholder=@L["Type Here"] Label=@L["TotalHours"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="decimal" InputType="InputType.Number" @bind-Value="input.InvoicePrice" Placeholder=@L["Type Here"] Label=@L["InvoicePrice"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="input.PlateNumber" Placeholder=@L["Type Here"] Label=@L["PlateNumber"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudSelect Variant="Variant.Text"
                                       Label=@L["Organizations"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       Clearable="true"
                                       Required="true"
                                       @bind-Value="input.OrganizationId">

                                @foreach (var organization in organizations)
                                {
                                    <MudSelectItem Value="@organization.Id">@organization.EnglishName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        @if (CultureInfo.CurrentCulture.Name == "en")
                        {
                        <MudItem sm="4">
                            <MudSelect Variant="Variant.Text"
                                       Label=@L["Garages"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"] 
                                       Clearable="true"
                                       Required="true"
                                       @bind-Value="input.GarageId">

                                @foreach (var garage in garages)
                                {
                                    <MudSelectItem Value="@garage.Id">@garage.NameEn</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        }
                        else
                        {

                            <MudItem sm="4">
                                <MudSelect Variant="Variant.Text"
                                           Label=@L["Garages"]
                                           Placeholder=@L["Choose"]
                                           HelperText=@L["Helper Text"]
                                           Clearable="true"
                                           Required="true"
                                           @bind-Value="input.GarageId">

                                    @foreach (var garage in garages)
                                    {
                                        <MudSelectItem Value="@garage.Id">@garage.NameAr</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            
                        }


                        <MudDivider Style="border-top:1px solid #505254; margin:50px 0px;" />


                    </MudGrid>

                    <MudItem class="d-flex justify-content-between mt-auto">
                        <MudButton OnClick="Back" Variant="Variant.Filled" Color="MudBlazor.Color.Dark">@L["Back"]</MudButton>
                        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Disabled="@(form == null || !form.IsValid)" OnClick="Submit">@L["Print"]</MudButton>
                    </MudItem>
                </MudForm>

            </MudPaper>
        </MudItem>
        <MudItem sm="4">
            <MudPaper Class="h-100 p-3  w-100 h-100 main-layout-paper d-flex flex-column justify-content-between" Style="background-color: #F2F2F2;">

                <MudText Typo="Typo.h6">@L["ChoosePaymentMethod"]</MudText>
                <MudGrid Class="my-4">
                    <MudItem md="6" lg="4">
                        <input type="radio" class="visually-hidden radio-block-input" name="payment" id="visa"/>
                        <label for="visa" class="bg-white radio-block">
                            <MudImage Src="images/payment/visa.jpg"/>
                        </label>
                    </MudItem>
                    <MudItem md="6" lg="4">
                        <input type="radio" class="visually-hidden radio-block-input" name="payment" id="mada" />
                        <label for="mada" class="bg-white radio-block">
                            <MudImage Src="images/payment/mada.png" />
                        </label>
                    </MudItem>
                    <MudItem md="6" lg="4">
                        <input type="radio" class="visually-hidden radio-block-input" name="payment" id="pay" />
                        <label for="pay" class="bg-white radio-block">
                            <MudImage Src="images/payment/apple-pay.png" />
                        </label>
                    </MudItem>
                    <MudItem md="6" lg="4">
                        <input type="radio" class="visually-hidden radio-block-input" name="payment" id="stc" />
                        <label for="stc" class="bg-white radio-block">
                            <MudImage Src="images/payment/stc.png" />
                        </label>
                    </MudItem>
                    
                    <MudItem md="6" lg="4">
                        <input type="radio" class="visually-hidden radio-block-input" name="payment" id="american" />
                        <label for="american" class="bg-white radio-block">
                            <MudImage Src="images/payment/american.png" />
                        </label>
                    </MudItem>
                    <MudItem md="6" lg="4">
                        <input type="radio" class="visually-hidden radio-block-input" name="payment" id="pos" />
                        <label for="pos" class="bg-white radio-block">
                            <MudImage Src="images/payment/pos.png" />
                        </label>
                    </MudItem>
                </MudGrid>
                <MudItem>
                    <MudText Class="mb-3" Typo="Typo.h6">@L["Discount"]</MudText>
                    <MudItem Class="d-flex justify-content-between align-items-end">
                        <MudTextField @bind-Value="code" Placeholder="@L["TypeDiscountCode"]" Label="@L["AddDiscount%"]" Adornment="Adornment.End" AdornmentText="Apply" AdornmentColor="MudBlazor.Color.Secondary"></MudTextField>
                        @* <MudLink Underline="Underline.Always" Color="MudBlazor.Color.Tertiary">@L["Apply"]</MudLink> *@


                    </MudItem>
                </MudItem>
                <MudText Class="mb-3 mt-3" Typo="Typo.h6">@L["Summary"]</MudText>

                <MudGrid>
                    <MudItem xs="6">
                        <MudText Typo="Typo.body2">@L["DueValue"]</MudText>
                    </MudItem>
                    <MudItem xs="6" Class="text-end">
                        <MudText Typo="Typo.body2">620.00 @L["SAR"]</MudText>
                    </MudItem>

                    <MudItem xs="6">
                        <MudText Typo="Typo.body2">@L["VAT"]</MudText>
                    </MudItem>
                    <MudItem xs="6" Class="text-end">
                        <MudText Typo="Typo.body2">45.00 @L["SAR"]</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.body2">@L["Discount"]</MudText>
                    </MudItem>
                    <MudItem xs="6" Class="text-end">
                        <MudText Typo="Typo.body2">-400.00 @L["SAR"]</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Color="MudBlazor.Color.Primary" Typo="Typo.body1" Class="fw-bold">@L["Total"]</MudText>
                    </MudItem>
                    <MudItem xs="6" Class="text-end">
                        <MudText Typo="Typo.body1" Color="MudBlazor.Color.Primary" Class="fw-bold">265.00 @L["SAR"]</MudText>
                    </MudItem>
                </MudGrid>

                <div class="d-flex flex-column gap-2 mt-5">
                   
                        <MudButton FullWidth="true" Variant="Variant.Filled" Color="MudBlazor.Color.Primary">@L["CONFIRM"]</MudButton>
                    
                        <MudButton FullWidth="true" Variant="Variant.Text" Color="MudBlazor.Color.Dark">@L["CANCEL"]</MudButton>
                  
                </div>


            </MudPaper>
        </MudItem>

    </MudGrid>
</MudItem>