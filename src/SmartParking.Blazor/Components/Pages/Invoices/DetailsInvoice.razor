@page "/invoices/details/{Id:int}"
@using Microsoft.Extensions.Localization
@using SmartParking.Garages
@using SmartParking.Invoices
@using SmartParking.Localization
@using SmartParking.Organizations
@using SmartParking.Payments
@using SmartParking.Permissions.InvoicesPermissions
@using SmartParking.Vehicles
@using System.Globalization
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@inject IInvoiceAppService InvoiceAppService
@inject IOrganizationsAppService OrganizationAppService
@inject IGarageAppService GarageAppService
@inject IVehiclesAppService VehiclesAppService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject IPaymentAppService PaymentAppSerivce
@inject IAuthorizationService AuthorizationService

<PageTitle>@L["InvoiceDetails"]</PageTitle>

<MudItem>
    <MudGrid>
        <MudItem sm="7">
            <MudPaper Class="h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">
                <MudText Typo="Typo.h6" Class="fw-bold">@L["InvoiceDetails"]</MudText>
                <MudForm Class="flex-grow-1 mt-4">
                    <MudGrid>

                        <MudItem sm="4">
                            <MudTextField @bind-Value="TotalHours"
                            For="@(() => TotalHours)"
                            Immediate="true"
                            Variant="Variant.Text"
                            Label="@L["TotalHours"]"
                            Disabled />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField @bind-Value="InvoicePrice"
                            For="@(() => InvoicePrice)"
                            Immediate="true"
                            Variant="Variant.Text"
                            Label="@L["InvoicePrice"]"
                            Disabled />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField @bind-Value="LocalizedInvoiceType"
                            Immediate="true"
                            Variant="Variant.Text"
                            Label="@L["InvoiceType"]"
                            Disabled />
                        </MudItem>

                          @if (CultureInfo.CurrentCulture.Name == "ar")
                          {
                            <MudItem sm="4">

                                <MudTextField @bind-Value="OrganizationArabicName"
                                Immediate="true"
                                Variant="Variant.Text"
                                Label="@L["OrganizationName"]"
                                Disabled />
                                </MudItem>
                            <MudItem sm="4">
                                <MudTextField @bind-Value="GarageArabicName"
                                              Immediate="true"
                                              Variant="Variant.Text"
                                              Label="@L["Garage Name"]"
                                              Disabled />
                            </MudItem>
                          }else{

                            <MudItem sm="4">

                                <MudTextField @bind-Value="OrganizationEnglishName"
                                              Immediate="true"
                                              Variant="Variant.Text"
                                              Label="@L["OrganizationName"]"
                                              Disabled />
                            </MudItem>
                            <MudItem sm="4">
                                <MudTextField @bind-Value="GarageEnglishName"
                                              Immediate="true"
                                              Variant="Variant.Text"
                                              Label="@L["Garage Name"]"
                                              Disabled />
                            </MudItem>
                          }
                        
                        
                        <MudItem sm="4">
                            <MudTextField @bind-Value="PlateNumber"
                            For="@(() => PlateNumber)"
                            Immediate="true"
                            Variant="Variant.Text"
                            Label="@L["PlateNumber"]"
                            Disabled />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Value="EntranceTime.ToString()"
                            Immediate="true"
                            Variant="Variant.Text"
                            Label="@L["EntranceTime"]"
                            Disabled />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Value="InvoiceTime.ToString()"
                            Immediate="true"
                            Variant="Variant.Text"
                            Label="@L["ExitTime"]"
                            Disabled />
                        </MudItem>

                        <MudDivider Style="border-top:1px solid #505254; margin:50px 0px;" />


                    </MudGrid>

                    <MudItem class="d-flex justify-content-between mt-auto">
                        <MudButton OnClick="@Back" Variant="Variant.Filled" Color="MudBlazor.Color.Dark">@L["Back"]</MudButton>
                    </MudItem>
                </MudForm>

            </MudPaper>
        </MudItem>

        <MudItem sm="5">
            <MudPaper Class="h-100 p-3  w-100 h-100 main-layout-paper d-flex flex-column justify-content-between" Style="background-color: #F2F2F2;">
                <MudItem>

                <MudText Class="mb-3 mt-3" Typo="Typo.h5">@L["Summary"]</MudText>

                <MudGrid>
                    <MudItem xs="6">
                        <MudText Typo="Typo.h6">@L["DueValue"]</MudText>
                    </MudItem>
                    <MudItem xs="6" Class="text-end">
                        <MudText Typo="Typo.h6">@InvoicePrice @L["SAR"]</MudText>
                    </MudItem>

                    <MudItem xs="6">
                        <MudText Typo="Typo.h6">@L["VAT"]</MudText>
                    </MudItem>
                    <MudItem xs="6" Class="text-end">
                        <MudText Typo="Typo.h6">@($"{ Math.Round((InvoicePrice * 0.15m),2)} {L["SAR"]}")</MudText>
                    </MudItem>

                    <MudItem xs="6">
                        <MudText Color="MudBlazor.Color.Tertiary" Typo="Typo.h6">@L["Total"]</MudText>
                    </MudItem>
                    <MudItem xs="6" Class="text-end">
                        <MudText Typo="Typo.h6" Color="MudBlazor.Color.Tertiary">
                            @($"{Math.Round((InvoicePrice + (InvoicePrice * 0.15m)),2)} {L["SAR"]}")
                        </MudText>
                    </MudItem>
                </MudGrid>
                </MudItem>

                <MudItem>

                @if (AuthorizationService.IsGrantedAnyAsync(InvoicePermission.Confirm).Result){

                    <MudGrid Class="mt-4">
                        <MudItem xs="12" Class="text-center">
                            <MudButton FullWidth="true" Variant="Variant.Filled" Disabled="IsPaid ||InvoicePrice==0" Color="MudBlazor.Color.Primary" OnClick="PayInvoice"> @(IsPaid ?L["Paid"] :L["CONFIRM"])  </MudButton>
                        </MudItem>
                    </MudGrid>
                }
                </MudItem>


            </MudPaper>
        </MudItem>

    </MudGrid>
</MudItem>

