@using SmartParking.Invoices

<div class="invoice-body d-flex flex-column justify-content-center">
 
    <div class="row ">
        <div class="col-md-12 d-flex justify-content-center ">
           
            <div class="col-md-7">
                <p><strong>Cashier No.:</strong> @Invoice.GarageArabicName</p>
            </div>
            
            <div class="col-md-5">
                <p><strong>Hotel Name:</strong> @Invoice.OrganizationArabicName</p>
            </div>
        </div>
        <div class="col-md-12 d-flex justify-content-center " >
          
            <div class="col-md-7">
                <p><strong>Hotel Address:</strong> @OrganizationAddress</p>
            </div>
           
            <div class="col-md-5">
                <p><strong>Plate Number:</strong> @Invoice.PlateNumber</p>
            </div>
        </div>
        <div class="col-md-12 d-flex justify-content-center ">
          
           
            <div class="col-md-7">
                <p><strong>Entry Date:</strong> @Invoice.EntranceTime.ToString()</p>
            </div>
            
            <div class="col-md-5">
                <p><strong>Exit Date:</strong> @Invoice.InvoiceTime.ToString()</p>
            </div>
            
        </div>
    </div>
</div>

<div class=" d-flex justify-content-center align-items-center flex-row col-md-12 " style="background-color: beige; margin-top: 2rem; border-radius: 15px;">
    <div class="col-md-6 d-flex flex-column align-items-center justify-content-center">
        <h5>Subscription</h5>
        <h5>Hour</h5>
    </div>
    <div class="col-md-6 d-flex flex-column align-items-center justify-content-center">
        <h5>Interval</h5>
        <h5>@Invoice.TotalHours Hour(s)</h5>
    </div>
</div>



@code {
    [Parameter] public string OrganizationAddress { get; set; }
    [Parameter] public InvoiceDto? Invoice { get; set; }


}
