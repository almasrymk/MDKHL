@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Currency
@using SmartParking.Enums
@using SmartParking.Localization
@using SmartParking.Permissions.GarageTransactionPermissions
@using SmartParking.Permissions.InvoicesPermissions
@using SmartParking.Permissions.CheckoutPermissions
@using Discounts
@using System.Globalization
@using SmartParking.Validations
@inject IStringLocalizer<SmartParkingResource> L
@inject IAuthorizationService AuthorizationService
@inject ISnackbar Snackbar

<MudItem sm="ComponentSize">
    <MudPaper Class="h-100 p-3  w-100 h-100 main-layout-paper d-flex flex-column justify-content-between" Style="background-color: #F2F2F2;">
        <MudItem>

            <MudText Class="mb-3 mt-3 fw-bold" Typo="Typo.h5">@L["Summary"]</MudText>

            <MudGrid>
                <MudItem xs="6">
                    <MudText Typo="Typo.h6">@L["DueValue"]</MudText>
                </MudItem>
                <MudItem xs="6" Class="text-end">
                    <MudText Typo="Typo.h6">
                        @((MarkupString)$"{InvoicePrice.Value} {CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "14px")}")
                    </MudText>
                </MudItem>

                <MudItem xs="6">
                    <MudText Typo="Typo.h6">@L["VAT"]</MudText>
                </MudItem>
                <MudItem xs="6" Class="text-end">
                    <MudText Typo="Typo.h6">
                        @((MarkupString)$"{Math.Round((InvoicePrice.Value * 0.15m), 2)} {CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "14px")}")
                    </MudText>
                </MudItem>

                <MudItem xs="6">
                    <MudText Color="MudBlazor.Color.Tertiary" Typo="Typo.h6">@L["Total"]</MudText>
                </MudItem>
                <MudItem xs="6" Class="text-end">
                    <MudText Typo="Typo.h6" style="@(OnChooseDiscount ? "text-decoration: line-through;" : "")">
                        @((MarkupString)$"{InvoicePriceWithVat} {CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "14px")}")
                    </MudText>
                </MudItem>
                @if (OnChooseDiscount)
                {

                <MudItem xs="6">
                            <MudText Color="MudBlazor.Color.Tertiary" Typo="Typo.h6">@L["After"] @L["Discount"]</MudText>
                        </MudItem>
                        <MudItem xs="6" Class="text-end">
                            <MudText Typo="Typo.h6" Color="MudBlazor.Color.Tertiary">
                                @((MarkupString)$"{InvoicePriceAfterDiscount} {CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "14px")}")
                            </MudText>
                 </MudItem>
                }

                 

            </MudGrid>
        </MudItem>

        <MudItem>

            <MudGrid Class="mt-4">
                @if (AuthorizationService.IsGrantedAnyAsync(CheckoutPermissions.Discount).Result)
                {

                    <MudItem sm="12" md="12">
                        <div style="display: flex; flex-direction: column;font-weight:bold">
                                <label style="font-size: 0.75rem; margin-bottom: 4px;">
                                    @L["SecondHourPrice"]
                                    @((MarkupString)CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "15px"))
                                </label>
                               <MudNumericField T="decimal" Validation="@( (decimal value) => NumbersValidations.ValidateInvoice(value,InvoicePriceWithVat))" HideSpinButtons="true" ValueChanged="OnAddDiscount" Label="@L["Discount"]" Variant="Variant.Text" Culture="CultureInfo.InvariantCulture" />
                            </div>
                    </MudItem>
                }

                
                @if (HasConfirmPermission
                && (!IsPaid || InvoicePrice == 0))
                {
                    <MudItem xs="@(ConfirmSize)" Class="d-flex flex-row justify-content-center">
                        <MudRadioGroup @bind-Value="@PaymentMethod" Class="d-inline-flex align-content-center">
                            <MudRadio Value="@(Enums.PaymentMethod.Cash)" Color="MudBlazor.Color.Primary">@L["Cash"]</MudRadio>
                            <MudRadio Value="@(Enums.PaymentMethod.Cash)" Color="MudBlazor.Color.Secondary">@L["POS"]</MudRadio>
                        </MudRadioGroup>
                    </MudItem>



                    <MudItem xs="@(ConfirmSize)" Class="text-center">
                        <MudButton FullWidth="true" Variant="Variant.Filled" Disabled="IsPaid ||InvoicePrice==0 || !CanPayInvoice" Color="MudBlazor.Color.Primary" OnClick="PayInvoice"> @(IsPaid ? L["Paid"] : L["CONFIRM"])  </MudButton>
                    </MudItem>
                }

                
                @if (ShowOpenGate)
                {
                    <MudItem xs="12" Class="d-flex justify-content-between mt-1">

                        <MudItem xs="@(ConfirmSize/2)" Class="text-center pe-1">
                            <MudButton FullWidth="true" Variant="Variant.Filled" Color="MudBlazor.Color.Error" Disabled="NoInvoice" OnClick="Cancel">@L["Cancel"]</MudButton>
                        </MudItem>
                     @if (AuthorizationService.IsGrantedAnyAsync(CheckoutPermissions.OpenGate).Result){


                        <MudItem xs="@(ConfirmSize/2)" Class="text-center ps-1">
                            <MudButton FullWidth="true" Variant="Variant.Filled" Color="MudBlazor.Color.Dark" Disabled="NoInvoice" OnClick="OpenGate">@L["OpenGate"]</MudButton>
                        </MudItem>
                     }
                    </MudItem>

                }
            </MudGrid>
        </MudItem>
    </MudPaper>
</MudItem>
