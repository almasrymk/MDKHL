@using Microsoft.Extensions.Localization
@using SmartParking.Enums
@using SmartParking.Localization
@using SmartParking.Permissions.InvoicesPermissions
@using Discounts
@using System.Globalization
@inject IStringLocalizer<SmartParkingResource> L
@inject IAuthorizationService AuthorizationService


<MudItem sm="ComponentSize">
    <MudPaper Class="h-100 p-3  w-100 h-100 main-layout-paper d-flex flex-column justify-content-between" Style="background-color: #F2F2F2;">
        <MudItem>

            <MudText Class="mb-3 mt-3 fw-bold" Typo="Typo.h5">@L["Summary"]</MudText>

            <MudGrid>
                <MudItem xs="6">
                    <MudText Typo="Typo.h6">@L["DueValue"]</MudText>
                </MudItem>
                <MudItem xs="6" Class="text-end">
                    <MudText Typo="Typo.h6">@InvoicePrice.Value @L["SAR"]</MudText>
                </MudItem>

                <MudItem xs="6">
                    <MudText Typo="Typo.h6">@L["VAT"]</MudText>
                </MudItem>
                <MudItem xs="6" Class="text-end">
                    <MudText Typo="Typo.h6">@($"{Math.Round((InvoicePrice.Value * 0.15m), 2)} {L["SAR"]}")</MudText>
                </MudItem>

                <MudItem xs="6">
                    <MudText Color="MudBlazor.Color.Tertiary" Typo="Typo.h6">@L["Total"]</MudText>
                </MudItem>
                <MudItem xs="6" Class="text-end">
                    <MudText Typo="Typo.h6" style="@(OnChooseDiscount ? "text-decoration: line-through;" : "")">
                        @($"{InvoicePriceWithVat} {L["SAR"]}")
                    </MudText>
                </MudItem>
                @if(OnChooseDiscount){
                    <MudItem xs="6">
                        <MudText Color="MudBlazor.Color.Tertiary" Typo="Typo.h6">@L["After"]  @L["Discount"]</MudText>
                    </MudItem>
                    <MudItem xs="6" Class="text-end">
                        <MudText Typo="Typo.h6" Color="MudBlazor.Color.Tertiary">
                            @($"{InvoicePriceAfterDiscount} {L["SAR"]}")
                        </MudText>
                    </MudItem>
                }
            </MudGrid>
        </MudItem>

        <MudItem>
           
            <MudGrid Class="mt-4">
                @if (AuthorizationService.IsGrantedAnyAsync(InvoicePermission.Confirm).Result && (!IsPaid || InvoicePrice == 0))
                {
                    <MudItem sm="12" md="12">
                        <MudNumericField T="decimal" HideSpinButtons="true" ValueChanged="OnAddDiscount" Label="@L["Discount"]" Variant="Variant.Text" Min="decimal.Zero" Max="InvoicePriceWithVat" Culture="CultureInfo.InvariantCulture" />
                    </MudItem>

                }
                @if (AuthorizationService.IsGrantedAnyAsync(InvoicePermission.Confirm).Result)
                {
                    @if (!IsPaid || InvoicePrice==0)                    
                    {
                        <MudItem xs="@(ConfirmSize)" Class="d-flex flex-row justify-content-center">
                            <MudRadioGroup @bind-Value="@PaymentMethod" Class="d-inline-flex align-content-center">
                                <MudRadio Value="@(Enums.PaymentMethod.Cash)" Color="MudBlazor.Color.Primary">@L["Cash"]</MudRadio>
                                <MudRadio Value="@(Enums.PaymentMethod.Cash)" Color="MudBlazor.Color.Secondary">@L["POS"]</MudRadio>
                            </MudRadioGroup>
                        </MudItem>

                    }


                    <MudItem xs="@(ConfirmSize)" Class="text-center">
                        <MudButton FullWidth="true" Variant="Variant.Filled" Disabled="IsPaid ||InvoicePrice==0" Color="MudBlazor.Color.Primary" OnClick="PayInvoice"> @(IsPaid ? L["Paid"] : L["CONFIRM"])  </MudButton>
                    </MudItem>

                }
                @if (ShowOpenGate)
                {
                    <MudItem xs="12" Class="d-flex justify-content-between mt-1">

                        <MudItem xs="@(ConfirmSize/2)" Class="text-center pe-1">
                            <MudButton FullWidth="true" Variant="Variant.Filled" Color="MudBlazor.Color.Error" Disabled="NoInvoice" OnClick="Cancel">@L["Cancel"]</MudButton>
                        </MudItem>
                        <MudItem xs="@(ConfirmSize/2)" Class="text-center ps-1">
                            <MudButton FullWidth="true" Variant="Variant.Filled" Color="MudBlazor.Color.Dark" Disabled="NoInvoice" OnClick="OpenGate">@L["OpenGate"]</MudButton>
                        </MudItem>
                    </MudItem>

                }
            </MudGrid>
        </MudItem>


    </MudPaper>
</MudItem>

@code {
    [Parameter] public bool IsPaid { get; set; }
    [Parameter] public bool NoInvoice { get; set; }
    [Parameter] public bool ShowOpenGate { get; set; }
    [Parameter] public decimal? InvoicePrice { get; set; }
    [Parameter] public EventCallback PayInvoice { get; set; }
    [Parameter] public EventCallback OpenGate { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }
    [Parameter] public PaymentMethod PaymentMethod { get; set; }
    [Parameter] public int ConfirmSize { get; set; }
    [Parameter] public int ComponentSize { get; set; }
    [Parameter]
    public EventCallback<decimal> OnValueSelected { get; set; }

    public decimal InvoicePriceAfterDiscount { get; set; }
    public decimal InvoicePriceWithVat { get; set; }
    public bool OnChooseDiscount { get; set; } = false;


    protected override void OnParametersSet()
    {
        InvoicePriceWithVat = Math.Round((InvoicePrice.Value + (InvoicePrice.Value * 0.15m)), 2);
        base.OnParametersSet();
    }
    private async Task OnAddDiscount(decimal discountValue)
    {
        InvoicePriceAfterDiscount = InvoicePriceWithVat - discountValue;
        if(discountValue!=default)
            OnChooseDiscount = true;
        else
            OnChooseDiscount = false;

        await OnValueSelected.InvokeAsync(discountValue);
    }


}
