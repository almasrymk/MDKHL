@using Microsoft.Extensions.Localization
@using SmartParking.Currency
@using SmartParking.Localization
@inject IStringLocalizer<SmartParkingResource> L
<div class="col-md-6">
    <div class="d-flex flex-row">
        <p>
            <strong>@L["TotalPreVAT"]:</strong>
            @((MarkupString)$"{Amount} {CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "14px")}")
        </p>
    </div>
    @if (Discount!="0")
    {
        <div class="d-flex flex-row">
            <p >
                <strong>@L["Discount"]:</strong>
                @((MarkupString)$"{Discount} {CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "14px")}")
            </p>
        </div>
    }

    <div class="d-flex flex-row">
        <p>
            <strong>@L["VAT"] 15%:</strong>
            @((MarkupString)$"{Vat} {CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "14px")}")
        </p>
    </div>

     <div class="d-flex flex-row">
         <p>
            <strong>@L["Total"] :</strong>
             @((MarkupString)$"{Total} {CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "14px")}")
         </p>
     </div>
    

</div>
