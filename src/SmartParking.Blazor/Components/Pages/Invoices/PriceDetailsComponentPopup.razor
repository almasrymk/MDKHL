<div class="col-md-6">
    <div class="d-flex flex-row">
        <p><strong>Total Pre VAT:</strong> @Price SAR</p>
    </div>
    <div class="d-flex flex-row">
        <p><strong>VAT 15%:</strong> @($"{Math.Round((Price * 0.15m), 2)} ") SAR</p>
    </div>
    <div class="d-flex flex-row">
        <p>
            <strong>Total Include VAT:</strong>
            @($"{Math.Round((Price + (Price * 0.15m)), 2)} ") SAR
        </p>
    </div>
</div>

@code {
    [Parameter] public Decimal Price { get; set; }


}
