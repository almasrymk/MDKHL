@using Microsoft.Extensions.Localization
@using SmartParking.Currency
@using SmartParking.Localization
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar

<MudItem sm="ComponentSize">
    <MudPaper Class="h-100 p-3 w-100 d-flex flex-column justify-content-between" Style="background-color: #F2F2F2;">
        <MudItem>
            <MudText Class="mb-3 fw-bold" Typo="Typo.h5">@L["Summary"]</MudText>
            <MudGrid>
                <MudItem xs="6">
                    <MudText Typo="Typo.h6">@L["DueValue"]</MudText>
                </MudItem>
                <MudItem xs="6" Class="text-end">
                    <MudText Typo="Typo.h6">
                        @((MarkupString)$"{InvoicePrice} {CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "16px")}")
                    </MudText>
                </MudItem>

                <MudItem xs="6">
                    <MudText Typo="Typo.h6">@L["VAT"]</MudText>
                </MudItem>
                <MudItem xs="6" Class="text-end">
                    <MudText Typo="Typo.h6">
                        @((MarkupString)$"{VAT} {CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "16px")}")
                    </MudText>
                </MudItem>

                <MudItem xs="6">
                    <MudText Typo="Typo.h6">@L["Total"]</MudText>
                </MudItem>
                <MudItem xs="6" Class="text-end">
                    <MudText Typo="Typo.h6">
                        @((MarkupString)$"{InvoicePriceWithVat} {CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "16px")}")
                    </MudText>
                </MudItem>

            </MudGrid>
        </MudItem>
        <MudItem>
            <MudGrid Class="mt-4">
                <MudItem xs="6" Class="pe-1 text-center">
                    <MudButton FullWidth="true" Variant="Variant.Filled" Color="MudBlazor.Color.Dark" OnClick="Cancel">
                        @L["Cancel"]
                    </MudButton>
                </MudItem>
                <MudItem xs="6" Class="ps-1 text-center">
                    <MudButton FullWidth="true" Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Disabled="IsPaid || InvoicePrice == 0" OnClick="PayInvoice">
                        @L["Confirm"]
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudItem>
    </MudPaper>
</MudItem>

@code {
    [Parameter] public bool IsPaid { get; set; }
    [Parameter] public decimal? InvoicePrice { get; set; }
    [Parameter] public EventCallback PayInvoice { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }
    [Parameter] public int ComponentSize { get; set; }

    public decimal InvoicePriceWithVat { get; set; }
    public decimal VAT => Math.Round((InvoicePrice ?? 0) * 0.15m, 2);

    protected override void OnParametersSet()
    {
        InvoicePriceWithVat = Math.Round((InvoicePrice ?? 0) + VAT, 2);
    }
}
