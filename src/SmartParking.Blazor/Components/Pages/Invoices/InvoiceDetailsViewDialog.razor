@using SmartParking.Invoices
@using SmartParking.PDF
@using Volo.Abp.MultiTenancy
@inject IInvoiceAppService InvoiceAppService
@inject ICurrentTenant currentTenant
@inject IPDFGeneratorAppService PdfGenetrayorAppService
 <div class="mud-modal">
    <div class="title-content d-flex justify-content-center align-items-center">
        <h2 class="fw-bold">Invoice @Invoice.InvoiceNumber</h2>
    </div>
    <div class="dialog-content">
        <div class="main-layout-paper d-flex flex-column p-3" style="width: 100%; height: 100%; margin-top: 20px;">
            <div class="d-flex justify-content-center align-items-center" style="margin-top: 20px;">
                <div style="width: 120px;">
                    <img src="images/logo/MDHKL_01.png" alt="Logo" />
                </div>
                
            </div>

            <div class="invoice-header d-flex flex-column flex-grow-1 h-100 p-3 justify-content-center align-items-center">
                <h3>***Simplified tax invoice***</h3>
                <div class="d-flex flex-row">
                    <h5 class="fw-bold">VAT:</h5>
                    <h5>@CommercialRegisteration</h5>
                </div>
            </div>

            <div class="invoice-body d-flex flex-column justify-content-between">
                <h4>
                    This is the receipt for payment of This is the receipt for payment of @($"{(int)(Invoice.InvoicePrice + (Invoice.InvoicePrice * 0.14m))}") SAR
                    
                </h4>
                <div class="row">
                    <div class="col-md-6 d-flex flex-column">
                        <strong>Payment Number:</strong><p>@Invoice.InvoiceNumber </p>
                    </div>
                    <div class="col-md-6 d-flex flex-column align-items-center">
                        <strong>Hotel Name:</strong><p> @Invoice.OrganizationArabicName</p>
                    </div>
                    <div class="col-md-6 d-flex flex-column">
                        <strong>Cashier No.:</strong><p> @Invoice.GarageName - </p>
                    </div>
                    <div class="col-md-6 d-flex flex-column align-items-center">
                        <strong>Hotel Address:</strong>
                        <p> </p>
                    </div>
                    <div class="col-md-12 d-flex flex-column">
                        <strong>Payment Date:</strong><p> @DateTime.UtcNow.ToString()</p>
                    </div>
                    <div class="col-md-12 d-flex flex-column">
                        <strong>Plate Number:</strong> <p>@Invoice.PlateNumber</p>
                    </div>
                    <div class="col-md-6 d-flex flex-column">
                        <strong>Entry Date:</strong> <p>@Invoice.EntranceTime.ToString()</p>
                    </div>
                    <div class="col-md-6 d-flex flex-column align-items-center">
                        <strong>Exit Date:</strong><p>@Invoice.InvoiceTime.ToString() </p>
                    </div>
                </div>
            </div>

            <div class=" d-flex justify-content-center align-items-center flex-row" style="background-color: beige; margin-top: 2rem; border-radius: 15px;">
                    <div class="col-md-4 d-flex flex-column align-items-center justify-content-center">
                        <h5>Subscription</h5>
                        <h5>Hour</h5>
                    </div>
                <div class="col-md-4 d-flex flex-column align-items-center justify-content-center">
                        <h5>Quota</h5>
                    <h5>@((int) Invoice.InvoicePrice/Invoice.TotalHours) Hour SAR/Hour</h5>
                    </div>
                <div class="col-md-4 d-flex flex-column align-items-center justify-content-center">
                        <h5>Interval</h5>
                        <h5>@Invoice.TotalHours Hour</h5>
                    </div>
            </div>

            <div class="total-info" style="margin-top: 2rem;">
                <div class="row">
                    <div class="col-md-6">
                        <div class="d-flex flex-row">
                            <p><strong>Total Pre VAT:</strong> @Invoice.InvoicePrice SAR</p>
                        </div>
                        <div class="d-flex flex-row">
                            <p><strong>VAT 14%:</strong> @($"{Math.Round((Invoice.InvoicePrice * 0.14m),2)} ") SAR</p>
                        </div>
                        <div class="d-flex flex-row">
                            <p>
                                <strong>Total Include VAT:</strong>
                                @($"{Math.Round((Invoice.InvoicePrice + (Invoice.InvoicePrice * 0.14m)),2)} ") SAR
                            </p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex flex-row justify-content-end">
                            <div style="width: 120px;">
                                <img src="@imagepath" alt="Logo" style="width:120px;" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>
@code {
    [Parameter] public InvoiceDto Invoice { get; set; } 
    [Parameter] public string CommercialRegisteration { get; set; }
    [Parameter] public int ID { get; set; }
    public string imagepath { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (currentTenant.Id == null)
        {

            imagepath = await InvoiceAppService.GetInvoiceQRCodeForMDKHL(ID);
        }
        else
        {
            imagepath = await InvoiceAppService.GetInvoiceQRCodeForOrganization(ID);

        }
        var pdf = await PdfGenetrayorAppService.GenerateInvoicePdfAsync(ID, CommercialRegisteration, imagepath);

        await base.OnInitializedAsync();


    }

}
