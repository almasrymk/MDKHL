@using Microsoft.AspNetCore.Mvc
@using SmartParking.Invoices
@using SmartParking.Organizations
@using SmartParking.PDF
@using System.IO
@using SmartParking.Packages
@using Volo.Abp.MultiTenancy
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@inject IStringLocalizer<SmartParkingResource> L
@inject IInvoiceAppService InvoiceAppService
@inject ICurrentTenant currentTenant
@inject IPDFGeneratorAppService PdfGenetrayorAppService
@inject IOrganizationsAppService OrganizationService
<div class="mud-modal">

    <div class="title-content d-flex justify-content-center align-items-center">

        <InvoiceDetailsPopupHeader Title="@L[@title]" Description="@description" />
    </div>



    <div class="dialog-content">
        <div class="main-layout-paper d-flex flex-column p-3" style="width: 100%; height: 100%; margin-top: 20px;">
            <div class="d-flex justify-content-around align-items-center" style="margin-top: 20px;">
                <div style="width: 120px;">
                    <img src="images/logo/MDHKL_01.png" width="200" alt="Logo" />
                </div>
                <div style="width: 120px;">
                    <img src="@OrganizationPicture" width="200" alt="Logo" /> 
                </div>
            </div>
            <div class="invoice-header d-flex flex-column flex-grow-1 h-100 p-3 justify-content-center align-items-center">
                <h3>*** @L["SimplifiedTaxInvoice"] ***</h3>
                <div class="d-flex flex-row">
                    <h5 class="fw-bold">@L["VAT"]:</h5>
                    <h5>@CommercialRegisteration</h5>
                </div>
                <div class="align-items-center justify-content-center">
                    <h4 class="text-center">
                        @L["HeaderVatReceiptPayment"]  @($"{PaymentPrice} ") @L["SAR"]
                    </h4>
                </div>
            </div>

            <div class="d-flex justify-content-center align-items-center col-md-10 flex-column m-auto ">
                @if(Invoice is not null){
                    <InvoiceDetailsPopupDialog Invoice="@Invoice" OrganizationAddress="@OrganizationAddress"/>
                }else{
                    <PackageDetailsPopupDialog Package="@Package" OrganizationAddress="@OrganizationAddress"/>
                }


                <div class="total-info col-md-12" style="margin-top: 2rem;">
                    <div class="row">

                        <PriceDetailsComponentPopup Price="@price" />
                        <div class="col-md-6">
                            <div class="d-flex flex-row justify-content-end">
                                <div style="width: 120px;">
                                    <img src="@imagepath" alt="UnPaid" style="width:120px;" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class=" d-flex justify-content-end align-items-center mt-3">

                        <a href="/api/mobile/Invoice/getinvoicepdf/@ID" target="_blank"
                        style="display: inline-flex; align-items: center; justify-content: center;
                             background-color: #3A7398; color: white; text-decoration: none;
                             font-size: 16px; font-weight: bold; padding: 10px 20px;
                             border-radius: 8px; transition: all 0.3s ease-in-out;">
                            <span style="margin-right: 8px;">📄</span> @L["GetPdf"]

                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .mud-modal {
    border-radius: 0 20px 0 20px;
    }
</style>
@code {
    [Parameter] public InvoiceDto? Invoice { get; set; } 
    [Parameter] public PackageDto? Package { get; set; }
    [Parameter] public string CommercialRegisteration { get; set; }
    [Parameter] public int ID { get; set; }
    [Parameter] public string OrganizationAddress { get; set; }
    [Parameter] public string Code { get; set; }
    [Parameter] public decimal PaymentPrice { get; set; }
    public string imagepath { get; set; }
    public string OrganizationPicture { get; set; }
    public decimal price { get; set; }
    public string title { get; set; }
    public string description { get; set; }
    public bool HasDiscount { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Invoice is not null) {
            price = Invoice.InvoicePrice;
            title = "Invoice";
            description = Code;
            if (Math.Round((Invoice.InvoicePrice + (Invoice.InvoicePrice * 0.15m)), 2) != PaymentPrice){
                HasDiscount = true;
            }
    }
        else{

            price = Package.Price;
            title = "Package";
            description = Code;
        }

        if (currentTenant.Id == null)
        {

            imagepath = await InvoiceAppService.GetInvoiceQRCodeForMDKHL(ID);
        }
        else
        {
            imagepath = await InvoiceAppService.GetInvoiceQRCodeForOrganization(ID);
            OrganizationPicture = await OrganizationService.GetOrganizationPictureByOrganizationTenant(currentTenant.Id);

        }
        StateHasChanged();


    }



}
