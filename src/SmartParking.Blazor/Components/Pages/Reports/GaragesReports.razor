@page "/garagesreport"
@using Microsoft.Extensions.Localization
@using SmartParking.Analysis
@using SmartParking.Localization
@using Volo.Abp.MultiTenancy
@inject IStringLocalizer<SmartParkingResource> L
@inject IDialogService Dialog
@inject IAnalysisAppService AnalysisAppService
@inject ICurrentTenant CurrentTenant

<PageTitle>@L["GaragesReports"] </PageTitle>
<MudText Typo="Typo.h5" Class="mb-2">@L["GaragesReports"]</MudText>

<SPDataGrid PageName=@($"{@L["GaragesReports"]}") ShowMenue="true" Data="@itemData" ShowFiltering="true" OnPageChanged="FetchData" OnFiltering="FetchData" TotalItemsInTable="TotalItem"></SPDataGrid>