@page "/specificactorreport"
@using Microsoft.Extensions.Localization
@using SmartParking.Analysis
@using SmartParking.Localization
@using Volo.Abp.MultiTenancy
@inject IStringLocalizer<SmartParkingResource> L
@inject IDialogService Dialog
@inject IAnalysisAppService AnalysisAppService
@inject ICurrentTenant CurrentTenant

<PageTitle>@L["User"] @L["Reports"]</PageTitle>
<MudText Typo="Typo.h5" Class="mb-2">@L["User"] @L["Reports"]</MudText>

<SPDataGrid PageName=@($"{@L["User"]} {@L["Reports"]}") ShowMenue="true" Data="@itemData" OnPageChanged="ShowDialogReports" TotalItemsInTable="TotalItem"></SPDataGrid>
