@page "/customerpackage/reports"
@using Microsoft.Extensions.Localization
@using SmartParking.Analysis
@using SmartParking.Localization
@using Volo.Abp.MultiTenancy
@inject IStringLocalizer<SmartParkingResource> L
@inject IDialogService Dialog
@inject IAnalysisAppService AnalysisAppService
@inject ICurrentTenant CurrentTenant

<PageTitle>@L["CustomerPackages"] @L["Reports"]</PageTitle>
<MudText Typo="Typo.h5" Class="mb-2">@L["CustomerPackages"] @L["Reports"]</MudText>

<SPDataGrid PageName=@($"{@L["CustomerPackages"]} {@L["Reports"]}") ShowMenue="true" Data="@itemData" ShowFiltering="true" OnPageChanged="FetchData" OnFiltering="FetchData" TotalItemsInTable="TotalItem"></SPDataGrid>