@using Microsoft.Extensions.Localization
@using SmartParking.GarageTransactions
@using SmartParking.Localization
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject IUnLinkedTransactionAppService UnLinkedTransactionAppService
<div class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["Details"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="unLinkedTransactionDto.DeviceId"
									  For="@(() => unLinkedTransactionDto.DeviceId)"
									  Immediate="true"
									  Disabled=true
									  Label="@L["DeviceId"]" />
					</MudItem>

					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="unLinkedTransactionDto.PlateNumber"
									  For="@(() => unLinkedTransactionDto.PlateNumber)"
									  Immediate="true"
									  Disabled=true
									  Label="@L["PlateNumber"]" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="unLinkedTransactionDto.SnapTime"
									  For="@(() => unLinkedTransactionDto.SnapTime)"
									  Immediate="true"
									  Disabled=true
									  Label="@L["SnapTime"]" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField
									  Value=" unLinkedTransactionDto.AccurateTime.ToString()"
									  Immediate="true"
									  Disabled=true
									  Label="@L["AccurateTime"]" />
					</MudItem>
					

					

						<MudItem sm="12" md="12" class="d-flex justify-center">
							<div class="zoom-container"
								 @onmousemove="SetZoomOrigin"
								 @onmouseleave="ResetZoom">
								<img src="@unLinkedTransactionDto.VehiclePicture"
									 alt="Vehicle Image"
									 style="transform-origin: @TransformOrigin; transform: @Scale;" />
							</div>
						</MudItem>
		

				</MudGrid>
			</MudForm>



		</DialogContent>
		<DialogActions>
			<MudButton Color="MudBlazor.Color.Dark" Variant="Variant.Filled" OnClick="OnCloseViewOnly">@L["Back"]</MudButton>
		</DialogActions>


	</MudDialog>

</div>
<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
	.zoom-container {
		position: relative;
		display: inline-block;
		overflow: hidden;
		width: 400px; /* Container width */
		height: 300px; /* Container height */
		cursor: zoom-in;
	}

		.zoom-container img {
			width: 100%;
			height: 100%;
			transition: transform 0.3s ease, transform-origin 0.3s ease;
			transform: scale(1);
		}

		.zoom-container:hover img {
			transform: scale(2); /* Adjust the scale for zoom level */
		}
</style>

@code {
	[CascadingParameter]
	private IMudDialogInstance MudDialogAdd { get; set; }
	[Parameter] public UnLinkedTransactionDto unLinkedTransactionDto { get; set; }
	
	bool _clearable;
	private MudForm form;

	protected override async Task OnInitializedAsync()
	{
		
		await base.OnInitializedAsync();
	}
	private string TransformOrigin { get; set; } = "center center";
	private string Scale { get; set; } = "scale(1)";

	private void SetZoomOrigin(MouseEventArgs e)
	{
		// Calculate the position of the mouse relative to the container
		double xPercent = e.OffsetX / 400 * 100; // 400 is the container width
		double yPercent = e.OffsetY / 300 * 100; // 300 is the container height

		TransformOrigin = $"{xPercent}% {yPercent}%";
		Scale = "scale(2)"; // Zoom level when hovered
	}

	private void ResetZoom(MouseEventArgs e)
	{
		TransformOrigin = "center center";
		Scale = "scale(1)"; // Reset zoom when mouse leaves
	}




	private void OnCloseViewOnly()
	{
		MudDialogAdd.Cancel();

	}

}
