@page "/shifts"
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Organizations
@using SmartParking.Shifts
@using Volo.Abp.Application.Dtos
@inject IStringLocalizer<SmartParkingResource> L
@inject IDialogService Dialog
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IShiftAppService ShiftAppService
@inject IOrganizationsAppService OrganizationAppService
@inherits AbpCrudPageBase<IShiftAppService, ShiftDto, int, PagedAndSortedResultRequestDto, CreateUpdateShiftDto>


<PageTitle>@L["Shifts"]</PageTitle>
<MudText Typo="Typo.h5" Class="mb-2">@L["Shifts"]</MudText>
<SPDataGrid PageName=@L["Shifts"] Data="@itemData" Menus="@MenuDatas" ShowAdd="HasCreatePermission" ShowMenue="!CurrentTenant.Id.HasValue"
            ShowEdit="HasUpdatePermission" ShowDelete="HasDeletePermission" TotalItemsInTable="TotalItem" OnClickRowEdit="OnClickRowEdit"
            OnPageChanged="FetchTableData" OnSearching="FetchTableData" OnAdd="OpenDialogAsync" OnClickRowView="OnClickRowView" 
            ShowView="true" OnClickRowDelete="OnClickRowDelete" ShowAssign="true" OnClickAssign="AssignUserDialog"></SPDataGrid>

