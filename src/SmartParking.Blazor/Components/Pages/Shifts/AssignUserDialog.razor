@page "/assign-user-shift"
@using SmartParking.Authentication
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Entities
@using SmartParking.KeeperShifts
@using SmartParking.Localization
@using SmartParking.Organizations
@using SmartParking.Shifts
@using Microsoft.Extensions.Localization
@using System.Globalization
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@using Volo.Abp.MultiTenancy
@inject NavigationManager Navigation
@inject IOrganizationsAppService OrganizationsAppService
@inject IShiftAppService ShiftAppService
@inject IKeeperShiftsAppService KeeperShiftsAppService
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject ICurrentTenant CurrentTenant
@inject IUsersAppService UsersAppService

<PageTitle>@L["Assign User to Shift"]</PageTitle>
<MudDialog Class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["Assign User to Shift"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm Model="@keeperShiftCreateDto" @ref="form">
            <MudGrid>
                <MudItem sm="6" md="6">
                    <MudSelect T="string" Label="@L["User"]" ValueChanged="OnUserChanged" 
                    Required="true"
                    RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))">
                        <MudSelectItem Value="@string.Empty" Disabled="false"></MudSelectItem>
                        @foreach (var user in Users)
                        {
                            <MudSelectItem Value="@user.User.Id.ToString()">@user.User.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem sm="12" md="12">
                    <MudDatePicker Label="@L["StartDate"]"
                    PickerVariant="PickerVariant.Dialog"
                    ShowToolbar="false"
                    @bind-Date="_startDateTimeCreated"
                    MinDate="@( _startDateTime < DateTime.Today ? DateTime.Today : _startDateTime )"
                    MaxDate="_endDateTime"
                    Required="true"
                    RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                </MudItem>

                <MudItem sm="12" md="12">
                    <MudDatePicker Label="@L["EndDate"]"
                    PickerVariant="PickerVariant.Dialog"
                    ShowToolbar="false"
                    @bind-Date="_endDateTimeCreated"
                    MinDate="@( _startDateTimeCreated.HasValue ? _startDateTimeCreated.Value : ( _startDateTime < DateTime.Today ? DateTime.Today : _startDateTime ) )"
                    MaxDate="_endDateTime"
                    Required="true"
                    RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                </MudItem>

            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="MudBlazor.Color.Dark" Variant="Variant.Filled">@L["Back"]</MudButton>
        <MudButton OnClick="SubmitCreate" Color="MudBlazor.Color.Primary" Variant="Variant.Filled">@L["Assign"]</MudButton>
    </DialogActions>
</MudDialog>

