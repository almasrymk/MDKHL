@using Microsoft.Extensions.Localization
@using MudBlazor
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Entities.Cameras.Watchers
@using SmartParking.Garages
@using SmartParking.Localization
@using SmartParking.Mobile.Keepers
@using SmartParking.Shifts
@using SmartParking.Shifts.ShiftZones
@using SmartParking.Shifts.ShiftDevices
@using SmartParking.Shifts.ShiftStaffDetail
@using SmartParking.Authentication
@using SmartParking.Shifts.ShiftsMangers
@using SmartParking.Watchers
@using Volo.Abp.Application.Dtos
@using Volo.Abp.MultiTenancy
@using Volo.Abp.ObjectMapping

@inject IShiftZoneAppService ShiftZoneAppService
@inject IShiftAppService ShiftAppService
@inject IGarageAppService GarageAppService
@inject IUserAppService UserAppService
@inject IWatcherAppService WatcherAppService
@inject IAssignShiftZoneAppService AssignShiftZoneAppService
@inject IObjectMapper ObjectMapper
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager NavigationManager
@inject ICurrentTenant CurrentTenant




<div class="modal-wrapper">
    <MudDialog Class="mud-modal">
        <TitleContent>
            <div class="d-flex align-center">
                <MudText Typo="Typo.h6">@L["AddShiftZone"]</MudText>
            </div>
        </TitleContent>

        <DialogContent>
            <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
                <MudGrid>

                    <MudItem xs="12" md="6">
                        <MudSelect T="int" Label="@L["Shift"]" @bind-Value="CreateUpdateShiftZone.ShiftId" AnchorOrigin="Origin.BottomCenter" Disabled="@(!_isLoaded)">
                            <MudSelectItem T="int" Value="0" Disabled>@L["SelectShift"]</MudSelectItem>
                            @foreach (var shift in ShiftDtos)
                            {
                                <MudSelectItem T="int" Value="@shift.Id">@(System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar") ? shift.ArabicName : shift.EnglishName)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect T="int" Label="@L["Garage"]" @bind-Value="CreateUpdateShiftZone.ZoneId" AnchorOrigin="Origin.BottomCenter" Disabled="@(!_isLoaded)">
                            <MudSelectItem T="int" Value="0" Disabled>@L["SelectGarage"]</MudSelectItem>
                            @foreach (var garage in Garages)
                            {
                                <MudSelectItem T="int" Value="@garage.Id">@(System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar") ? garage.NameAr : garage.NameEn)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect T="Guid"
                                   Label="@L["Manager"]"
                                   @bind-Value="SelectedManagerId"
                                   Disabled="@(!_isLoaded)">
                            <MudSelectItem T="Guid" Value="Guid.Empty" Disabled>@L["SelectManager"]</MudSelectItem>
                            @foreach (var m in Keepers)
                            {
                                <MudSelectItem T="Guid" Value="@m.Id">@(System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar") ? m.EnglishName : m.EnglishName)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12">
                        <div class="sp-panel-root">
                            <MudPaper Elevation="0" Class="d-flex align-center pa-2" Style="cursor:pointer;" @onclick="ToggleAssignmentPanel">
                                <MudText Typo="Typo.subtitle1">@L["StaffAndDeviceAssignment"]</MudText>
                                <MudSpacer />
                                <MudIconButton Icon="@Icons.Material.Filled.ExpandMore"
                                               Class="@($"sp-panel-chevron {(_assignmentPanelOpen ? "open" : "")}")"
                                               Edge="@Edge.End" />
                            </MudPaper>

                            <div class="sp-panel-content @(_assignmentPanelOpen ? "open" : "closed")" aria-hidden="@(!_assignmentPanelOpen)">
                                <div style="overflow-y: auto; max-height: 400px; padding: 12px;">
                                    <MudGrid>
                                        @for (int i = 0; i < UiAssignments.Count; i++)
                                        {
                                            var assignment = UiAssignments[i];
                                            <MudItem xs="5">
                                                <MudSelect T="Guid ?" Label="@L["Staff"]" @bind-Value="assignment.StaffId" AnchorOrigin="Origin.BottomCenter" Dense="true">
                                                    <MudSelectItem T="Guid?" Disabled Value="@((Guid?)null)">@L["SelectStaff"]</MudSelectItem>
                                                    @foreach (var keeper in Keepers)
                                                    {
                                                        <MudSelectItem T="Guid?" Value="@keeper.Id" Disabled="@IsKeeperDisabled(keeper.Id, assignment)">
                                                            @(System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar") ? keeper.EnglishName : keeper.EnglishName)
                                                        </MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>

                                            <MudItem xs="5">
                                                <MudSelect T="int?" Label="@L["Device"]" @bind-Value="assignment.DeviceId" AnchorOrigin="Origin.BottomCenter" Dense="true">
                                                    <MudSelectItem T="int?" Disabled Value="@((int?)null)">@L["SelectDevice"]</MudSelectItem>
                                                    @foreach (var device in Devices)
                                                    {
                                                        <MudSelectItem T="int?" Value="@device.Id" Disabled="@IsDeviceDisabled(device.Id, assignment)">
                                                            @device.Name
                                                        </MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>

                                            <MudItem xs="2" Class="d-flex align-center">
                                                <MudIconButton Icon="@Icons.Material.Filled.RemoveCircle" Color="MudBlazor.Color.Error" OnClick="@(() => RemoveRow(assignment))" Disabled="@(UiAssignments.Count == 1)" />
                                            </MudItem>
                                        }

                                        <MudItem xs="12">
                                            <MudButton StartIcon="@Icons.Material.Filled.AddCircle" Color="MudBlazor.Color.Primary" OnClick="AddRow">@L["AddRow"]</MudButton>
                                        </MudItem>
                                    </MudGrid>
                                </div>
                            </div>
                        </div>
                    </MudItem>

                </MudGrid>
            </MudForm>
        </DialogContent>


        <DialogActions>
            <DialogActionComponent 
            ButtonOneColor="MudBlazor.Color.Dark" 
            ButtonTwoColor="MudBlazor.Color.Primary" 
            ButtonOneLabel="@L["Back"]" 
            ButtonTwoLabel="@L["SaveAsDraft"]" 
            ButtonOneClick="Cancel" 
            ButtonTwoClick="Submit" 
            ButtonOneVariant="MudBlazor.Variant.Filled" 
            ButtonTwoVariant="MudBlazor.Variant.Filled" />
        </DialogActions>

    </MudDialog>
</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>
