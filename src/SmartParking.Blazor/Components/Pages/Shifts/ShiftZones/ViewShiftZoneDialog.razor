@using System.Globalization
@using Microsoft.Extensions.Localization
@using SmartParking.Garages
@using SmartParking.Localization
@using SmartParking.Shifts
@using SmartParking.Shifts.ShiftDetail
@using SmartParking.Shifts.ShiftDevices
@using SmartParking.Shifts.ShiftStaffDetail
@using SmartParking.Shifts.ShiftZones
@using SmartParking.Shifts.ShiftsMangers
@using Volo.Abp.MultiTenancy
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@inject IShiftAppService ShiftAppService
@inject IGarageAppService GarageAppService
@inject IShiftDetailsAppService ShiftDetailsAppService
@inject IShiftZoneAppService ShiftZoneAppService
@inject ICurrentTenant CurrentTenant



<PageTitle>@L["ShiftZoneDetails"]</PageTitle>

<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["Details"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
				<MudGrid>
					<MudItem sm="3">
						<MudTextField Value="@(GetLocalized(ShiftZone?.ShiftEnglishName, ShiftZone?.ShiftArabicName))"
									  For="@(() => ShiftZone.ShiftEnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label=@L["ShiftName"]
									  Disabled />
					</MudItem>

					<MudItem sm="3">
						<MudTextField Value="@(GetLocalized(ShiftZone?.ZoneEnName, ShiftZone?.ZoneArName))"
									  For="@(() => ShiftZone.ZoneEnName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label=@L["ZoneName"]
									  Disabled />
					</MudItem>

					<MudItem sm="3">
						<MudTextField Value="@(GetLocalized(ShiftZone?.ShiftMangerDto?.ManagerEnName, ShiftZone?.ShiftMangerDto?.ManagerEnName))"
									  For="@(() => ShiftZone.ShiftMangerDto.ManagerEnName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label=@L["Manager Name"]
									  Disabled />
					</MudItem>

					<MudItem sm="3">
						<MudTextField T="string"
									  Value="@L[$"{ShiftZone.Status}"]"
									  Immediate="true"
									  Disabled=true
									  Label="@L["Status"]" />
					</MudItem>

					
					<MudItem sm="3" md="3">
						<MudTextField Value="ShiftZone.StartDate.ToString()"
										Disabled=true
										Label="@L["StartDate"]" />
					</MudItem>
					<MudItem sm="3" md="3">
						<MudTextField Value="ShiftZone.EndDate.ToString()"
										Disabled=true
										Label="@L["EndDate"]" />
					</MudItem>
					@if (ShiftZone.IsFullDay == true)
					{
						<MudItem sm="4" md="4">
							<MudTextField T="string"
											Text="@(24+L["Hour"])"
											Immediate="true"
											Disabled=true
											Label=@L["Published"] />
						</MudItem>
					}
					else
					{
						<MudItem sm="3" md="3">
							<MudTextField Value="ShiftZone.StartTime.ToString()"
											Disabled=true
											Label="@L["StartTime"]" />
						</MudItem>

						<MudItem sm="3" md="3">
							<MudTextField Value="ShiftZone.EndTime.ToString()"
											Disabled=true
											Label="@L["EndTime"]" />
						</MudItem>
					}

					@if (CurrentTenant.Id is null)
					{

						@if (CultureInfo.CurrentCulture.Name == "ar")
						{
							<MudItem sm="6" md="6">
								<MudTextField @bind-Value="ShiftZone.OrganizationArName"
												Immediate="true"
												Disabled=true
												Label="@L["Organization"]" />
							</MudItem>
						}
						else
						{

							<MudItem sm="6" md="6">
								<MudTextField @bind-Value="ShiftZone.OrganizationEnName"
												Immediate="true"
												Disabled=true
												Label="@L["Organization"]" />
							</MudItem>
						}
					}
					
					<MudItem sm="12">
						<SPDataGrid PageName=@L["StaffDevices"] 
							TotalItemsInTable="@TotalItem" 
							Data="@itemData" 
							OnPageChanged="FetchTableData"
							ShowExport=false></SPDataGrid>
					</MudItem>
				</MudGrid>
			</MudForm>
		</DialogContent>

		<DialogActions>
			<MudButton Color="MudBlazor.Color.Dark" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
		</DialogActions>
	</MudDialog>
</MudItem>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>