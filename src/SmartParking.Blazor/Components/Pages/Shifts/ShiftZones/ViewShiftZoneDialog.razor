@using System.Globalization
@using Microsoft.Extensions.Localization
@using SmartParking.Garages
@using SmartParking.Localization
@using SmartParking.Shifts
@using SmartParking.Shifts.ShiftDetail
@using SmartParking.Shifts.ShiftDevices
@using SmartParking.Shifts.ShiftStaffDetail
@using SmartParking.Shifts.ShiftZones
@using SmartParking.Shifts.ShiftsMangers
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@inject IShiftAppService ShiftAppService
@inject IGarageAppService GarageAppService
@inject IShiftDetailsAppService ShiftDetailsAppService
@inject IShiftZoneAppService ShiftZoneAppService


<PageTitle>@L["ShiftZoneDetails"]</PageTitle>

<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["Details"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
				<MudGrid>
					<MudItem sm="6">
						<MudTextField Value="@(GetLocalized(ShiftZone?.ShiftDto?.EnglishName, ShiftZone?.ShiftDto?.ArabicName))"
									  For="@(() => ShiftZone.ShiftDto.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label=@L["ShiftName"]
									  Disabled />
					</MudItem>

					<MudItem sm="6">
						<MudTextField Value="@(GetLocalized(ShiftZone?.ShiftDto?.GarageEnglishName, ShiftZone?.ShiftDto?.GarageArabicName))"
									  For="@(() => ShiftZone.ShiftDto.GarageEnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label=@L["Garage Name"]
									  Disabled />
					</MudItem>

					<MudItem sm="6">
						<MudTextField Value="@(GetLocalized(ShiftZone?.ShiftMangerDto?.ManagerEnName, ShiftZone?.ShiftMangerDto?.ManagerUserName))"
									  For="@(() => ShiftZone.ShiftMangerDto.ManagerEnName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label=@L["Manager Name"]
									  Disabled />
					</MudItem>

					<MudItem sm="12" Class="mt-4">
						<MudText Typo="Typo.h6">@L["ShiftDevices"]</MudText>

						@if (ShiftZone?.ShiftDetailsDto?.ShiftDevices != null &&
												ShiftZone.ShiftDetailsDto.ShiftDevices.Any())
						{
							<MudList T="ShiftDeviceDto" Dense="true">
								@foreach (var device in ShiftZone.ShiftDetailsDto.ShiftDevices)
								{
									<MudListItem T="ShiftDeviceDto" Value="@device">
										@device.DeviceCode
									</MudListItem>
								}
							</MudList>
						}
						else
						{
							<MudText>@L["NoDevicesFound"]</MudText>
						}
					</MudItem>

					<MudItem sm="12" Class="mt-4">
						<MudText Typo="Typo.h6">@L["ShiftStaffDetails"]</MudText>

						@if (ShiftZone?.ShiftDetailsDto?.ShiftStaffDetails != null &&
												ShiftZone.ShiftDetailsDto.ShiftStaffDetails.Any())
						{
							<MudList T="ShiftStaffDetailsDto" Dense="true">
								@foreach (var staff in ShiftZone.ShiftDetailsDto.ShiftStaffDetails)
								{
									<MudListItem T="ShiftStaffDetailsDto" Value="@staff">
										@GetLocalized(staff?.StaffEnName, staff?.StaffArName)
									</MudListItem>
								}
							</MudList>
						}
						else
						{
							<MudText>@L["NoStaffFound"]</MudText>
						}
					</MudItem>

				</MudGrid>
			</MudForm>
		</DialogContent>

		<DialogActions>
			<MudButton Color="MudBlazor.Color.Dark" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
		</DialogActions>
	</MudDialog>
</MudItem>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>