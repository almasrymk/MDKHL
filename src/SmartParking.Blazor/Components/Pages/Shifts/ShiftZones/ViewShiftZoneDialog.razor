@using System.Globalization
@using Microsoft.Extensions.Localization
@using SmartParking.Garages
@using SmartParking.Localization
@using SmartParking.Shifts
@using SmartParking.Shifts.ShiftDetail
@using SmartParking.Shifts.ShiftDevices
@using SmartParking.Shifts.ShiftStaffDetail
@using SmartParking.Shifts.ShiftZones
@using SmartParking.Shifts.ShiftsMangers
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@inject IShiftAppService ShiftAppService
@inject IGarageAppService GarageAppService
@inject IShiftDetailsAppService ShiftDetailsAppService
@inject IShiftZoneAppService ShiftZoneAppService


<PageTitle>@L["ShiftZoneDetails"]</PageTitle>

<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["Details"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
				<MudGrid>
					<MudItem sm="4">
						<MudTextField Value="@(GetLocalized(ShiftZone?.ShiftDto?.EnglishName, ShiftZone?.ShiftDto?.ArabicName))"
									  For="@(() => ShiftZone.ShiftDto.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label=@L["ShiftName"]
									  Disabled />
					</MudItem>

					<MudItem sm="4">
						<MudTextField Value="@(GetLocalized(ShiftZone?.ShiftDto?.GarageEnglishName, ShiftZone?.ShiftDto?.GarageArabicName))"
									  For="@(() => ShiftZone.ShiftDto.GarageEnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label=@L["ZoneName"]
									  Disabled />
					</MudItem>

					<MudItem sm="4">
						<MudTextField Value="@(GetLocalized(ShiftZone?.ShiftMangerDto?.ManagerEnName, ShiftZone?.ShiftMangerDto?.ManagerUserName))"
									  For="@(() => ShiftZone.ShiftMangerDto.ManagerEnName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label=@L["Manager Name"]
									  Disabled />
					</MudItem>

					
						<MudItem sm="3" md="3">
							<MudTextField Value="ShiftZone.ShiftDto.StartDate.ToString()"
										  Disabled=true
										  Label="@L["StartDate"]" />
						</MudItem>
						<MudItem sm="3" md="3">
							<MudTextField Value="ShiftZone.ShiftDto.EndDate.ToString()"
										  Disabled=true
										   Label="@L["EndDate"]" />
						</MudItem>
						@if (ShiftZone.ShiftDto.IsFullDay == true)
						{
							<MudItem sm="4" md="4">
								<MudTextField T="string"
											  Text="@(24+L["Hour"])"
											  Immediate="true"
											  Disabled=true
											  Label=@L["Published"] />
							</MudItem>


						}
						else{

					
							<MudItem sm="3" md="3">
								<MudTextField Value="ShiftZone.ShiftDto.StartTime.ToString()"
											  Disabled=true
											   Label="@L["StartTime"]" />
							</MudItem>
							<MudItem sm="3" md="3">
								<MudTextField Value="ShiftZone.ShiftDto.EndTime.ToString()"
											  Disabled=true
											   Label="@L["EndTime"]" />
							</MudItem>
						}
					

					<SPDataGrid PageName=@L["StaffDevices"] >    </SPDataGrid>

				</MudGrid>
			</MudForm>
		</DialogContent>

		<DialogActions>
			<MudButton Color="MudBlazor.Color.Dark" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
		</DialogActions>
	</MudDialog>
</MudItem>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>