@using SmartParking.Authentication
@inject IUsersAppService UsersAppService
@inject IDialogService Dialog
<div class="modal-wrapper ">
    <MudDialog class="mud-modal ">
        <TitleContent>
            <MudText Class="fw-bold">Organization - Users</MudText>
        </TitleContent>
        <DialogContent>
            <SPDataGrid Data="@itemData" TotalItemsInTable="TotalItem" OnPageChanged="FetchTableData" ></SPDataGrid>
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Filled" FullWidth="true" class="mx-3 mt-5" Color="MudBlazor.Color.Primary" OnClick="Cancel">Cancel</MudButton>
        </DialogActions>
    </MudDialog>
</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>