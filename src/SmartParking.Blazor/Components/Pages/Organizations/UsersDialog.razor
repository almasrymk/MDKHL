@using Microsoft.Extensions.Localization
@using SmartParking.Authentication
@using SmartParking.Localization
@inject IUsersAppService UsersAppService
@inject IDialogService Dialog
@inject IStringLocalizer<SmartParkingResource> L
<div class="modal-wrapper ">
    <MudDialog class="mud-modal ">
        <TitleContent>
            <MudText Class="fw-bold">@L["Organization - Users"]</MudText>
        </TitleContent>
        <DialogContent>
            <SPDataGrid Data="@itemData" TotalItemsInTable="TotalItem" OnSearching="HandleSearch" OnFiltering="HandleFilter" OnPageChanged="FetchTableData" ></SPDataGrid>
        </DialogContent>
        <DialogActions>

            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Cancel">@L["Cancel"]</MudButton>
        </DialogActions>
    </MudDialog>
</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>