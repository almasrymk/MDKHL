@page "/organizations"
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Organizations
@using Volo.Abp.Application.Dtos
@inject ISnackbar Snackbar
@inject IOrganizationsAppService OrganizationsAppService
@inject IDialogService Dialog
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@inject IAuthorizationService AuthorizationService
@attribute [Authorize(Roles = "Mdkhl , admin")]
@inherits AbpCrudPageBase<IOrganizationsAppService, OrganizationDto, int, PagedAndSortedResultRequestDto, CreateUpdateOrganiztionDto>
<PageTitle>@L["Organizations"]</PageTitle>
<MudText Typo="Typo.h5" Class="mb-2">@L["Organizations"]</MudText>

<SPDataGrid PageName=@L["Organizations"] OnAdd="HandleAdd" Data="@itemData" ShowAdd="HasCreatePermission" ShowDelete="HasDeletePermission" ShowEdit="HasUpdatePermission" TotalItemsInTable="TotalItem" OnClickRowEdit="HandleEdit" OnClickRowView="HandleView" OnClickRowDelete="HandleDelete" OnFiltering="HandleFilter" OnPageChanged="FetchTableData" OnSearching="HandleSearch"></SPDataGrid>