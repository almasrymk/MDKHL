@using Microsoft.Extensions.Localization
@using SmartParking.Cutomers
@using SmartParking.Localization
@using SmartParking.Packages
@using Volo.Abp.MultiTenancy
@inject ICustomerAppService CustomersAppService
@inject IDialogService Dialog
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject ICurrentTenant currentTenant
@inject NavigationManager Navigation

<div class="modal-wrapper ">


    <PageTitle>@L["Organization Customers"]</PageTitle>
    <MudDialog class="mud-modal ">
        <TitleContent>
            <MudText Class="fw-bold">@L["Organization Customers"]</MudText>
        </TitleContent>
        <DialogContent>
            <SPDataGrid PageName=@L["Organization Customers"] Data="@itemData" TotalItemsInTable="TotalItem" OnPageChanged="FetchTableData" OnClickRowEdit="HandleEdit"></SPDataGrid>
        </DialogContent>
        <DialogActions>

            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Cancel">@L["Cancel"]</MudButton>
        </DialogActions>
    </MudDialog>
</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>