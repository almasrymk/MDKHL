@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Subscriptions
@using System.Globalization
@inject ISubscriptionAppService SubscriptionAppService
@inject IStringLocalizer<SmartParkingResource> L

<div class="modal-wrapper ">


    <PageTitle>@L["Organization Customers"]</PageTitle>
    <MudDialog class="mud-modal ">
                <TitleContent>
            @L["Organization Subscription"]

                </TitleContent>


                <DialogContent>

        <MudText Color="MudBlazor.Color.Primary" Class="fw-bold" Align="Align.Center" Typo="Typo.h5">@subscription.EnglishName</MudText>
        <div class="subscription-card">
            <div class="d-flex flex-column gap-1 text-white align-items-center rounded-circle subscription-circle">
                <div class="price">
                        <MudText Class="fw-bold" Typo="Typo.h2" Color="MudBlazor.Color.Primary"> @L["SAR"]</MudText>
                        <div class=" d-flex justify-content-center align-items-center">

                           <MudText Class="fw-bold " Typo="Typo.h2" Color="MudBlazor.Color.Primary">@subscription.SubscriptionPrice</MudText>
                        </div>
                        @if (CultureInfo.CurrentCulture.Name == "en")
                        {
                            <MudText>@subscription.SubscriptionTypeEn</MudText>
                        }
                        else
                        {
                            <MudText>@subscription.SubscriptionTypeAr</MudText>

                        }
                    </div>

            </div>
            <ul class="d-flex flex-column gap-2">
               
                <li class="d-flex align-items-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.CheckBox" Color="MudBlazor.Color.Primary" Title=@L["Favorite"] />
                    <MudText>@subscription.NumbersOfGarages @L["Garages"]</MudText>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.CheckBox" Color="MudBlazor.Color.Primary" Title=@L["Favorite"] />
                    <MudText>@subscription.NumberOfCustomers @L["Customers"]</MudText>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.CheckBox" Color="MudBlazor.Color.Primary" Title=@L["Favorite"] />
                    <MudText>@subscription.NumberOfUsers @L["Users"]</MudText>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.CheckBox" Color="MudBlazor.Color.Primary" Title=@L["Favorite"] />
                    <MudText>@subscription.NumberOfCameras @L["Cameras"]</MudText>
                </li>
            </ul>
        </div>
        </DialogContent>

                <DialogActions>

            <MudButton Variant="Variant.Filled" FullWidth="true" class="mx-3 mt-5" Color="MudBlazor.Color.Dark"  OnClick="Cancel">@L["Cancel"]</MudButton>
            </DialogActions>
            
        
    </MudDialog>

</div>
<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>

