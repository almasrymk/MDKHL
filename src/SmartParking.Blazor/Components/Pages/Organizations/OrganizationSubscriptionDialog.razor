@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Subscriptions
@inject ISubscriptionAppService SubscriptionAppService
@inject IStringLocalizer<SmartParkingResource> L

@if (subscription != null)
{
<MudDialog class="mud-modal text-center">

    <div>
        <MudText Color="MudBlazor.Color.Primary" Class="fw-bold" Align="Align.Center" Typo="Typo.h5">@subscription.EnglishName</MudText>
        <div class="subscription-card">
            <div class="d-flex flex-column gap-1 text-white align-items-center rounded-circle subscription-circle">
                <div class="price">
                    <MudText>@L["SAR"]</MudText>
                    <MudText Class="fw-bold" Typo="Typo.h2">@subscription.SubscriptionPrice</MudText>
                    <MudText>@subscription.SubscriptionType</MudText>
                </div>

            </div>
            <ul class="d-flex flex-column gap-2">
                <li class="d-flex align-items-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.CheckBox" Color="MudBlazor.Color.Primary" Title=@L["Favorite"] />
                    <MudText>3 Organization</MudText>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.CheckBox" Color="MudBlazor.Color.Primary" Title=@L["Favorite"] />
                    <MudText>@subscription.NumbersOfGarages @L["Garages"]</MudText>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.CheckBox" Color="MudBlazor.Color.Primary" Title=@L["Favorite"] />
                    <MudText>@subscription.NumberOfUsers @L["Customers"]</MudText>
                </li>
            </ul>
            <MudButton Variant="Variant.Filled" FullWidth="true" class="mx-3 mt-5" Color="MudBlazor.Color.Primary"  OnClick="Cancel">@L["Cancel"]</MudButton>

        </div>
    </div>
    </MudDialog>
}
else
{
    <div class="modal-wrapper text-center">
        <MudDialog class="mud-modal text-center w-50">
            <TitleContent>
                <MudText Class="fw-bold">@L["No Subscription for organization"]</MudText>
            </TitleContent>
            <DialogActions>
                <MudButton Variant="Variant.Filled" FullWidth="true" class="mx-3 mt-5" Color="MudBlazor.Color.Primary" OnClick="Cancel">@L["Cancel"]</MudButton>
            </DialogActions>
        </MudDialog>
    </div>
}
