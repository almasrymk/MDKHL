@page "/organizations/add"
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.Region
@using SmartParking.Lookups.State
@using SmartParking.Organizations
@using SmartParking.Subscriptions
@using Volo.Abp.Identity
@layout Shared.ProfileLayout
@inject IOrganizationsAppService OrganizationAppService
@inject ISnackbar Snackbar
@inject IIdentityUserAppService IdentityUserAppService;
@inject IStateAppService StateAppService
@inject ISubscriptionAppService SubscriptionAppService
@inject IGovernorateAppService GovernorateAppService
@inject ICitiesAppService CitiesAppService 
@inject IRegionAppService RegionAppService
@inject  UserManager<Volo.Abp.Identity.IdentityUser> UserManager;
@inject SignInManager<Volo.Abp.Identity.IdentityUser> signInManager
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@inject IDialogService Dialog
@inject IPackageTypesAppService PackageTypesAppService
<PageTitle>@L["Add Organization"]</PageTitle>
<div>
    <MudGrid>
        <MudItem sm="8">
            <MudPaper Class="h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">
                <h3 Color="fw-bold">@L["Main Data"]</h3>
                <MudForm Class="flex-grow-1 mt-4" @ref="form">
                    <MudGrid>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="ArabicName" Placeholder=@L["Type Here"] Label=@L["OrganizationArabicName"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="EnglishName" Placeholder=@L["Type Here"] Label=@L["OrganizationEnglishName"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="UnifiedLicenseNum" Placeholder=@L["Type Here"] Label=@L["Unified License Num"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField Required="true"  @bind-Value="NumOfCameras" HideSpinButtons="true" Placeholder=@L["Type Here"] Label=@L["Num Of Cameras"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField Required="true" @bind-Value="MaxCapacity" HideSpinButtons="true" Placeholder=@L["Type Here"] Label=@L["Max Capacity"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudDatePicker IsDateDisabledFunc="@((DateTime dt) => dt.Date < DateTime.Today)" Required="true" Label=@L["CR Expiry Date"] Placeholder=@L["Time Placeholder"] @bind-Date="CRExpiryDate" ShowToolbar="false" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudDatePicker IsDateDisabledFunc="@((DateTime dt) => dt.Date < DateTime.Today)"
                                           Required="true" Label=@L["License Expiry Date"] Placeholder=@L["Time Placeholder"]
                                           @bind-Date="LicenseExpiryDate" ShowToolbar="false" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField Required="true" @bind-Value="FirstHourPrice" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["FirstHourPrice"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField Required="true" @bind-Value="SecondHourPrice" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["SecondHourPrice"]" />
                        </MudItem>
                         <MudItem sm="4">
                            <MudNumericField Required="true" @bind-Value="ThirdHourPrice" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["ThirdHourPrice"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField Required="true" @bind-Value="AdditionalHourPrice" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["AdditionalHourPrice"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField Required="true" @bind-Value="FullDayPrice" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["FullDayPrice"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField Required="true" @bind-Value="NumberOfHours" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["NumberOfHours"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTimePicker Required="true" Label="@L["ClosingHoursStart"]" TimeFormat="h:mm tt" Placeholder="@L["Type Here"]" @bind-Time="ClosingHoursStart" ShowToolbar="false" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTimePicker Required="true" Label="@L["ClosingHoursEnd"]" TimeFormat="h:mm tt" Placeholder="@L["Type Here"]" @bind-Time="ClosingHoursEnd" ShowToolbar="false" />
                        </MudItem>

                        <MudItem sm="4">
                            <MudSelect Variant="Variant.Text"
                                       Label=@L["Package"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       Clearable="true"
                                       Required
                                       @bind-Value="@PackageSelectValue">
                                <MudSelectItem Value="PackageSelectValue"></MudSelectItem>
                                @foreach (var package in packages)
                                {
                                    <MudSelectItem Value="package.Id.ToString()">@package.EnglishName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem sm="4">
                            <MudSwitch Label="@L["Status Active"]" LabelPosition="LabelPosition.Start" @bind-Value="Status" Color="MudBlazor.Color.Primary" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudSwitch Label="@L["IsClose"]" LabelPosition="LabelPosition.Start" @bind-Value="IsClose" Color="MudBlazor.Color.Primary" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudSwitch Label="@L["NumberOfHoursExceeded"]" LabelPosition="LabelPosition.Start"  @bind-Value="IsNumberOfHoursExceeded" Color="MudBlazor.Color.Primary" />
                        </MudItem>
                        <MudDivider Style="border-top:1px solid #505254; margin:50px 0px;" />
                        <MudItem sm="4">
                            <MudSelect T="string"
                                Variant="Variant.Text"
                                       Label=@L["Country"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       Clearable="true"
                                       Required
                                       ValueChanged="GetRegions">
                                <MudSelectItem Value="CitySelectValue"></MudSelectItem>
                                @foreach (var country in countries)
                                {
                                    <MudSelectItem  Value="country.Id.ToString()">@country.EnglishName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        @if (!CountrySelectValue.IsNullOrEmpty())
                        {
                            <MudItem sm="4">
                                <MudSelect  T="string"
                                    Variant="Variant.Text"
                                           Label=@L["Region"]
                                           Placeholder=@L["Choose"]
                                           HelperText=@L["Helper Text"]
                                           Clearable="true"
                                           Required
                                           AnchorOrigin="Origin.TopCenter"
                                           ValueChanged="GetStates">
                                    <MudSelectItem Value="CitySelectValue"></MudSelectItem>
                                    @foreach (var region in regions)
                                    {
                                        <MudSelectItem Value="@region.Id.ToString()">@region.EnglishName</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        }
                        @if (!RegionSelectValue.IsNullOrEmpty())
                        {
                            <MudItem sm="4">
                                <MudSelect Variant="Variant.Text"
                                           Label=@L["State"]
                                           Placeholder=@L["Choose"]
                                           HelperText=@L["Helper Text"]
                                           Clearable="true"
                                           Required
                                           @bind-Value="@StateSelectValue">

                                    @foreach (var state in states)
                                    {
                                        <MudSelectItem Value="@state.Id.ToString()">@state.EnglishName</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        }
                        
                        @if (!RegionSelectValue.IsNullOrEmpty())
                        {
                            <MudItem sm="4">
                                <MudSelect Variant="Variant.Text"
                                           Label=@L["City"]
                                           Placeholder=@L["Choose"]
                                           HelperText=@L["Helper Text"]
                                           Clearable="true"
                                           Required
                                           @bind-Value="@CitySelectValue">
                                    <MudSelectItem Value="CitySelectValue"></MudSelectItem>
                                    @foreach (var city in cities)
                                    {
                                        <MudSelectItem Value="city.Id.ToString()">@city.EnglishName</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        }
                        
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Telephone" @bind-Value="PhoneNum" Placeholder="@L["Type Here"]" Label="@L["Contact Phone"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Telephone" @bind-Value="WhatsAppNum" Placeholder="@L["Type Here"]" Label="@L["Whatsapp Num"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Email" @bind-Value="ContactMail" Placeholder="@L["Type Here"]" Label="@L["Contact Email"]" />
                        </MudItem>
                    </MudGrid>
                    <div class="d-flex justify-content-between mt-5">
                        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Dark" OnClick="Cancel">@L["Cancel"]</MudButton>
                        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Disabled="@(form == null || !form.IsValid)" OnClick="Save">@L["Create"]</MudButton>
                    </div>
                </MudForm>

            </MudPaper>
        </MudItem>
        <MudItem sm="4">
            <MudPaper Class="h-100 p-3  w-100 h-100 main-layout-paper d-flex flex-column justify-content-between" Style="background-color: #F2F2F2;">
                <div class="d-flex justify-content-between align-items-center">
                    <MudText>@L["My Profile"]</MudText>
                    <MudLink Underline="Underline.Always" Href="/edit-profile">@L["Edit Profile"]</MudLink>
                </div>
                <div class="d-flex flex-column align-content-center gap-4 p-5">
                    <MudImage Src="images/profile-avatar.png" Class="rounded-circle" />
                    <div class="d-flex flex-column align-items-center">
                        <MudText Class="fw-bold">Ahmed Mohamed</MudText>
                        <MudText>A.Mohamed@mdkhl.com</MudText>
                    </div>
                </div>
                <MudGrid Class="mt-3">
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Disabled="true" Color="MudBlazor.Color.Dark" >@L["Garages"]</MudLink>
                        </MudPaper>
                    </MudItem>
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Disabled="true" Color="MudBlazor.Color.Dark" >@L["Subscriptions"]</MudLink>
                        </MudPaper>
                    </MudItem>

                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Disabled="true" Color="MudBlazor.Color.Dark">@L["Customer Categories"]</MudLink>

                        </MudPaper>
                    </MudItem>
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Disabled="true" Color="MudBlazor.Color.Dark">@L["Packages"]</MudLink>

                        </MudPaper>
                    </MudItem>

                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Disabled="true" Color="MudBlazor.Color.Dark">@L["Users"]</MudLink>
                        </MudPaper>
                    </MudItem>
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Disabled="true" Color="MudBlazor.Color.Dark">@L["Contact Data"]</MudLink>
                        </MudPaper>
                    </MudItem>

                </MudGrid>
            </MudPaper>
        </MudItem>

    </MudGrid>
</div>

