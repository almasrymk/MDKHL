@page "/organizations/add"
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.Region
@using SmartParking.Lookups.State
@using SmartParking.Organizations
@using SmartParking.Subscriptions
@using System.Globalization
@using SmartParking.Validations
@using Volo.Abp.Identity
@using Volo.Abp.Users
@layout Shared.ProfileLayout
@inject IOrganizationsAppService OrganizationAppService
@inject ISnackbar Snackbar
@inject IIdentityUserAppService IdentityUserAppService;
@inject IStateAppService StateAppService
@inject ISubscriptionAppService SubscriptionAppService
@inject ICitiesAppService CitiesAppService 
@inject IRegionAppService RegionAppService
@inject ICountriesAppService CountriesAppService
@inject  UserManager<Volo.Abp.Identity.IdentityUser> UserManager;
@inject SignInManager<Volo.Abp.Identity.IdentityUser> signInManager
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@inject IDialogService Dialog
@inject IPackageTypesAppService PackageTypesAppService
@inject ICurrentUser currentuser
<PageTitle>@L["Add Organization"]</PageTitle>
<div>
    <MudGrid>
        <MudItem sm="8">
            <MudPaper Class="h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">
                <h3 Color="fw-bold">@L["Main Data"]</h3>
                <MudForm Class="flex-grow-1 mt-4" @ref="form">
                    <MudGrid>
                        <MudItem sm="6">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="CreateUpdateOrganiztion.UserName" Placeholder=@L["Type Here"] Label=@L["UserName"] />
                        </MudItem>                         
                        <MudItem sm="6">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="CreateUpdateOrganiztion.TenantName" Placeholder=@L["Type Here"] Label=@L["TenantName"] />
                        </MudItem> 
                        <MudItem sm="6">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="CreateUpdateOrganiztion.NationalId" Placeholder=@L["Type Here"] Label=@L["NationalIdLbl"] />
                        </MudItem>
                        <MudDivider Style="border-top:1px solid #505254; margin:15px 0px;" />

                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="CreateUpdateOrganiztion.ArabicName" Placeholder=@L["Type Here"] Label=@L["ArabicName"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="CreateUpdateOrganiztion.EnglishName" Placeholder=@L["Type Here"] Label=@L["EnglishName"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="CreateUpdateOrganiztion.CommercialRegistrationNumber" Placeholder=@L["Type Here"] Label=@L["CommercialRegistrationNumber"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudDatePicker IsDateDisabledFunc="@((DateTime dt) => dt.Date < DateTime.Today)" Required="true" Label=@L["CR Expiry Date"] Placeholder=@L["Time Placeholder"] @bind-Date="CRExpiryDate" ShowToolbar="false" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="CreateUpdateOrganiztion.TaxNumber" Placeholder=@L["Type Here"] Label=@L["TaxNumber"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField T="string" Disabled ReadOnly="true" InputType="InputType.Text" Placeholder="@L["Will Be Automatically Created"]"
                                          Label=@L["Code"] />
                        </MudItem>
                        <MudDivider Style="border-top:1px solid #505254; margin:15px 0px;" />

                         <MudItem sm="4">
                             <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="CreateUpdateOrganiztion.PhoneNumber" Placeholder="@L["Type Here"]" Label="@L["Contact Phone"]" />
                         </MudItem>
                         <MudItem sm="4">
                             <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="CreateUpdateOrganiztion.WhatsAppNum" Placeholder="@L["Type Here"]" Label="@L["Whatsapp Num"]" />
                         </MudItem>
                         <MudItem sm="4">
                             <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="CreateUpdateOrganiztion.Email" Placeholder="@L["Type Here"]" Label="@L["Contact Email"]" />
                         </MudItem>
                        <MudDivider Style="border-top:1px solid #505254; margin:15px 0px;" />


                         <MudItem sm="4">
                            <MudNumericField T="int" Required="true" Validation="@(new Func<int, string>(NumbersValidations.validateNumber0to9999))"  @bind-Value="CreateUpdateOrganiztion.BuildingNumber" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["BuidlingNumber"]" />
                         </MudItem>

                         <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="CreateUpdateOrganiztion.StreetName" Placeholder="@L["Type Here"]" Label="@L["StreetName"]" />
                         </MudItem>
                        
                         <MudItem sm="4">
                            <MudNumericField Required="true" Validation="@(new Func<int, string>(NumbersValidations.ValidateNumber1111to9999))" @bind-Value="CreateUpdateOrganiztion.SecondaryNumber" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["SecondaryNumber"]" />
                         </MudItem>

                         <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="CreateUpdateOrganiztion.District" Placeholder="@L["Type Here"]" Label="@L["District"]" />
                         </MudItem>
                         <MudItem sm="4">
                            <MudNumericField Required="true" Validation="@(new Func<int, string>(NumbersValidations.ValidateNumber11111to99999))" @bind-Value="CreateUpdateOrganiztion.PostalCode" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["PostalCode"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Disabled T="string" InputType="InputType.Text" dir="rtl" Placeholder="@L["Type Here"]" Label="@L["Address"]" />
                        </MudItem>

                        <MudDivider Style="border-top:1px solid #505254; margin:15px 0px;" />


                        <MudItem sm="4">
                            <MudSelect T="string"
                                       Variant="Variant.Text"
                                       Label=@L["Country"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       Required
                                       ValueChanged="GetRegions">
                                <MudSelectItem Value="CitySelectValue"></MudSelectItem>
                                @foreach (var country in countries)
                                {
                                    if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="country.Id.ToString()">@country.EnglishName</MudSelectItem>
                                    }
                                    else
                                    {
                                        <MudSelectItem Value="country.Id.ToString()">@country.ArabicName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </MudItem>
                        @if (!CountrySelectValue.IsNullOrEmpty())
                        {
                            <MudItem sm="4">
                                <MudSelect T="string"
                                           Variant="Variant.Text"
                                           Label=@L["Region"]
                                           Placeholder=@L["Choose"]
                                           HelperText=@L["Helper Text"]
                                           Required
                                           AnchorOrigin="Origin.TopCenter"
                                           ValueChanged="GetStates">
                                    <MudSelectItem Value="CitySelectValue"></MudSelectItem>
                                    @foreach (var region in regions)
                                    {
                                        if (CultureInfo.CurrentCulture.Name == "en")
                                        {
                                            <MudSelectItem Value="@region.Id.ToString()">@region.EnglishName</MudSelectItem>
                                        }
                                        else
                                        {
                                            <MudSelectItem Value="@region.Id.ToString()">@region.ArabicName</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                        }
                        @if (!RegionSelectValue.IsNullOrEmpty())
                        {
                            <MudItem sm="4">
                                <MudSelect T="string" Variant="Variant.Text"
                                           Label=@L["State"]
                                           Placeholder=@L["Choose"]
                                           HelperText=@L["Helper Text"]
                                           Required
                                           ValueChanged="GetCities">

                                    @foreach (var state in states)
                                    {
                                        if (CultureInfo.CurrentCulture.Name == "en")
                                        {
                                            <MudSelectItem Value="@state.Id.ToString()">@state.EnglishName</MudSelectItem>
                                        }
                                        else
                                        {
                                            <MudSelectItem Value="@state.Id.ToString()">@state.ArabicName</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                        }
                        @if (!RegionSelectValue.IsNullOrEmpty())
                        {
                            <MudItem sm="4">
                                <MudSelect Variant="Variant.Text"
                                           Label=@L["City"]
                                           Placeholder=@L["Choose"]
                                           HelperText=@L["Helper Text"]
                                           Required
                                           @bind-Value="CitySelectValue">
                                    <MudSelectItem Value="@CitySelectValue"></MudSelectItem>
                                    @foreach (var city in cities)
                                    {
                                        if (CultureInfo.CurrentCulture.Name == "en")
                                        {
                                            <MudSelectItem Value="@city.Id.ToString()"> @city.EnglishName </MudSelectItem>
                                        }
                                        else
                                        {
                                            <MudSelectItem Value="@city.Id.ToString()"> @city.ArabicName </MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                        }

                        <MudDivider Style="border-top:1px solid #505254; margin:50px 0px;" />
                        <MudItem sm="12">
                            <MudSelect T="string" Variant="Variant.Text"
                                       Label=@L["Package"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       Required
                                       ValueChanged="OnPackageSelected">
                                <MudSelectItem Value="PackageSelectValue"></MudSelectItem>
                                @foreach (var package in packages)
                                {
                                    if (package.Status != Enums.SubscriptionStatus.Active)
                                        continue;
                                    if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="package.Id.ToString()">@package.EnglishName</MudSelectItem>
                                    }
                                    else
                                    {
                                        <MudSelectItem Value="package.Id.ToString()">@package.ArabicName</MudSelectItem>

                                    }
                                }
                            </MudSelect>
                        </MudItem>
                        @if (SelectedPackage != null)
                        {

                            <MudItem sm="4">
                                <MudNumericField ReadOnly="true" HideSpinButtons="true" Label=@L["Max Number Of Garages"] @bind-Value="NumbersOfGarages" />

                            </MudItem>
                            <MudItem sm="4">
                                <MudNumericField ReadOnly="true" HideSpinButtons="true" Label=@L["Max Number Of Cameras"] @bind-Value="NumberOfCameras" />

                            </MudItem>
                            <MudItem sm="4">
                                <MudNumericField ReadOnly="true" HideSpinButtons="true" Label=@L["Max Number Of Users"] @bind-Value="NumberOfUsers" />

                            </MudItem>
                            <MudItem sm="4">
                                <MudNumericField ReadOnly="true" HideSpinButtons="true" Label=@L["Max Number Of Customers"] @bind-Value="NumberOfCustomers" />
                            </MudItem>
                            <MudItem sm="4">
                                <MudNumericField ReadOnly="true" HideSpinButtons="true" Label=@L["ParkingSlot"] @bind-Value="ParkingSlot" />
                            </MudItem>
                            <MudItem sm="4">
                                <MudNumericField ReadOnly="true" HideSpinButtons="true" Label=@L["SubscriptionSlotNumber"] @bind-Value="SubscriptionSlotNumber" />

                            </MudItem>


                        }


                        <MudDivider Style="border-top:1px solid #505254; margin:50px 0px;" />
                        <MudItem sm="4"> 
                        <MudCheckBox @bind-Value="CreateUpdateOrganiztion.HasFreeSlots">@L["HasFreeSlots"]</MudCheckBox>
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField T="decimal" RequiredError="@L["This field is required."]" @bind-Value="CreateUpdateOrganiztion.FirstHourPrice" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label=@($"{L["FirstHourPrice"]} ({L["SAR"]})") />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField @bind-Value="CreateUpdateOrganiztion.SecondHourPrice" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label=@($"{L["SecondHourPrice"]} ({L["SAR"]})") />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField @bind-Value="CreateUpdateOrganiztion.ThirdHourPrice" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label=@($"{L["ThirdHourPrice"]} ({L["SAR"]})") />
                        </MudItem>

                        <MudItem sm="4">
                            <MudNumericField @bind-Value="CreateUpdateOrganiztion.AdditionalHourPrice" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label=@($"{L["AdditionalHourPrice"]} ({L["SAR"]})") />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField @bind-Value="CreateUpdateOrganiztion.FullDayPrice" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label=@($"{L["FullDayPrice"]} ({L["SAR"]})") />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField @bind-Value="CreateUpdateOrganiztion.FreeMinutes" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label=@($"{L["FreeMinutes"]} ({L["Minutes"]})") />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField @bind-Value="CreateUpdateOrganiztion.Graceperiod" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label=@($"{L["Graceperiod"]} ({L["Minutes"]})") />
                        </MudItem>
                        <MudItem sm="12">
                            <MudSwitch Required="false" Label="@L["IsClose"]" LabelPosition="LabelPosition.End" @bind-Value="CreateUpdateOrganiztion.IsClose" Color="MudBlazor.Color.Primary" />
                        </MudItem>
                        @if (CreateUpdateOrganiztion.IsClose)
                        {
                            <MudItem sm="6">
                                <MudTimePicker Required="false" Label="@L["ClosingHoursStart"]" TimeFormat="h:mm tt" Placeholder="@L["Type Here"]" @bind-Time="ClosingHoursStart" ShowToolbar="false" />
                            </MudItem>
                            <MudItem sm="6">
                                <MudTimePicker Required="false" Label="@L["ClosingHoursEnd"]" TimeFormat="h:mm tt" Placeholder="@L["Type Here"]" @bind-Time="ClosingHoursEnd" ShowToolbar="false" />
                            </MudItem>
                        }
                        <MudItem sm="12">
                            <MudSwitch Required="false" Label="@L["NumberOfHoursExceeded"]" LabelPosition="LabelPosition.End" @bind-Value="CreateUpdateOrganiztion.IsNumberOfHoursExceeded" Color="MudBlazor.Color.Primary" />
                        </MudItem>
                        @if (CreateUpdateOrganiztion.IsNumberOfHoursExceeded)
                        {
                            <MudItem sm="6">
                                <MudNumericField Required="false" @bind-Value="CreateUpdateOrganiztion.NumberOfHours" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["NumberOfHours"]" />
                            </MudItem>
                        }
                          
                    

                        <MudDivider Style="border-top:1px solid #505254; margin:50px 0px;" />

                     
                        
                       
                    </MudGrid>
                    <DialogActions>
                        <div class="d-flex justify-content-between ">
                         <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Dark" OnClick="Cancel">
            @L["Cancel"]
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Disabled="@(form == null || !form.IsValid)" OnClick="Save">
            @L["Create"]
        </MudButton>
    </div>
</DialogActions>


                </MudForm>

            </MudPaper>
        </MudItem>
        <MudItem sm="4">
            <MudPaper Class="h-100 p-3  w-100 h-100 main-layout-paper d-flex flex-column justify-content-between" Style="background-color: #F2F2F2;">

                <div class="d-flex flex-column align-items-center px-5 position-relative pb-6">
                    @if (OrganizationPicture != null)
                    {
                        <MudImage Src="@(OrganizationPicture ?? "images/MDHKL_04.png")" Class="bg_w_foto " Width="200" Height="200" Alt="@L["OrganizationLogo"]" />
                    }
                    else
                    {
                        <MudImage Src="images/MDHKL_04.png" Class="bg_w_foto " Width="200" Height="200" Alt="@L["OrganizationLogo"]" />
                    }
                    <MudFileUpload T="IBrowserFile" Accept=".png, .jpg" FilesChanged="OnImageUpload" MaximumFileCount="1">
                        <ActivatorContent>
                            <MudFab Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.CameraAlt" Size="MudBlazor.Size.Medium" Class="rounded-circle" />
                        </ActivatorContent>
                    </MudFileUpload>
                </div>
                
            </MudPaper>
        </MudItem>

    </MudGrid>
</div>

<style>
    .bg_w_foto {
        background: url(images/cities/<?php echo $city_name;
        ?>) no-repeat center center;
        -webkit-background-size: cover;
        -moz-background-size: cover;
        -o-background-size: cover;
        background-size: cover;
    }
</style>