@page "/organizations/add"
@using Microsoft.AspNetCore.Identity
@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Organizations
@using Volo.Abp.Identity
@layout Shared.ProfileLayout
@inject IOrganizationsAppService OrganizationAppService
@inject ISnackbar Snackbar
@inject IIdentityUserAppService IdentityUserAppService;
@inject  UserManager<Volo.Abp.Identity.IdentityUser> UserManager;
<PageTitle>Add Organization</PageTitle>
<div>
    <MudGrid>
        <MudItem sm="8">
            <MudPaper Class="h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">
                <h3 Color="fw-bold">Main Data</h3>
                <MudForm Class="flex-grow-1 mt-4">
                    <MudGrid>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="ArabicName" Placeholder="Type Here" Label="Arabic Name" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="EnglishName" Placeholder="Type Here" Label="English Name" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="UnifiedLicenseNum" Placeholder="Type Here" Label="Unified License Num" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField Required="true"  @bind-Value="NumOfCameras" HideSpinButtons="true" Placeholder="Type Here" Label="Num Of Cameras" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField Required="true" @bind-Value="MaxCapacity" HideSpinButtons="true" Placeholder="Type Here" Label="Max Capacity" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudDatePicker Required="true" Label="CR Expiry Date" Placeholder="Choose your date" @bind-Date="CRExpiryDate" ShowToolbar="false" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudDatePicker Required="true" Label="License Expiry Date" Placeholder="Choose your date" @bind-Date="LicenseExpiryDate" ShowToolbar="false" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField Required="true" @bind-Value="EmaraaId" HideSpinButtons="true" Placeholder="Type Here" Label="Emaraa Id" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField Required="true" @bind-Value="StateId" HideSpinButtons="true" Placeholder="Type Here" Label="StateId" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudSwitch Label="Status Active" LabelPosition="LabelPosition.Start" Placeholder="Choose your date" @bind-Value="Status" Color="MudBlazor.Color.Primary" />
                        </MudItem>

                        <MudDivider Style="border-top:1px solid #505254; margin:50px 0px;" />
                        <Countrylookups SelectValueChanged="SelectCountry"></Countrylookups>
                        <CityLookups SelectValueChanged="SelectCity"></CityLookups>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Telephone" @bind-Value="PhoneNum" Placeholder="Type Here" Label="Contact Phone" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Telephone" @bind-Value="WhatsAppNum" Placeholder="Type Here" Label="Whatsapp Num." />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Email" @bind-Value="ContactMail" Placeholder="Type Here" Label="Contact Email" />
                        </MudItem>
                       
                    </MudGrid>
                   
                    <div class="d-flex justify-content-between mt-auto">
                        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Dark">Cancel</MudButton>
                        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="Save" >Save</MudButton>
                    </div>
                </MudForm>

            </MudPaper>
        </MudItem>
        <MudItem sm="4">
            <MudPaper Class="h-100 p-3  w-100 h-100 main-layout-paper d-flex flex-column justify-content-between" Style="background-color: #F2F2F2;">
                <div class="d-flex justify-content-between align-items-center">
                    <MudText>My Profile</MudText>
                    <MudLink Underline="Underline.Always" Href="/edit-profile">Edit Profile</MudLink>
                </div>
                <div class="d-flex flex-column align-content-center gap-4 p-5">
                    <MudImage Src="images/profile-avatar.png" Class="rounded-circle" />
                    <div class="d-flex flex-column align-items-center">
                        <MudText Class="fw-bold">Ahmed Mohamed</MudText>
                        <MudText>A.Mohamed@mdkhl.com</MudText>
                    </div>
                </div>
                <MudGrid Class="mt-3">
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark">Garages</MudLink>
                        </MudPaper>
                    </MudItem>
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark">Subscriptions</MudLink>
                        </MudPaper>
                    </MudItem>

                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark">Categories</MudLink>

                        </MudPaper>
                    </MudItem>
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark">Packages</MudLink>

                        </MudPaper>
                    </MudItem>

                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark">Users</MudLink>
                        </MudPaper>
                    </MudItem>
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark">Contact Data</MudLink>
                        </MudPaper>
                    </MudItem>

                </MudGrid>
            </MudPaper>
        </MudItem>

    </MudGrid>
</div>

