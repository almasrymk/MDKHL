@page "/organizations/add"
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.Region
@using SmartParking.Lookups.State
@using SmartParking.Organizations
@using SmartParking.Subscriptions
@using System.Globalization
@using Volo.Abp.Identity
@using Volo.Abp.Users
@layout Shared.ProfileLayout
@inject IOrganizationsAppService OrganizationAppService
@inject ISnackbar Snackbar
@inject IIdentityUserAppService IdentityUserAppService;
@inject IStateAppService StateAppService
@inject ISubscriptionAppService SubscriptionAppService
@inject ICitiesAppService CitiesAppService 
@inject IRegionAppService RegionAppService
@inject ICountriesAppService CountriesAppService
@inject  UserManager<Volo.Abp.Identity.IdentityUser> UserManager;
@inject SignInManager<Volo.Abp.Identity.IdentityUser> signInManager
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@inject IDialogService Dialog
@inject IPackageTypesAppService PackageTypesAppService
@inject ICurrentUser currentuser
<PageTitle>@L["Add Organization"]</PageTitle>
<div>
    <MudGrid>
        <MudItem sm="8">
            <MudPaper Class="h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">
                <h3 Color="fw-bold">@L["Main Data"]</h3>
                <MudForm Class="flex-grow-1 mt-4" @ref="form">
                    <MudGrid>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="UserName" Placeholder=@L["Type Here"] Label=@L["UserName"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="ArabicName" Placeholder=@L["Type Here"] Label=@L["ArabicName"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="EnglishName" Placeholder=@L["Type Here"] Label=@L["EnglishName"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="CommercialRegistrationNumber" Placeholder=@L["Type Here"] Label=@L["CommercialRegistrationNumber"] />
                        </MudItem>

                        <MudItem sm="4">
                        <MudTextField T="string" Disabled ReadOnly="true" InputType="InputType.Text" Placeholder="@L["Will Be Automatically Created"]"
                                      Label=@L["Code"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudDatePicker IsDateDisabledFunc="@((DateTime dt) => dt.Date < DateTime.Today)" Required="true" Label=@L["CR Expiry Date"] Placeholder=@L["Time Placeholder"] @bind-Date="CRExpiryDate" ShowToolbar="false" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudDatePicker IsDateDisabledFunc="@((DateTime dt) => dt.Date < DateTime.Today)"
                                           Required="true" Label=@L["License Expiry Date"] Placeholder=@L["Time Placeholder"]
                                           @bind-Date="LicenseExpiryDate" ShowToolbar="false" />
                        </MudItem>

                         <MudItem sm="4">
                             <MudTextField Required="true" T="string" InputType="InputType.Telephone" @bind-Value="PhoneNum" Placeholder="@L["Type Here"]" Label="@L["Contact Phone"]" />
                         </MudItem>
                         <MudItem sm="4">
                             <MudTextField Required="true" T="string" InputType="InputType.Telephone" @bind-Value="WhatsAppNum" Placeholder="@L["Type Here"]" Label="@L["Whatsapp Num"]" />
                         </MudItem>
                         <MudItem sm="4">
                             <MudTextField Required="true" T="string" InputType="InputType.Email" @bind-Value="ContactMail" Placeholder="@L["Type Here"]" Label="@L["Contact Email"]" />
                         </MudItem>

                         <MudItem sm="4">
                             <MudNumericField Required="true" Min="1" Max="9999"  @bind-Value="BuildingNumber" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["BuidlingNumber"]" />
                         </MudItem>

                         <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="StreetName" Placeholder="@L["Type Here"]" Label="@L["StreetName"]" />
                         </MudItem>
                         <MudItem sm="4">
                            <MudNumericField Required="true" Min="1" Max="9999" @bind-Value="SecondaryNumber" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["SecondaryNumber"]" />
                         </MudItem>

                         <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="District" Placeholder="@L["Type Here"]" Label="@L["District"]" />
                         </MudItem>
                         <MudItem sm="4">
                            <MudNumericField Required="true" Min="11111" Max="99999" @bind-Value="PostalCode" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["PostalCode"]" />
                        </MudItem>

                        <MudItem sm="4">
                            <MudSelect T="string"
                                       Variant="Variant.Text"
                                       Label=@L["Country"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       Required
                                       ValueChanged="GetRegions">
                                <MudSelectItem Value="CitySelectValue"></MudSelectItem>
                                @foreach (var country in countries)
                                {
                                    if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="country.Id.ToString()">@country.EnglishName</MudSelectItem>
                                    }
                                    else
                                    {
                                        <MudSelectItem Value="country.Id.ToString()">@country.ArabicName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </MudItem>
                        @if (!CountrySelectValue.IsNullOrEmpty())
                        {
                            <MudItem sm="4">
                                <MudSelect T="string"
                                           Variant="Variant.Text"
                                           Label=@L["Region"]
                                           Placeholder=@L["Choose"]
                                           HelperText=@L["Helper Text"]
                                           Required
                                           AnchorOrigin="Origin.TopCenter"
                                           ValueChanged="GetStates">
                                    <MudSelectItem Value="CitySelectValue"></MudSelectItem>
                                    @foreach (var region in regions)
                                    {
                                        if (CultureInfo.CurrentCulture.Name == "en")
                                        {
                                            <MudSelectItem Value="@region.Id.ToString()">@region.EnglishName</MudSelectItem>
                                        }
                                        else
                                        {
                                            <MudSelectItem Value="@region.Id.ToString()">@region.ArabicName</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                        }
                        @if (!RegionSelectValue.IsNullOrEmpty())
                        {
                            <MudItem sm="4">
                                <MudSelect T="string" Variant="Variant.Text"
                                           Label=@L["State"]
                                           Placeholder=@L["Choose"]
                                           HelperText=@L["Helper Text"]
                                           Required
                                           ValueChanged="GetCities">

                                    @foreach (var state in states)
                                    {
                                        if (CultureInfo.CurrentCulture.Name == "en")
                                        {
                                            <MudSelectItem Value="@state.Id.ToString()">@state.EnglishName</MudSelectItem>
                                        }
                                        else
                                        {
                                            <MudSelectItem Value="@state.Id.ToString()">@state.ArabicName</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                        }

                        @if (!RegionSelectValue.IsNullOrEmpty())
                        {
                            <MudItem sm="4">
                                <MudSelect Variant="Variant.Text"
                                           Label=@L["City"]
                                           Placeholder=@L["Choose"]
                                           HelperText=@L["Helper Text"]
                                           Required
                                           @bind-Value="CitySelectValue">
                                    <MudSelectItem Value="@CitySelectValue"></MudSelectItem>
                                    @foreach (var city in cities)
                                    {
                                        if (CultureInfo.CurrentCulture.Name == "en")
                                        {
                                            <MudSelectItem Value="@city.Id.ToString()"> @city.EnglishName </MudSelectItem>
                                        }
                                        else
                                        {
                                            <MudSelectItem Value="@city.Id.ToString()"> @city.ArabicName </MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                        }

                        <MudDivider Style="border-top:1px solid #505254; margin:50px 0px;" />

                        <MudItem sm="6">
                            <MudSwitch Label="@L["IsClose"]" LabelPosition="LabelPosition.Start" @bind-Value="IsClose" Color="MudBlazor.Color.Primary" />
                        </MudItem>
                        <MudItem sm="6">
                            <MudSwitch Label="@L["NumberOfHoursExceeded"]" LabelPosition="LabelPosition.Start" @bind-Value="IsNumberOfHoursExceeded" Color="MudBlazor.Color.Primary" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudSelect Variant="Variant.Text"
                                       Label=@L["Package"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       Required
                                       @bind-Value="@PackageSelectValue">
                                <MudSelectItem Value="PackageSelectValue"></MudSelectItem>
                                @foreach (var package in packages)
                                {
                                    if (package.Status != Enums.SubscriptionStatus.Active)
                                        continue;
                                    if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                    <MudSelectItem Value="package.Id.ToString()">@package.EnglishName</MudSelectItem>
                                    }
                                    else
                                    {
                                    <MudSelectItem Value="package.Id.ToString()">@package.ArabicName</MudSelectItem>
                              
                                    }
                                }
                            </MudSelect>
                        </MudItem>

                        

                            <MudItem sm="4">
                            <MudNumericField Required @bind-Value="FirstHourPrice" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["FirstHourPrice"]" />
                            </MudItem>
                            <MudItem sm="4">
                            <MudNumericField Required @bind-Value="SecondHourPrice" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["SecondHourPrice"]" />
                            </MudItem>
                             <MudItem sm="4">
                            <MudNumericField Required @bind-Value="ThirdHourPrice" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["ThirdHourPrice"]" />
                            </MudItem>
                            <MudItem sm="4">
                            <MudNumericField Required @bind-Value="AdditionalHourPrice" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["AdditionalHourPrice"]" />
                            </MudItem>
                            <MudItem sm="4">
                            <MudNumericField Required @bind-Value="FullDayPrice" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["FullDayPrice"]" />
                            </MudItem>
                            <MudItem sm="4">
                            <MudNumericField Required @bind-Value="NumberOfHours" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["NumberOfHours"]" />
                            </MudItem>
                        
                       

                        <MudItem sm="4">
                            <MudTimePicker  Label="@L["ClosingHoursStart"]" TimeFormat="h:mm tt" Placeholder="@L["Type Here"]" @bind-Time="ClosingHoursStart" ShowToolbar="false" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTimePicker Label="@L["ClosingHoursEnd"]" TimeFormat="h:mm tt" Placeholder="@L["Type Here"]" @bind-Time="ClosingHoursEnd" ShowToolbar="false" />
                        </MudItem>
                        


                        <MudDivider Style="border-top:1px solid #505254; margin:50px 0px;" />

                        <MudFileUpload Class="ms-3" T="IBrowserFile" Accept=".png, .jpg" FilesChanged="OnImageUpload" MaximumFileCount="1">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Filled"
                                           Color="MudBlazor.Color.Primary"
                                           StartIcon="@Icons.Material.Filled.CloudUpload">
                                    @L["OrganizationLogo"]
                                </MudButton>
                            </ActivatorContent>
                            
                        </MudFileUpload>
                        
                       
                    </MudGrid>
                    <MudItem sm="4" Class="mt-5">

                        <div class="d-flex justify-content-between ">
                            <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Dark" OnClick="Cancel">@L["Cancel"]</MudButton>
                            <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Disabled="@(form == null || !form.IsValid)" OnClick="Save">@L["Create"]</MudButton>
                        </div>
                    </MudItem>
                </MudForm>

            </MudPaper>
        </MudItem>
        <MudItem sm="4">
            <MudPaper Class="h-100 p-3  w-100 h-100 main-layout-paper d-flex flex-column justify-content-between" Style="background-color: #F2F2F2;">
              
              @if(Photo != null )
              {
                    <MudItem class="d-flex flex-column align-content-center gap-4 p-5">

                        <MudImage Src="@Photo" Class="rounded-circle" Alt="@L["OrganizationLogo"]" />

                    </MudItem>
              }
                
            </MudPaper>
        </MudItem>

    </MudGrid>
</div>

