@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Packages
@inject IPackagesAppService PackagesAppService
@inject IDialogService Dialog
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
<div class="modal-wrapper ">


    <PageTitle>@L["Organization Packages"]</PageTitle>
    <MudDialog class="mud-modal ">
        <TitleContent>
            <MudText Class="fw-bold">@L["Organization Packages"]</MudText>
        </TitleContent>
        <DialogContent>
            <SPDataGrid PageName=@L["Organization Packages"] Data="@itemData" TotalItemsInTable="TotalItem" OnAdd="CreatePackage" OnFiltering="HandleFilter" OnPageChanged="FetchTableData" OnSearching="HandleSearch"></SPDataGrid>
        </DialogContent>
        <DialogActions>

            <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        </DialogActions>
    </MudDialog>
</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>