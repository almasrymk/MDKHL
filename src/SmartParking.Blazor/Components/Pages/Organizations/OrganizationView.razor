@page "/organizations/view/{Id}"
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@inject IOrganizationsAppService OrganizationsAppService
@inject IStringLocalizer<SmartParkingResource> L
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.State
@using SmartParking.Organizations
@using Volo.Abp.Identity
@using Volo.Abp.Users
@layout Shared.ProfileLayout
@inject ISnackbar Snackbar
@inject IIdentityUserAppService IdentityUserAppService;
@inject UserManager<Volo.Abp.Identity.IdentityUser> UserManager;
@inject SignInManager<Volo.Abp.Identity.IdentityUser> signInManager
@inject NavigationManager Navigation
@inject IDialogService Dialog
@inject ICurrentUser currentuser
<PageTitle>@L["Edit Organization"]</PageTitle>
<div>
    <MudGrid>
        <MudItem sm="8">
            <MudPaper Class="h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">
                <h3 Color="fw-bold">@L["Main Data"]</h3>
                <MudForm Class="flex-grow-1 mt-4">
                    <MudGrid>
                        <MudItem sm="4">
                            <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Code" Label=@L["Code"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="ArabicName" Label=@L["OrganizationArabicName"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="EnglishName" Label=@L["OrganizationEnglishName"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudDatePicker ReadOnly="true" Label="@L["License Expiry Date"]" @bind-Date="LicenseExpiryDate" ShowToolbar="false" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudDatePicker ReadOnly="true" Label="@L["CR Expiry Date"]" @bind-Date="CRExpiryDate" ShowToolbar="false" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField ReadOnly="true" @bind-Value="NumOfCameras" HideSpinButtons="true"  Label=@L["Num Of Cameras"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField ReadOnly="true" @bind-Value="MaxCapacity" HideSpinButtons="true"  Label=@L["Max Capacity"] />
                        </MudItem>
                       
                       
                        <MudItem sm="4"  >
                            <Label>@L["Status"]</Label>
                            <Div Style=@($"background-color: {(Status ? "#b8efb0" : "#f20707")};border:none;color:{(Status ? "#2c5e45" : "#820707")};border-radius:0.4rem;height:2rem;display:flex;justify-content:center;align-items:center;")>
                                @if (Status)
                                {
                                    <MudText>@L["Active"]</MudText>
                                }
                                else
                                {
                                    <MudText>@L["InActive"]</MudText>
                                    
                                }

                                </Div>

                        </MudItem>

                        <MudDivider Style="border-top:1px solid #505254; margin:50px 0px;" />
                        <MudItem sm="4">
                            <MudTextField ReadOnly="true" 
                                Variant="Variant.Text"
                                Label=@L["State"]
                                       @bind-Value="@StateName">

                              
                            </MudTextField>
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField 
                                ReadOnly="true"
                                Variant="Variant.Text"
                                Label=@L["Region"]
                                @bind-Value="@RegionName">
                            </MudTextField>
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField 
                                ReadOnly="true"
                                Variant="Variant.Text"
                                Label=@L["Country"]
                                @bind-Value="@CountryName">
                                
                            </MudTextField>
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField
                                ReadOnly="true"
                                Variant="Variant.Text"
                                Label=@L["City"]
                                @bind-Value="@CityName">
                                
                            </MudTextField>
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField ReadOnly="true" T="string"  @bind-Value="PhoneNum"  Label=@L["Contact Phone"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField ReadOnly="true" T="string"  @bind-Value="WhatsAppNum"  Label="@L["Whatsapp Num"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField ReadOnly="true" T="string"  @bind-Value="ContactMail"  Label="@L["Contact Email"]" />
                        </MudItem>

                    </MudGrid>

                    <div class="d-flex justify-content-between mt-auto">
                        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="Back">@L["Back"]</MudButton>
                    </div>
                </MudForm>

            </MudPaper>
        </MudItem>
        <MudItem sm="4">
            <MudPaper Class="h-100 p-3  w-100 h-100 main-layout-paper d-flex flex-column justify-content-between" Style="background-color: #F2F2F2;">
                <div class="d-flex justify-content-between align-items-center">
                    <MudText>@L["My Profile"]</MudText>
                    <MudLink Underline="Underline.Always" Href="/edit-profile">@L["Edit Profile"]</MudLink>
                </div>
                <div class="d-flex flex-column align-content-center gap-4 p-5">
                    <MudImage Src="images/profile-avatar.png" Class="rounded-circle" />
                    <div class="d-flex flex-column align-items-center">
                        <MudText Class="fw-bold">@currentuser.Name</MudText>
                        <MudText>@currentuser.Email</MudText>
                    </div>
                </div>
                <MudGrid Class="mt-3">
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewGarages">@L["Garages"]</MudLink>
                        </MudPaper>
                    </MudItem>
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark">@L["Subscriptions"]</MudLink>
                        </MudPaper>
                    </MudItem>

                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewCategories">@L["Categories"]</MudLink>

                        </MudPaper>
                    </MudItem>
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewCustomers">@L["Customers"]</MudLink>

                        </MudPaper>
                    </MudItem>

                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewUsers">@L["Users"]</MudLink>
                        </MudPaper>
                    </MudItem>
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewContact">@L["Contact Data"]</MudLink>
                        </MudPaper>
                    </MudItem>

                </MudGrid>
            </MudPaper>
        </MudItem>

    </MudGrid>
</div>

