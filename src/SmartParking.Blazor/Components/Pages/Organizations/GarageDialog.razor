@using SmartParking.Garages
@inject IGarageAppService GarageAppService
@inject IDialogService Dialog
<div class="modal-wrapper ">
    <MudDialog class="mud-modal ">
        <TitleContent>
            <MudText Class="fw-bold">Organization - Garage</MudText>
        </TitleContent>
        <DialogContent>
            <SPDataGrid Data="@itemData" TotalItemsInTable="TotalItem" OnAdd="CreateGarage" OnFiltering="HandleFilter" OnPageChanged="FetchTableData" OnSearching="HandleSearch"></SPDataGrid>
        </DialogContent>
        <DialogActions>
           
            <MudButton OnClick="Cancel">Cancel</MudButton>
        </DialogActions>
    </MudDialog>
</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>