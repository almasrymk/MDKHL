@using Microsoft.Extensions.Localization
@using SmartParking.Garages
@using SmartParking.Localization
@inject IGarageAppService GarageAppService
@inject IDialogService Dialog

@inject IStringLocalizer<SmartParkingResource> L

<PageTitle>@L["Organization Garages"]</PageTitle>
<div class="modal-wrapper ">
    <MudDialog class="mud-modal ">
        <TitleContent>
            <MudText Class="fw-bold">@L["Organization Garages"]</MudText>
        </TitleContent>
        <DialogContent>
            <SPDataGrid PageName=@L["Organization Garages"] Data="@itemData" TotalItemsInTable="TotalItem" OnPageChanged="FetchTableData" OnClickRowEdit="OnClickRowEdit"></SPDataGrid>
        </DialogContent>
        <DialogActions>
           
            <MudButton Variant="Variant.Filled"  class="mx-3 mt-5" Color="MudBlazor.Color.Primary" OnClick="Cancel">@L["Cancel"]</MudButton>
        </DialogActions>
    </MudDialog>
</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>