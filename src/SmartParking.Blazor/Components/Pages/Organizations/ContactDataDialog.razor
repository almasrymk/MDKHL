@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Organizations
@inject IDialogService Dialog
@inject IStringLocalizer<SmartParkingResource> L
@inject IContactInfoAppService ContactInfoAppService
<PageTitle>@L["Organization"]-@L["Contact Data"]</PageTitle>
<div class="modal-wrapper ">
    <MudDialog class="mud-modal ">
        <TitleContent>
            <MudText Class="fw-bold">@L["Organization"]-@L["Contact Data"]</MudText>
        </TitleContent>
        <DialogContent>
            <SPDataGrid PageName=@L["Contact Data"] Data="@itemData" TotalItemsInTable="TotalItem"  OnPageChanged="FetchTableData" ></SPDataGrid>
        </DialogContent>
        <DialogActions>

            <MudButton Variant="Variant.Filled" class="mx-3 mt-5" Color="MudBlazor.Color.Dark" OnClick="Cancel">@L["Cancel"]</MudButton>
        </DialogActions>
    </MudDialog>
</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>