@using Microsoft.Extensions.Localization
@using SmartParking.CustomerCategories
@using SmartParking.Localization
@inject IDialogService Dialog
@inject IStringLocalizer<SmartParkingResource> L
@inject ICustomerCategoryAppService CustomerCategoryAppService

<PageTitle>@L["Organization - Customer Categories"]</PageTitle>
<div class="modal-wrapper ">
    <MudDialog class="mud-modal ">
        <TitleContent>
            <MudText Class="fw-bold">@L["Organization Customer Categories"]</MudText>
        </TitleContent>
        <DialogContent>
            <SPDataGrid PageName=@L["Organization Customer Categories"] Data="@itemData" TotalItemsInTable="TotalItem"   OnPageChanged="FetchTableData" ></SPDataGrid>
        </DialogContent>
        <DialogActions>

            <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        </DialogActions>
    </MudDialog>
</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>