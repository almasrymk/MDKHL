@page "/organizations/update/{Id}"
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@inject IOrganizationsAppService OrganizationsAppService
@inject IStringLocalizer<SmartParkingResource> L
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.State
@using SmartParking.Organizations
@using Volo.Abp.Identity
@layout Shared.ProfileLayout
@inject IOrganizationsAppService OrganizationAppService
@inject ISnackbar Snackbar
@inject IStateAppService StateAppService
 @inject IGovernorateAppService GovernorateAppService
 @inject ICitiesAppService CitiesAppService
@inject IIdentityUserAppService IdentityUserAppService;
@inject UserManager<Volo.Abp.Identity.IdentityUser> UserManager;
@inject SignInManager<Volo.Abp.Identity.IdentityUser> signInManager
@inject NavigationManager Navigation
@inject IDialogService Dialog
<PageTitle>@L["Edit Organization"]</PageTitle>
<div>
    <MudGrid>
        <MudItem sm="8">
            <MudPaper Class="h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">
                <h3 Color="fw-bold">@L["Main Data"]</h3>
                <MudForm Class="flex-grow-1 mt-4">
                    <MudGrid>
                       
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="EnglishName" Placeholder="@L["Type Here"]" Label="@L["English Name"]" />
                        </MudItem>
                       
                        <MudItem sm="4">
                            <MudNumericField Required="true"  @bind-Value="NumOfCameras" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["Num Of Cameras"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField Required="true" @bind-Value="MaxCapacity" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["Max Capacity"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudDatePicker IsDateDisabledFunc="@((DateTime dt) => dt.Date < DateTime.Today)" Required="true" Label="@L["CR Expiry Date"]" Placeholder="@L["Choose your date"]" @bind-Date="CRExpiryDate" ShowToolbar="false" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudDatePicker IsDateDisabledFunc="@((DateTime dt) => dt.Date < DateTime.Today)" Required="true" Label="@L["License Expiry Date"]" Placeholder="@L["Choose your date"]" @bind-Date="LicenseExpiryDate" ShowToolbar="false" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudSwitch Label="@L["Status Active"]" LabelPosition="LabelPosition.Start" Placeholder="@L["Choose your date"]" @bind-Value="Status" Color="MudBlazor.Color.Primary" />
                        </MudItem>

                        <MudDivider Style="border-top:1px solid #505254; margin:50px 0px;" />
                        <MudItem sm="4">
                            <MudSelect Variant="Variant.Text"
                                       Label="@L["State"]"
                                       Placeholder="@L["Choose"]"
                                       Clearable="true"
                                       @bind-Value="@StateSelectValue">

                                @foreach (var state in states)
                                {
                                    <MudSelectItem Value="@state.Id.ToString()">@state.EnglishName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem sm="4">
                            <MudSelect Variant="Variant.Text"
                                       Label="@L["Region"]"
                                       Placeholder="@L["Choose"]"
                                       Clearable="true"
                                       AnchorOrigin="Origin.TopCenter"
                                       @bind-Value="@RegionSelectValue">
                                <MudSelectItem Value="CitySelectValue"></MudSelectItem>
                                @foreach (var region in regions)
                                {
                                    <MudSelectItem Value="@region.Id.ToString()">@region.EnglishName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem sm="4">
                            <MudSelect Variant="Variant.Text"
                                       Label="@L["Country"]"
                                       Placeholder="@L["Choose"]"
                                       Clearable="true"
                                       @bind-Value="@CountrySelectValue">
                                <MudSelectItem Value="CitySelectValue"></MudSelectItem>
                                @foreach (var country in countries)
                                {
                                    <MudSelectItem Value="country.Id.ToString()">@country.EnglishName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem sm="4">
                            <MudSelect Variant="Variant.Text"
                                       Label="@L["City"]"
                                       Placeholder="@L["Choose"]"
                                       Clearable="true"
                                       @bind-Value="@CitySelectValue">
                                <MudSelectItem Value="CitySelectValue"></MudSelectItem>
                                @foreach (var city in cities)
                                {
                                    <MudSelectItem Value="city.Id.ToString()">@city.EnglishName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        
                       
                    </MudGrid>
                   
                    <div class="d-flex justify-content-between mt-auto">
                        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Dark" OnClick="Cancel">@L["Cancel"]</MudButton>
                        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="Update">@L["Save"]</MudButton>
                    </div>
                </MudForm>

            </MudPaper>
        </MudItem>
        <MudItem sm="4">
            <MudPaper Class="h-100 p-3  w-100 h-100 main-layout-paper d-flex flex-column justify-content-between" Style="background-color: #F2F2F2;">
                <div class="d-flex justify-content-between align-items-center">
                    <MudText>@L["My Profile"]</MudText>
                    <MudLink Underline="Underline.Always" Href="/edit-profile">@L["Edit Profile"]</MudLink>
                </div>
                <div class="d-flex flex-column align-content-center gap-4 p-5">
                    <MudImage Src="images/profile-avatar.png" Class="rounded-circle" />
                    <div class="d-flex flex-column align-items-center">
                        <MudText Class="fw-bold">Ahmed Mohamed</MudText>
                        <MudText>A.Mohamed@mdkhl.com</MudText>
                    </div>
                </div>
                <MudGrid Class="mt-3">
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewGarages">@L["Garages"]</MudLink>
                        </MudPaper>
                    </MudItem>
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewSubscription">@L["Subscriptions"]</MudLink>
                        </MudPaper>
                    </MudItem>

                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark">@L["Categories"]</MudLink>

                        </MudPaper>
                    </MudItem>
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewPackages">@L["Packages"]</MudLink>

                        </MudPaper>
                    </MudItem>

                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark">@L["Users"]</MudLink>
                        </MudPaper>
                    </MudItem>
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark">@L["Contact Data"]</MudLink>
                        </MudPaper>
                    </MudItem>

                </MudGrid>
            </MudPaper>
        </MudItem>

    </MudGrid>
</div>

