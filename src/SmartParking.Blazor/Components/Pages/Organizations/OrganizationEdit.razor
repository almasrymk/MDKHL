@page "/organizations/update/{Id}"
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@inject IOrganizationsAppService OrganizationsAppService
@inject IStringLocalizer<SmartParkingResource> L
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.Region
@using SmartParking.Lookups.State
@using SmartParking.Organizations
@using SmartParking.SubscriptionTypes
@using SmartParking.Subscriptions
@using System.Globalization
@using SmartParking.Validations
@using Volo.Abp.Identity
@layout Shared.ProfileLayout
@inject IOrganizationsAppService OrganizationAppService
@inject ISnackbar Snackbar
@inject IStateAppService StateAppService
 @inject ICountriesAppService CountriesAppService
 @inject ICitiesAppService CitiesAppService
@inject IIdentityUserAppService IdentityUserAppService;
@inject UserManager<Volo.Abp.Identity.IdentityUser> UserManager;
@inject SignInManager<Volo.Abp.Identity.IdentityUser> signInManager
@inject NavigationManager Navigation
@inject IDialogService Dialog
@inject ISubscriptionAppService SubscriptionAppService
@inject IRegionAppService RegionAppService
@inject IAuthorizationService AuthorizationService
<PageTitle>@L["Edit Organization"]</PageTitle>
<div>
    <MudGrid>
        <MudItem sm="8">
            <MudPaper Class="h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">
                <h3 Color="fw-bold">@L["Main Data"]</h3>
                <MudForm Class="flex-grow-1 mt-4">
                    <MudGrid>
                       
                        <MudItem sm="6">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="_createUpdateOrganiztionDto.EnglishName" Placeholder=@L["Type Here"] Label=@L["EnglishName"] />
                        </MudItem>
                        <MudItem sm="6">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="_createUpdateOrganiztionDto.ArabicName" Placeholder=@L["Type Here"] Label=@L["ArabicName"] />
                        </MudItem>                        
                        <MudItem sm="6">
                            <MudTextField Disabled="true" T="string" InputType="InputType.Text" @bind-Value="Code" Placeholder=@L["Type Here"] Label=@L["Code"] />
                        </MudItem>
                      
                        <MudItem sm="6">
                            <MudDatePicker IsDateDisabledFunc="@((DateTime dt) => dt.Date < DateTime.Today)" Required="true" Label=@L["CR Expiry Date"] Placeholder=@L["Time Placeholder"]
                                           @bind-Date="CRExpiryDate" ShowToolbar="false" />
                        </MudItem>
                        
                        <MudItem sm="6">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="_createUpdateOrganiztionDto.CommercialRegistrationNumber" Placeholder=@L["Type Here"] Label=@L["CommercialRegistrationNumber"] />
                        </MudItem>

                        <MudItem sm="6">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="_createUpdateOrganiztionDto.TaxNumber" Placeholder=@L["Type Here"] Label=@L["TaxNumber"] />
                        </MudItem>

                        <MudDivider Style="border-top:1px solid #505254; margin:10px 0px;" />
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="_createUpdateOrganiztionDto.PhoneNumber" Placeholder=@L["Type Here"] Label=@L["Contact Phone"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="_createUpdateOrganiztionDto.WhatsAppNum" Placeholder=@L["Type Here"] Label=@L["Whatsapp Num"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="_createUpdateOrganiztionDto.Email" Placeholder=@L["Type Here"] Label=@L["Contact Email"] />
                        </MudItem>

                        <MudDivider Style="border-top:1px solid #505254; margin:10px 0px;" />

                        <MudItem sm="4">
                            <MudSelect Variant="Variant.Text"
                                       Label=@L["Country"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       @bind-Value="@CountrySelectValue"
                                       @onchange="GetRegions">
                                <MudSelectItem Disabled="true" Value="CountryNameEdit"></MudSelectItem>
                                @foreach (var country in countries)
                                {
                                    if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="country.Id.ToString()">@country.EnglishName</MudSelectItem>
                                    }
                                    else
                                    {
                                        <MudSelectItem Value="country.Id.ToString()">@country.ArabicName</MudSelectItem>
                                    }
                                }

                            </MudSelect>
                        </MudItem>

                        <MudItem sm="4">
                            <MudSelect T="string" Variant="Variant.Text"
                                       Label=@L["Region"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       @bind-Value="RegionSelectValue"
                                       @onchange="GetStates">
                                <MudSelectItem Disabled="true" Value="RegionNameEdit"></MudSelectItem>
                                @foreach (var region in regions)
                                {
                                    if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="@region.Id.ToString()">@region.EnglishName</MudSelectItem>
                                    }
                                    else
                                    {
                                        <MudSelectItem Value="@region.Id.ToString()">@region.ArabicName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem sm="4">
                            <MudSelect T="string" Variant="Variant.Text"
                                       Label=@L["State"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       Text="@StateNameEdit"
                                       @onchange="GetCities">
                                <MudSelectItem Value="StateNameEdit"></MudSelectItem>
                                @foreach (var state in states)
                                {
                                    if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="@state.Id.ToString()">@state.EnglishName</MudSelectItem>
                                    }
                                    else
                                    {

                                        <MudSelectItem Value="@state.Id.ToString()">@state.ArabicName</MudSelectItem>

                                    }

                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem sm="4">
                            <MudSelect Variant="Variant.Text"
                                       Label=@L["City"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       @bind-Value="@CitySelectValue">
                                <MudSelectItem Disabled="true" Value="CityNameEdit"></MudSelectItem>
                                @foreach (var city in cities)
                                {

                                    if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="city.Id.ToString()">@city.EnglishName</MudSelectItem>
                                    }
                                    else
                                    {
                                        <MudSelectItem Value="city.Id.ToString()">@city.ArabicName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem sm="4">
                            <MudSwitch Label=@L["Status Active"] Disabled="!HasChangeStatusPermission" LabelPosition="LabelPosition.Start" @bind-Value="Status" Color="MudBlazor.Color.Primary" />
                        </MudItem>

                        <MudDivider Style="border-top:1px solid #505254; margin:10px 0px;" />

                        <MudItem sm="4">
                            <MudNumericField Required="true" Validation="@(new Func<int, string>(NumbersValidations.validateNumber0to9999))" @bind-Value="_createUpdateOrganiztionDto.BuildingNumber" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["BuidlingNumber"]" />
                        </MudItem>

                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="_createUpdateOrganiztionDto.StreetName" Placeholder="@L["Type Here"]" Label="@L["StreetName"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField Validation="@(new Func<int, string>(NumbersValidations.ValidateNumber1111to9999))"
                                             Required="true" @bind-Value="_createUpdateOrganiztionDto.SecondaryNumber" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["SecondaryNumber"]" />
                        </MudItem>

                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="_createUpdateOrganiztionDto.District" Placeholder="@L["Type Here"]" Label="@L["District"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField Required="true" Validation="@(new Func<int, string>(NumbersValidations.ValidateNumber11111to99999))" @bind-Value="_createUpdateOrganiztionDto.PostalCode" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["PostalCode"]" />
                        </MudItem>
                        <MudItem sm="12">
                            <MudTextField Disabled T="string" InputType="InputType.Text" dir="rtl" @bind-Value="_createUpdateOrganiztionDto.Address" Placeholder="@L["Type Here"]" Label="@L["Address"]" />
                        </MudItem>
                   
                       
                       
                        <MudDivider Style="border-top:1px solid #505254; margin:10px 0px;" />
                        <MudItem sm="12">
                            <MudSelect T="int" Variant="Variant.Text"
                                       Label=@L["Package"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       Required
                                       ValueChanged="OnSubscriptionSelected">
                                <MudSelectItem Disabled="true" Value="SelectedSubscription.Id">@(CultureInfo.CurrentCulture.Name == "en" ? SelectedSubscription.EnglishName : SelectedSubscription.ArabicName)</MudSelectItem>

                                @foreach (var subscription in SubscriptionDtos)
                                {
                                    if (subscription.Status != Enums.SubscriptionStatus.Active)
                                        continue;
                                    if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="subscription.Id">@subscription.EnglishName</MudSelectItem>
                                    }
                                    else
                                    {
                                        <MudSelectItem Value="subscription.Id">@subscription.ArabicName</MudSelectItem>

                                    }
                                }
                            </MudSelect>
                        </MudItem>
                        @if (SelectedSubscription is not null)
                        {

                            <MudItem sm="4">
                                <MudNumericField ReadOnly="true" HideSpinButtons="true" Label=@L["Max Number Of Garages"] @bind-Value="NumbersOfGarages" />

                            </MudItem>
                            <MudItem sm="4">
                                <MudNumericField ReadOnly="true" HideSpinButtons="true" Label=@L["Max Number Of Cameras"] @bind-Value="NumberOfCameras" />

                            </MudItem>
                            <MudItem sm="4">
                                <MudNumericField ReadOnly="true" HideSpinButtons="true" Label=@L["Max Number Of Users"] @bind-Value="NumberOfUsers" />

                            </MudItem>
                            <MudItem sm="4">
                                <MudNumericField ReadOnly="true" HideSpinButtons="true" Label=@L["Max Number Of Customers"] @bind-Value="NumberOfCustomers" />

                            </MudItem>
                            <MudItem sm="4">
                                <MudNumericField ReadOnly="true" HideSpinButtons="true" Label=@L["ParkingSlot"] @bind-Value="Parkingslot" />

                            </MudItem>


                        }
                        <MudDivider Style="border-top:1px solid #505254; margin:10px 0px;" />
                        <MudItem sm="4">
                            <MudCheckBox T="bool" @bind-Value="_createUpdateOrganiztionDto.HasFreeSlots">@L["HasFreeSlots"]</MudCheckBox>
                        </MudItem>
                        <MudItem sm="4">
                            <MudCheckBox T="bool" @bind-Value="_createUpdateOrganiztionDto.HasPackageOnly">@L["HasPackageOnly"]</MudCheckBox>
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField T="decimal" Immediate="true" @bind-Value="_createUpdateOrganiztionDto.FirstHourPrice" Min="0" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label=@($"{L["FirstHourPrice"]} ({L["SAR"]})") />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField T="decimal" Immediate="true" @bind-Value="_createUpdateOrganiztionDto.SecondHourPrice" Min="0" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label=@($"{L["SecondHourPrice"]} ({L["SAR"]})") />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField T="decimal" Immediate="true" @bind-Value="_createUpdateOrganiztionDto.ThirdHourPrice" Min="0" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label=@($"{L["ThirdHourPrice"]} ({L["SAR"]})") />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField T="decimal" Immediate="true" @bind-Value="_createUpdateOrganiztionDto.AdditionalHourPrice" Min="0" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label=@($"{L["AdditionalHourPrice"]} ({L["SAR"]})") />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField T="decimal" Immediate="true" @bind-Value="_createUpdateOrganiztionDto.FullDayPrice" Min="0" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label=@($"{L["FullDay"]} ({L["SAR"]})") />
                        </MudItem>

                        <MudItem sm="4">
                            <MudNumericField T="int" @bind-Value="_createUpdateOrganiztionDto.FreeMinutes" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label=@($"{L["FreeMinutes"]} ({L["Minutes"]})") />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField T="int" @bind-Value="_createUpdateOrganiztionDto.Graceperiod" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label=@($"{L["Graceperiod"]} ({L["Minutes"]})") />
                        </MudItem>
                        <MudItem sm="12">
                            <MudSwitch Label="@L["NumberOfHoursExceeded"]" LabelPosition="LabelPosition.End" @bind-Value="_createUpdateOrganiztionDto.IsNumberOfHoursExceeded" Color="MudBlazor.Color.Primary" />
                        </MudItem>
                        <MudItem sm="12">
                            <MudSwitch Label="@L["IsClose"]" LabelPosition="LabelPosition.End" @bind-Value="_createUpdateOrganiztionDto.IsClose" Color="MudBlazor.Color.Primary" />
                        </MudItem>
                    
                        @if (_createUpdateOrganiztionDto.IsNumberOfHoursExceeded)
                        {
                            <MudItem sm="6">
                                <MudNumericField T="int" Immediate="true" Required="@_createUpdateOrganiztionDto.IsNumberOfHoursExceeded" @bind-Value="@NumberOfHours" Min="0" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["NumberOfHours"]" />
                            </MudItem>
                        }
                        @if (_createUpdateOrganiztionDto.IsClose)
                        {
                            <MudItem sm="6">
                                <MudTimePicker Required="@_createUpdateOrganiztionDto.IsClose" Label="@L["ClosingHoursStart"]" Placeholder="@L["Type Here"]" TimeFormat="h:mm tt" @bind-Time="ClosingHoursStart" ShowToolbar="false" />
                            </MudItem>
                            <MudItem sm="6">
                                <MudTimePicker Required="@_createUpdateOrganiztionDto.IsClose" Label="@L["ClosingHoursEnd"]" Placeholder="@L["Type Here"]" TimeFormat="h:mm tt" @bind-Time="ClosingHoursEnd" ShowToolbar="false" />
                            </MudItem>

                        }
                                               
                       
                    </MudGrid>
                   
                    <div class="d-flex justify-content-between mt-5">
                        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Dark" OnClick="Cancel">@L["Cancel"]</MudButton>
                        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="Update">@L["Save"]</MudButton>
                    </div>
                </MudForm>

            </MudPaper>
        </MudItem>
        <MudItem sm="4">
            <MudPaper Class="h-100 p-3  w-100 h-100 main-layout-paper d-flex flex-column justify-content-between" Style="background-color: #F2F2F2;">

                <div class="d-flex flex-column align-items-center px-5 position-relative pb-6">
                    @if (OrganizationPicture != null)
                    {
                      <MudImage Src="@(OrganizationPicture ?? "images/MDHKL_04.png")" Class="bg_w_foto " Width="200" Height="200" Alt="@L["OrganizationLogo"]" />
                    }
                    else
                    {
                      <MudImage Src="images/MDHKL_04.png" Class="bg_w_foto " Width="200" Height="200" Alt="@L["OrganizationLogo"]" />
                    }                   
                    <MudFileUpload T="IBrowserFile" Accept=".png, .jpg" FilesChanged="OnImageUpload" MaximumFileCount="1">
                        <ActivatorContent>
                            <MudFab Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.CameraAlt" Size="MudBlazor.Size.Medium" Class="rounded-circle" />
                        </ActivatorContent>
                    </MudFileUpload>
                </div>


             
                
                <MudGrid Class="mt-3">
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewGarages">@L["Garages"]</MudLink>
                        </MudPaper>
                    </MudItem>
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewSubscription">@L["Subscriptions"]</MudLink>
                        </MudPaper>
                    </MudItem>

                    <MudItem sm="12">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewCustomers">@L["Customers"]</MudLink>

                        </MudPaper>
                    </MudItem>
                    @* <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewUsers">@L["Users"]</MudLink>
                        </MudPaper>
                    </MudItem> 
                    <MudItem sm="12">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewContact">@L["Contact Data"]</MudLink>
                        </MudPaper>
                    </MudItem>
                    *@
                 
                </MudGrid>
            </MudPaper>
        </MudItem>

    </MudGrid>
</div>

<style>
    .bg_w_foto 
    {
        background: url(images/cities/<?php echo $city_name;
        ?>) no-repeat center center;
        -webkit-background-size: cover;
        -moz-background-size: cover;
        -o-background-size: cover;
        background-size: cover;
        display: flex;
        align-self: center;
    }
</style>