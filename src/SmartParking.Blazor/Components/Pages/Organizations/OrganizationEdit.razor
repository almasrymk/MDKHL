@page "/organizations/update/{Id}"
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@inject IOrganizationsAppService OrganizationsAppService
@inject IStringLocalizer<SmartParkingResource> L
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.Region
@using SmartParking.Lookups.State
@using SmartParking.Organizations
@using SmartParking.SubscriptionTypes
@using SmartParking.Subscriptions
@using System.Globalization
@using Volo.Abp.Identity
@layout Shared.ProfileLayout
@inject IOrganizationsAppService OrganizationAppService
@inject ISnackbar Snackbar
@inject IStateAppService StateAppService
 @inject ICountriesAppService CountriesAppService
 @inject ICitiesAppService CitiesAppService
@inject IIdentityUserAppService IdentityUserAppService;
@inject UserManager<Volo.Abp.Identity.IdentityUser> UserManager;
@inject SignInManager<Volo.Abp.Identity.IdentityUser> signInManager
@inject NavigationManager Navigation
@inject IDialogService Dialog
@inject ISubscriptionAppService SubscriptionAppService
@inject IRegionAppService RegionAppService
<PageTitle>@L["Edit Organization"]</PageTitle>
<div>
    <MudGrid>
        <MudItem sm="8">
            <MudPaper Class="h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">
                <h3 Color="fw-bold">@L["Main Data"]</h3>
                <MudForm Class="flex-grow-1 mt-4">
                    <MudGrid>
                       
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="EnglishName" Placeholder=@L["Type Here"] Label=@L["EnglishName"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="ArabicName" Placeholder=@L["Type Here"] Label=@L["ArabicName"] />
                        </MudItem>
                       
                        <MudItem sm="4">
                            <MudNumericField Required="true"  @bind-Value="NumOfCameras" HideSpinButtons="true" Min="0"  Placeholder=@L["Type Here"] Label=@L["Num Of Cameras"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField Required="true" @bind-Value="MaxCapacity" HideSpinButtons="true" Min="0" Placeholder=@L["Type Here"] Label=@L["Max Capacity"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudDatePicker IsDateDisabledFunc="@((DateTime dt) => dt.Date < DateTime.Today)" Required="true" Label=@L["CR Expiry Date"] Placeholder=@L["Time Placeholder"]
                                           @bind-Date="CRExpiryDate" ShowToolbar="false" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudDatePicker IsDateDisabledFunc="@((DateTime dt) => dt.Date < DateTime.Today)" Required="true" Label=@L["License Expiry Date"] Placeholder=@L["Time Placeholder"] @bind-Date="LicenseExpiryDate" ShowToolbar="false" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="CommercialRegistrationNumber" Placeholder=@L["Type Here"] Label=@L["CommercialRegistrationNumber"] />
                        </MudItem>
                        <MudItem sm="8">
                            <MudTextField ReadOnly="true" T="string" InputType="InputType.Text" @bind-Value="Address" Placeholder=@L["Type Here"] Label=@L["Address"] />
                        </MudItem>

                        <MudItem sm="4">
                            <MudNumericField Required="true" Min="1" Max="9999" @bind-Value="BuildingNumber" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["BuidlingNumber"]" />
                        </MudItem>

                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="StreetName" Placeholder="@L["Type Here"]" Label="@L["StreetName"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField Required="true" Min="1" Max="9999" @bind-Value="SecondaryNumber" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["SecondaryNumber"]" />
                        </MudItem>

                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="District" Placeholder="@L["Type Here"]" Label="@L["District"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField Required="true" Min="11111" Max="99999" @bind-Value="PostalCode" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["PostalCode"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField T="decimal" Immediate="true" Required="true" @bind-Value="FirstHourPrice" Min="0" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["FirstHourPrice"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField T="decimal" Immediate="true" Required="true" @bind-Value="SecondHourPrice" Min="0" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["SecondHourPrice"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField T="decimal" Immediate="true" Required="true" @bind-Value="ThirdHourPrice" Min="0" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["ThirdHourPrice"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField T="decimal" Immediate="true" Required="true" @bind-Value="AdditionalHourPrice" Min="0" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["AdditionalHourPrice"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField T="decimal" Immediate="true" Required="true" @bind-Value="FullDayPrice" Min="0" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["FullDay"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField T="int" Immediate="true" Required="true" @bind-Value="NumberOfHours" Min="0" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["NumberOfHours"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTimePicker Required="true" Label="@L["ClosingHoursStart"]"  Placeholder="@L["Type Here"]" TimeFormat="h:mm tt" @bind-Time="ClosingHoursStart" ShowToolbar="false" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTimePicker Required="true" Label="@L["ClosingHoursEnd"]"  Placeholder="@L["Type Here"]" TimeFormat="h:mm tt" @bind-Time="ClosingHoursEnd" ShowToolbar="false" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudSwitch Label=@L["Status Active"] LabelPosition="LabelPosition.Start"  @bind-Value="Status" Color="MudBlazor.Color.Primary" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudSwitch Label="@L["NumberOfHoursExceeded"]" LabelPosition="LabelPosition.Start" @bind-Value="IsNumberOfHoursExceeded" Color="MudBlazor.Color.Primary" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudSwitch Label="@L["IsClose"]" LabelPosition="LabelPosition.Start" @bind-Value="IsClose" Color="MudBlazor.Color.Primary" />
                        </MudItem>
                        <MudDivider Style="border-top:1px solid #505254; margin:50px 0px;" />
                        <MudItem sm="4">
                            <MudSelect Variant="Variant.Text"
                                       Label=@L["Package"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       Required
                                       @bind-Value="@PackageSelectValue">
                                <MudSelectItem Value="PackageSelectValue"></MudSelectItem>
                                @foreach (var package in packages)
                                {
                                    if (package.Status != Enums.SubscriptionStatus.Active)
                                        continue;
                                    if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="package.Id.ToString()">@package.EnglishName</MudSelectItem>
                                    }
                                    else
                                    {
                                        <MudSelectItem Value="package.Id.ToString()">@package.ArabicName</MudSelectItem>

                                    }
                                }
                            </MudSelect>
                        </MudItem>

                        <MudDivider Style="border-top:1px solid #505254; margin:50px 0px;" />
                        <MudItem sm="4">
                            <MudSelect Variant="Variant.Text"
                                       Label=@L["Country"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       @bind-Value="@CountrySelectValue"
                                       @onchange="GetRegions">
                                <MudSelectItem Value="CountryNameEdit"></MudSelectItem>
                                @foreach (var country in countries)
                                {
                                    <MudSelectItem Value="country.Id.ToString()">@country.EnglishName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                       
                        <MudItem sm="4">
                            <MudSelect T="string" Variant="Variant.Text"
                                       Label=@L["Region"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       @bind-Value="RegionSelectValue"
                                       @onchange="GetStates">
                                <MudSelectItem Value="RegionNameEdit"></MudSelectItem>
                                @foreach (var region in regions)
                                {
                                    <MudSelectItem Value="@region.Id.ToString()">@region.EnglishName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem sm="4">
                            <MudSelect T="string" Variant="Variant.Text"
                                       Label=@L["State"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       @bind-Value="StateSelectValue"
                                       @onchange="GetCities">
                                <MudSelectItem Value="StateNameEdit"></MudSelectItem>
                                @foreach (var state in states)
                                {
                                    <MudSelectItem Value="@state.Id.ToString()">@state.EnglishName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem sm="4">
                            <MudSelect Variant="Variant.Text"
                                       Label=@L["City"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       @bind-Value="@CitySelectValue">
                                <MudSelectItem Value="CityNameEdit"></MudSelectItem>
                                @foreach (var city in cities)
                                {
                                    <MudSelectItem Value="city.Id.ToString()">@city.EnglishName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Telephone" @bind-Value="PhoneNum" Placeholder=@L["Type Here"] Label=@L["Contact Phone"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Telephone" @bind-Value="WhatsAppNum" Placeholder=@L["Type Here"] Label=@L["Whatsapp Num"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Email" @bind-Value="ContactMail" Placeholder=@L["Type Here"] Label=@L["Contact Email"] />
                        </MudItem>

                        <MudItem sm="4">
                            <MudFileUpload T="IBrowserFile" Accept=".png, .jpg" FilesChanged="OnImageUpload" MaximumFileCount="1">
                                <ActivatorContent>
                                    <MudButton Variant="Variant.Filled"
                                               Color="MudBlazor.Color.Primary"
                                               StartIcon="@Icons.Material.Filled.CloudUpload">
                                        @L["OrganizationLogo"]
                                    </MudButton>
                                </ActivatorContent>

                            </MudFileUpload>

                        </MudItem>
                    </MudGrid>
                   
                    <div class="d-flex justify-content-between mt-5">
                        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Dark" OnClick="Cancel">@L["Cancel"]</MudButton>
                        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="Update">@L["Save"]</MudButton>
                    </div>
                </MudForm>

            </MudPaper>
        </MudItem>
        <MudItem sm="4">
            <MudPaper Class="h-100 p-3  w-100 h-100 main-layout-paper d-flex flex-column justify-content-between" Style="background-color: #F2F2F2;">
               
                <MudItem class="d-flex flex-column align-content-center gap-4 p-5">
                    <MudImage Src="@OrganizationPicture" Class="rounded-circle" Alt="@L["OrganizationLogo"]" />
                </MudItem>


                <MudGrid Class="mt-3">
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewGarages">@L["Garages"]</MudLink>
                        </MudPaper>
                    </MudItem>
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewSubscription">@L["Subscriptions"]</MudLink>
                        </MudPaper>
                    </MudItem>
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewCategories">@L["Categories"]</MudLink>

                        </MudPaper>
                    </MudItem>
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewCustomers">@L["Customers"]</MudLink>

                        </MudPaper>
                    </MudItem>
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewUsers">@L["Users"]</MudLink>
                        </MudPaper>
                    </MudItem>
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewContact">@L["Contact Data"]</MudLink>
                        </MudPaper>
                    </MudItem>

                </MudGrid>
            </MudPaper>
        </MudItem>

    </MudGrid>
</div>

