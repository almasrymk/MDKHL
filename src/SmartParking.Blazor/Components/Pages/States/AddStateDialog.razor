@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.City
@using SmartParking.Lookups.State
@using System.Globalization
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@inject IStateAppService StateAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
<PageTitle>@L["AddStates"]</PageTitle>

<MudItem class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["NewState"]</MudText>
        </TitleContent>
        <DialogContent>


            <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                <MudGrid>
                    <MudItem sm="6">
                        <MudTextField @bind-Value="input.ArabicName"
                                      For="@(() => input.ArabicName)"
                                      Immediate="true"
                                      Required ="true"
                                      Variant="Variant.Text"
                                      Placeholder=@L["Type Here"]
                                      InputType="InputType.Text"
                                      Label="@L["ArabicName"]" />
                    </MudItem>

                    <MudItem sm="6">
                        <MudTextField @bind-Value="input.EnglishName"
                                      For="@(() => input.EnglishName)"
                                      Immediate="true"
                                      Required="true"
                                      Variant="Variant.Text"
                                      Placeholder=@L["Type Here"]
                                      InputType="InputType.Text"
                                          Label="@L["EnglishName"]" />
                    </MudItem>
                    <MudItem sm="6">
                        <MudSelect Variant="Variant.Text"
                                   Label="@L["Region"]"
                                   Placeholder="@L["Choose"]"
                                   Clearable="true"
                                   @bind-Value="input.RegionId">
                            @foreach (var region in regions)
                            {
                                @if(CultureInfo.CurrentCulture.Name == "en")
                                {
                                    <MudSelectItem Value="region.Id">@region.EnglishName</MudSelectItem>

                                }
                                else
                                {
                                    <MudSelectItem Value="region.Id">@region.ArabicName</MudSelectItem>

                                }
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem sm="6" Class="d-inline-flex justify-content-center">
                        <MudItem Class="d-flex flex-row justify-content-between">
                            <MudRadioGroup @bind-Value="@input.Status" Class="d-inline-flex align-content-center">
                                <MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">@L["Active"]</MudRadio>
                                <MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Secondary">@L["Status InActive"]</MudRadio>
                            </MudRadioGroup>
                        </MudItem>
                    </MudItem>
                </MudGrid>
            </MudForm>

        </DialogContent>

        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" Disabled="@(form == null || !form.IsValid)" OnClick="Submit">@L["Create"]</MudButton>
        </DialogActions>
    </MudDialog>

</MudItem>



<style>
    .mud-modal 
    {
        border-radius: 0 20px 0 20px;
    }
</style>