@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Lookups
@using SmartParking.Lookups.City
@using SmartParking.Lookups.State
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@using Microsoft.Extensions.Localization
@using SmartParking.Localization

@inject IStateAppService StateAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L

<MudItem class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">New State</MudText>
        </TitleContent>
        <DialogContent>


            <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                <MudGrid>
                    <MudItem sm="6">
                        <MudTextField @bind-Value="input.ArabicName"
                                      For="@(() => input.ArabicName)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="ArabicName" />
                    </MudItem>

                    <MudItem sm="6">
                        <MudTextField @bind-Value="input.EnglishName"
                                      For="@(() => input.EnglishName)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="EnglishName" />
                    </MudItem>
                  @*   <MudItem sm="4" md="4">
                        <MudSelect @bind-Value="@input.RegionId" Label="@L["Region"]" Placeholder="Please Select">

                            @foreach (var region in regions)
                            {
                                <MudSelectItem T="int" Value="@region.Id">
                                    @region.EnglishName
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem> *@
                    <RegionLookups SelectValueChanged="SelectRegion"></RegionLookups>


                    <MudItem sm="6" Class="d-inline-flex justify-content-center">
                        <MudItem Class="d-flex flex-row justify-content-between">
                            <MudRadioGroup @bind-Value="@input.Status" Class="d-inline-flex align-content-center">
                                <MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">Active</MudRadio>
                                <MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Secondary">InActive</MudRadio>
                                <MudRadio Value="@(Enums.Status.Deleted)" Color="MudBlazor.Color.Warning">Deleted</MudRadio>
                            </MudRadioGroup>
                        </MudItem>
                    </MudItem>
                </MudGrid>
            </MudForm>

        </DialogContent>

        <DialogActions>
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Submit">Create</MudButton>
        </DialogActions>
    </MudDialog>

</MudItem>


@code {

    private MudForm form;
    public CreateUpdateStateDto input = new CreateUpdateStateDto();
    public IReadOnlyList<RegionLookupDto> regions = new List<RegionLookupDto>();

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }
    bool _clearable;
    private int RegionSelectValue { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var regions = await StateAppService.GetRegionLookupAsync();
        await base.OnInitializedAsync();
    }

    private void SelectRegion(int region)
    {
        RegionSelectValue = region;
    }
    private async Task Submit()
    {
        if (form.IsValid)
        {
            // Call your service to create the camera
            try
            {
                await StateAppService.CreateAsync(input);
            }
            catch (UserFriendlyException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
                return;
            }
            Snackbar.Add("State created successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));

        }
        else
        {
            Snackbar.Add("Please fix the validation errors.", Severity.Error);
        }
    }
    private void Cancel()
    {
        MudDialog.Cancel();
    }
}



<style>
    .mud-modal 
    {
        border-radius: 0 20px 0 20px;
    }
</style>