@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.State
@using Volo.Abp.Application.Dtos
@inject IStateAppService StateAppService
@inject IStringLocalizer<SmartParkingResource> L
<PageTitle>@L["StatesDetails"]</PageTitle>

<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
				<MudText Typo="Typo.h6">@L["StateDetails"]</MudText>
		</TitleContent>
		<DialogContent>



			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" >
				<MudGrid>



					<MudItem sm="6">
						<MudTextField @bind-Value="state.ArabicName"
									  For="@(() => state.ArabicName)"
									  Immediate="true"
									  Variant="Variant.Text"
										  Label="@L["Arabic Name"]"
									  Disabled/>
					</MudItem>

					<MudItem sm="6">
						<MudTextField @bind-Value="state.EnglishName"
									  For="@(() => state.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
										  Label="@L["English Name"]"
									  Disabled/>
					</MudItem>

					<MudItem sm="6">
						<MudTextField @bind-Value="state.RegionEnglishName"
									  For="@(() => state.RegionEnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["Region English Name"]"
									  Disabled />
					</MudItem>

					<MudItem sm="6" >
						<MudTextField @bind-Value="state.Status"
									  For="@(() => state.Status)"
									  Immediate="true"
									  Disabled=true
									  Label="@L["Status"]" />
					</MudItem>

				</MudGrid>
			</MudForm>



		</DialogContent>

		<DialogActions>
			<MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
		</DialogActions>

	</MudDialog>

</MudItem>


<style>
	.mud-modal 
	{
		border-radius: 0 20px 0 20px;
	}
</style>
