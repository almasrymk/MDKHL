@using SmartParking.Blazor.Components.Lookups
@using SmartParking.Lookups
@using SmartParking.Lookups.State
@using Volo.Abp.Application.Dtos
@inject IStateAppService StateAppService

<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">Update State</MudText>
		</TitleContent>
		<DialogContent>



			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="editForm">
				<MudGrid>



					<MudItem sm="6" >
						<MudTextField @bind-Value="state.ArabicName"
									  For="@(() => state.ArabicName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="ArabicName" />
					</MudItem>

					<MudItem sm="6">
						<MudTextField @bind-Value="state.EnglishName"
									  For="@(() => state.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="EnglishName" />
					</MudItem>
					
					<RegionLookups SelectValueChanged="SelectRegion"></RegionLookups>


					<MudItem sm="6" Class="d-inline-flex justify-content-center">
						<MudItem Class="d-flex flex-row justify-content-between">
							<MudRadioGroup @bind-Value="@state.Status" Class="d-inline-flex align-content-center">
								<MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">Active</MudRadio>
								<MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Secondary">InActive</MudRadio>
								<MudRadio Value="@(Enums.Status.Deleted)" Color="MudBlazor.Color.Warning">Deleted</MudRadio>
							</MudRadioGroup>
						</MudItem>
					</MudItem>

				</MudGrid>
			</MudForm>



		</DialogContent>

		<DialogActions>
			<MudButton OnClick="Cancel">Cancel</MudButton>
			<MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Save">Edit</MudButton>
		</DialogActions>
	</MudDialog>

</MudItem>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>

@code {
	[CascadingParameter] MudDialogInstance MudDialog { get; set; }
	[Parameter] public StateDto state { get; set; } = new StateDto();
	public IReadOnlyList<RegionLookupDto> regions { get; set; } = new List<RegionLookupDto>();
	private MudForm editForm;
	bool _clearable;
	private int RegionSelectValue { get; set; }


	protected override async Task OnInitializedAsync()
	{
		var result = await StateAppService.GetRegionLookupAsync();
		regions = result;
	}

	private void SelectRegion(int region)
	{
		RegionSelectValue = region;
	}

	private async Task Save()
	{
		await editForm.Validate();
		if (editForm.IsValid)
		{

			// Create the input object for update
			var input = new CreateUpdateStateDto
				{
					ArabicName = state.ArabicName,
					EnglishName = state.EnglishName,
					Status = state.Status,
					RegionId = state.RegionId,


				};

			// Call the update method
			await StateAppService.UpdateAsync(state.Id, input);

			// Close the dialog with a success result
			MudDialog.Close(DialogResult.Ok(true));
		}
	}


	private void Cancel()
	{
		MudDialog.Cancel();
	}
}

