@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.State
@using Volo.Abp.Application.Dtos
@inject IStateAppService StateAppService
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
<PageTitle>@L["EditStates"]</PageTitle>

<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["Edit"] @state.EnglishName</MudText>
		</TitleContent>
		<DialogContent>

			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="editForm">
				<MudGrid>



					<MudItem sm="6" >
						<MudTextField @bind-Value="state.ArabicName"
									  For="@(() => state.ArabicName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Placeholder=@L["Type Here"]
									  Label=@L["Arabic Name"] />
					</MudItem>

					<MudItem sm="6">
						<MudTextField @bind-Value="state.EnglishName"
									  For="@(() => state.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Placeholder=@L["Type Here"]
									  Label="@L["English Name"]" />
					</MudItem>
					
						<MudItem sm="6">
							<MudSelect @bind-Value="@state.RegionId"
									   Variant="Variant.Text"
									   Label=@L["Region"]
									   Placeholder=@L["Choose"]
								   HelperText=@L["Helper Text"] 
									   AnchorOrigin="Origin.TopCenter"
									   TransformOrigin="Origin.TopCenter">

							@foreach (var region in regions)
							{
								<MudSelectItem Value="region.Id">@region.EnglishName</MudSelectItem>
							}
						</MudSelect>
					</MudItem>



					<MudItem sm="6" Class="d-inline-flex justify-content-center">
						<MudItem Class="d-flex flex-row justify-content-between">
							<MudRadioGroup @bind-Value="@state.Status" Class="d-inline-flex align-content-center">
								<MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">@L["Active"]</MudRadio>
								<MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Secondary">@L["InActive"]</MudRadio>
								
							</MudRadioGroup>
						</MudItem>
					</MudItem>

				</MudGrid>
			</MudForm>



		</DialogContent>

		<DialogActions>
			<MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
			<MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Save">@L["Edit"]</MudButton>
		</DialogActions>
	</MudDialog>

</MudItem>

<style>
	.mud-modal 
	{
		border-radius: 0 20px 0 20px;
	}
</style>

