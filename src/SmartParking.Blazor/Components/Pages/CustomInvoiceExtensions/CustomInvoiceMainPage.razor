@page "/checkout-extension/{WatcherCode}"
@using SmartParking.Blazor.Components.InvoiceExtensionComponents
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Invoices
@layout CustomLayout
@inject IInvoiceAppService invoiceAppService
@attribute [AllowAnonymous]

<MudContainer MaxWidth="MaxWidth.False" Class="pa-2">
    <MudGrid Class="mb-4">
        <MudItem xs="12">
            <InvoiceHeader />
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="3">
                <InvoiceScan />

                <InvoiceDetailsCard InvoiceNo="@InvoiceNumber"
                                    InvoiceDate="@InvoiceDate"
                                    AmountPaid="@InvoicePrice"
                                    VATAmount="@Vat"
                                    Duration="@Duration"
                                    CheckInTime="@CheckIn"
                                    CheckOutTime="@Checkout" />

                <VehicleImagesCard EntryPictureUrl="@EntryPicture"
                                   ExitPictureUrl="@ExitPicture" />

                <VehicleInfoCard PlateText="@PlateNumber"
                                 PlateCountry="KSA"
                                 CountryFlagUrl="images/sa.png"
                                 BrandLogoUrl="images/cherry.png"
                                 BrandName="Chery" />
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <PaymentSummaryCard Amount="@InvoiceAmount"
                                VATRate="@VatRate"
                                VATAmount="@Vat"
                                TotalAmount="@InvoicePrice" />
        </MudItem>
    </MudGrid>
</MudContainer>
