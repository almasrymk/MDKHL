@page "/checkout-extension"
@using SmartParking.Blazor.Components.InvoiceExtensionComponents
@using SmartParking.Blazor.Components.Shared
@layout CustomLayout
@attribute [AllowAnonymous]

<MudContainer MaxWidth="MaxWidth.False" Class="pa-2">
    <MudGrid Class="mb-4">
        <MudItem xs="12">
            <InvoiceHeader />
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="3">
                <InvoiceScan />

                <InvoiceDetailsCard InvoiceNo="#7788"
                                    InvoiceDate="@(new DateTime(2024, 12, 15))"
                                    AmountPaid="40"
                                    VATAmount="22.50"
                                    Duration="3 hours 25 minutes"
                                    CheckInTime="@(new DateTime(2024, 12, 15, 9, 30, 0))"
                                    CheckOutTime="@(new DateTime(2024, 12, 15, 12, 55, 0))" />

                <VehicleImagesCard EntryPictureUrl="images/vehicle-image.png"
                                   ExitPictureUrl="images/vehicle-image.png" />

                <VehicleInfoCard PlateText="ABC 1234"
                                 PlateCountry="KSA"
                                 CountryFlagUrl="images/sa.png"
                                 BrandLogoUrl="images/cherry.png"
                                 BrandName="Chery" />
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <PaymentSummaryCard Amount="150.00"
                                VATRate="15"
                                VATAmount="22.50"
                                TotalAmount="172.50" />
        </MudItem>
    </MudGrid>
</MudContainer>
