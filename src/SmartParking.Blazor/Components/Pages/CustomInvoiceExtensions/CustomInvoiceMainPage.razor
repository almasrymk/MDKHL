@page "/checkout-extension/"
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@using SmartParking.Blazor.Components.InvoiceExtensionComponents
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Blazor.Contracts
@using SmartParking.Entities.Cameras.Watchers
@using SmartParking.Invoices
@using SmartParking.Invoices.Factory
@using SmartParking.Localization
@using SmartParking.Payments
@using SmartParking.Payments.PaymentIntegrations
@using SmartParking.Watchers
@using Volo.Abp.Domain
@layout CustomLayout
@inject IPaymentAppService paymentAppService
@inject NavigationManager navigationManager
@inject ISnackbar snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject IInvoiceActionsFactoryAppService InvoiceActionsFactory
@inject IInvoiceUiAppService invoiceUiAppService
@* Inject the configured active IPaymentGateway directly — no hardcoded provider logic on the page *@
@inject IPaymentGatewayIntegrationService gateway
@inject IJSRuntime JS
@inject IDialogService DialogService



@attribute [AllowAnonymous]

<MudContainer MaxWidth="MaxWidth.False" Class="pa-2">
    <MudGrid Class="mb-4">
        <MudItem xs="12">
            <InvoiceHeader />
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="3">
                <InvoiceScan  OnButtonTriggered="OnSearch" OnSearchTextChanged="OnSearchValueChanged"/>
                @if (ShowInvoiceDetails)
                {
                    <InvoiceDetailsCard InvoiceNo="@InvoiceNumber"
                                    InvoiceDate="@InvoiceDate"
                                    AmountPaid="@InvoicePrice"
                                    VATAmount="@Vat"
                                    PaymentMethod="@paymentMethod"
                                    Duration="@Duration"
                                    CheckInTime="@CheckIn"
                                    CheckOutTime="@Checkout" />

                    <VehicleImagesCard EntryPictureUrl="@EntryPicture"
                                       ExitPictureUrl="@ExitPicture" />

                    <VehicleInfoCard PlateText="@PlateNumber"
                                     PlateCountry="KSA"
                                     CountryFlagUrl="images/sa.png"
                                      />
                }
                
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <PaymentSummaryCard Amount="@InvoicePrice"
                                VATRate="@VatRate"
                                VATAmount="@Vat"
                                TotalAmount="@InvoiceAmount"
                                SelectedPaymentMethod="@paymentMethod"
                                SelectedPaymentMethodChanged="OnPaymentMethodChanged"
                                ProceedToPayment="ProceedToPayment"
                                IsLoading="@_isProcessingPayment" />

            @* ── Unified payment container ───────────────────────────── *@
            <div id="payment-container" class="mt-3"></div>

        </MudItem>
    </MudGrid>
</MudContainer>

@* ── Helper to pass DotNet reference to JS ───────────────────────── *@
<script>
    window.dotNetHelper = null;
    window.setDotNetHelper = function(helper) {
        window.dotNetHelper = helper;
    };
</script>

@* ── HyperPay widget script (fully configuration-driven) ───────────────────────── *@
<script>
    window.hyperPay = {
        loadWidget: function (checkoutId, shopperResultUrl, brands, scriptUrl) {

            if (!checkoutId) {
                console.error("HyperPay: checkoutId is missing");
                return;
            }

            document.getElementById("hyperpay-script")?.remove();
            document.getElementById("hyperpay-form")?.remove();

            const script = document.createElement("script");
            script.id = "hyperpay-script";
            script.src = scriptUrl || `https://eu-test.oppwa.com/v1/paymentWidgets.js?checkoutId=${checkoutId}`;
            script.crossOrigin = "anonymous";

            script.onload = function () {
                const form = document.createElement("form");
                form.id = "hyperpay-form";
                form.action = shopperResultUrl;
                form.className = "paymentWidgets";
                form.setAttribute("data-brands", brands);

                const container = document.getElementById("payment-container");
                if (!container) {
                    console.error("HyperPay: payment-container not found");
                    return;
                }
                container.appendChild(form);
            };

            document.body.appendChild(script);
        }
    };
</script>

@* ── Geidea.js — hosted card form (tokenises PAN/CVV in the browser; nothing touches your server) *@
<script>
    window.geidea = {
        loadCheckout: function (sessionId, merchantPublicKey, callbackUrl, jsUrl) {
            if (!sessionId || !merchantPublicKey || !callbackUrl) {
                console.error("Geidea: Missing required parameters");
                return;
            }

            const checkout = new GeideaCheckout(
                function onSuccess(data) {
                    console.log("Geidea success", data);
                    if (window.dotNetHelper) {
                        window.dotNetHelper.invokeMethodAsync('HandlePaymentSuccess', data);
                    }
                },
                function onError(error) {
                    console.error("Geidea error", error);
                },
                function onCancel() {
                    console.warn("Geidea cancelled");
                }
            );

            checkout.startPayment(sessionId, null, "payment-container")
        },
        loadExpressCheckout: async function (sessionId, merchantPublicKey, callbackUrl, jsUrl) {
            if (!sessionId) {
                console.error("Geidea Express Checkout: sessionId is missing");
                return;
            }

            const config = {
                sessionId: sessionId,
                merchantPublicKey: merchantPublicKey,
                returnUrl: callbackUrl,
                onSuccess: function (data) {
                    console.log("Geidea Express Checkout success", data);
                    if (window.dotNetHelper) {
                        window.dotNetHelper.invokeMethodAsync('HandlePaymentSuccess', data);
                    }
                },
                onError: function (error) {
                    console.error("Geidea Express Checkout error", error);
                },
                onCancel: function () {
                    console.warn("Geidea Express Checkout cancelled");
                }
            };

            const api = new GeideaExpressCheckout();
            const expressCheckout = await api.create(config);
            expressCheckout.mount('#payment-container');
        }
    };
</script>