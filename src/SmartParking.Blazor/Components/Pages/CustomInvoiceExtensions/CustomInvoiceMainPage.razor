@page "/checkout-extension/"
@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.InvoiceExtensionComponents
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Blazor.Contracts
@using SmartParking.Entities.Cameras.Watchers
@using SmartParking.Invoices
@using SmartParking.Invoices.Factory
@using SmartParking.Localization
@using SmartParking.Payments
@using SmartParking.Payments.PaymentIntegrations
@using SmartParking.Watchers
@using Volo.Abp.Domain
@layout CustomLayout
@inject IPaymentAppService paymentAppService
@inject NavigationManager navigationManager
@inject ISnackbar snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject IInvoiceActionsFactoryAppService InvoiceActionsFactory
@inject IInvoiceUiAppService invoiceUiAppService
@inject IOppwaIntegrationAppService OppwaIntegrationAppService
@inject IJSRuntime JS 


@attribute [AllowAnonymous]

<MudContainer MaxWidth="MaxWidth.False" Class="pa-2">
    <MudGrid Class="mb-4">
        <MudItem xs="12">
            <InvoiceHeader />
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="3">
                <InvoiceScan  OnButtonTriggered="OnSearch" OnSearchTextChanged="OnSearchValueChanged"/>
                @if (ShowInvoiceDetails)
                {
                    <InvoiceDetailsCard InvoiceNo="@InvoiceNumber"
                                    InvoiceDate="@InvoiceDate"
                                    AmountPaid="@InvoicePrice"
                                    VATAmount="@Vat"
                                    PaymentMethod="@paymentMethod"
                                    Duration="@Duration"
                                    CheckInTime="@CheckIn"
                                    CheckOutTime="@Checkout" />

                    <VehicleImagesCard EntryPictureUrl="@EntryPicture"
                                       ExitPictureUrl="@ExitPicture" />

                    <VehicleInfoCard PlateText="@PlateNumber"
                                     PlateCountry="KSA"
                                     CountryFlagUrl="images/sa.png"
                                      />
                }
                
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <PaymentSummaryCard Amount="@InvoicePrice"
                                VATRate="@VatRate"
                                VATAmount="@Vat"
                                TotalAmount="@InvoiceAmount"
                                SelectedPaymentMethod="@paymentMethod"
                                SelectedPaymentMethodChanged="OnPaymentMethodChanged"
                                ProceedToPayment="ProceedToPayment" />

            <div id="hyperpay-container"></div>

        </MudItem>
    </MudGrid>
</MudContainer>
<script>
    window.hyperPay = {
        loadWidget: function (checkoutId, shopperResultUrl, brands) {

            if (!checkoutId) {
                console.error("HyperPay: checkoutId is missing");
                return;
            }

            // Remove previous widget if exists
            document.getElementById("hyperpay-script")?.remove();
            document.getElementById("hyperpay-form")?.remove();

            // Create HyperPay script
            const script = document.createElement("script");
            script.id = "hyperpay-script";
            script.src = `https://eu-test.oppwa.com/v1/paymentWidgets.js?checkoutId=${checkoutId}`;
            script.crossOrigin = "anonymous";

            script.onload = function () {
                const form = document.createElement("form");
                form.id = "hyperpay-form";
                form.action = shopperResultUrl;
                form.className = "paymentWidgets";
                form.setAttribute("data-brands", brands);

                const container = document.getElementById("hyperpay-container");
                if (!container) {
                    console.error("HyperPay: container not found");
                    return;
                }

                container.appendChild(form);
            };

            document.body.appendChild(script);
        }
    };
</script>