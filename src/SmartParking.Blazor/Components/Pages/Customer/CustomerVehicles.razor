@using Abp.Application.Navigation
@using Microsoft.Extensions.Localization
@using SmartParking.CustomerPackages
@using SmartParking.Cutomers
@using SmartParking.Localization
@using SmartParking.Packages
@using SmartParking.Vehicles
@using System.Globalization
@inject ICustomerAppService CustomerAppService
@inject ICustomerPackagesAppService CustomerPackagesAppService
@inject IStringLocalizer<SmartParkingResource> L
@inject IDialogService Dialog
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
<PageTitle>@L["Details Of Customer"] @Customer.FullName</PageTitle>

<div class="modal-wrapper">
    <MudDialog Class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Details Of Customer"] @Customer.FullName</MudText>
        </TitleContent>

        <DialogContent>
            <MudGrid>
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="12" sm="4">
                            <MudTextField T="string" @bind-Value="Customer.FullName" Label="@L["EnglishName"]" ReadOnly="true" FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField T="string" @bind-Value="Customer.ArabicName" Label="@L["ArabicName"]" ReadOnly="true" FullWidth="true" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="4">
                            <MudTextField T="string" Label="@L["NationalId"]" @bind-Value="Customer.NationalId" ReadOnly="true" FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="@L["Email"]" @bind-Value="Customer.Email" ReadOnly="true" FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="@L["Contact Phone"]" @bind-Value="Customer.MobileNumber" ReadOnly="true" FullWidth="true" />
                        </MudItem>                        
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="@L["customer category"]" @bind-Value="Customer.CustomerCategory" ReadOnly="true" FullWidth="true" />
                        </MudItem>
                    </MudGrid>
                </MudItem>

                <MudDivider />

                <MudItem xs="12">
                    <MudText>@Customer.FullName Vehicles</MudText>
                    <MudGrid>
                        <MudTable T="VehicleDto" Items="vehicles" Breakpoint="MudBlazor.Breakpoint.LgAndUp" Class="w-100">
                            <HeaderContent>
                                <MudTh>@L["ModelYear"]</MudTh>
                                <MudTh>@L["PlateNumber"]</MudTh>
                                <MudTh>@L["BelongToCompany"]</MudTh>
                                <MudTh>@L["CompanyName"]</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@L["ModelYear"]">@context.ModelYear</MudTd>
                                <MudTd DataLabel="@L["PlateNumber"]">@context.EnPlateNumber</MudTd>
                                <MudTd DataLabel="@L["BelongToCompany"]">@context.BelongToCompany</MudTd>
                                <MudTd DataLabel="@L["CompanyName"]">@context.CompanyName</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudGrid>
                </MudItem>
                <MudDivider />
                @if(Packages.Count!=0){

                <MudItem xs="12">
                    <MudText>@L["Packages"]</MudText>
                    <MudGrid>
                        <MudTable T="CustomerPackageDto" Items="Packages" Breakpoint="MudBlazor.Breakpoint.LgAndUp" Class="w-100">
                            <HeaderContent>
                                <MudTh>@L["Price"]</MudTh>
                                
                                @if (CultureInfo.CurrentCulture.Name == "en")
                                {
                                    <MudTh>@L["EnglishName"]</MudTh>
                                    <MudTh>@L["PackageTypeEnglishName"]</MudTh>
                                }
                                else
                                {
                                    <MudTh>@L["ArabicName"]</MudTh>
                                    <MudTh>@L["PackageTypeArabicName"]</MudTh>
                                }
                                <MudTh>@L["Actions"]</MudTh>

                            </HeaderContent>
                            <RowTemplate>

                                @if(context.DescriptionOfPackage is null){
                                    return;
                                }
                                
                                <MudTd DataLabel="@L["Price"]">@context.PriceOfPackage</MudTd>
                                
                                @if (CultureInfo.CurrentCulture.Name == "en")
                                {
                                    <MudTd DataLabel="@L["EnglishName"]">@context.Package.EnglishName</MudTd>
                                    <MudTd DataLabel="@L["PackageTypeEnglishName"]">@context.Package.PackageType.EnglishName</MudTd>
                                }
                                else
                                {
                                    <MudTd DataLabel="@L["ArabicName"]">@context.Package.ArabicName</MudTd>
                                    <MudTd DataLabel="@L["PackageTypeArabicName"]">@context.Package.PackageType.ArabicName</MudTd>
                                }
                                <MudTd DataLabel="@L["Actions"]">
                                    <MudIconButton OnClick="@(e => DeletePackage(context.Id))"
                                                   Icon="@Icons.Material.Filled.Delete"
                                                   Variant="Variant.Filled"
                                                   Color="MudBlazor.Color.Error"
                                                   Size="MudBlazor.Size.Small"
                                                   Class="mx-1" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudGrid>
                </MudItem>
                }
            </MudGrid>
        </DialogContent>

        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="OnCloseViewOnly">@L["Back"]</MudButton>
        </DialogActions>
    </MudDialog>



</div>


<style>

    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>