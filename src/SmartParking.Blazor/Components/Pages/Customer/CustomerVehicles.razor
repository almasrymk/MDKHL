@using Microsoft.Extensions.Localization
@using SmartParking.Cutomers
@using SmartParking.Localization
@using SmartParking.Vehicles
@inject ICustomerAppService CustomerAppService
@inject IStringLocalizer<SmartParkingResource> L
<PageTitle>@L["Details for Customer"]</PageTitle>

<div class="modal-wrapper">
    <MudDialog Class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Details for Customer"] @Customer.FullName</MudText>
        </TitleContent>

        <DialogContent>
            <MudGrid>
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="12" sm="4">
                            <MudTextField T="string" @bind-Value="Customer.FullName" Label="@L["EnglishName"]" Disabled="true" FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField T="string" @bind-Value="Customer.ArabicName" Label="@L["ArabicName"]" Disabled="true" FullWidth="true" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="4">
                            <MudTextField T="string" Label="@L["NationalId"]" @bind-Value="Customer.NationalId" Disabled="true" FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="@L["Email"]" @bind-Value="Customer.Email" Disabled="true" FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="@L["Contact Phone"]" @bind-Value="Customer.MobileNumber" Disabled="true" FullWidth="true" />
                        </MudItem>                        
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="@L["customer category"]" @bind-Value="Customer.CustomerCategory" Disabled="true" FullWidth="true" />
                        </MudItem>
                    </MudGrid>
                </MudItem>

                <MudDivider />

                <MudItem xs="12">
                    <MudText>@Customer.FullName Vehicles</MudText>
                    <MudGrid>
                        <MudTable T="VehicleDto" Items="vehicles" Breakpoint="MudBlazor.Breakpoint.LgAndUp" Class="w-100">
                            <HeaderContent>
                                <MudTh>@L["ModelYear"]</MudTh>
                                <MudTh>@L["PlateNumber"]</MudTh>
                                <MudTh>@L["BelongToCompany"]</MudTh>
                                <MudTh>@L["CompanyName"]</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@L["ModelYear"]">@context.ModelYear</MudTd>
                                <MudTd DataLabel="@L["PlateNumber"]">@context.EnPlateNumber</MudTd>
                                <MudTd DataLabel="@L["BelongToCompany"]">@context.BelongToCompany</MudTd>
                                <MudTd DataLabel="@L["CompanyName"]">@context.CompanyName</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudGrid>
                </MudItem>
            </MudGrid>
        </DialogContent>

        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="OnCloseViewOnly">@L["Back"]</MudButton>
        </DialogActions>
    </MudDialog>



</div>


<style>

    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>