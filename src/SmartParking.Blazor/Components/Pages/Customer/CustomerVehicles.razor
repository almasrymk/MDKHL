@using Microsoft.Extensions.Localization
@using SmartParking.Cutomers
@using SmartParking.Localization
@using SmartParking.Vehicles
@inject ICustomerAppService CustomerAppService
@inject IStringLocalizer<SmartParkingResource> L

<div class="modal-wrapper">
    <MudDialog Class="mud-modal">

        <TitleContent>
            <MudText Typo="Typo.h6">@L["Details for Customer"] @Customer.FullName</MudText>
        </TitleContent>
        <DialogContent>
            <MudGrid>
                <MudItem Class="w-100 h-auto">
                    <MudGrid>
                        <MudTable T="VehicleDto" Items="vehicles" Breakpoint="MudBlazor.Breakpoint.LgAndUp">

                            <HeaderContent>
                                <MudTh>@L["ModelYear"]</MudTh>
                                <MudTh>@L["PlateNumber"]</MudTh>
                                <MudTh>@L["BelongToCompany"]</MudTh>
                                <MudTh>@L["CompanyName"]</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@L["ModelYear"]">@context.ModelYear</MudTd>
                                <MudTd DataLabel="@L["PlateNumber"]">@context.Platenumber</MudTd>
                                <MudTd DataLabel="@L["BelongToCompany"]">@context.BelongToCompany</MudTd>
                                <MudTd DataLabel="@L["CompanyName"]">@context.CompanyName</MudTd>

                           
                            </RowTemplate>
                            
                        </MudTable>

                    </MudGrid>

                </MudItem>
            </MudGrid>
        </DialogContent>


        <DialogActions>
            <div class="overflow-hidden px-5 w-100">

                <MudGrid>
                    <MudItem sm="6" md="6">

                        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Tertiary" OnClick="OnCloseViewOnly">@L["Cancel"]</MudButton>
                    </MudItem>
                </MudGrid>
            </div>

        </DialogActions>
    </MudDialog>



</div>


<style>

    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>