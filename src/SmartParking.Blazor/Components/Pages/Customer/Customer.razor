@page "/customers"
@using Microsoft.Extensions.Localization
@using SmartParking.Cutomers
@using SmartParking.Localization
@inject IDialogService DialogService
@inject ICustomerAppService CustomerAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation


<PageTitle>@L["Customers"]</PageTitle>
<MudText Typo="Typo.h5" Class="mb-2">@L["Customers"]</MudText>

<SPDataGrid PageName=@L["Customers"] Data="@itemData"   OnAdd="HandleAdd" TotalItemsInTable="TotalItem" OnFiltering="HandleFilter" OnPageChanged="FetchTableData" OnSearching="HandleSearch" ShowAdd="ViewAdd" OnClickAssign="AssignPackage" OnClickCar="CreateVehicle" OnClickRowView="ShowVehiclesForCustomer"></SPDataGrid>

