@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.CustomerPackages
@using SmartParking.Cutomers
@using SmartParking.Enums
@using SmartParking.Localization
@using SmartParking.Organizations
@using SmartParking.Packages
@using System.Globalization
@using SmartParking.Vehicles
@using Volo.Abp.Application.Dtos
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Users
@inject ICustomerPackagesAppService CustomerPackagesAppService
@inject IPackagesAppService PackagesAppService
@inject NavigationManager Navigation
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject ICurrentTenant CurrentTenant
@inject ICurrentUser currentUser
@inject IOrganizationsAppService OrganizationAppService
@inject IVehiclesAppService VehiclesAppService

<PageTitle>@L["Assign Package"]</PageTitle>

<div class="modal-wrapper w-100">
	<MudDialog class="d-flex mud-modal w-100">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["Assign Package"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-0 mt-4 h-100 w- p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>
					@if (CurrentTenant.Id is null)
					{
						<MudItem sm="12" md="12">
							<MudSelect T="int"
							Variant="Variant.Text"
							Label=@L["Organizations"]
							Placeholder=@L["Choose"]
							HelperText=@L["Helper Text"]
							Required
							@bind-Value="organizationId">
								<MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
								@foreach (var organization in Organizations)
								{
									if (organization.Status != Enums.Status.Active)
										continue;


									if (CultureInfo.CurrentCulture.Name == "en")
									{
										<MudSelectItem Value="organization.Id">@organization.EnglishName</MudSelectItem>
									}
									else
									{
										<MudSelectItem Value="organization.Id">@organization.ArabicName</MudSelectItem>
									}
								}
							</MudSelect>
						</MudItem>



					}
					@if (organizationId != 0 || CurrentTenant.Id is not null)
					{
						<MudItem sm="12" md="12">
							<MudSelect T="string"
							Label="@L["customer category"]"
							Placeholder="@L[ "Choose"]"
							HelperText=@L["Helper Text"]
							Required="true"
							ValueChanged="getPackage">

								@foreach (var category in Enum.GetValues(typeof(CustomerCategoryStatus)).Cast<CustomerCategoryStatus>())
								{
									<MudSelectItem Value="@category.ToString()">

										@category.ToString()
									</MudSelectItem>
								}
							</MudSelect>

						</MudItem>
					}
					@if (Packages.Count > 0 && !IsCustom )
					{
						<MudItem sm="10">
							<MudSelect T="int"
							ValueChanged="PackageValueChanged"
							Variant="Variant.Text"
							Label="@L["EnglishName"]"
							Placeholder=@L["Choose"]
							HelperText=@L["Helper Text"]
							Clearable="_clearable">
								@foreach (var package in Packages)
								{
									if (package.PackageStatus != SubscriptionStatus.Active && package.Status!=Status.Active)
										continue;
									if (CultureInfo.CurrentCulture.Name == "en")
									{
										<MudSelectItem Value="package.Id">@package.EnglishName</MudSelectItem>

									}
									else
									{
										<MudSelectItem Value="package.Id">@package.ArabicName</MudSelectItem>

									}
								}
							</MudSelect>
						</MudItem>
					}
					else if (IsCustom)
					{
						<MudItem sm="10">
							@if(CultureInfo.CurrentCulture.Name == "en")
							{

								<MudTextField T="string" Label="@L["CustomPackage"]" Placeholder="@L["CustomPackage"]" ReadOnly @bind-Value="_customerPackageDto.PackageArabicName"> @L["CustomPackage"] </MudTextField>
							}
							else
							{
								<MudTextField T="string" Label="@L["CustomPackage"]" Placeholder="@L["CustomPackage"]" ReadOnly @bind-Value="_customerPackageDto.PackageArabicName"> @L["CustomPackage"] </MudTextField>
							}
						</MudItem>

					}
					<MudItem sm="2">
						<MudCheckBox @bind-value="IsCustom">
							@L["IsCustom"]
						</MudCheckBox>
					</MudItem>

					@if (IsCustom)
					{


						<MudItem sm="4">
							<MudDatePicker Label="@L["StartDate"]"
										   PickerVariant="PickerVariant.Dialog"
										   ShowToolbar="false"
										   @bind-Date="ActivationDate"
										   MinDate="@( DateTime.Today  )"
										   MaxDate="DectivationDate"
										   Required="true"
										   RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
						</MudItem>
						<MudItem sm="4">
							<MudDatePicker Label="@L["EndDate"]"
										   PickerVariant="PickerVariant.Dialog"
										   ShowToolbar="false"
										   @bind-Date="DectivationDate"
										   MinDate="@( ActivationDate is not null  ? ActivationDate : DateTime.Today )"
										   MaxDate="DectivationDate"
										   Required="true"
										   RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
						</MudItem>
						<MudItem sm="4">
							<MudNumericField 
								@bind-value="_customerPackageDto.PriceOfPackage" HideSpinButtons Min="0" Label="@L["Price"]"
							    Required ="true"
							    RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"/>
						</MudItem>


					}
				</MudGrid>


				@if (!IsCustom)
				{
					<MudTable T="PackageDto" Items="selectedPackageDto" Style="width:100%">
						<HeaderContent>
							<MudTh>@L["Name"]</MudTh>
							<MudTh>@L["Package Type"]</MudTh>
							<MudTh>@L["Price"]</MudTh>
							<MudTh>@L["Publish From"]</MudTh>
							<MudTh>@L["Publish To"]</MudTh>
							<MudTh>@L["TotalHours"]</MudTh>
						</HeaderContent>
						<RowTemplate>
							@if (CultureInfo.CurrentCulture.Name == "en")
							{
								<MudTd>@context.EnglishName</MudTd>
							}
							else
							{
								<MudTd>@context.ArabicName</MudTd>
							}

							<MudTd>@context.PackageTypeEnglishName</MudTd>
							<MudTd>@context.Price</MudTd>
							<MudTd>@context.PublishFrom</MudTd>
							<MudTd>@context.PublishTo</MudTd>
							<MudTd>@context.DurationOfPackage</MudTd>
						</RowTemplate>
					</MudTable>
				}

			</MudForm>
		</DialogContent>
		<DialogActions>
			<DialogActionComponent ButtonOneColor="MudBlazor.Color.Dark"
			ButtonTwoColor="MudBlazor.Color.Primary"
			ButtonOneLabel="@L["Back"]"
			ButtonTwoLabel="@L["Assign"]"
			ButtonOneClick="CancelEdit"
			ButtonTwoClick="SubmitEdit"
			ButtonOneVariant="MudBlazor.Variant.Filled"
			ButtonTwoVariant="MudBlazor.Variant.Filled" />
		</DialogActions>


	</MudDialog>


</div>

<style>
	.mud-modal {
	border-radius: 0 20px 0 20px;
	}
</style>

@code {
	[CascadingParameter]
	private IMudDialogInstance MudDialogAdd { get; set; }
	public PackageDto CustomerPackage = new PackageDto();
	public CustomerPackageDto _customerPackageDto = new CustomerPackageDto();
	[Parameter]
	public CustomerDto Customer { get; set; }
	[Parameter] public int VehicleId { get; set; }
	public CustomerCategoryStatus Customercategory { get; set; }
	private int organizationId;
	private IReadOnlyList<OrganizationDto> Organizations = new List<OrganizationDto>();

	public List<PackageDto> Packages { get; set; } = new List<PackageDto>();
	bool _clearable;
	private MudForm form;
	public List<PackageDto> selectedPackageDto { get; set; } = new List<PackageDto>();
	private bool IsCustom { get; set; } = false;
	private DateTime?  ActivationDate { get; set; }
	private DateTime? DectivationDate { get; set; }


	private async Task getPackage(string customerCategory)
	{
		Customercategory = (CustomerCategoryStatus) Enum.Parse(typeof(CustomerCategoryStatus),customerCategory);
		if (CurrentTenant.Id is null)
			Packages = await PackagesAppService.GetAllMdkhlAsync(organizationId, Customercategory);
		else
			Packages = await PackagesAppService.GetAllOrganizationAsync(Customercategory);

	}
	protected override async Task OnInitializedAsync()
	{
		var result = await OrganizationAppService.GetListAsync(new PagedAndSortedResultRequestDto());
		Organizations = result.Items;
		await base.OnInitializedAsync();
	}

	private async Task SubmitEdit()
	{

		if(CustomerPackage.CustomerCategory!=Customercategory.ToString() && !IsCustom){
			SnackBar.ShowSnackbar(Snackbar, $"{LocalizationHelper.GetLocalizedString("Package")} , " +
			$"{LocalizationHelper.GetLocalizedString("customer category")} "+
			$"{LocalizationHelper.GetLocalizedString("NotSameType")} ", Severity.Error);
			return;

		}
		try
		{
			var vehicle = await VehiclesAppService.GetAsync(VehicleId);
			if (CustomerPackage.CustomerCategory == CustomerCategoryStatus.Customer.ToString())
			{
				await CustomerPackagesAppService.CheckSubscriptionCustomersLimitsAsync(CustomerPackage.OrganizationId);
			}
			_customerPackageDto.ArPlateNumber = vehicle.ArPlateNumber;
			_customerPackageDto.EnPlateNumber = vehicle.EnPlateNumber;

			_customerPackageDto.CustomerId = Customer.Id;

			if (IsCustom)
			{
				_customerPackageDto.CustomerCategory = Customercategory;
				_customerPackageDto.publishedOfPackage = true;
				_customerPackageDto.ActivationDateOfPackage = ActivationDate.Value.Date;
				_customerPackageDto.ExpiryDate = DectivationDate.Value.Date;
				_customerPackageDto.IsCustomPackage = true;
				_customerPackageDto.DurationOfPackage = DectivationDate.Value.DayOfYear - ActivationDate.Value.DayOfYear;
				CustomerPackage.Id = default;
				_customerPackageDto.PackageArabicName = AlertMessages.AlertMessages.PackageNameAr;
				_customerPackageDto.PackageEnglishName = AlertMessages.AlertMessages.PackageNameEn;
			}
			if (CurrentTenant.Id is null)
			{
				_customerPackageDto.OrganizationId = organizationId;
				_customerPackageDto.TenantId = Organizations.FirstOrDefault(x => x.Id == organizationId).TenantId;

			}
			else
			{
				_customerPackageDto.OrganizationId = Organizations.FirstOrDefault(x => x.TenantId == CurrentTenant.Id).Id;
				_customerPackageDto.TenantId = CurrentTenant.Id;
			}
			var assignPackage = await CustomerPackagesAppService.AssignPackageToCustomerWebAsync(CustomerPackage.Id, _customerPackageDto);

			if (!assignPackage)
				throw new Exception(LocalizationHelper.GetLocalizedString(AlertMessages.AlertMessages.FAILED) + " " +
				LocalizationHelper.GetLocalizedString(AlertMessages.AlertMessages.ASSIGN) + " " +
				LocalizationHelper.GetLocalizedString("Package") + " ");
			SnackBar.ShowSnackbar(Snackbar, LocalizationHelper.GetLocalizedString(AlertMessages.AlertMessages.SUCCESS) + " " +
			LocalizationHelper.GetLocalizedString(AlertMessages.AlertMessages.ADD)+" "+
			LocalizationHelper.GetLocalizedString("Package"),Severity.Success);
			MudDialogAdd.Close(DialogResult.Ok(true));
			await Task.Delay(1000);
			Navigation.NavigateTo("/customers", forceLoad: true);
		}
		catch (Exception ex)
		{
			SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.ADD]} {L[AlertMessages.AlertMessages.FAILED]}: {ex.Message} ", Severity.Error);
			
		}
	}

	private async Task CancelEdit()
	{
		MudDialogAdd.Cancel();


	}

	private async Task PackageValueChanged(int value)
	{
		selectedPackageDto.Clear();
		selectedPackageDto.Add( Packages.Find(x => x.Id == value));
		CustomerPackage = Packages.Find(x => x.Id == value);

	}




}
