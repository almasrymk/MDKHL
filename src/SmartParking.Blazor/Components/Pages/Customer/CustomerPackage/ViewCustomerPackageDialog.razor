@using Microsoft.Extensions.Localization
@using SmartParking.CustomerPackages
@using SmartParking.Cutomers
@using SmartParking.Localization
@using SmartParking.UnitVehiclePackages
@using Volo.Abp.MultiTenancy
@using AutoMapper
@using SmartParking.Analysis
@using SmartParking.PDF
@using SmartParking.Permissions.Reports
@using SmartParking.Vehicles
@inject IDialogService Dialog
@inject IStringLocalizer<SmartParkingResource> L
@inject ICustomerPackagesAppService CustomerPackagesAppService
@inject ICustomerAppService CustomerAppService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ICurrentTenant CurrentTenant
@inject IJSRuntime JSRuntime
@inject IUnitVehiclePackageAppService UnitVehiclePackageAppService
<PageTitle>@L["CustomerPackages"]</PageTitle>
<div class="modal-wrapper ">
    <MudDialog class="mud-modal w-100" Style="min-width:auto !important">
        <TitleContent>
            <MudText Class="fw-bold">@L["CustomerPackagesHead"]</MudText>
        </TitleContent>
        <DialogContent>
            <SPDataGrid PageName=@L["CustomerPackages"] TotalItemsInTable="@TotalItem" Data="@itemData" OnPageChanged="FetchTableData" OnClickRowDelete="HandleDelete" ShowDownloadCustomerPackage="true" OnDownloadCustomerPackage="HandleDownload"></SPDataGrid>
        </DialogContent>
        <DialogActions>
            <MudButton Color="MudBlazor.Color.Dark" Variant="Variant.Filled" OnClick="Cancel">@L["Cancel"]</MudButton>
        </DialogActions>
    </MudDialog>
</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
        max-width: 900px;
        margin: auto;
    }
</style>