@using Microsoft.Extensions.Localization
@using SmartParking.Cutomers
@using SmartParking.Enums
@using SmartParking.Localization
@using System.Globalization
@using SmartParking.Organizations
@using Volo.Abp.Application.Dtos
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Users
@inject ICustomerAppService CustomerAppService
@inject NavigationManager Navigation
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject ICurrentTenant CurrentTenant
@inject ICurrentUser currentUser
@inject IOrganizationsAppService OrganizationAppService

<PageTitle>@L["Update Customer"]</PageTitle>

<div class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["Update Customer"]</MudText>
		</TitleContent>
		<DialogContent>
            <MudForm Class="flex-grow-1 mt-4 h-100 w- p-3 d-flex flex-column w-100 h-100 main-layout-paper" Model="customerDataDto">
				<MudGrid>
                    <MudItem sm="6">
                        <MudTextField T="string" Placeholder="@L["Type Here"]" @bind-Value="customerDataDto.FullName" Label="@L["EnglishName"]" Required />
                    </MudItem>
                    <MudItem sm="6">
                        <MudTextField T="string" Placeholder="@L["Type Here"]" @bind-Value="customerDataDto.ArabicName" Label="@L["ArabicName"]" Required />
                    </MudItem>                    
                    <MudItem sm="6">
                        <MudTextField T="string" Placeholder="@L["Type Here"]" @bind-Value="customerDataDto.Email" Label="@L["Email"]" Required />
                    </MudItem>
                    <MudItem sm="6">
                        <MudTextField T="string" Placeholder="@L["Type Here"]" @bind-Value="customerDataDto.UserName" Label="@L["UserName"]" Required />
                    </MudItem>
                    <MudItem sm="6">
                        <MudTextField T="string" Placeholder="@L["Type Here"]" InputType="InputType.Telephone" Label="@L["MobileNumber"]" @bind-Value="customerDataDto.MobileNumber" Required />
                    </MudItem>
                    <MudItem sm="6">
                        <MudTextField T="string" Placeholder="@L["Type Here"]" Label="@L["NationalId"]" @bind-Value="customerDataDto.NationalId" Required />
                    </MudItem>
                    <MudItem sm="6" Class="d-inline-flex justify-content-center">
                        <MudItem Class="d-flex flex-row justify-content-between">
                            <MudRadioGroup @bind-Value="@customerDataDto.IdentificationType" Class="d-inline-flex align-content-center">
                                <MudRadio Value="@(Enums.IdentificationTypes.NationalID)" Color="MudBlazor.Color.Primary">@L["NationalId"]</MudRadio>
                                <MudRadio Value="@(Enums.IdentificationTypes.Passport)" Color="MudBlazor.Color.Primary">@L["Passport"]</MudRadio>
                            </MudRadioGroup>
                        </MudItem>
                    </MudItem>

                    <MudItem sm="6" md="6">
                        <MudSelect @bind-Value="@customerDataDto.CustomerCategory"
                                   Label="@L["customer category"]"
                                   Placeholder="@L[ "Choose"]"
                                   HelperText=@L["Helper Text"]
                                   Required>

                            @foreach (var category in Enum.GetValues(typeof(CustomerCategoryStatus)).Cast<CustomerCategoryStatus>())
                            {
                                <MudSelectItem Value="@category">

                                    @category.ToString()
                                </MudSelectItem>
                            }
                        </MudSelect>

                    </MudItem>
                    @* @if (currentUser.IsInRole(Enums.RolesType.Mdkhl.ToString()) || currentUser.IsInRole("admin"))
                    {
                        <MudItem sm="6" md="6">
                            <MudSelect T="int"
                                       Variant="Variant.Text"
                                       Label=@L["Organizations"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       Required
                                       @bind-Value="createUpdateCustomerDto.OrganizationId">
                                <MudSelectItem Value="0"></MudSelectItem>
                                @foreach (var organization in Organizations)
                                {
                                    if (organization.Status != Enums.Status.Active)
                                        continue;


                                    if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="organization.Id">@organization.EnglishName</MudSelectItem>
                                    }
                                    else
                                    {
                                        <MudSelectItem Value="organization.Id">@organization.ArabicName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </MudItem>



                    } *@

				</MudGrid>
			</MudForm>
		</DialogContent>
		<DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="CancelEdit">@L["Back"]</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="SubmitEdit">@L["Save"]</MudButton>
		</DialogActions>

	</MudDialog>

</div>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>