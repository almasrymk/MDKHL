@page "/customers/edit/{customerId}"
@using Microsoft.Extensions.Localization
@using SmartParking.Cutomers
@using SmartParking.Enums
@using SmartParking.Localization
@using System.Globalization
@using SmartParking.Organizations
@using Volo.Abp.Application.Dtos
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Users
@layout Shared.ProfileLayout
@inject ICustomerAppService CustomerAppService
@inject NavigationManager Navigation
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject ICurrentTenant CurrentTenant
@inject ICurrentUser currentUser
@inject IOrganizationsAppService OrganizationAppService
@inject IDialogService DialogService

<PageTitle>@L["Edit"]</PageTitle>
<div>
    <MudGrid>
        <MudItem sm="8">
            <MudPaper Class="h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">
                <h3 Color="fw-bold">@L["Edit"]</h3>
                <MudForm Class="flex-grow-1 mt-4">
                    <MudGrid>

                        <MudItem sm="4">
                            <MudTextField T="string" Placeholder="@L["Type Here"]" @bind-Value="customerDataDto.FullName" Label="@L["EnglishName"]" Required />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField T="string" Placeholder="@L["Type Here"]" @bind-Value="customerDataDto.ArabicName" Label="@L["ArabicName"]" Required />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField T="string" Placeholder="@L["Type Here"]" InputType="InputType.Text" Label="@L["MobileNumber"]" @bind-Value="customerDataDto.PhoneNumber" Required />
                        </MudItem>
                        <MudItem sm="8">
                            <MudTextField T="string" Placeholder="@L["Type Here"]" @bind-Value="customerDataDto.Email" Label="@L["Email"]" />
                        </MudItem>
                        <MudItem sm="6">
                            <MudTextField T="string" Placeholder="@L["Type Here"]" Label="@L["NationalId"]" @bind-Value="customerDataDto.NationalId" Required />
                        </MudItem>
                        <MudItem sm="6" Class="d-inline-flex justify-content-center">
                            <MudItem Class="d-flex flex-row justify-content-between">
                                <MudRadioGroup @bind-Value="@customerDataDto.IdentificationType" Class="d-inline-flex align-content-center">
                                    <MudRadio Value="@(Enums.IdentificationTypes.NationalID)" Color="MudBlazor.Color.Primary">@L["NationalIdSwitch"]</MudRadio>
                                    <MudRadio Value="@(Enums.IdentificationTypes.Passport)" Color="MudBlazor.Color.Primary">@L["Passport"]</MudRadio>
                                </MudRadioGroup>
                            </MudItem>
                        </MudItem>

                    </MudGrid>
                    <div class="d-flex justify-content-between mt-auto">
                        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Dark" OnClick="CancelEdit">@L["Cancel"]</MudButton>
                        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="SubmitEdit" >@L["Create"]</MudButton>
                    </div>
                </MudForm>

            </MudPaper>
        </MudItem>
        <MudItem sm="4">    
            <MudPaper Class="h-100 p-3  w-100 h-100 main-layout-paper d-flex flex-column justify-content-between" Style="background-color: #F2F2F2;">
                <div class="d-flex justify-content-between align-items-center">
                    <MudText>@L["My Profile"]</MudText>
                    <MudLink Underline="Underline.Always" Href="/edit-profile">@L["Edit Profile"]</MudLink>
                </div>
                <div class="d-flex flex-column align-content-center gap-4 p-5">
                    <MudImage Src="@Picture" Class="bg_w_foto " Width="200" Height="200" />
                    <div class="d-flex flex-column align-items-center">
                        <MudText Class="fw-bold">@currentUser.Name</MudText>
                        <MudText>@currentUser.Email</MudText>
                    </div>
                </div>
                <MudGrid Class="mt-3">
                    @if (CurrentTenant.Id is not null)
                    {
                        <MudItem sm="6">
                            <MudPaper class="text-center p-2">
                                <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewInvoice">@L["Invoices"]</MudLink>
                            </MudPaper>
                        </MudItem>
                    }
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewVehicle">@L["Cars"]</MudLink>
                        </MudPaper>
                    </MudItem>
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark" OnClick="ViewPackage">@L["Packages"]</MudLink>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

    </MudGrid>
</div>

<style>
    .bg_w_foto 
    {
        background: url(images/cities/<?php echo $city_name;
        ?>) no-repeat center center;
        -webkit-background-size: cover;
        -moz-background-size: cover;
        -o-background-size: cover;
        background-size: cover;
    }
</style>