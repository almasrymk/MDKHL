@using Microsoft.Extensions.Localization
@using SmartParking.CustomerPackages
@using SmartParking.Localization
@using SmartParking.Packages
@using System.Globalization
@using Volo.Abp.Application.Dtos
@using Volo.Abp.MultiTenancy
@inject ICustomerPackagesAppService CustomerPackagesAppService
@inject IPackagesAppService PackagesAppService
@inject NavigationManager Navigation
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject ICurrentTenant CurrentTenant

<PageTitle>@L["Assign Package"]</PageTitle>

<div class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["Assign Package"]</MudText>
		</TitleContent>
		<DialogContent>



			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>
					<MudItem sm="6">
						<MudSelect @bind-Value="@CustomerPackage.PackageId"
								   Variant="Variant.Text"
								   Label="@L["EnglishName"]"
								   Placeholder=@L["Choose"]
								   HelperText=@L["Helper Text"]
								   Clearable="_clearable">
							@foreach (var package in Packages)
							{
								if (package.Status != Enums.Status.Active)
									continue;
								if (CultureInfo.CurrentCulture.Name == "en")
								{
								  <MudSelectItem Value="package.Id">@package.EnglishName</MudSelectItem>

								}
								else
								{
								  <MudSelectItem Value="package.Id">@package.ArabicName</MudSelectItem>

								}
							}
						</MudSelect>
					</MudItem>




					

				


			

				
				
				
				</MudGrid>
			</MudForm>



		</DialogContent>
		<DialogActions>
			<MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="CancelEdit">@L["Back"]</MudButton>
			<MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="SubmitEdit">@L["Assign"]</MudButton>
		</DialogActions>

	</MudDialog>

</div>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>

@code {
	[CascadingParameter]
	private MudDialogInstance MudDialogAdd { get; set; }
	public CreateUpdateCustomerPackageDto CustomerPackage = new CreateUpdateCustomerPackageDto();
	[Parameter]
	public Guid CustomerId { get; set; }
	public List<PackageDto> Packages { get; set; } = new List<PackageDto>();
	bool _clearable;
	private MudForm form;

	protected override async Task OnInitializedAsync()
	{
		if(CurrentTenant.Id is null)
			Packages = await PackagesAppService.GetAllMdkhlAsync();
		else
			Packages = await PackagesAppService.GetAllOrganizationAsync();

		await base.OnInitializedAsync();
	}

	private async Task SubmitEdit()
	{
		var successedMessage = L["CustomerPackageAssignedSuccessfully"];
		try
		{
			await CustomerPackagesAppService.AssignPackageToCustomerWebAsync(CustomerPackage.PackageId, CustomerId);
			Snackbar.Add(successedMessage, Severity.Success);
			MudDialogAdd.Close(DialogResult.Ok(true));
			await Task.Delay(1000);
			Navigation.NavigateTo("/customers", forceLoad: true);
		}
		catch (Exception e)
		{
			Snackbar.Add(e.Message, Severity.Error);
		}
	}

	private async Task CancelEdit()
	{
		MudDialogAdd.Cancel();


	}


}
