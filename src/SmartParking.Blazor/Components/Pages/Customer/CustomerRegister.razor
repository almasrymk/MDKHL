@page "/customers/register"
@using SmartParking.Cutomers
@layout Shared.ProfileLayout
@inject ICustomerAppService CustomerAppService
@inject IOrganizationsAppService OrganizationAppService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using Microsoft.Extensions.Localization
@using SmartParking.Enums
@using SmartParking.Localization
@using SmartParking.Organizations
@using System.Globalization
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Users
@inject IStringLocalizer<SmartParkingResource> L
@inject ICurrentUser currentUser
@inject NavigationManager Navigation
@inject ICurrentTenant CurrentTenant


<PageTitle>@L["Register"]</PageTitle>
<div>
    <MudGrid>
        <MudItem sm="8">
            <MudPaper Class="h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">
                <h3 Color="fw-bold">@L["Register"]</h3>
                <MudForm Class="flex-grow-1 mt-4" @ref="form">
                    <MudGrid>
                                            
                        <MudItem sm="6">
                            <MudTextField T="string" Placeholder="@L["Type Here"]"  @bind-Value="createUpdateCustomerDto.FullName" Label="@L["EnglishName"]" Required />
                        </MudItem> 
                        <MudItem sm="6">
                            <MudTextField T="string" Placeholder="@L["Type Here"]" @bind-Value="createUpdateCustomerDto.ArabicName" Label="@L["ArabicName"]" Required />
                        </MudItem>
                        <MudItem sm="6">
                            <MudTextField T="string" Placeholder="@L["Type Here"]" @bind-Value="createUpdateCustomerDto.UserName" Label="@L["UserName"]" Required />
                        </MudItem>
                        <MudItem sm="6">
                            <MudTextField T="string" Placeholder="@L["Type Here"]" InputType="InputType.Telephone"  Label="@L["MobileNumber"]" @bind-Value="createUpdateCustomerDto.MobileNumber" Required />
                        </MudItem>
                        <MudItem sm="6">
                            <MudTextField T="string"  Placeholder="@L["Type Here"]" Label="@L["NationalIdLbl"]" @bind-Value="createUpdateCustomerDto.NationalId" Required/>
                        </MudItem>
                        <MudItem sm="6" Class="d-inline-flex justify-content-center">
                            <MudItem Class="d-flex flex-row justify-content-between">
                                <MudRadioGroup @bind-Value="@createUpdateCustomerDto.IdentificationType" Class="d-inline-flex align-content-center">
                                    <MudRadio Value="@(Enums.IdentificationTypes.NationalID)" Color="MudBlazor.Color.Primary">@L["NationalId"]</MudRadio>
                                    <MudRadio Value="@(Enums.IdentificationTypes.Passport)" Color="MudBlazor.Color.Primary">@L["Passport"]</MudRadio>
                                </MudRadioGroup>
                            </MudItem>
                        </MudItem>
                      
                            <MudItem sm="6" md="6">
                            <MudSelect @bind-Value="@createUpdateCustomerDto.CustomerCategory"
                                           Label="@L["customer category"]"
                                           Placeholder="@L[ "Choose"]"
                                           HelperText=@L["Helper Text"]
                                           Required>

                                @foreach (var category in Enum.GetValues(typeof(CustomerCategoryStatus)).Cast<CustomerCategoryStatus>())
                                    {
                                    <MudSelectItem Value="@category">

                                        @category.ToString()
                                        </MudSelectItem>
                                    }
                                </MudSelect>

                            </MudItem>
                        @if (currentUser.IsInRole(Enums.RolesType.Mdkhl.ToString()) || currentUser.IsInRole("admin"))
                        {
                            <MudItem sm="6" md="6">
                                <MudSelect T="int"
                                           Variant="Variant.Text"
                                           Label=@L["Organizations"]
                                           Placeholder=@L["Choose"]
                                           HelperText=@L["Helper Text"]
                                           Required
                                           @bind-Value="createUpdateCustomerDto.OrganizationId">
                                    <MudSelectItem Value="0"></MudSelectItem>
                                    @foreach (var organization in Organizations)
                                    {
                                        if (organization.Status != Enums.Status.Active)
                                            continue;


                                        if (CultureInfo.CurrentCulture.Name == "en")
                                        {
                                            <MudSelectItem Value="organization.Id">@organization.EnglishName</MudSelectItem>
                                        }
                                        else
                                        {
                                            <MudSelectItem Value="organization.Id">@organization.ArabicName</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>



                        }

                    </MudGrid>
                    <div class="d-flex justify-content-between mt-auto">
                        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Dark" OnClick="HandleCancel">@L["Cancel"]</MudButton>
                        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="HandleSubmit" Disabled="@(form == null || !form.IsValid)">@L["Create"]</MudButton>
                    </div>
                </MudForm>

            </MudPaper>
        </MudItem>
        <MudItem sm="4">    
            <MudPaper Class="h-100 p-3  w-100 h-100 main-layout-paper d-flex flex-column justify-content-between" Style="background-color: #F2F2F2;">
                <div class="d-flex justify-content-between align-items-center">
                    <MudText>@L["My Profile"]</MudText>
                    <MudLink Underline="Underline.Always" Href="/edit-profile">@L["Edit Profile"]</MudLink>
                </div>
                <div class="d-flex flex-column align-content-center gap-4 p-5">
                    <MudImage Src="@Picture" Class="bg_w_foto " Width="200" Height="200" />
                    <div class="d-flex flex-column align-items-center">
                        <MudText Class="fw-bold">@currentUser.Name</MudText>
                        <MudText>@currentUser.Email</MudText>
                    </div>
                </div>
                <MudGrid Class="mt-3">
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark">@L["Invoices"]</MudLink>
                        </MudPaper>
                    </MudItem>
                    <MudItem sm="6">
                        <MudPaper class="text-center p-2">
                            <MudLink Color="MudBlazor.Color.Dark">@L["Cars"]</MudLink>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

    </MudGrid>
</div>

<style>
    .bg_w_foto 
    {
        background: url(images/cities/<?php echo $city_name;
        ?>) no-repeat center center;
        -webkit-background-size: cover;
        -moz-background-size: cover;
        -o-background-size: cover;
        background-size: cover;
    }
</style>
