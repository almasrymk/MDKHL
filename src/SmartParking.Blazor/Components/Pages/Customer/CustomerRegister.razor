@page "/customers/register"
@using SmartParking.Cutomers
@layout Shared.ProfileLayout
@inject ICustomerAppService CustomerAppService
@inject IOrganizationsAppService OrganizationAppService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using Microsoft.Extensions.Localization
@using SmartParking.Enums
@using SmartParking.Localization
@using SmartParking.Lookups.LicenceType
@using SmartParking.Lookups.PlateColor
@using SmartParking.Lookups.VehicleModel
@using SmartParking.Organizations
@using System.Globalization
@using SmartParking.Packages
@using SmartParking.Validations
@using SmartParking.Vehicles
@using SmartParking.Vehicles.LookUps
@using Volo.Abp.MultiTenancy
@using SmartParking.Lookups.VehicleBrand
@using Volo.Abp.Users
@inject IStringLocalizer<SmartParkingResource> L
@inject ICurrentUser currentUser
@inject NavigationManager Navigation
@inject ICurrentTenant CurrentTenant
@inject IPackagesAppService PackagesAppService
@inject IPlateColorsAppService PlateColorsAppService
@inject ILicenceTypesAppService LicenceTypesAppService
@inject IVehicleBrandsAppService VehicleBrandAppService
@inject IVehicleModelsAppService VehicleModelAppService
@inject IVehiclesAppService VehicleAppService

<PageTitle>@L["Register"]</PageTitle>
<div>
    <MudGrid>
        <MudItem sm="showVehicle?7:12">
            <MudPaper Class="h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">
                <h3 Color="fw-bold">@L["Register"]</h3>
                <MudForm Class="flex-grow-1 mt-4" @ref="form">
                    <MudGrid>
                                            
                        <MudItem sm="6">
                            <MudTextField T="string" Placeholder="@L["Type Here"]" ReadOnly="showVehicle"
                                          @bind-Value="createUpdateCustomerDto.FullName" Label="@L["EnglishName"]" Required />
                        </MudItem> 
                        <MudItem sm="6">
                            <MudTextField T="string" Placeholder="@L["Type Here"]" ReadOnly="showVehicle"
                                          @bind-Value="createUpdateCustomerDto.ArabicName" Label="@L["ArabicName"]" Required />
                        </MudItem>
                        <MudItem sm="6">
                            <MudTextField T="string" Placeholder="@L["Type Here"]" ReadOnly="showVehicle"
                                          InputType="InputType.Telephone" Label="@L["MobileNumber"]" @bind-Value="createUpdateCustomerDto.MobileNumber" Required />
                        </MudItem>
                        <MudItem sm="6">
                            <MudTextField T="string" Placeholder="@L["Type Here"]" ReadOnly="showVehicle"
                                          Label="@L["NationalIdLbl"]" @bind-Value="createUpdateCustomerDto.NationalId" Required />
                        </MudItem>
                        <MudItem sm="6" Class="d-inline-flex justify-content-center">
                            <MudItem Class="d-flex flex-row justify-content-between">
                                <MudRadioGroup @bind-Value="@createUpdateCustomerDto.IdentificationType" Required="false" ReadOnly="showVehicle"
                                               Class="d-inline-flex align-content-center">
                                    <MudRadio Value="@(Enums.IdentificationTypes.NationalID)" Color="MudBlazor.Color.Primary">@L["NationalId"]</MudRadio>
                                    <MudRadio Value="@(Enums.IdentificationTypes.Passport)" Color="MudBlazor.Color.Primary">@L["Passport"]</MudRadio>
                                </MudRadioGroup>
                            </MudItem>
                        </MudItem>
                        @if (currentUser.IsInRole(Enums.RolesType.Mdkhl.ToString()) || currentUser.IsInRole("admin"))
                        {
                            <MudItem sm="6" md="6">
                                <MudSelect T="int"
                                           Variant="Variant.Text"
                                           Label=@L["Organizations"]
                                           Placeholder=@L["Choose"]
                                           HelperText=@L["Helper Text"]
                                           Required
                                           ReadOnly="showVehicle"
                                           @bind-Value="createUpdateCustomerDto.OrganizationId">
                                    <MudSelectItem Value="0"></MudSelectItem>
                                    @foreach (var organization in Organizations)
                                    {
                                        if (organization.Status != Enums.Status.Active)
                                            continue;


                                        if (CultureInfo.CurrentCulture.Name == "en")
                                        {
                                            <MudSelectItem Value="organization.Id">@organization.EnglishName</MudSelectItem>
                                        }
                                        else
                                        {
                                            <MudSelectItem Value="organization.Id">@organization.ArabicName</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>



                        }
                        @if (createUpdateCustomerDto.OrganizationId != 0 || CurrentTenant.Id is not null)
                        {
                            <MudItem sm="6" md="6">
                                <MudSelect T="CustomerCategoryStatus"
                                           Label="@L["customer category"]"
                                           Placeholder=@L["Choose"]
                                           HelperText=@L["Helper Text"]
                                           Required="true"
                                           ReadOnly="showVehicle"
                                           ValueChanged="getPackage">
                        
                                    @foreach (var category in Enum.GetValues(typeof(CustomerCategoryStatus)).Cast<CustomerCategoryStatus>())
                                    {
                                        <MudSelectItem Value="@category">

                                            @category.ToString()
                                        </MudSelectItem>
                                    }
                                </MudSelect>

                            </MudItem>
                        }


                        @if (packages.Count >0)
                        {
                            <MudItem sm="6" md="6">
                                <MudSelect @bind-Value="createUpdateCustomerDto.PackageId"
                                           Label="@L["Package"]"
                                           Placeholder="@L[ "Choose"]"
                                           HelperText=@L["Helper Text"]
                                           ReadOnly="showVehicle"
                                           Required="true">

                                    @foreach (var package in packages)
                                    {
                                        @if (CultureInfo.CurrentCulture.Name == "ar")
                                        {
                                            <MudSelectItem Value="@package.Id">
                                                @package.ArabicName
                                            </MudSelectItem>
                                        }
                                        else
                                        {
                                            <MudSelectItem Value="@package.Id">
                                                @package.EnglishName
                                            </MudSelectItem>
                                        }

                                    }
                                </MudSelect>

                            </MudItem>
                        }



                    </MudGrid>
                        @if(!showVehicle){
                            <div class="d-flex justify-content-between mt-auto">
                                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Dark" OnClick="HandleCancel">@L["Cancel"]</MudButton>
                                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="HandleSubmit"  Disabled="@(form == null || !form.IsValid)">@L["Create"]</MudButton>
                            </div>
                        }
                </MudForm>

            </MudPaper>
        </MudItem>
        @if (showVehicle)
        {
            <MudItem sm="5">
                <MudPaper Class="h-100 p-3  w-100 h-100 main-layout-paper d-flex flex-column justify-content-between" Style="background-color: #F2F2F2;">
                <MudForm Model="createUpdateVehicle" Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
                    <MudGrid>

                        <MudItem sm="6" md="6">
                                <MudTextField T="string" Validation="VehicleValidation.ValidateArabicLetters" InputType="InputType.Text" Label="@L["ArPlateLetter"]" @bind-Value="createUpdateVehicle.ArPlateLetters" Placeholder="@L["Type Here"]" />
                        </MudItem>
                        <MudItem sm="6" md="6">
                                <MudTextField T="string" InputType="InputType.Text" Validation="VehicleValidation.ValidateArabicNumber" Label="@L["ArPlateNumber"]" @bind-Value="createUpdateVehicle.ArPlateNumber" Placeholder="@L["Type Here"]" />
                        </MudItem>
                        <MudItem sm="6" md="6">
                                <MudTextField T="string" InputType="InputType.Text" Label="@L["EnPlateLetter"]" Validation="VehicleValidation.ValidateEnglishLetter" @bind-Value="createUpdateVehicle.EnPlateLetters" Placeholder="@L["Type Here"]" />
                        </MudItem>
                        <MudItem sm="6" md="6">
                                <MudTextField T="string" InputType="InputType.Text" Label="@L["EnPlateNumber"]" Validation="VehicleValidation.ValidateEnglishNumber" @bind-Value="createUpdateVehicle.EnPlateNumber" Placeholder="@L["Type Here"]" />
                        </MudItem>
                        <MudItem sm="6" md="6">
                            <MudSelect @bind-Value="@createUpdateVehicle.LicenceTypeId"
                                       Variant="Variant.Text"
                                       Label="@L["LicenceType"]"
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       Required="true"
                                       Clearable="true">
                                @foreach (var licenceType in LicenceTypes)
                                {
                                    @if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="licenceType.Id">@licenceType.EnglishName</MudSelectItem>
                                    }
                                    else
                                    {
                                        <MudSelectItem Value="licenceType.Id">@licenceType.ArabicName</MudSelectItem>

                                    }
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem sm="6" md="6">
                            <MudSelect T="int"
                                       Variant="Variant.Text"
                                       Label="@L["VehicleBrand"]"
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       Required="true"
                                       Clearable="true"
                                       ValueChanged="SelectBrand">
                                @foreach (var vehiclebrand in VehicleBrands)
                                {
                                    @if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="vehiclebrand.Id">@vehiclebrand.EnglishName</MudSelectItem>

                                    }
                                    else
                                    {
                                        <MudSelectItem Value="vehiclebrand.Id">@vehiclebrand.ArabicName</MudSelectItem>

                                    }
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem sm="6" md="6">
                            <MudSelect @bind-Value="@createUpdateVehicle.VehicleModelId"
                                       Variant="Variant.Text"
                                       Label="@L["VehicleModel"]"
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       Required="true"
                                       Clearable="true">
                                @foreach (var vehiclemodel in VehicleModels)
                                {
                                    @if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="vehiclemodel.Id">@vehiclemodel.EnglishName</MudSelectItem>
                                    }
                                    else
                                    {
                                        <MudSelectItem Value="vehiclemodel.Id">@vehiclemodel.ArabicName</MudSelectItem>
                                    }

                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem sm="6" md="6">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" Label="@L["ModelYear"]" @bind-Value="createUpdateVehicle.ModelYear" Placeholder="@L["Type Here"]" />
                        </MudItem>

                        <MudItem sm="6" md="6">
                            <MudTextField Label="@L["CompanyName"]" Disabled="createUpdateVehicle.BelongToCompany==false" T="string" InputType="InputType.Text" @bind-Value="createUpdateVehicle.CompanyName" Placeholder="@L["Type Here"]" />
                        </MudItem>

                        <MudItem sm="6" md="6">
                            <MudSwitch Label="@L["BelongToCompany"]" LabelPosition="LabelPosition.Start" @bind-Value="createUpdateVehicle.BelongToCompany" Color="MudBlazor.Color.Primary" />
                        </MudItem>
                        <MudItem sm="6" md="6">
                                <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="CancelCreate">@L["Back"]</MudButton>
                        </MudItem>
                        <MudItem sm="6" md="6">
                        <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="SubmitCreate">@L["Create"]</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudForm>
                </MudPaper>
            </MudItem>

            
        }


    </MudGrid>
</div>

<style>
    .bg_w_foto 
    {
        background: url(images/cities/<?php echo $city_name;
        ?>) no-repeat center center;
        -webkit-background-size: cover;
        -moz-background-size: cover;
        -o-background-size: cover;
        background-size: cover;
    }
</style>
