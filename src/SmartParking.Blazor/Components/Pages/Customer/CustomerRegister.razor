@page "/customers/register"
@using SmartParking.Authentication
@using SmartParking.CustomerPackages
@using SmartParking.Cutomers
@layout Shared.ProfileLayout
@inject ICustomerAppService CustomerAppService
@inject IOrganizationsAppService OrganizationAppService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using Microsoft.Extensions.Localization
@using SmartParking.Enums
@using SmartParking.Localization
@using SmartParking.Lookups.LicenceType
@using SmartParking.Lookups.PlateColor
@using SmartParking.Lookups.VehicleModel
@using SmartParking.Organizations
@using System.Globalization
@using SmartParking.Packages
@using SmartParking.Validations
@using SmartParking.Vehicles
@using SmartParking.Vehicles.LookUps
@using Volo.Abp.MultiTenancy
@using SmartParking.Lookups.VehicleBrand
@using Volo.Abp.Users
@inject IStringLocalizer<SmartParkingResource> L
@inject ICurrentUser currentUser
@inject NavigationManager Navigation
@inject ICurrentTenant CurrentTenant
@inject IPackagesAppService PackagesAppService
@inject IPlateColorsAppService PlateColorsAppService
@inject ILicenceTypesAppService LicenceTypesAppService
@inject IVehicleBrandsAppService VehicleBrandAppService
@inject IVehicleModelsAppService VehicleModelAppService
@inject IVehiclesAppService VehicleAppService
@inject IRoleAppService RoleAppService
@inject IAuthorizationService AuthorizationService
@inject ICustomerPackagesAppService CustomerPackagesAppService
<PageTitle>@L["Register"]</PageTitle>
<div>
    <MudGrid>
        <MudItem sm="showVehicle?7:12">
            <MudPaper Class="h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">
                <h3 Color="fw-bold">@L["Add NEW"]</h3>
                <MudForm Class="flex-grow-1 mt-4" >
                    <MudGrid Class="mb-5">

                        <MudItem sm="6">
                            <MudTextField T="string" Placeholder="@L["Type Here"]" ReadOnly="showVehicle"
                            @bind-Value="createUpdateCustomerDto.FullName" Label="@L["EnglishName"]" Required
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                        </MudItem> 
                        <MudItem sm="6">
                            <MudTextField T="string" Placeholder="@L["Type Here"]" ReadOnly="showVehicle"
                            @bind-Value="createUpdateCustomerDto.ArabicName" Label="@L["ArabicName"]" Required
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                        </MudItem>
                        <MudItem sm="6">
                            <MudTextField T="string" Placeholder="@L["Type Here"]" ReadOnly="showVehicle"
                            InputType="InputType.Text" Label="@L["MobileNumber"]" @bind-Value="createUpdateCustomerDto.PhoneNumber" Required
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                        </MudItem>                        
                        
                        <MudItem sm="6">
                            <MudTextField T="string" Placeholder="@L["Type Here"]" ReadOnly="showVehicle"
                            InputType="InputType.Text" Label="@L["Email"]" @bind-Value="createUpdateCustomerDto.Email" />
                        </MudItem>

                        <MudItem sm="6" Class="d-inline-flex">
                            <MudItem Class="d-flex flex-row justify-content-between">
                                <MudRadioGroup @bind-Value="@createUpdateCustomerDto.IdentificationType" Required="false" ReadOnly="showVehicle"
                                               Class="d-inline-flex align-content-center">
                                    <MudRadio Value="@(Enums.IdentificationTypes.NationalID)" Color="MudBlazor.Color.Primary">@L["NationalIdSwitch"]</MudRadio>
                                    <MudRadio Value="@(Enums.IdentificationTypes.Passport)" Color="MudBlazor.Color.Primary">@L["Passport"]</MudRadio>
                                </MudRadioGroup>
                            </MudItem>
                        </MudItem>
                        <MudItem sm="6">
                            <MudTextField T="string" Placeholder="@L["Type Here"]" ReadOnly="showVehicle"
                            Label="@L["NationalId"]" @bind-Value="createUpdateCustomerDto.NationalId" Required
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                        </MudItem>
                        @if (createUpdateCustomerDto.IsUser && CurrentTenant.Id is null)
                        {
                            <MudItem sm="6" md="6">
                                <MudSelect T="int"
                                           Variant="Variant.Text"
                                           Label=@L["Organizations"]
                                           Placeholder=@L["Choose"]
                                           HelperText=@L["Helper Text"]
                                           Required
                                           ReadOnly="showVehicle"
                                           ValueChanged="CheckIsUser">
                                    <MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
                                    @foreach (var organization in Organizations)
                                    {
                                        if (organization.Status != Enums.Status.Active)
                                            continue;


                                        if (CultureInfo.CurrentCulture.Name == "en")
                                        {
                                            <MudSelectItem Value="organization.Id">@organization.EnglishName</MudSelectItem>
                                        }
                                        else
                                        {
                                            <MudSelectItem Value="organization.Id">@organization.ArabicName</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>



                        }
                       
                        <MudItem sm="6" md="6" Style="margin-left: -13px">
                            <MudCheckBox  T="bool" @bind-Value="createUpdateCustomerDto.IsUser"  Color="MudBlazor.Color.Primary">@L["ISUser"]</MudCheckBox>
                        </MudItem>
                        @if (createUpdateCustomerDto.IsUser && createUpdateCustomerDto.OrganizationId > 0)
                        {
                         
                            <MudItem sm="6" md="6" Style="@(CurrentTenant.Id != null ? "margin-left: 13px;" : "margin-left:0")">
                                <MudSelect @bind-Value="@RoleId"
                                           Label="@L["UserRole"]"
                                           Placeholder="@L[ "Choose"]"
                                           HelperText=@L["Helper Text"]
                                           Required>
                                    <MudSelectItem Value="@("Choose")">@L["Choose"]</MudSelectItem>
                                    @foreach (var role in Roles)
                                    {

                                        <MudSelectItem Value="@role.Id.ToString()">
                                            @role.Name
                                        </MudSelectItem>

                                    }
                                </MudSelect>

                            </MudItem>
                        }
                    </MudGrid>
                        @if(!showVehicle){
                            <div class="d-flex justify-content-between mt-auto">
                                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Dark" OnClick="HandleCancel">@L["Cancel"]</MudButton>
                                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="HandleSubmit" >@L["Create"]</MudButton>
                            </div>
                        }
                </MudForm>

            </MudPaper>
        </MudItem>
        @if (showVehicle)
        {
            <MudItem sm="5">
                <MudPaper Class="h-100 p-3  w-100 h-100 main-layout-paper d-flex flex-column justify-content-between" Style="background-color: #F2F2F2;">
                <MudForm Model="createUpdateVehicle" Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
                    <MudGrid>

                            <MudItem sm="6" md="6">
                                <MudTextField T="string" Validation="VehicleValidation.ValidateArabicLetters" InputType="InputType.Text" Immediate="true" Label="@L["ArPlateLetters"]" MaxLength="3" OnBlur="HandleKeyUpLettersArabic" @bind-Value="createUpdateVehicle.ArPlateLetters" Placeholder="@L["Type Here"]" />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField T="string" Validation="VehicleValidation.ValidateArabicNumber" Immediate="true" OnBlur="HandleKeyUpArabic"  InputType="InputType.Text" Label="@L["ArPlateNumber"]" MaxLength="4" @bind-Value="createUpdateVehicle.ArPlateNumber" Placeholder="@L["Type Here"]" />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField T="string" Validation="VehicleValidation.ValidateEnglishLetter" Immediate="true" OnBlur="HandleKeyUpLettersEnglish"  InputType="InputType.Text" MaxLength="3" Label="@L["EnPlateLetters"]" @bind-Value="createUpdateVehicle.EnPlateLetters" Placeholder="@L["Type Here"]" />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField T="string" Validation="VehicleValidation.ValidateNumber" InputType="InputType.Text" Immediate="true"  Label="@L["EnPlateNumber"]" OnBlur="HandleKeyUpEnglish" MaxLength="4" @bind-Value="createUpdateVehicle.EnPlateNumber" Placeholder="@L["Type Here"]" />
                            </MudItem>


                        <MudItem sm="6" md="6">
                            <MudSelect @bind-Value="@createUpdateVehicle.LicenceTypeId"
                                       Variant="Variant.Text"
                                       Label="@L["LicenceType"]"
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       Required="true"
                                       Clearable="true">
                                    <MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
                                @foreach (var licenceType in LicenceTypes)
                                {
                                    @if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="licenceType.Id">@licenceType.EnglishName</MudSelectItem>
                                    }
                                    else
                                    {
                                        <MudSelectItem Value="licenceType.Id">@licenceType.ArabicName</MudSelectItem>

                                    }
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem sm="6" md="6">
                            <MudSelect T="int"
                                       Variant="Variant.Text"
                                       Label="@L["VehicleBrand"]"
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       Required="true"
                                       Clearable="true"
                                       ValueChanged="SelectBrand">
                                    <MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
                                @foreach (var vehiclebrand in VehicleBrands)
                                {
                                    @if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="vehiclebrand.Id">@vehiclebrand.EnglishName</MudSelectItem>

                                    }
                                    else
                                    {
                                        <MudSelectItem Value="vehiclebrand.Id">@vehiclebrand.ArabicName</MudSelectItem>

                                    }
                                }
                            </MudSelect>
                        </MudItem>
                            @if(createUpdateVehicle.VehicleBrandId != 0)
                            {
                                <MudItem sm="6" md="6">
                                    <MudSelect @bind-Value="@createUpdateVehicle.VehicleModelId"
                                               Variant="Variant.Text"
                                               Label="@L["VehicleModel"]"
                                               Placeholder=@L["Choose"]
                                               HelperText=@L["Helper Text"]
                                               Required="true"
                                               Clearable="true">
                                            <MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
                                        @foreach (var vehiclemodel in VehicleModels)
                                        {
                                            @if (CultureInfo.CurrentCulture.Name == "en")
                                            {
                                                <MudSelectItem Value="vehiclemodel.Id">@vehiclemodel.EnglishName</MudSelectItem>
                                            }
                                            else
                                            {
                                                <MudSelectItem Value="vehiclemodel.Id">@vehiclemodel.ArabicName</MudSelectItem>
                                            }

                                        }
                                    </MudSelect>
                                </MudItem>
                        }
                        <MudItem sm="6" md="6">
                                <MudTextField Required="true" RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" T="string" Validation="VehicleValidation.ValidateYear" MaxLength="4" InputType="InputType.Text" Label="@L["ModelYear"]" @bind-Value="createUpdateVehicle.ModelYear" Placeholder="@L["Type Here"]" />
                        </MudItem>

                        <MudItem sm="6" md="6">
                            <MudTextField Label="@L["CompanyName"]" Disabled="createUpdateVehicle.BelongToCompany==false" T="string" InputType="InputType.Text" @bind-Value="createUpdateVehicle.CompanyName" Placeholder="@L["Type Here"]" />
                        </MudItem>

                        <MudItem sm="6" md="6">
                            <MudSwitch Label="@L["BelongToCompany"]" LabelPosition="LabelPosition.Start" @bind-Value="createUpdateVehicle.BelongToCompany" Color="MudBlazor.Color.Primary" />
                        </MudItem>
                        <MudItem sm="6" md="6">
                                <MudButton Color="MudBlazor.Color.Dark" Variant="Variant.Filled" OnClick="CancelCreate">@L["Back"]</MudButton>
                        </MudItem>
                        <MudItem sm="6" md="6">
                        <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="SubmitCreate">@L["Create"]</MudButton>
                        </MudItem>
                          
                          
                    </MudGrid>
                </MudForm>
                </MudPaper>
            </MudItem>

            
        }


    </MudGrid>
</div>

<style>
    .bg_w_foto 
    {
        background: url(images/cities/<?php echo $city_name;
        ?>) no-repeat center center;
        -webkit-background-size: cover;
        -moz-background-size: cover;
        -o-background-size: cover;
        background-size: cover;
    }
</style>
