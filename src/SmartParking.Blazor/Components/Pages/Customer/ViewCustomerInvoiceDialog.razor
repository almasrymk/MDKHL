@using Microsoft.Extensions.Localization
@using SmartParking.Invoices
@using SmartParking.Localization
@inject IDialogService Dialog
@inject IStringLocalizer<SmartParkingResource> L
@inject IInvoiceAppService InvoiceAppService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
<PageTitle>@L["CustomerInvoice"]</PageTitle>
<div class="modal-wrapper ">
    <MudDialog class="mud-modal ">
        <TitleContent>
            <MudText Class="fw-bold">@L["CustomerInvoice"]</MudText>
        </TitleContent>
        <DialogContent>
            <SPDataGrid PageName=@L["CustomerInvoice"] Data="@itemData" OnPageChanged="FetchTableData" ></SPDataGrid>
        </DialogContent>
        <DialogActions>

            <MudButton Color="MudBlazor.Color.Primary" OnClick="Cancel">@L["Cancel"]</MudButton>
        </DialogActions>
    </MudDialog>
</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>