@using Microsoft.Extensions.Localization
@using SmartParking.CustomerPackages
@using SmartParking.CustomerUnitPackages
@using SmartParking.Localization
@using Volo.Abp.MultiTenancy
@inject IStringLocalizer<SmartParkingResource> L
@inject ICurrentTenant CurrentTenant
@inject ICustomerUnitPackageAppService CustomerUnitPackageAppService
@inject IAssignUnitCustomerPackageAppService AssignCustomerPackagesAppService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation




<PageTitle>@L["CustomePackage"]</PageTitle>
<div class="modal-wrapper ">
    <MudDialog class="mud-modal w-100" Style="min-width:auto !important">
        <TitleContent>
            <MudText Class="fw-bold">@L["CustomePackage"]</MudText>
        </TitleContent>
        <DialogContent>
            <SPDataGrid PageName=@L["CustomePackage"] Data="@itemData" TotalItemsInTable="TotalItem"  OnClickAssign="HandleAssign"  OnPageChanged="FetchTableData"></SPDataGrid>
        </DialogContent>
        <DialogActions>

            <MudButton Color="MudBlazor.Color.Dark" Variant="Variant.Filled" OnClick="Cancel">@L["Cancel"]</MudButton>
        </DialogActions>
    </MudDialog>
</div>