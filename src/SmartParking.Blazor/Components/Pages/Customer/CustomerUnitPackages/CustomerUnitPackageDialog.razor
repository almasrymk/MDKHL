@using Microsoft.Extensions.Localization
@using SmartParking.CustomerPackages
@using SmartParking.Cutomers
@using SmartParking.Localization
@using SmartParking.UnitPackages
@using SmartParking.Blazor.Components.SPComponents
@using SmartParking.CustomerUnitPackages
@using SmartParking.UnitVehiclePackages
@inject IDialogService Dialog
@inject ICustomerAppService CustomersAppService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SmartParkingResource> L
@inject IUnitVehiclePackageAppService UnitVehiclePackageAppService
@inject ICustomerPackagesAppService CustomerPackagesAppService


<PageTitle>@L["AssignPackage"]</PageTitle>

<div class="modal-wrapper">
    <MudDialog class="mud-modal w-100" Style="min-width:auto !important">
        <TitleContent>
            <MudText Class="fw-bold">@L["AssignPackage"]</MudText>
        </TitleContent>
        <DialogContent>
            <SPDataGrid PageName=@L["UnitPackages"] 
                        TotalItemsInTable="@TotalItem"
                        Data="@itemData" 
                        OnAdd="OpenAssignPackage" 
                        OnPageChanged="FetchTableData"
                        ShowDelete="true"
                        OnClickRowDelete="RemovePackage">
            </SPDataGrid>
        </DialogContent>
        <DialogActions>
            <MudButton Color="MudBlazor.Color.Dark" Variant="Variant.Filled" OnClick="Cancel">@L["Cancel"]</MudButton>
        </DialogActions>
    </MudDialog>
</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
        min-width:max-content;
    }
</style>
