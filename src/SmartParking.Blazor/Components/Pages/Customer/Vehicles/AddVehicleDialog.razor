@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups.LicenceType
@using SmartParking.Lookups.PlateColor
@using SmartParking.Lookups.VehicleBrand
@using SmartParking.Lookups.VehicleModel
@using SmartParking.Validations
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Vehicles
@using System.Globalization
@inject IPlateColorsAppService PlateColorsAppService
@inject ILicenceTypesAppService LicenceTypesAppService
@inject IVehicleBrandsAppService VehicleBrandAppService
@inject IVehicleModelsAppService VehicleModelAppService
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject IVehiclesAppService VehicleAppService
@inject NavigationManager Navigation

<PageTitle>@L["Add Vehicle for Customer"]</PageTitle>

<div class="modal-wrapper w-100">

    <MudDialog Class="mud-modal w-100">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Add Vehicle for Customer"] </MudText>
        </TitleContent>
        <DialogContent>

            <MudForm Model="createUpdateVehicle" Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
                <MudGrid>
                    <MudItem sm="6" md="6">
                        <MudTextField T="string" Validation="VehicleValidation.ValidateArabicLetters" InputType="InputType.Text" Immediate="true" Label="@L["ArPlateLetters"]" OnBlur="HandleKeyUpLettersArabic" @bind-Value="createUpdateVehicle.ArPlateLetters" MaxLength="3" Placeholder="@L["Type Here"]" />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudTextField T="string" Validation="VehicleValidation.ValidateArabicNumber" Immediate="true" OnBlur="HandleKeyUpArabic" InputType="InputType.Text" Label="@L["ArPlateNumber"]" @bind-Value="createUpdateVehicle.ArPlateNumber" MaxLength="4"  Placeholder="@L["Type Here"]" />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudTextField T="string" Validation="VehicleValidation.ValidateEnglishLetter" Immediate="true" OnBlur="HandleKeyUpLettersEnglish" InputType="InputType.Text" Label="@L["EnPlateLetters"]" @bind-Value="createUpdateVehicle.EnPlateLetters" MaxLength="3"  Placeholder="@L["Type Here"]" />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudTextField T="string" Validation="VehicleValidation.ValidateNumber" InputType="InputType.Text" Immediate="true" Label="@L["EnPlateNumber"]" OnBlur="HandleKeyUpEnglish" @bind-Value="createUpdateVehicle.EnPlateNumber" MaxLength="4"  Placeholder="@L["Type Here"]" />
                    </MudItem>



                    <MudItem sm="6" md="6">


                        <MudSelect @bind-Value="LicenceTypeId"
                                   Variant="Variant.Text"
                                   Label="@L["LicenceType"]"
                                   Placeholder=@L["Choose"]
                                   HelperText=@L["Helper Text"]
                                   Required="true"
                                   Clearable="_clearable">
                            @foreach (var licenceType in LicenceTypes)
                            {
                                @if (CultureInfo.CurrentCulture.Name == "en")
                                {
                                    <MudSelectItem Value="licenceType.Id.ToString()">@licenceType.EnglishName</MudSelectItem>
                                }
                                else
                                {
                                    <MudSelectItem Value="licenceType.Id.ToString()">@licenceType.ArabicName</MudSelectItem>

                                }
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudSelect T="string"
                                   Variant="Variant.Text"
                                   Label="@L["VehicleBrand"]"
                                   Placeholder=@L["Choose"]
                                   HelperText=@L["Helper Text"]
                                   Required="true"
                                   Clearable="_clearable"
                                   ValueChanged="SelectBrand">
                            @foreach (var vehiclebrand in VehicleBrands)
                            {
                                @if(CultureInfo.CurrentCulture.Name == "en")
                                {
                                    <MudSelectItem Value="vehiclebrand.Id.ToString()">@vehiclebrand.EnglishName</MudSelectItem>

                                }
                                else
                                {
                                    <MudSelectItem Value="vehiclebrand.Id.ToString()">@vehiclebrand.ArabicName</MudSelectItem>

                                }
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudSelect @bind-Value="@VehicleModelId"
                                   Variant="Variant.Text"
                                   Label="@L["VehicleModel"]"
                                   Placeholder=@L["Choose"]
                                   HelperText=@L["Helper Text"]
                                   Required="true"
                                   Clearable="_clearable">
                            @foreach (var vehiclemodel in VehicleModels)
                            {
                                @if (CultureInfo.CurrentCulture.Name == "en")
                                {
                                    <MudSelectItem Value="vehiclemodel.Id.ToString()">@vehiclemodel.EnglishName</MudSelectItem>
                                }
                                else
                                {
                                    <MudSelectItem Value="vehiclemodel.Id.ToString()">@vehiclemodel.ArabicName</MudSelectItem>
                                }

                            }
                        </MudSelect>
                    </MudItem>
                   
                    <MudItem sm="6" md="6">
                        <MudTextField Required="true" T="string" Validation="VehicleValidation.ValidateYear" InputType="InputType.Text" MaxLength="4" Label="@L["ModelYear"]" @bind-Value="createUpdateVehicle.ModelYear" Placeholder="@L["Type Here"]" />
                    </MudItem>
                   
                    <MudItem sm="6" md="6">
                        <MudTextField Label="@L["CompanyName"]" Disabled="createUpdateVehicle.BelongToCompany==false" T="string" InputType="InputType.Text" @bind-Value="createUpdateVehicle.CompanyName" Placeholder="@L["Type Here"]"  />
                    </MudItem>

                    <MudItem sm="6" md="6">
                        <MudSwitch Label="@L["BelongToCompany"]" LabelPosition="LabelPosition.Start" @bind-Value="createUpdateVehicle.BelongToCompany" Color="MudBlazor.Color.Primary" />
                    </MudItem>
                </MudGrid>
            </MudForm>

        </DialogContent>
                <DialogActions>
    <DialogActionComponent 
        ButtonOneColor="MudBlazor.Color.Dark" 
        ButtonTwoColor="MudBlazor.Color.Primary" 
        ButtonOneLabel="@L["Back"]" 
        ButtonTwoLabel="@L["Save"]"
        ButtonOneClick="CancelCreate"
        ButtonTwoClick="SubmitCreate"
        ButtonOneVariant="MudBlazor.Variant.Filled" 
        ButtonTwoVariant="MudBlazor.Variant.Filled" />
</DialogActions>
    </MudDialog>
</div>



<style>

    .mud-modal
    {
        border-radius: 0 20px 0 20px;
    }
</style>
