@using Microsoft.Extensions.Localization
@using SmartParking.Analysis
@using SmartParking.Cutomers
@using SmartParking.Localization
@using SmartParking.PDF
@using SmartParking.Permissions.Reports
@using SmartParking.Vehicles
@using Volo.Abp.MultiTenancy
@inject IDialogService Dialog
@inject IStringLocalizer<SmartParkingResource> L
@inject ICustomerAppService CustomerAppService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IVehiclesAppService VehiclesAppService
@inject ICurrentTenant CurrentTenant
@inject IAuthorizationService AuthorizationService
@inject IAnalysisAppService AnalysisAppService
@inject IGenerateFilesAppService GenerateFilesAppService
@inject IJSRuntime JSRuntime;


<PageTitle>@L["CustomerVehicle"]</PageTitle>
<div class="modal-wrapper ">
    <MudDialog class="mud-modal w-100" Style="min-width:auto !important">
        <TitleContent>
            <MudText Class="fw-bold">@L["CustomerVehicle"]</MudText>
        </TitleContent>
        <DialogContent>
            <SPDataGrid PageName=@L["CustomerVehicle"] Data="@itemData" TotalItemsInTable="TotalItem" OnClickRowEdit="HandleEdit" OnClickAssign="HandleAssign" ShowEdit="ShowEdit" OnPageChanged="FetchTableData" ShowVehicleTransactions="AuthorizationService.IsGrantedAnyAsync(ReportsPermissions.IT).Result || !CurrentTenant.Id.HasValue" ShowVehicleTransactionsMethod="ShowCustomerTransactions" OnClickRowDelete="HandleDelete" OnAdd="HandleAdd"></SPDataGrid>
        </DialogContent>
        <DialogActions>

            <MudButton Color="MudBlazor.Color.Dark" Variant="Variant.Filled" OnClick="Cancel">@L["Cancel"]</MudButton>
        </DialogActions>
    </MudDialog>
</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>