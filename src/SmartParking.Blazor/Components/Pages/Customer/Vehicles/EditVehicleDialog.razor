@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups.LicenceType
@using SmartParking.Lookups.PlateColor
@using SmartParking.Lookups.VehicleBrand
@using SmartParking.Lookups.VehicleModel
@using SmartParking.Validations
@using SmartParking.Vehicles
@using SmartParking.Blazor.Components.Shared
@using System.Globalization
@inject IPlateColorsAppService PlateColorsAppService
@inject ILicenceTypesAppService LicenceTypesAppService
@inject IVehicleBrandsAppService VehicleBrandAppService
@inject IVehicleModelsAppService VehicleModelAppService
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject IVehiclesAppService VehicleAppService
@inject NavigationManager Navigation

<PageTitle>@L["EditVehicle"]</PageTitle>

<div class="modal-wrapper w-100">

    <MudDialog Class="mud-modal w-100">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["EditVehicle"] </MudText>
        </TitleContent>
        <DialogContent>

            <MudForm Model="Vehicle" Class="flex-grow-1 mt-4 h-100 d-flex flex-column w-100 h-100 main-layout-paper">
                <MudGrid>
                    <MudItem sm="6" md="6">
                        <MudTextField T="string" Validation="VehicleValidation.ValidateArabicLetters" InputType="InputType.Text" Immediate="true" Label="@L["ArPlateLetters"]" OnBlur="HandleKeyUpLettersArabic" @bind-Value="Vehicle.ArPlateLetters" MaxLength="3" Placeholder="@L["Type Here"]" />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudTextField T="string" Validation="VehicleValidation.ValidateArabicNumber" Immediate="true" OnBlur="HandleKeyUpArabic" InputType="InputType.Text" Label="@L["ArPlateNumber"]"  @bind-Value="Vehicle.ArPlateNumber" MaxLength="4" Placeholder="@L["Type Here"]" />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudTextField T="string" Validation="VehicleValidation.ValidateEnglishLetter" Immediate="true" OnBlur="HandleKeyUpLettersEnglish" InputType="InputType.Text" Label="@L["EnPlateLetters"]"  @bind-Value="Vehicle.EnPlateLetters" MaxLength="3" Placeholder="@L["Type Here"]" />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudTextField T="string" Validation="VehicleValidation.ValidateNumber" InputType="InputType.Text" Immediate="true" Label="@L["EnPlateNumber"]" OnBlur="HandleKeyUpEnglish"  @bind-Value="Vehicle.EnPlateNumber" MaxLength="4" Placeholder="@L["Type Here"]" />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudSelect @bind-Value="@Vehicle.LicenceTypeId"
                                   Variant="Variant.Text"
                                   Label="@L["LicenceType"]"
                                   Placeholder=@L["Choose"]
                                   HelperText=@L["Helper Text"]
                                   Required="true"
                                   Clearable="_clearable">
                            @foreach (var licenceType in LicenceTypes)
                            {
                                @if (CultureInfo.CurrentCulture.Name == "en")
                                {
                                    <MudSelectItem Value="licenceType.Id">@licenceType.EnglishName</MudSelectItem>
                                }
                                else
                                {
                                    <MudSelectItem Value="licenceType.Id">@licenceType.ArabicName</MudSelectItem>

                                }
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudSelect T="int"
                                   Variant="Variant.Text"
                                   Label="@L["VehicleBrand"]"
                                   Placeholder=@L["Choose"]
                                   HelperText=@L["Helper Text"]
                                   Required="true"
                                   Clearable="_clearable"
                                   ValueChanged="SelectBrand">
                            @foreach (var vehiclebrand in VehicleBrands)
                            {
                                @if (CultureInfo.CurrentCulture.Name == "en")
                                {
                                    <MudSelectItem Value="vehiclebrand.Id">@vehiclebrand.EnglishName</MudSelectItem>

                                }
                                else
                                {
                                    <MudSelectItem Value="vehiclebrand.Id">@vehiclebrand.ArabicName</MudSelectItem>

                                }
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudSelect @bind-Value="@Vehicle.VehicleModelId"
                                   Variant="Variant.Text"
                                   Label="@L["VehicleModel"]"
                                   Placeholder=@L["Choose"]
                                   HelperText=@L["Helper Text"]
                                   Required="true"
                                   Clearable="_clearable">
                            @foreach (var vehiclemodel in VehicleModels)
                            {
                                @if (CultureInfo.CurrentCulture.Name == "en")
                                {
                                    <MudSelectItem Value="vehiclemodel.Id">@vehiclemodel.EnglishName</MudSelectItem>
                                }
                                else
                                {
                                    <MudSelectItem Value="vehiclemodel.Id">@vehiclemodel.ArabicName</MudSelectItem>
                                }

                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem sm="6" md="6">
                        <MudTextField Required="true" T="string" Validation="VehicleValidation.ValidateYear" MaxLength="4" InputType="InputType.Text" Label="@L["ModelYear"]" @bind-Value="Vehicle.ModelYear" Placeholder="@L["Type Here"]" />
                    </MudItem>

                    <MudItem sm="6" md="6">
                        <MudTextField Label="@L["CompanyName"]" Disabled="Vehicle.BelongToCompany==false" T="string" InputType="InputType.Text" @bind-Value="Vehicle.CompanyName" Placeholder="@L["Type Here"]" />
                    </MudItem>

                    <MudItem sm="6" md="6">
                        <MudSwitch Label="@L["BelongToCompany"]" LabelPosition="LabelPosition.Start" @bind-Value="Vehicle.BelongToCompany" Color="MudBlazor.Color.Primary" />
                    </MudItem>
                </MudGrid>
            </MudForm>

        </DialogContent>
        <DialogActions>
    <DialogActionComponent 
        ButtonOneColor="MudBlazor.Color.Dark" 
        ButtonTwoColor="MudBlazor.Color.Primary" 
        ButtonOneLabel="@L["Back"]" 
        ButtonTwoLabel="@L["Save"]" 
        ButtonOneClick="CancelEdit" 
        ButtonTwoClick="SubmitEdit" 
        ButtonOneVariant="MudBlazor.Variant.Filled" 
        ButtonTwoVariant="MudBlazor.Variant.Filled" />
</DialogActions>
    </MudDialog>
</div>



<style>

    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>
