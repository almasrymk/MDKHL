@page "/Account/Login"

@layout Shared.AuthLayout
@inject NavigationManager NavigationManager
@using Microsoft.Extensions.Localization
@using SmartParking.Authentication
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Localization
@using System.Security.Authentication
@using Volo.Abp
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Validation
@inject IStringLocalizer<SmartParkingResource> L
@inject ICurrentTenant CurrentTenant
@inject IAuthenticationAppService authentication
@inject ISnackbar Snackbar

<PageTitle>@L["Sign In"]</PageTitle>

<h2>@L["Sign In"]</h2>
<MudContainer Class="d-flex justify-content-center my-5">
    <EditForm Model="@loginModel" Class="d-flex flex-column gap-3 w-75" OnValidSubmit="HandleLogin">
        <MudTextField @bind-Value="loginModel.Username" T="string" Placeholder=@L["Type Here"] Label=@L["Mobile/User Name"] Required="true" RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
        <MudTextField @bind-Value="loginModel.Password" T="string" Placeholder=@L["Type Here"] Label=@L["Password"] InputType="InputType.Password" Required="true" RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
        <div class="d-flex align-items-center justify-content-center gap-1">
            <p class="m-0">@L["Forget Your Password Don't worry .."]</p>
            <MudLink Href="/verify-account" Class="fw-bold" Color="MudBlazor.Color.Dark">@L["Click here to reset"]</MudLink>
        </div>

        <MudButton ButtonType="MudBlazor.ButtonType.Submit" Class="mt-4" Variant="Variant.Filled" Color="MudBlazor.Color.Primary">@L["Sign In"]</MudButton>
    </EditForm>

</MudContainer>
@code {
    private MudForm form;
    private LoginInputDto loginModel = new LoginInputDto();

    // [Parameter]
    // [SupplyParameterFromQuery]
    // public string? errorMessage { get; set; }
    // protected override Task OnInitializedAsync()
    // {
    //     if(!errorMessage.IsNullOrEmpty())
    //     {
    //         SnackBar.ShowSnackbar(Snackbar, L["InvalidCredentials"], Severity.Error);
    //     }
    //     return base.OnInitializedAsync();

    // }

    private async void HandleLogin()
    {
        try
        {
            var user = await authentication.LoginForWebAsync(loginModel);
            if(user != null)
            {
                var token =await authentication.GenerateToken(user.Id.ToString());
                NavigationManager.NavigateTo($"logIn/{token}", true);
            }
        }
        catch (AbpValidationException validationException)
        {
            foreach (var validationError in validationException.ValidationErrors)
            {
                SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.VAlIDATION_ERROR]}: {L[validationError.MemberNames.First()]} - {validationError.ErrorMessage}", Severity.Error);
            }
        }
        catch (BusinessException ex)
        {

            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]}: {ex.Message}", Severity.Error);
        }
        catch (AuthenticationException ex)
        {
            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]} : {ex.Message} ", Severity.Error);
        }
        catch (Exception ex)
        {

            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]}: {ex.Message} ", Severity.Error);
        }
        
        //NavigationManager.NavigateTo($"api/Accounts?username={loginModel.UserNameOrEmailAddress}&password={loginModel.Password}", true);
    }

}
