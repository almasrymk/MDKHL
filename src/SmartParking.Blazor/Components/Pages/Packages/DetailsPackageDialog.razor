@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Packages
@using System.Globalization
@inject IPackagesAppService PackagesAppService

@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar

<PageTitle>@L["View Package"]</PageTitle>

<div class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
            @if (CultureInfo.CurrentCulture.Name == "en")
            {
                <MudText Typo="Typo.h6">@Package.EnglishName</MudText>
            }
            else
            {
                <MudText Typo="Typo.h6">@Package.ArabicName</MudText>
            }
		</TitleContent>
		<DialogContent>



			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>


                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="Package.ArabicName"
                                      For="@(() => Package.ArabicName)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Disabled='true'
                                      Label=@L["ArabicName"] />
                    </MudItem>
                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="Package.EnglishName"
                                      For="@(() => Package.EnglishName)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Disabled='true'
                                      Label=@L["EnglishName"] />
                    </MudItem>
                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="Package.Price"
                                      For="@(() => Package.Price)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Disabled='true'
                                      Label=@L["Price"] />
                    </MudItem>


                   

                @*     <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="Package.PackageType.EnglishName"
                                      For="@(() => Package.PackageType.EnglishName)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Disabled='true'
                                      Label=@L["PackageTypeEnglishName"] />
                    </MudItem> *@
                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="Package.PublishFrom"
                                      For="@(() => Package.PublishFrom)"
                                      Immediate="true"
                                      Disabled=true
                                      Label=@L["PublishFrom"] />
                    </MudItem>
                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="Package.PublishTo"
                                      For="@(() => Package.PublishTo)"
                                      Immediate="true"
                                      Disabled=true
                                      Label=@L["PublishTo"] />
                    </MudItem>
                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="Package.OrganizationId"
                                      For="@(() => Package.OrganizationId)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Disabled='true'
                                      Label=@L["OrgnizationId"] />
                    </MudItem>
              
                    <MudItem sm="4">
                        <MudSwitch Label=@L["Published"]
                                   LabelPosition="LabelPosition.Start"
                                   Placeholder=@L["Published"]
                                   @bind-Value="Package.published"
                                   Disabled='true'
                                   Color="MudBlazor.Color.Primary" />
                    </MudItem>
                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="CustomerCategory"
                                      For="@(() => CustomerCategory)"
                                      Immediate="true"
                                      Disabled=true
                                      Label=@L["customer category"] />
                    </MudItem>
                    
                    <MudItem sm="12">
                        <MudTextField @bind-Value="Package.Description"
                                      For="@(() => Package.Description)"
                                      Variant="Variant.Outlined"
                                      Class="w-100"
                                      Lines="5"
                                      Disabled='true'
                                      Label=@L["Description"] />

                    </MudItem>

                
                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="Package.PackageStatus"
                                      For="@(() => Package.PackageStatus)"
                                      Immediate="true"
                                      Disabled=true
                                      Label=@L["Status"] />
                    </MudItem>

				</MudGrid>
			</MudForm>



		</DialogContent>
        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="OnCloseViewOnly">@L["Back"]</MudButton>
        </DialogActions>

	</MudDialog>

</div>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialogAdd { get; set; }
    [Parameter] public CreateUpdatePackageDto Package { get; set; }
    [Parameter]
    public int UpdatedId { get; set; }
    [Parameter]
    public string CustomerCategory { get; set; }
    
    bool _clearable;
    private MudForm form;

   
    protected override async Task OnInitializedAsync()
    {
        
        await base.OnInitializedAsync();
	}



	private void OnCloseViewOnly()
	{
		MudDialogAdd.Cancel();

	}

}
