@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Packages
@inject IPackagesAppService PackagesAppService

@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar

<PageTitle>@L["View Package"]</PageTitle>

<div class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["View Package"]</MudText>
		</TitleContent>
		<DialogContent>



			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>


                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="Package.ArabicName"
                                      For="@(() => Package.ArabicName)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Disabled='true'
                                      Label=@L["Arabic Name"] />
                    </MudItem>
                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="Package.EnglishName"
                                      For="@(() => Package.EnglishName)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Disabled='true'
                                      Label=@L["English Name"] />
                    </MudItem>
                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="Package.Price"
                                      For="@(() => Package.Price)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Disabled='true'
                                      Label=@L["Price"] />
                    </MudItem>


                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="Package.OrgnizationId"
                                      For="@(() => Package.OrgnizationId)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Disabled='true'
                                      Label=@L["OrgnizationId"] />
                    </MudItem>

                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="Package.PackageType.EnglishName"
                                      For="@(() => Package.PackageType.EnglishName)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Disabled='true'
                                      Label=@L["PackageTypeEnglishName"] />
                    </MudItem>
                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="Package.PublishFrom"
                                      For="@(() => Package.PublishFrom)"
                                      Immediate="true"
                                      Disabled=true
                                      Label=@L["PublishFrom"] />
                    </MudItem>
                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="Package.PublishTo"
                                      For="@(() => Package.PublishTo)"
                                      Immediate="true"
                                      Disabled=true
                                      Label=@L["PublishTo"] />
                    </MudItem>
                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="Package.OrgnizationId"
                                      For="@(() => Package.OrgnizationId)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Disabled='true'
                                      Label=@L["OrgnizationId"] />
                    </MudItem>
              
                    <MudItem sm="4">
                        <MudSwitch Label=@L["published"]
                                   LabelPosition="LabelPosition.Start"
                                   Placeholder=@L["published"]
                                   @bind-Value="Package.published"
                                   Disabled='true'
                                   Color="MudBlazor.Color.Primary" />
                    </MudItem>
                    <MudItem sm="12">
                        <MudTextField @bind-Value="Package.Description"
                                      For="@(() => Package.Description)"
                                      Variant="Variant.Outlined"
                                      Class="w-100"
                                      Lines="5"
                                      Disabled='true'
                                      Label=@L["Description"] />

                    </MudItem>

                
                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="Package.Status"
                                      For="@(() => Package.Status)"
                                      Immediate="true"
                                      Disabled=true
                                      Label=@L["Status"] />
                    </MudItem>

				</MudGrid>
			</MudForm>



		</DialogContent>
		<DialogActions>
			<div class="overflow-hidden px-5 w-100">

				<MudGrid>
					<MudItem sm="6" md="6">

						<MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Tertiary" OnClick="OnCloseViewOnly">@L["Cancel"]</MudButton>
					</MudItem>
				</MudGrid>
			</div>

		</DialogActions>

	</MudDialog>

</div>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>

@code {
	[CascadingParameter]
	private MudDialogInstance MudDialogAdd { get; set; }
    [Parameter] public CreateUpdatePackageDto Package { get; set; }
	[Parameter]
	public int UpdatedId { get; set; }
	
	bool _clearable;
	private MudForm form;

	protected override async Task OnInitializedAsync()
	{
		
		await base.OnInitializedAsync();
	}



	private void OnCloseViewOnly()
	{
		MudDialogAdd.Cancel();

	}

}
