@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Packages
@using System.Globalization
@inject IPackagesAppService PackagesAppService

@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar

<PageTitle>@L["View Package"]</PageTitle>

<div class="modal-wrapper">
	<MudDialog class="mud-modal" style="min-height:fit-content !important">
		<TitleContent>
            @if (CultureInfo.CurrentCulture.Name == "en")
            {
                <MudText Typo="Typo.h6">@Package.EnglishName</MudText>
            }
            else
            {
                <MudText Typo="Typo.h6">@Package.ArabicName</MudText>
            }
		</TitleContent>
		<DialogContent>



			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>


                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="Package.ArabicName"
                                      For="@(() => Package.ArabicName)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Disabled='true'
                                      Label=@L["ArabicName"] />
                    </MudItem>
                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="Package.EnglishName"
                                      For="@(() => Package.EnglishName)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Disabled='true'
                                      Label=@L["EnglishName"] />
                    </MudItem>
                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="Package.Price"
                                      For="@(() => Package.Price)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Disabled='true'
                                      Label=@L["Price"] />
                    </MudItem>

                    <MudItem sm="4" md="4">
                        <MudNumericField @bind-Value="Package.DurationOfPackage"
                                         Variant="Variant.Text"                                        
                                         HideSpinButtons="true"
                                         Disabled="true"
                                         Class="w-100"
                                         Label=@L["PackageDuration"] />
                    </MudItem>

                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="CustomerCategory"
                                      For="@(() => CustomerCategory)"
                                      Immediate="true"
                                      Disabled=true
                                      Label=@L["customer category"] />
                    </MudItem>
                    @if(Package.Published == true)
                    {
                        <MudItem sm="4">
                            <MudSwitch Label=@L["Published"]
                                       LabelPosition="LabelPosition.Start"
                                       Placeholder=@L["Published"]
                                       @bind-Value="Package.Published"
                                       Disabled='true'
                                       Color="MudBlazor.Color.Primary" />
                        </MudItem>
                        <MudItem sm="4" md="4">
                            <MudTextField @bind-Value="Package.PublishFrom"
                                          For="@(() => Package.PublishFrom)"
                                          Immediate="true"
                                          Disabled=true
                                          Label=@L["Publish From"] />
                        </MudItem>
                        <MudItem sm="4" md="4">
                            <MudTextField @bind-Value="Package.PublishTo"
                                          For="@(() => Package.PublishTo)"
                                          Immediate="true"
                                          Disabled=true
                                          Label=@L["Publish To"] />
                        </MudItem>
                    }
                    
              

                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="Package.PackageStatus"
                                      For="@(() => Package.PackageStatus)"
                                      Immediate="true"
                                      Disabled=true
                                      Label=@L["Status"] />
                    </MudItem>
                    <MudItem sm="12">
                        <MudTextField @bind-Value="Package.Description"
                                      For="@(() => Package.Description)"
                                      Variant="Variant.Outlined"
                                      Class="w-100"
                                      Lines="5"
                                      Disabled='true'
                                      Label=@L["Description"] />

                    </MudItem>

                
                   

				</MudGrid>
			</MudForm>



		</DialogContent>
        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="OnCloseViewOnly">@L["Back"]</MudButton>
        </DialogActions>

	</MudDialog>

</div>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialogAdd { get; set; }
    [Parameter] public PackageDto Package { get; set; }
    [Parameter]
    public int UpdatedId { get; set; }
    [Parameter]
    public string CustomerCategory { get; set; }
    
    bool _clearable;
    private MudForm form;

   
    protected override async Task OnInitializedAsync()
    {
        
        await base.OnInitializedAsync();
	}



	private void OnCloseViewOnly()
	{
		MudDialogAdd.Cancel();

	}

}
