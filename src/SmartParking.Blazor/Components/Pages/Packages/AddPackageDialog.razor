@using SmartParking.Blazor.Components.Shared
@using SmartParking.Enums
@using SmartParking.Lookups
@using SmartParking.Packages
@using SmartParking.Organizations
@using SmartParking.Blazor.Components.Shared
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Validations
@using System.Globalization
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Validation
@inject IPackagesAppService packagesAppService
@inject IOrganizationsAppService organizationAppService
@inject IPackageTypesAppService packageTypesAppService
@inject IStringLocalizer<SmartParkingResource> L
@inject ICurrentTenant CurrentTenant
@inject NavigationManager NavigationManager


<PageTitle>@L["New Package"]</PageTitle>
<div class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Add NEW"]</MudText>
        </TitleContent>
        <DialogContent>

            <MudForm Class="flex-grow-1 mt-2 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper"  Model="createUpdatePackage"  >
                <MudGrid>
                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="createUpdatePackage.ArabicName"
                        For="@(() => createUpdatePackage.ArabicName)"
                        Variant="Variant.Text"
                        Class="w-100"
                        Placeholder=@L["Type Here"]
                        Required="true"
                        RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                        Label=@L["ArabicName"] />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="createUpdatePackage.EnglishName"
                        For="@(() => createUpdatePackage.EnglishName)"
                        Variant="Variant.Text"
                        Required="true"
                        RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                        Class="w-100"
                        Placeholder=@L["Type Here"]
                        Label=@L["EnglishName"] />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudNumericField @bind-Value="createUpdatePackage.Price"
                        For="@(() => createUpdatePackage.Price)"
                        Variant="Variant.Text"
                        Min="0"
                        HideSpinButtons="true"
                        Required="true"
                        RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                        Class="w-100"
                        Label="@($"{L["Price"]} ({L["SAR"]})")"  />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudNumericField @bind-Value="createUpdatePackage.DurationOfPackage"
                        For="@(() => createUpdatePackage.DurationOfPackage)"
                        Variant="Variant.Text"
                        Min="1"
                        HideSpinButtons="true"
                        Required="true"
                        RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                        Class="w-100"
                        Label=@L["PackageDuration"] />
                    </MudItem>
                    @if (CurrentTenant.Id == null)
                    {
                        <MudItem sm="6">
                            <MudSelect T="int"
                            Variant="Variant.Text"
                            Label=@L["Organizations"]
                            Placeholder=@L["Choose"]
                            HelperText=@L["Helper Text"]
                            Required
                            RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                            @bind-Value="createUpdatePackage.OrganizationId">
                                <MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
                                @foreach (var organization in _organizations)
                                {
                                    if (organization.Status != Enums.Status.Active)
                                        continue;


                                    if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="organization.Id">@organization.EnglishName</MudSelectItem>
                                    }
                                    else
                                    {
                                        <MudSelectItem Value="organization.Id">@organization.ArabicName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </MudItem>



                    }


                    <MudItem sm="6" md="6">
                        <MudSelect @bind-Value="@createUpdatePackage.PackageTypeId" Label="@L["PackageType"]" HelperText=@L["Helper Text"] Placeholder=@L["Choose"] Required>
                            <MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
                            @foreach (var type in packageTypes)
                            {
                                <MudSelectItem T="int" Value="@type.Id">
                                    @type.EnglishName
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudSelect @bind-Value="CustomerCategory"
                        Label="@L["customer category"]"
                        Placeholder="@L[ "Choose"]"
                        HelperText=@L["Helper Text"]
                        RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                        Required>
                            @foreach (var category in Enum.GetValues(typeof(CustomerCategoryStatus)).Cast<CustomerCategoryStatus>())
                            {
                                <MudSelectItem Value="@category.ToString()">

                                    @category.ToString()
                                </MudSelectItem>
                            }
                        </MudSelect>

                    </MudItem>
                    <MudItem sm="4">
                        <MudSwitch 
                        T="bool"
                        @bind-Value="createUpdatePackage.Published"
                        Label="@L["Published"]"
                        LabelPosition="LabelPosition.Start"
                        Color="MudBlazor.Color.Primary" />
                    </MudItem>
                    @if(createUpdatePackage.Published == false)
                    {


                        <MudItem sm="4" md="4">
                            <MudTimePicker Variant="Variant.Text"
                            Class="w-100"
                            Required="!createUpdatePackage.Published" 
                            RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                            TimeChanged="OnTimeFromChanged"
                            PickerVariant="PickerVariant.Dialog"
                            Placeholder=@L["Time Placeholder"]
                            Label="@L["Publish From"]" />
                        </MudItem>

                        <MudItem sm="4" md="4">
                            <MudTimePicker Variant="Variant.Text"
                            Class="w-100"
                            Required="!createUpdatePackage.Published"
                            PickerVariant="PickerVariant.Dialog"
                            RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                            TimeChanged="OnTimeToChanged"
                            Placeholder=@L["Time Placeholder"]
                            Label="@L["Publish To"]" />
                        </MudItem>


                    }

                    <MudItem sm="12">
                        <MudTextField @bind-Value="createUpdatePackage.Description"
                        For="@(() => createUpdatePackage.Description)"
                        Variant="Variant.Outlined"
                        Class="w-100"
                        Required="true"
                        RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                        Lines="5"
                        Placeholder=@L["Type Here"]
                        Label="@L["Description"]" />

                    </MudItem>


                </MudGrid>
            </MudForm>

        </DialogContent>
       <DialogActions>
    <DialogActionComponent 
        ButtonOneColor="MudBlazor.Color.Dark" 
        ButtonTwoColor="MudBlazor.Color.Primary" 
        ButtonOneLabel="@L["Back"]" 
        ButtonTwoLabel="@L["SaveAsDraft"]" 
        ButtonOneClick="Cancel" 
        ButtonTwoClick="Submit" 
        ButtonOneVariant="MudBlazor.Variant.Filled" 
        ButtonTwoVariant="MudBlazor.Variant.Filled" />
</DialogActions>


    </MudDialog>

</div>

<style>
    .mud-modal 
    {
    border-radius: 0 20px 0 20px;
    }
</style>

@code 
{
    [Inject] ISnackbar Snackbar { get; set; }
    [Inject] IPackagesAppService PackagesAppService { get; set; } // Assuming you have a service to handle the camera creation

    private MudForm form;
    private CreateUpdatePackageDto createUpdatePackage = new CreateUpdatePackageDto();
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }
    bool _clearable;
    private List<PackageTypeDto> packageTypes = new List<PackageTypeDto>();
    private List<OrganizationDto> _organizations = new List<OrganizationDto>();
    private TimeSpan? timeSpanFrom;
    private TimeSpan? timeSpanTo;
    private string CustomerCategory { get; set; }
    protected override async Task OnInitializedAsync()
    {
        var organizationsList = await organizationAppService.GetListAsync(new PagedAndSortedResultRequestDto());
        _organizations = organizationsList.Items.ToList();
        var packageTypesList = await packageTypesAppService.GetAllListAsync();
        packageTypes = packageTypesList;
        timeSpanFrom = createUpdatePackage.PublishFrom.ToTimeSpan();
        timeSpanTo = createUpdatePackage.PublishTo.ToTimeSpan();
        await base.OnInitializedAsync();
    }
    private void OnTimeFromChanged(TimeSpan? value)
    {
        if (value.HasValue)
        {
            timeSpanFrom = value;
            createUpdatePackage.PublishFrom = TimeOnly.FromTimeSpan(value.Value);
        }
        else
        {
            createUpdatePackage.PublishFrom = new TimeOnly(0,0,0);
        }
    }
    private void OnTimeToChanged(TimeSpan? value)
    {
        // Handle null case and update CreateUpdatePackage.PublishTo
        if (value.HasValue)
        {
            timeSpanTo = value;
            createUpdatePackage.PublishTo = TimeOnly.FromTimeSpan(value.Value);
        }
        else
        {
            createUpdatePackage.PublishTo = new TimeOnly(0,0,0);
        }
    }

    private async Task Submit()
    {
        createUpdatePackage.CustomerCategory = (CustomerCategoryStatus)Enum.Parse(typeof(CustomerCategoryStatus), CustomerCategory);
        if (CurrentTenant.Id != null)
        {
            createUpdatePackage.OrganizationId = await organizationAppService.GetOrganizationIdByTenant(CurrentTenant.Id);
        }
        else{
            createUpdatePackage.TenantId = _organizations.FirstOrDefault(x => x.Id == createUpdatePackage.OrganizationId).TenantId;
        }
        try
        {
            createUpdatePackage.Published = createUpdatePackage.Published || PackageValidations.CheckPackageTimeValiditity(createUpdatePackage.PublishFrom, createUpdatePackage.PublishTo);

            createUpdatePackage.TenantId = CurrentTenant.Id;
            createUpdatePackage.ActivationDate = DateTime.Now;
            createUpdatePackage.PackageStatus = SubscriptionStatus.Draft;
            createUpdatePackage.Status = Status.Inactive;
            await PackagesAppService.CreateAsync(createUpdatePackage);
            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.SUCCESS]} {L[AlertMessages.AlertMessages.ADD]} {createUpdatePackage.ArabicName}", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                await Task.Delay(1000);
                NavigationManager.NavigateTo("/package", true);
            }
        catch (AbpValidationException validationException)
        {
            foreach (var validationError in validationException.ValidationErrors)
            {
                SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.VAlIDATION_ERROR]}: {L[validationError.MemberNames.First()]} - {validationError.ErrorMessage}", Severity.Error);
            }
        }
        catch (BusinessException ex)
        {

            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]} {L[AlertMessages.AlertMessages.ADD]} : {ex.Message}", Severity.Error);
        }
       
        catch (Exception ex)
        {

            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]} {L[AlertMessages.AlertMessages.ADD]} : {ex.Message} ", Severity.Error);
        }


        

    }
    private void Cancel()
    {
        MudDialog.Cancel();
    }

   
}
