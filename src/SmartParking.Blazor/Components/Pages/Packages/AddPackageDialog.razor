@using SmartParking.Lookups
@using SmartParking.Packages
@using SmartParking.Organizations
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Validation

@inject IPackagesAppService packagesAppService
@inject IOrganizationsAppService organizationAppService
@inject IPackageTypesAppService packageTypesAppService
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@inject ICurrentTenant CurrentTenant
<PageTitle>@L["New Package"]</PageTitle>
<div class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["New Package"]</MudText>
        </TitleContent>
        <DialogContent>

            <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                <MudGrid>
                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="createUpdatePackage.ArabicName"
                                      For="@(() => createUpdatePackage.ArabicName)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Placeholder=@L["Type Here"]
                                      Required
                                      Label=@L["ArabicName"] />
                    </MudItem>
                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="createUpdatePackage.EnglishName"
                                      For="@(() => createUpdatePackage.EnglishName)"
                                      Variant="Variant.Text"
                                      Required
                                      Class="w-100"
                                      Placeholder=@L["Type Here"]
                                      Label=@L["EnglishName"] />
                    </MudItem>
                    <MudItem sm="4" md="4">
                        <MudNumericField @bind-Value="createUpdatePackage.Price"
                                      For="@(() => createUpdatePackage.Price)"
                                      Variant="Variant.Text"
                                         Min="1"
                                         HideSpinButtons="true"
                                      Required
                                      Class="w-100"
                                      Label=@L["Price"] />
                    </MudItem>


                
                    <MudItem sm="4" md="4">
                        <MudSelect @bind-Value="@createUpdatePackage.PackageTypeId" Label="@L["Package Type"]" HelperText=@L["Helper Text"] Placeholder=@L["Choose"] Required>

                            @foreach (var type in packageTypes)
                            {
                                <MudSelectItem T="int" Value="@type.Id">
                                    @type.EnglishName
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem sm="4" md="4">
                        <MudTimePicker Variant="Variant.Text"
                                       Class="w-100"
                                       Required
                                       TimeChanged="OnTimeFromChanged"
                                       Placeholder=@L["Time Placeholder"]
                                       Label="@L["Publish From"]" />
                    </MudItem>

                    <MudItem sm="4" md="4">
                        <MudTimePicker Variant="Variant.Text"
                                       Class="w-100"
                                       Required
                                       TimeChanged="OnTimeToChanged"
                                       Placeholder=@L["Time Placeholder"]
                                       Label="@L["Publish To"]" />
                    </MudItem>
                    <MudItem sm="4">
                        <MudSwitch Label="@L["Published"]"
                                   LabelPosition="LabelPosition.Start"
                                   @bind-Value="createUpdatePackage.published"
                                   Color="MudBlazor.Color.Primary" />
                    </MudItem>
                    <MudItem sm="12">
                        <MudTextField @bind-Value="createUpdatePackage.Description"
                                      For="@(() => createUpdatePackage.Description)"
                                      Variant="Variant.Outlined"
                                      Class="w-100"
                                      Required
                                      Lines="5"
                                      Placeholder=@L["Type Here"]
                                      Label="@L["Description"]" />

                    </MudItem>

                    <MudItem sm="12" md="12" Class="d-inline-flex justify-content-center">
                        <div Class="d-flex flex-row justify-content-between">
                            <MudRadioGroup @bind-Value="@createUpdatePackage.Status" Class="d-inline-flex align-content-center">
                                <MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">@L["Status Active"]</MudRadio>
                                <MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Secondary">@L["Status InActive"]</MudRadio>
                            </MudRadioGroup>
                        </div>
                    </MudItem>



                </MudGrid>
            </MudForm>

        </DialogContent>
        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" Disabled="@(form == null || !form.IsValid)" OnClick="Submit">@L["Create"]</MudButton>
        </DialogActions>

    </MudDialog>

</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>

@code {
    [Inject] ISnackbar Snackbar { get; set; }
    [Inject] IPackagesAppService PackagesAppService { get; set; } // Assuming you have a service to handle the camera creation

    private MudForm form;
    private CreateUpdatePackageDto createUpdatePackage = new CreateUpdatePackageDto();
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }
    bool _clearable;
    //private List<OrganizationDto> organizations = new List<OrganizationDto>();
    private List<PackageTypeDto> packageTypes = new List<PackageTypeDto>();
    private TimeSpan? timeSpanFrom;
    private TimeSpan? timeSpanTo;
    //public List<PackageDto> Garages { get; set; } = new List<GarageDto>();

    protected override async Task OnInitializedAsync()
    {
        var organizationsList = await organizationAppService.GetListAsync(new PagedAndSortedResultRequestDto());
        //organizations = organizationsList.Items.ToList();
        var packageTypesList = await packageTypesAppService.GetListAsync(new PagedAndSortedResultRequestDto());
        packageTypes = packageTypesList.Items.ToList();
        timeSpanFrom = createUpdatePackage.PublishFrom.ToTimeSpan();
        timeSpanTo = createUpdatePackage.PublishTo.ToTimeSpan();
        await base.OnInitializedAsync();
    }
    private void OnTimeFromChanged(TimeSpan? value)
    {
        // Handle null case and update CreateUpdatePackage.PublishFrom
        if (value.HasValue)
        {
            timeSpanFrom = value;
            createUpdatePackage.PublishFrom = TimeOnly.FromTimeSpan(value.Value);
        }
    }
    private void OnTimeToChanged(TimeSpan? value)
    {
        // Handle null case and update CreateUpdatePackage.PublishTo
        if (value.HasValue)
        {
            timeSpanTo = value;
            createUpdatePackage.PublishTo = TimeOnly.FromTimeSpan(value.Value);
        }
    }
    private async Task Submit()
    {
        var currentTenant = CurrentTenant.Id;
        createUpdatePackage.OrganizationId =await organizationAppService.GetOrganizationIdByTenant(currentTenant);
        var successedMessage = L["PackageCreatedSuccessfully"];
        var errorMessage = L["FillRequriedItems"];
        var validationErrorMessage = L["PleaseFixTheValidationErrors"];
        if (form.IsValid)
        {
            // Call your service to create the camera
            try
            {
                await PackagesAppService.CreateAsync(createUpdatePackage);
                Snackbar.Add(successedMessage, Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                await Task.Delay(1000);
                Navigation.NavigateTo("/packages", true);
            }
            catch (AbpValidationException ex)
            {
                foreach (var validationError in ex.ValidationErrors)
                {
                    Snackbar.Add($"{validationError.MemberNames.First()}: {validationError.ErrorMessage}", Severity.Error);
                }
            }
            catch (Exception e)
            {
                Snackbar.Add(errorMessage, Severity.Error);
                return;
            }


        }
        else
        {
            Snackbar.Add(validationErrorMessage, Severity.Error);
        }
    }
    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
