@using SmartParking.Lookups
@using SmartParking.Packages
@using SmartParking.Organizations
@using Microsoft.Extensions.Localization
@using SmartParking.Localization

@inject ISnackbar Snackbar
@inject IPackagesAppService packagesAppService
@inject IOrganizationsAppService organizationAppService
@inject IPackageTypesAppService packageTypesAppService
@inject IStringLocalizer<SmartParkingResource> L

<div class="modal-wrapper">
    <MudDialog Class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">New Package</MudText>
        </TitleContent>
        <DialogContent>
            <MudGrid>
                <MudItem Class="w-100">
                    <MudForm Model="createUpdatePackage" Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-120 h-120 main-layout-paper">
                        <MudGrid>
                            <MudItem sm="4" md="4">
                                <MudTextField @bind-Value="createUpdatePackage.ArabicName"
                                              For="@(() => createUpdatePackage.ArabicName)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              Label="@L["Arabic Name"]" />
                            </MudItem>
                            <MudItem sm="4" md="4">
                                <MudTextField @bind-Value="createUpdatePackage.EnglishName"
                                              For="@(() => createUpdatePackage.EnglishName)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              Label="@L["English Name"]" />
                            </MudItem>
                            <MudItem sm="4" md="4">
                                <MudTextField @bind-Value="createUpdatePackage.Price"
                                              For="@(() => createUpdatePackage.Price)"
                                              Variant="Variant.Text"
                                              Class="w-100"
                                              Label="@L["Price"]" />
                            </MudItem>


                            <MudItem sm="4" md="4">
                                <MudSelect @bind-Value="@createUpdatePackage.OrgnizationId" Label="@L["Organizations"]" Placeholder="Please Select">

                                    @foreach (var organization in organizations)
                                    {
                                        <MudSelectItem T="int" Value="@organization.Id">
                                            @organization.EnglishName
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem sm="4" md="4">
                                <MudSelect @bind-Value="@createUpdatePackage.PackageTypeId" Label="@L["Package Type"]" Placeholder="Please Select">

                                    @foreach (var type in packageTypes)
                                    {
                                        <MudSelectItem T="int" Value="@type.Id">
                                            @type.EnglishName
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem sm="4" md="4">
                                <MudTimePicker Variant="Variant.Text"
                                               Class="w-100"
                                               TimeChanged="OnTimeFromChanged"
                                               Label="@L["Publish From"]" />
                            </MudItem>

                            <MudItem sm="4" md="4">
                                <MudTimePicker Variant="Variant.Text"
                                               Class="w-100"
                                               TimeChanged="OnTimeToChanged"
                                               Label="@L["Publish To"]" />
                            </MudItem>
                            <MudItem sm="4">
                                <MudSwitch Label="@L["published"]"
                                           LabelPosition="LabelPosition.Start"
                                           Placeholder="@L["published"]"
                                           @bind-Value="createUpdatePackage.published"
                                           Color="MudBlazor.Color.Primary" />
                            </MudItem>
                            <MudItem sm="12">
                                <MudTextField @bind-Value="createUpdatePackage.Description"
                                              For="@(() => createUpdatePackage.Description)"
                                              Variant="Variant.Outlined"
                                              Class="w-100"
                                              Lines="5"
                                              Label="@L["Description"]" />

                            </MudItem>

                            <MudItem sm="12" md="12" Class="d-inline-flex justify-content-center">
                                <div Class="d-flex flex-row justify-content-between">
                                    <MudRadioGroup @bind-Value="@createUpdatePackage.Status" Class="d-inline-flex align-content-center">
                                        <MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">Active</MudRadio>
                                        <MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Secondary">InActive</MudRadio>
                                    </MudRadioGroup>
                                </div>
                            </MudItem>
                        </MudGrid>
                    </MudForm>
                </MudItem>
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudGrid Class="ps-lg-7">

                <MudItem sm="6" md="6">

                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="@(() =>  SubmitCreate())">Create</MudButton>
                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Tertiary" OnClick="@( () => CancelCreate())">Cancel</MudButton>

                </MudItem>

            </MudGrid>
        </DialogActions>
    </MudDialog>
</div>



<style>

    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>
