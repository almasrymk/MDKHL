@using Microsoft.Extensions.Localization
@using SmartParking.Packages
@using SmartParking.Localization
@inject IPackagesAppService PackagesAppService
@inject IDialogService Dialog
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@page "/packages"


<h3>@L["Packages"]</h3>

<SPDataGrid PageName="packages" Data="@itemData" TotalItemsInTable="TotalItem" OnFiltering="HandleFilter" OnClickRowEdit="OnClickRowEdit" OnClickRowView="OnClickRowView" OnPageChanged="FetchTableData" OnSearching="HandleSearch" OnAdd="@(() => OpenDialogAsync(_backdropClick))" OnClickRowDelete="OnClickRowDelete"></SPDataGrid>

