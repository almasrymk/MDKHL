@using Microsoft.Extensions.Localization
@using SmartParking.Packages
@using SmartParking.Localization
@inject IPackagesAppService PackagesAppService
@inject IDialogService Dialog
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@page "/packages"

<PageTitle>@L["Packages"]</PageTitle>

<MudText Typo="Typo.h5" Class="mb-2">@L["Packages"]</MudText>

<SPDataGrid PageName=@L["Packages"] Data="@itemData" TotalItemsInTable="TotalItem" OnFiltering="HandleFilter" OnClickRowEdit="OnClickRowEdit" OnClickRowView="OnClickRowView" OnPageChanged="FetchTableData" OnSearching="HandleSearch" OnAdd="@(() => OpenDialogAsync(_backdropClick))" OnClickRowDelete="OnClickRowDelete"></SPDataGrid>

