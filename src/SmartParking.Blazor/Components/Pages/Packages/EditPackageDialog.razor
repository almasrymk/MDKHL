@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Enums
@using SmartParking.Localization
@using SmartParking.Packages
@using System.Globalization
@using System.Security.Authentication
@using SmartParking.Validations
@using Volo.Abp
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Validation
@inject IPackagesAppService PackagesAppService
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ICurrentTenant CurrentTenant


<PageTitle>@L["Edit Package"]</PageTitle>
<div class="modal-wrapper">
    <MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Edit"] </MudText>
        </TitleContent>
        <DialogContent>


            <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                <MudGrid>
                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="Package.ArabicName"
                        For="@(() => Package.ArabicName)"
                        Variant="Variant.Text"
                        Class="w-100"
                        Label="@L["ArabicName"]" />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="Package.EnglishName"
                        For="@(() => Package.EnglishName)"
                        Variant="Variant.Text"
                        Class="w-100"
                        Label="@L["EnglishName"]" />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudNumericField @bind-Value="Package.Price"
                        For="@(() => Package.Price)"
                                         Variant="Variant.Text"
                                         Min="0"
                                         HideSpinButtons="true"
                                         Required="true"
                                         RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                                         Class="w-100"
                        Label="@L["Price"]" />
                    </MudItem>

                    <MudItem sm="6" md="6">
                        <MudNumericField @bind-Value="Package.DurationOfPackage"
                        For="@(() => Package.DurationOfPackage)"
                        Variant="Variant.Text"
                        Min="1"
                        HideSpinButtons="true"
                        Required
                        Class="w-100"
                        Label=@L["PackageDuration"] />
                    </MudItem>

                    <MudItem sm="6" md="6">
                        <MudSelect @bind-Value="Package.CustomerCategory"
                        Label="@L["customer category"]"
                        Placeholder="@L[ "Choose"]"
                        HelperText=@L["Helper Text"]
                        Required>

                            @foreach (var category in Enum.GetValues(typeof(CustomerCategoryStatus)).Cast<CustomerCategoryStatus>())
                            {
                                <MudSelectItem Value="@category">

                                    @category.ToString()
                                </MudSelectItem>
                            }
                        </MudSelect>

                    </MudItem>
                    @if (Package.Status == Enums.Status.Active)
                    {
                        <MudItem sm="6" md="6">
                            <MudDatePicker Variant="Variant.Text"
                            Class="w-100"
                            @bind-Date="ActivationDate"
                            Disabled
                            Label="@L["ActivationDate"]" />
                        </MudItem>
                    }

                    @if (Package.Status == Enums.Status.Inactive)
                    {
                        <MudItem sm="6" md="6">
                            <MudDatePicker Variant="Variant.Text"
                            Class="w-100"
                            @bind-Date="DectivationDate"
                            Disabled
                            Label="@L["DectivationDate"]" />
                        </MudItem>
                    }

                    <MudItem sm="4">
                        <MudSwitch Label="@L["Published"]"
                        LabelPosition="LabelPosition.Start"
                        @bind-Value="Package.Published"

                        Color="MudBlazor.Color.Primary" />
                    </MudItem>

                    @if(Package.Published == false)
                    {
                        <MudItem sm="4" md="4">
                            <MudTimePicker Variant="Variant.Text"
                            Class="w-100"
                            Time="timeSpanFrom"
                            Required="@(Package.Published == false)"
                            TimeChanged="OnTimeFromChanged"
                            Label="@L["Publish From"]"
                            ShowToolbar="false"

                            />
                        </MudItem>

                        <MudItem sm="4" md="4">
                            <MudTimePicker Variant="Variant.Text"
                            Class="w-100"
                            Time="timeSpanTo"
                            Required="@(Package.Published == false)"
                            TimeChanged="OnTimeToChanged"
                            Label="@L["Publish To"]"
                            ShowToolbar="false"
                            />
                        </MudItem>
                    }
                    <MudItem sm="12">
                        <MudTextField @bind-Value="Package.Description"
                        For="@(() => Package.Description)"
                        Variant="Variant.Outlined"
                        Class="w-100"
                        Lines="5"
                        Label="@L["Description"]" />

                    </MudItem>
                    <MudItem sm="12" md="12" Class="d-flex justify-content-between">
                        <MudRadioGroup @bind-Value="@Package.Status" Class="d-flex">
                            <MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">@L["Status Active"]</MudRadio>
                            <MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Secondary">@L["Status InActive"]</MudRadio>
                        </MudRadioGroup>
                    </MudItem>
                </MudGrid>
            </MudForm>



        </DialogContent>
        <DialogActions>
            <MudItem sm="12">

            	<div class="d-flex justify-content-between align-items-center">
                    <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="CancelEdit">@L["Back"]</MudButton>
                    <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="SubmitEdit">@L["Save"]</MudButton>
                </div>
            </MudItem>
        </DialogActions>

    </MudDialog>

</div>

<style>
    .mud-modal {
    border-radius: 0 20px 0 20px;
    }
</style>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialogAdd { get; set; }
    [Parameter] public CreateUpdatePackageDto Package { get; set; }
    [Parameter]
    public int UpdatedId { get; set; }


    public DateTime? ActivationDate { get; set; } = DateTime.Now;

    bool _clearable;
    private MudForm form;
    private TimeSpan? timeSpanFrom;
    private TimeSpan? timeSpanTo;
    private DateTime? DectivationDate { get; set; } = DateTime.Now;
    private Status currentStatus { get; set; }


    protected override async Task OnInitializedAsync()
    {
        currentStatus = Package.Status;
        timeSpanFrom = Package.PublishFrom.ToTimeSpan();
        timeSpanTo = Package.PublishTo.ToTimeSpan();
        await base.OnInitializedAsync();
    }
    private void OnTimeFromChanged(TimeSpan? value)
    {
        if (value.HasValue)
        {
            timeSpanFrom = value;
            Package.PublishFrom = TimeOnly.FromTimeSpan(value.Value);
        }
    }
    private void OnTimeToChanged(TimeSpan? value)
    {
        if (value.HasValue)
        {
            timeSpanTo = value;
            Package.PublishTo = TimeOnly.FromTimeSpan(value.Value);
        }
    }
    private async Task SubmitEdit()
    {

        try
        {
            Package.TenantId = CurrentTenant.Id;
            Package.Published = Package.Published|| PackageValidations.CheckPackageTimeValiditity(Package.PublishFrom, Package.PublishTo);
          
            await PackagesAppService.UpdateAsync(UpdatedId, Package);
            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.SUCCESS]} {L[AlertMessages.AlertMessages.UPDATE]} {Package.EnglishName}", Severity.Success);
            MudDialogAdd.Close(DialogResult.Ok(true));
            await Task.Delay(1000);
            Navigation.NavigateTo("/package", true);
        }
        catch (AbpValidationException validationException)
        {
            foreach (var validationError in validationException.ValidationErrors)
            {
                SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.VAlIDATION_ERROR]}: {L[validationError.MemberNames.First()]} - {validationError.ErrorMessage}", Severity.Error);
            }
        }
        catch (BusinessException ex)
        {

            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.UPDATE]} {L[AlertMessages.AlertMessages.FAILED]}: {ex.Code}", Severity.Error);
        }
        catch (AuthenticationException ex)
        {
            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.UPDATE]} {L[AlertMessages.AlertMessages.FAILED]}: {ex.Message} ", Severity.Error);
        }
        catch (Exception ex)
        {

            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.UPDATE]} {L[AlertMessages.AlertMessages.FAILED]} : {ex.Message} ", Severity.Error);
        }
	}

	private async Task CancelEdit()
	{
	    	MudDialogAdd.Cancel();
	}


}
