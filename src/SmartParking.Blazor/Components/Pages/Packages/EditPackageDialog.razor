@using Microsoft.Extensions.Localization
@using SmartParking.Enums
@using SmartParking.Localization
@using SmartParking.Packages
@using System.Globalization
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Validation
@inject IPackagesAppService PackagesAppService
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ICurrentTenant CurrentTenant


<PageTitle>@L["Edit Package"]</PageTitle>
<div class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
            @if (CultureInfo.CurrentCulture.Name == "en")
            {
                <MudText Typo="Typo.h6">@L["Edit"] @Package.EnglishName</MudText>

            }
            else
            {
                <MudText Typo="Typo.h6">@L["Edit"] @Package.ArabicName</MudText>

            }
        </TitleContent>
		<DialogContent>


			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>
                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="Package.ArabicName"
                                      For="@(() => Package.ArabicName)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Label="@L["ArabicName"]" />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="Package.EnglishName"
                                      For="@(() => Package.EnglishName)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Label="@L["EnglishName"]" />
                    </MudItem>
                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="Package.Price"
                                      For="@(() => Package.Price)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Label="@L["Price"]" />
                    </MudItem>

                    <MudItem sm="6" md="6">
                        <MudNumericField @bind-Value="Package.DurationOfPackage"
                                         For="@(() => Package.DurationOfPackage)"
                                         Variant="Variant.Text"
                                         Min="1"
                                         HideSpinButtons="true"
                                         Required
                                         Class="w-100"
                                         Label=@L["PackageDuration"] />
                    </MudItem>
                   
                    <MudItem sm="6" md="6">
                        <MudSelect @bind-Value="Package.CustomerCategory"
                                   Label="@L["customer category"]"
                                   Placeholder="@L[ "Choose"]"
                                   HelperText=@L["Helper Text"]
                                   Required
                                   MultiSelection="true"
                                   SelectAllText="Select All"
                                   SelectAll="true">

                            @foreach (var category in Enum.GetValues(typeof(CustomerCategoryStatus)).Cast<CustomerCategoryStatus>())
                            {
                                <MudSelectItem Value="@category">

                                    @category.ToString()
                                </MudSelectItem>
                            }
                        </MudSelect>

                    </MudItem>
                    @if (Package.PackageStatus == SubscriptionStatus.Active)
                    {
                        <MudItem sm="6" md="6">
                            <MudDatePicker Variant="Variant.Text"
                                           Class="w-100"
                                           @bind-Date="ActivationDate"
                                           Disabled
                                           Label="@L["ActivationDate"]" />
                        </MudItem>
                    }

                    @if (Package.PackageStatus == SubscriptionStatus.Inactive)
                    {
                        <MudItem sm="6" md="6">
                            <MudDatePicker Variant="Variant.Text"
                                           Class="w-100"
                                           @bind-Date="DectivationDate"
                                           Disabled
                                           Label="@L["DectivationDate"]" />
                        </MudItem>
                    }

                    <MudItem sm="4">
                          <MudSwitch Label="@L["Published"]"
                                       LabelPosition="LabelPosition.Start"
                                       @bind-Value="Package.Published"
                                       
                                       Color="MudBlazor.Color.Primary" />
                    </MudItem>
                    
                   @if(Package.Published == false)
                   {
                      <MudItem sm="4" md="4">
                            <MudTimePicker Variant="Variant.Text"
                                           Class="w-100"
                                           @bind-Time="timeSpanFrom"
                                           Label="@L["Publish From"]" 
                                           ShowToolbar="false"
                                          
                                           />
                      </MudItem>

                      <MudItem sm="4" md="4">
                            <MudTimePicker Variant="Variant.Text"
                                           Class="w-100"
                                           @bind-Time="timeSpanTo"
                                           Label="@L["Publish To"]"
                                           ShowToolbar="false"
                                            />
                        </MudItem>
                   }

                    <MudItem sm="4" md="4">
                        <MudTextField @bind-Value="Package.OrganizationId"
                                      For="@(() => Package.OrganizationId)"
                                      Variant="Variant.Text"
                                      Class="w-100"
                                      Disabled='true'
                                      Label="@L["OrgnizationId"]" />
                    </MudItem>

                    <MudItem sm="12">
                        <MudTextField @bind-Value="Package.Description"
                                      For="@(() => Package.Description)"
                                      Variant="Variant.Outlined"
                                      Class="w-100"
                                      Lines="5"
                                      Disabled='true'
                                      Label="@L["Description"]" />

                    </MudItem>
                    <MudItem sm="12" md="12" Class="d-flex justify-content-between">

                        <MudRadioGroup @bind-Value="@Package.PackageStatus" Class="d-flex">
                            <MudRadio Value="@(Enums.SubscriptionStatus.Active)" Color="MudBlazor.Color.Primary">@L["Status Active"]</MudRadio>
                            <MudRadio Value="@(Enums.SubscriptionStatus.Inactive)" Color="MudBlazor.Color.Secondary">@L["Status InActive"]</MudRadio>
                        </MudRadioGroup>
                    </MudItem>
				</MudGrid>
			</MudForm>



		</DialogContent>
        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="CancelEdit">@L["Back"]</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="SubmitEdit">@L["Save"]</MudButton>
        </DialogActions>

	</MudDialog>

</div>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialogAdd { get; set; }
    [Parameter] public CreateUpdatePackageDto Package { get; set; }
    [Parameter]
    public int UpdatedId { get; set; }
    [Parameter]
    public DateTime? ActivationDate { get; set; }

    bool _clearable;
    private MudForm form;
    private TimeSpan? timeSpanFrom;
    private TimeSpan? timeSpanTo;
    private DateTime? DectivationDate { get; set; } = DateTime.Now;


    protected override async Task OnInitializedAsync()
    {
        timeSpanFrom = Package.PublishFrom.ToTimeSpan();
        timeSpanTo = Package.PublishTo.ToTimeSpan();
        await base.OnInitializedAsync();
    }
    private void OnTimeFromChanged(TimeSpan? value)
    {
        if (value.HasValue)
        {
            timeSpanFrom = value;
            Package.PublishFrom = TimeOnly.FromTimeSpan(value.Value);
        }
    }
    private void OnTimeToChanged(TimeSpan? value)
    {
        if (value.HasValue)
        {
            timeSpanTo = value;
            Package.PublishTo = TimeOnly.FromTimeSpan(value.Value);
        }
    }
    private async Task SubmitEdit()
    {
        var successedMessage = L["PackageUpdatedSuccessfully"];

        try
        {
            Package.TenantId = CurrentTenant.Id;
            await PackagesAppService.UpdateAsync(UpdatedId, Package);
            Snackbar.Add(successedMessage, Severity.Success);
            MudDialogAdd.Close(DialogResult.Ok(true));
            await Task.Delay(1000);
            Navigation.NavigateTo("/package", true);
        }
        catch (AbpValidationException ex)
        {
            foreach (var validationError in ex.ValidationErrors)
            {
                Snackbar.Add($"{validationError.MemberNames.First()}: {validationError.ErrorMessage}", Severity.Error);
            }
        }
        catch (Exception e)
		{
			Snackbar.Add(e.Message, Severity.Error);
		}
	}

	private async Task CancelEdit()
	{
	    	MudDialogAdd.Cancel();
	}


}
