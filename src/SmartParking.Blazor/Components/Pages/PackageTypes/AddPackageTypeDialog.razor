@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.Governorate
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@inject IPackageTypesAppService PackageTypesAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
<PageTitle>@L["AddPackageTypes"]</PageTitle>
@inject NavigationManager Navigation
<MudItem class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
                <MudText Typo="Typo.h6">@L["NewPackageType"]</MudText>
        </TitleContent>
        <DialogContent>


            <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                <MudGrid>
                    <MudItem sm="6" >
                        <MudTextField @bind-Value="input.ArabicName"
                                      For="@(() => input.ArabicName)"
                                      Immediate="true"
                                      Required
                                      Variant="Variant.Text"
                                      InputType="InputType.Text"
                                      Placeholder=@L["Type Here"]
                                      Label=@L["Arabic Name"] />
                    </MudItem>

                    <MudItem sm="6">
                        <MudTextField @bind-Value="input.EnglishName"
                                      For="@(() => input.EnglishName)"
                                      Immediate="true"
                                      Required
                                      Variant="Variant.Text"
                                      InputType="InputType.Text"
                                      Placeholder=@L["Type Here"]
                                      Label=@L["English Name"] />
                    </MudItem>
                    
                    <MudItem sm="6">
                        <MudTextField @bind-Value="input.Notes"
                                      For="@(() => input.Notes)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                          InputType="InputType.Text"
                                      Placeholder=@L["Type Here"]
                                      Label=@L["Notes"] />
                    </MudItem>

                </MudGrid>
            </MudForm>

        </DialogContent>

        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" Disabled="@(form == null || !form.IsValid)" OnClick="Submit">@L["Create"]</MudButton>
        </DialogActions>
    </MudDialog>

</MudItem>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>

