@using SmartParking.Lookups
@using SmartParking.Lookups.Governorate
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@inject IPackageTypesAppService PackageTypesAppService
@inject ISnackbar Snackbar


<MudItem class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">New Country</MudText>
        </TitleContent>
        <DialogContent>


            <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                <MudGrid>
                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="input.ArabicName"
                                      For="@(() => input.ArabicName)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="ArabicName" />
                    </MudItem>

                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="input.EnglishName"
                                      For="@(() => input.EnglishName)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="EnglishName" />
                    </MudItem>
                    
                    <MudItem sm="6" md="6">
                        <MudTextField @bind-Value="input.Notes"
                                      For="@(() => input.Notes)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="Notes" />
                    </MudItem>

                </MudGrid>
            </MudForm>

        </DialogContent>

        <DialogActions>
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Submit">Create</MudButton>
        </DialogActions>
    </MudDialog>

</MudItem>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>

@code {

    private MudForm form;
    public CreateUpdatePackageTypeDto input = new CreateUpdatePackageTypeDto();

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }
    bool _clearable;


    private async Task Submit()
    {
        if (form.IsValid)
        {
            // Call your service to create the camera
            try
            {
                await PackageTypesAppService.CreateAsync(input);
            }
            catch (UserFriendlyException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
                return;
            }
            Snackbar.Add("Package Type created successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));

        }
        else
        {
            Snackbar.Add("Please fix the validation errors.", Severity.Error);
        }
    }
    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
