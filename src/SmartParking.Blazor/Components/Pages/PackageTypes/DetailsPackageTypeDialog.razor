@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.Governorate
@using Volo.Abp.Application.Dtos
@inject IPackageTypesAppService PackageTypesAppService
@inject IStringLocalizer<SmartParkingResource> L
<PageTitle>@L["PackageTypesDetails"]</PageTitle>

<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
				<MudText Typo="Typo.h6">@L["PackageTypeDetails"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
				<MudGrid>
					<MudItem sm="6">
						<MudTextField @bind-Value="packageType.ArabicName"
									  For="@(() => packageType.ArabicName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label=@L["Arabic Name"]
									  Disabled/>
					</MudItem>

					<MudItem sm="6">
						<MudTextField @bind-Value="packageType.EnglishName"
									  For="@(() => packageType.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label=@L["English Name"]
									  Disabled/>
					</MudItem>

					

				</MudGrid>
			</MudForm>



		</DialogContent>

		<DialogActions>
				<MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
		</DialogActions>
	</MudDialog>

</MudItem>



<style>
	.mud-modal 
	{
		border-radius: 0 20px 0 20px;
	}
</style>

