@using SmartParking.Lookups
@using SmartParking.Lookups.Governorate
@using Volo.Abp.Application.Dtos
@inject IPackageTypesAppService PackageTypesAppService

<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">Update Country</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="editForm">
				<MudGrid>
					<MudItem sm="6">
						<MudTextField @bind-Value="packageType.ArabicName"
									  For="@(() => packageType.ArabicName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="ArabicName" 
									  Disabled/>
					</MudItem>

					<MudItem sm="6">
						<MudTextField @bind-Value="packageType.EnglishName"
									  For="@(() => packageType.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="EnglishName" 
									  Disabled/>
					</MudItem>

					

				</MudGrid>
			</MudForm>



		</DialogContent>

		<DialogActions>
			<MudButton OnClick="Cancel">Cancel</MudButton>
		</DialogActions>
	</MudDialog>

</MudItem>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>

@code {

	[CascadingParameter] MudDialogInstance MudDialog { get; set; }
	[Parameter] public PackageTypeDto packageType { get; set; } = new PackageTypeDto();
	private MudForm editForm;
	bool _clearable;

	private void Cancel()
	{
		MudDialog.Cancel();
	}
}

