@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.City
@using SmartParking.Lookups.Governorate
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@inject ICitiesAppService CitiesAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
<PageTitle>@L["Add Cities"]</PageTitle>

<MudItem class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">"@L["NewCity"]</MudText>
        </TitleContent>
        <DialogContent>


            <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                <MudGrid>
                    <MudItem sm="6" >
                        <MudTextField @bind-Value="input.ArabicName"
                                      For="@(() => input.ArabicName)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="@L["Arabic Name"]"
                                      Placeholder="@L["ُEnterYourArabicName"]" />
                    </MudItem>

                    <MudItem sm="6">
                        <MudTextField @bind-Value="input.EnglishName"
                                      For="@(() => input.EnglishName)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="@L["English Name"]"
                                      Placeholder="@L["EnterYourEnglishName"]" />
                    </MudItem>
                    
                    <MudItem sm="6" >
                        <MudTextField @bind-Value="input.Notes"
                                      For="@(() => input.Notes)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="@L["Notes"]"
                                      Placeholder="@L["EnterYourNotes"]" />
                    </MudItem>
                    <GovernorateLookUps SelectValueChanged="SelectGovernment"></GovernorateLookUps>
                </MudGrid>
            </MudForm>

        </DialogContent>

        <DialogActions>
            <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Submit">@L["Create"]</MudButton>
        </DialogActions>
    </MudDialog>

</MudItem>


    @code {

    private MudForm form;
    public CreateUpdateCityDto input = new CreateUpdateCityDto();
    public IReadOnlyList<GovernorateLookupDto> cities = new List<GovernorateLookupDto>();
    private int GovernmentSelectValue { get; set; }

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }
    bool _clearable;


    private void SelectGovernment(int Government)
    {
        GovernmentSelectValue = Government;
    }
    protected override async Task OnInitializedAsync()
    {
        var result = await CitiesAppService.GetGovernorateLookupAsync();
        cities = result;
    }
    private async Task Submit()
    {
        var successedMessage = L["CityCreatedSuccessfully"];
        var errorMessage = L["PleaseFixTheValidationErrors"];

        if (form.IsValid)
        {
            // Call your service to create the camera
            try
            {
                CreateUpdateCityDto createUpdateCityDto = new CreateUpdateCityDto()
                {
                    ArabicName = input.ArabicName,
                    EnglishName = input.EnglishName,
                    Notes = input.Notes,
                    GovernorateId = GovernmentSelectValue
                };
                await CitiesAppService.CreateAsync(createUpdateCityDto);
            }
            catch (UserFriendlyException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
                return;
            }
            Snackbar.Add(successedMessage, Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));

        }
        else
        {
            Snackbar.Add(errorMessage, Severity.Error);
        }
    }
    private void Cancel()
    {
        MudDialog.Cancel();
    }
}



<style>
    .mud-modal 
    {
        border-radius: 0 20px 0 20px;
    }
</style>