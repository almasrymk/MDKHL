@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.City
@using SmartParking.Lookups.State
@using System.Globalization
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@inject ICitiesAppService CitiesAppService
@inject IStateAppService StateAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
<PageTitle>@L["Add Cities"]</PageTitle>

<MudItem class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">"@L["NewCity"]</MudText>
        </TitleContent>
        <DialogContent>


            <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                <MudGrid>
                    <MudItem sm="6" >
                        <MudTextField @bind-Value="input.ArabicName"
                                      For="@(() => input.ArabicName)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="@L["ArabicName"]"
                                      Placeholder="@L["Type Here"]" 
                                      Required
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>

                    <MudItem sm="6">
                        <MudTextField @bind-Value="input.EnglishName"
                                      For="@(() => input.EnglishName)"
                                      Immediate="true"
                                      Variant="Variant.Text"
                                      Label="@L["EnglishName"]"
                                      Placeholder="@L["Type Here"]" 
                                      Required
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>
                  
                    <MudItem sm="6">
                        <MudSelect Variant="Variant.Text"
                                   Label="@L["State"]"
                                   Placeholder="@L["Choose"]"
                                   Clearable="true"
                                   Required
                                   RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                                   @bind-Value="input.StateId">
                            <MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
                            @foreach (var state in states)
                            {
                                @if (CultureInfo.CurrentCulture.Name == "en")
                                {
                                    <MudSelectItem Value="state.Id">@state.EnglishName</MudSelectItem>
                                }
                                else
                                {
                                    <MudSelectItem Value="state.Id">@state.ArabicName</MudSelectItem>
                                }

                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </MudForm>

        </DialogContent>

        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Submit" >@L["Create"]</MudButton>
        </DialogActions>
    </MudDialog>

</MudItem>


<style>
    .mud-modal 
    {
        border-radius: 0 20px 0 20px;
    }
</style>