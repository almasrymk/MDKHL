@page "/cities"
@using Customs
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups
@using Volo.Abp.Application.Dtos
@inherits AbpCrudPageBase<ICitiesAppService, CityDto, int, PagedAndSortedResultRequestDto, CreateUpdateCityDto>
@inject IDialogService Dialog
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Mdkhl , admin")]

<PageTitle>@L["Cities"]</PageTitle>

<MudText Typo="Typo.h5" Class="mb-2">@L["Cities"]</MudText>

<SPDataGrid PageName=@L["Cities"] Data="@itemData" TotalItemsInTable="TotalItem" OnFiltering="HandleFilter" OnClickRowEdit="OnClickRowEdit" OnClickRowView="OnClickRowView" OnPageChanged="FetchTableData" OnSearching="HandleSearch" OnAdd="CreateCity" OnClickRowDelete="OnClickRowDelete">

</SPDataGrid>