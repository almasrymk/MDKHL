@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.City
@using SmartParking.Lookups.State
@using System.Globalization
@using Volo.Abp.Application.Dtos
@inject ICitiesAppService CitiesAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject IStateAppService StateAppService
@inject NavigationManager Navigation
<PageTitle>@L["UpdateCities"]</PageTitle>


<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			@if (CultureInfo.CurrentCulture.Name == "en")
			{
				<MudText Typo="Typo.h6">@L["Edit"] @city.EnglishName</MudText>

			}
			else
			{
				<MudText Typo="Typo.h6">@L["Edit"] @city.ArabicName</MudText>

			}
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="editForm">
				<MudGrid>
					<MudItem sm="6" >
						<MudTextField @bind-Value="city.ArabicName"
									  For="@(() => city.ArabicName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["ArabicName"]" />
					</MudItem>

					<MudItem sm="6" >
						<MudTextField @bind-Value="city.EnglishName"
									  For="@(() => city.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["EnglishName"]" />
					</MudItem>

						<StateLookups State="" SelectValueChanged="SelectState"></StateLookups>
				
					
				</MudGrid>
			</MudForm>
		</DialogContent>
		<DialogActions>
			<MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
			<MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="@(async () => await Save())">@L["Edit"]</MudButton>
		</DialogActions>

		
	</MudDialog>

</MudItem>



<style>
	.mud-modal 
	{
		border-radius: 0 20px 0 20px;
	}
</style>
