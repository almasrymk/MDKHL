@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Lookups
@using SmartParking.Lookups.City
@using Volo.Abp.Application.Dtos
@inject ICitiesAppService CitiesAppService

<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">Update Government</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="editForm">
				<MudGrid>
					<MudItem sm="6" >
						<MudTextField @bind-Value="city.ArabicName"
									  For="@(() => city.ArabicName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="ArabicName" />
					</MudItem>

					<MudItem sm="6" >
						<MudTextField @bind-Value="city.EnglishName"
									  For="@(() => city.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="EnglishName" />
					</MudItem>


					<GovernorateLookups SelectValueChanged="SelectGovernment"></GovernorateLookups>
				</MudGrid>
			</MudForm>
		</DialogContent>
		<DialogActions>
			<MudButton OnClick="Cancel">Cancel</MudButton>
			<MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Save">Edit</MudButton>
		</DialogActions>
	</MudDialog>

</MudItem>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>

@code {

	[CascadingParameter] MudDialogInstance MudDialog { get; set; }
	[Parameter] public CityDto city { get; set; } = new CityDto();
	public IReadOnlyList<GovernmentLookupDto> governments { get; set; } = new List<GovernmentLookupDto>();
	private MudForm editForm;
	private int GovernmentSelectValue { get; set; }

	bool _clearable;


	private void SelectGovernment(int Government)
	{
		GovernmentSelectValue = Government;
	}
	protected override async Task OnInitializedAsync()
	{
		var result = await CitiesAppService.GetGovernmentLookupAsync();
		governments = result;
	}

	private async Task Save()
	{
		await editForm.Validate();
		if (editForm.IsValid)
		{

			// Create the input object for update
			var input = new CreateUpdateCityDto
				{
					ArabicName = city.ArabicName,
					EnglishName = city.EnglishName,
					Notes = city.Notes,
					GovernorateId = city.GovernorateId,

			};

			// Call the update method
			await CitiesAppService.UpdateAsync(city.Id, input);

			// Close the dialog with a success result
			MudDialog.Close(DialogResult.Ok(true));
		}
	}


	private void Cancel()
	{
		MudDialog.Cancel();
	}
}

