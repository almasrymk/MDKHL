@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.City
@using Volo.Abp.Application.Dtos
@inject ICitiesAppService CitiesAppService
@inject IStringLocalizer<SmartParkingResource> L
<PageTitle>@L["UpdateCities"]</PageTitle>


<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["UpdateCity"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="editForm">
				<MudGrid>
					<MudItem sm="6" >
						<MudTextField @bind-Value="city.ArabicName"
									  For="@(() => city.ArabicName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["Arabic Name"]" />
					</MudItem>

					<MudItem sm="6" >
						<MudTextField @bind-Value="city.EnglishName"
									  For="@(() => city.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["English Name"]" />
					</MudItem>


					<MudItem sm="6">
						<MudSelect @bind-Value="@city.GovernorateId"
								   Variant="Variant.Text"
								   Label="@L["Governorate"]"
								   Placeholder="Please Select"
								   Clearable="_clearable"
								   AnchorOrigin="Origin.TopCenter"
								   TransformOrigin="Origin.TopCenter">

							@foreach (var governorate in governorates)
							{
								<MudSelectItem Value="governorate.Id">@governorate.EnglishName</MudSelectItem>
							}
						</MudSelect>
					</MudItem>
				</MudGrid>
			</MudForm>
		</DialogContent>
		<DialogActions>
			<MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
			<MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Save">@L["Edit"]</MudButton>
		</DialogActions>
	</MudDialog>

</MudItem>


@code {

	[CascadingParameter] MudDialogInstance MudDialog { get; set; }
	[Parameter] public CityDto city { get; set; } = new CityDto();
	public IReadOnlyList<GovernorateLookupDto> governorates { get; set; } = new List<GovernorateLookupDto>();
	private MudForm editForm;

	bool _clearable;

	protected override async Task OnInitializedAsync()
	{
		var result = await CitiesAppService.GetGovernmentLookupAsync();
		governorates = result;
	}

	private async Task Save()
	{
		await editForm.Validate();
		if (editForm.IsValid)
		{

			// Create the input object for update
			var input = new CreateUpdateCityDto
				{
					ArabicName = city.ArabicName,
					EnglishName = city.EnglishName,
					Notes = city.Notes,
					GovernorateId = city.GovernorateId,

			};

			// Call the update method
			await CitiesAppService.UpdateAsync(city.Id, input);

			// Close the dialog with a success result
			MudDialog.Close(DialogResult.Ok(true));
		}
	}


	private void Cancel()
	{
		MudDialog.Cancel();
	}
}



<style>
	.mud-modal 
	{
		border-radius: 0 20px 0 20px;
	}
</style>
