@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.City
@using SmartParking.Lookups.State
@using System.Globalization
@using Volo.Abp.Application.Dtos
@inject ICitiesAppService CitiesAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject IStateAppService StateAppService
@inject NavigationManager Navigation
<PageTitle>@L["UpdateCities"]</PageTitle>


<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
				<MudText Typo="Typo.h6">@L["Edit"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="editForm">
				<MudGrid>
					<MudItem sm="6" >
						<MudTextField @bind-Value="city.ArabicName"
									  For="@(() => city.ArabicName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["ArabicName"]" 
									  Required
									  RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
					</MudItem>

					<MudItem sm="6" >
						<MudTextField @bind-Value="city.EnglishName"
									  For="@(() => city.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["EnglishName"]" 
									  Required
									  RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
					</MudItem>

					<MudItem sm="6">
						<MudSelect Variant="Variant.Text"
								   Label="@L["State"]"
								   Placeholder="@L["Choose"]"
								   Clearable="true"
								   Required
								   RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
								   @bind-Value="city.StateId">
							<MudSelectItem Value="0" Disabled>@L["Choose"]</MudSelectItem>
							@foreach (var state in states)
							{
								@if (CultureInfo.CurrentCulture.Name == "en")
								{
									<MudSelectItem Value="state.Id">@state.EnglishName</MudSelectItem>
								}
								else
								{
									<MudSelectItem Value="state.Id">@state.ArabicName</MudSelectItem>
								}
							}
						</MudSelect>
					</MudItem>
				</MudGrid>
			</MudForm>
		</DialogContent>
		<DialogActions>
    <DialogActionComponent 
		ButtonOneColor="MudBlazor.Color.Dark"
        ButtonTwoColor="MudBlazor.Color.Primary" 
        ButtonOneLabel="@L["Back"]" 
        ButtonTwoLabel="@L["Save"]" 
        ButtonOneClick="Cancel" 
        ButtonTwoClick="@(async () => await Save())" 
        ButtonOneVariant="MudBlazor.Variant.Filled" 
        ButtonTwoVariant="MudBlazor.Variant.Filled" 
    />
</DialogActions>


		
	</MudDialog>

</MudItem>



<style>
	.mud-modal 
	{
		border-radius: 0 20px 0 20px;
	}
</style>
