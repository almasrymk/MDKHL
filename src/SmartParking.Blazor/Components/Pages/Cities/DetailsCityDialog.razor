@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.City
@using Volo.Abp.Application.Dtos
@inject ICitiesAppService CitiesAppService
@inject IStringLocalizer<SmartParkingResource> L
<PageTitle>@L["CitiesDetails"]</PageTitle>

<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["CityDetails"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" >
				<MudGrid>
					<MudItem sm="6">
						<MudTextField @bind-Value="city.ArabicName"
									  For="@(() => city.ArabicName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["Arabic Name"]" 
									  Disabled/>
					</MudItem>

					<MudItem sm="6">
						<MudTextField @bind-Value="city.EnglishName"
									  For="@(() => city.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["English Name"]"
									  Disabled/>
					</MudItem>


					<MudItem sm="6">
						<MudSelect @bind-Value="@city.GovernorateId"
								   Variant="Variant.Text"
								   Label="@L["Governorate"]"
								   Placeholder="Please Select"
								   AnchorOrigin="Origin.TopCenter"
								   TransformOrigin="Origin.TopCenter"
								   Disabled>

							@foreach (var governorate in governorates)
							{
								<MudSelectItem Value="governorate.Id">@governorate.EnglishName</MudSelectItem>
							}
						</MudSelect>
					</MudItem>
				</MudGrid>
			</MudForm>
		</DialogContent>
		<DialogActions>
			<MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
		</DialogActions>
	</MudDialog>

</MudItem>

<style>
	.mud-modal 
	{
		border-radius: 0 20px 0 20px;
	}
</style>

@code {

	[CascadingParameter] MudDialogInstance MudDialog { get; set; }
	[Parameter] public CityDto city { get; set; } = new CityDto();
	public IReadOnlyList<GovernorateLookupDto> governorates { get; set; } = new List<GovernorateLookupDto>();


	protected override async Task OnInitializedAsync()
	{
		var result = await CitiesAppService.GetGovernmentLookupAsync();
		governorates = result;
	}



	private void Cancel()
	{
		MudDialog.Cancel();
	}
}

