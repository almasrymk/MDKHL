@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.City
@using Volo.Abp.Application.Dtos
@inject ICitiesAppService CitiesAppService
@inject IStringLocalizer<SmartParkingResource> L
<PageTitle>@L["CitiesDetails"]</PageTitle>

<MudItem class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@city.EnglishName</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" >
				<MudGrid>
					<MudItem sm="6">
						<MudTextField @bind-Value="city.ArabicName"
									  For="@(() => city.ArabicName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["Arabic Name"]" 
									  Disabled/>
					</MudItem>

					<MudItem sm="6">
						<MudTextField @bind-Value="city.EnglishName"
									  For="@(() => city.EnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["English Name"]"
									  Disabled/>
					</MudItem>

					<MudItem sm="6">
						<MudTextField @bind-Value="city.GovernorateEnglishName"
									  For="@(() => city.GovernorateEnglishName)"
									  Immediate="true"
									  Variant="Variant.Text"
									  Label="@L["Governorate English Name"]"
									  Disabled />
					</MudItem>
				
				</MudGrid>
			</MudForm>
		</DialogContent>
		<DialogActions>
			<MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
		</DialogActions>
	</MudDialog>

</MudItem>

<style>
	.mud-modal 
	{
		border-radius: 0 20px 0 20px;
	}
</style>


