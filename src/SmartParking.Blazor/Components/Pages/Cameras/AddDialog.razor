@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Cameras
@using SmartParking.Enums
@using SmartParking.Garages
@using SmartParking.Localization
@using System.Globalization
@using System.Security.Authentication
@using SmartParking.Lookups.CameraBrands
@using SmartParking.Lookups.CameraMainType
@using SmartParking.Lookups.CameraModel
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@using Volo.Abp.Validation
@inject IDialogService DialogService
@inject IStringLocalizer<SmartParkingResource> L
@inject IGarageAppService GaragesAppService
<PageTitle>@L["New Cameras"]</PageTitle>
@inject NavigationManager Navigation

<div class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Add NEW"]</MudText>
        </TitleContent>
        <DialogContent>
                    <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                        <MudGrid>
                            <MudItem sm="6">
                                <MudTextField @bind-Value="cameraDto.Name"
                                              For="@(() => cameraDto.Name)"
                                              Immediate="true"
                                              Required="true"
                                              Placeholder="@L["Name"]"
                                              Label="@L["Name"]"
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                            </MudItem>
                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="cameraDto.DeviceId"
                                              Immediate="true"
                                              Disabled=true
                                      Placeholder="@L["Will Be Automatically Created"]"
                                      Label="@L["Code"]" />
                            </MudItem>

                   

                    <MudItem sm="6">
                        <MudSelect @bind-Value="@cameraDto.BrandNameId"
                                   Variant="Variant.Text"
                                   Label="@L["BrandName"]"
                                   HelperText=@L["Helper Text"]
                                   Placeholder=@L["Choose"]
                                   Required="true"
                                   RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                                   Clearable="_clearable">
                            <MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
                            @foreach (var vehicleBrand in CameraBrands)
                            {
                                @if (CultureInfo.CurrentCulture.Name == "en")
                                {
                                    <MudSelectItem Value="vehicleBrand.Id">@vehicleBrand.EnglishName</MudSelectItem>
                                }
                                else
                                {
                                    <MudSelectItem Value="vehicleBrand.Id">@vehicleBrand.ArabicName</MudSelectItem>
                                }

                            }
                        </MudSelect>
                    </MudItem> 
                    
                    <MudItem sm="6">
                        <MudSelect @bind-Value="@cameraDto.ModelId"
                                   Variant="Variant.Text"
                                   Label="@L["Model"]"
                                   HelperText=@L["Helper Text"]
                                   Placeholder=@L["Choose"]
                                   Required="true"
                                   RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                                   Clearable="_clearable">
                            <MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
                            @foreach (var vehicleBrand in CameraModels)
                            {
                                @if (CultureInfo.CurrentCulture.Name == "en")
                                {
                                    <MudSelectItem Value="vehicleBrand.Id">@vehicleBrand.EnglishName</MudSelectItem>
                                }
                                else
                                {
                                    <MudSelectItem Value="vehicleBrand.Id">@vehicleBrand.ArabicName</MudSelectItem>
                                }

                            }
                        </MudSelect>
                    </MudItem>                    
                    
                    <MudItem sm="6">
                        <MudSelect @bind-Value="@cameraDto.MainTypeId"
                                   Variant="Variant.Text"
                                   Label="@L["MainType"]"
                                   HelperText=@L["Helper Text"]
                                   Placeholder=@L["Choose"]
                                   Required="true"
                                   RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                                   Clearable="_clearable">
                            <MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
                            @foreach (var vehicleBrand in CameraMainTypes)
                            {
                                @if (CultureInfo.CurrentCulture.Name == "en")
                                {
                                    <MudSelectItem Value="vehicleBrand.Id">@vehicleBrand.EnglishName</MudSelectItem>
                                }
                                else
                                {
                                    <MudSelectItem Value="vehicleBrand.Id">@vehicleBrand.ArabicName</MudSelectItem>
                                }

                            }
                        </MudSelect>
                    </MudItem>

                   
                  
                         
                            <MudItem sm="6">
                       
                                <MudTextField @bind-Value="cameraDto.CameraIP"
                                    For="@(() => cameraDto.CameraIP)"
                                    Immediate="true"
                                    Required
                                    RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                                    Placeholder="@L["CameraIP"]"
                                    Label="@L["CameraIP"]" />

                                </MudItem>
                            <MudItem sm="6">
                        
                                 <MudTextField @bind-Value="cameraDto.MacAddress"
                                          For="@(() => cameraDto.MacAddress)"
                                          Immediate="true"
                                          Required
                                          RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
                                          Placeholder="@L["MacAddress"]"
                                          Label="@L["MacAddress"]" />

                                </MudItem>
                          @if (CultureInfo.CurrentCulture.Name == "en")
                        {
                            <MudItem sm="6">
                                <MudSelect @bind-Value="@cameraDto.GarageId"
                                        Variant="Variant.Text"
                                        Label="@L["EnGarageName"]"
                                        Placeholder="Choose"
                                        Required
                                        RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))">
                                <MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
                                    @foreach (var garage in Garages)
                                {
                                    if (garage.Status != Enums.Status.Active)
                                        continue;
                                        <MudSelectItem Value="garage.Id">@garage.NameEn</MudSelectItem>
                                    }
                                </MudSelect>
                             </MudItem>
                    }
                    else
                    {
                        <MudItem sm="6">
                            <MudSelect @bind-Value="@cameraDto.GarageId"
                                       Variant="Variant.Text"
                                       Label="@L["ArGarageName"]"
                                       Placeholder=@L["Choose"]
                                       Required
                                       RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))">
                                <MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
                                @foreach (var garage in Garages)
                                {
                                    if (garage.Status != Enums.Status.Active)
                                        continue;
                                    <MudSelectItem Value="garage.Id">@garage.NameAr</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        
                    }

                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="cameraDto.GarageId"
                                              For="@(() => cameraDto.GarageId)"
                                              Immediate="true"
                                              Disabled=true
                                      
                                              Label="@L["GarageId"]" />
                            </MudItem> 
                    <MudItem sm="6" md="6" Class="d-inline-flex justify-content-center">
                        <div Class="d-flex flex-row justify-content-between">

                          
                            <MudRadioGroup @bind-Value="@cameraDto.CameraType" Class="d-inline-flex align-content-center">
                                <MudRadio Value="@(Enums.CameraType.Entry)" Color="MudBlazor.Color.Primary">@L["Entry"]</MudRadio>
                                <MudRadio Value="@(Enums.CameraType.Exit)" Color="MudBlazor.Color.Error">@L["Exit"]</MudRadio>
                            </MudRadioGroup>
                        </div>
                    </MudItem>
                      
                            <MudItem sm="6" md="6" Class="d-inline-flex justify-content-center">
                                <div Class="d-flex flex-row justify-content-between">



                            <MudRadioGroup @bind-Value="@cameraDto.Status" Class="d-inline-flex align-content-center" >
                               
                                        <MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">@L["Active"]</MudRadio>
                                        <MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Secondary">@L["InActive"]</MudRadio>
                                    </MudRadioGroup>
                                </div>
                            </MudItem>
                        </MudGrid>
                    </MudForm>
                   
        </DialogContent>

        <DialogActions>
            <MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Submit" >@L["Create"]</MudButton>
        </DialogActions>
        
    </MudDialog>

</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>

@code {
    [Inject] ISnackbar Snackbar { get; set; }
    [Inject] ICamerasAppService CamerasAppService { get; set; } // Assuming you have a service to handle the camera creation
    [Inject] ICameraBrandAppService CameraBrandAppService { get; set; }
    [Inject] ICameraModelAppService CameraModelAppService { get; set; }
    [Inject] ICameraMainTypeAppService CameraMainTypeAppService { get; set; }

    private MudForm form;
    private CreateUpdateCameraDto cameraDto = new CreateUpdateCameraDto();
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }
    bool _clearable;
    public List<GarageDto> Garages { get; set; } = new List<GarageDto>();

    IList<CameraBrandDto> CameraBrands = new List<CameraBrandDto>();
    IList<CameraModelDto> CameraModels = new List<CameraModelDto>();
    IList<CameraMainTypeDto> CameraMainTypes = new List<CameraMainTypeDto>();


    protected override async Task OnInitializedAsync()
    {
        CameraBrands = await CameraBrandAppService.GetAllCameraBrandsAsync();
        CameraModels = await CameraModelAppService.GetAllCameraModelsAsync();
        CameraMainTypes = await CameraMainTypeAppService.GetAllCameraMainTypesAsync();
        var result = await GaragesAppService.GetListAsync(new PagedAndSortedResultRequestDto
            {
                MaxResultCount = 100,
                SkipCount = (1 - 1) * 100
            });
        Garages = result.Items.ToList();
        await base.OnInitializedAsync();
    }
    private async Task Submit()
    {
            try
            {
                var garage = Garages.Find(x => x.Id == cameraDto.GarageId);
                cameraDto.TenantId = garage.TenantId;
                cameraDto.OrganizationId = garage.OrganizationId;
                var createdCameraDto=await CamerasAppService.CreateAsync(cameraDto);
                MudDialog.Close(DialogResult.Ok(true));
                SnackBar.ShowSnackbar(Snackbar, $"{createdCameraDto.Name} {L[AlertMessages.AlertMessages.ADD]} {L[AlertMessages.AlertMessages.SUCCESS]}", Severity.Success);

                await Task.Delay(1000);
                Navigation.NavigateTo("/cameras", forceLoad: true);

               
            }
            catch (AbpValidationException validationException)
            {
                foreach (var validationError in validationException.ValidationErrors)
                {
                    SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.VAlIDATION_ERROR]}: {L[validationError.MemberNames.First()]} - {validationError.ErrorMessage}", Severity.Error);
                }
            }
            catch (BusinessException ex)
            {

            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]}{L[AlertMessages.AlertMessages.ADD]} : {ex.Code}", Severity.Error);
            }
            catch (AuthenticationException ex)
            {
            SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]}{L[AlertMessages.AlertMessages.ADD]}: {ex.Message} ", Severity.Error);
            }
            catch (Exception ex)
            {

                SnackBar.ShowSnackbar(Snackbar, $"{L[AlertMessages.AlertMessages.FAILED]} {L[AlertMessages.AlertMessages.ADD]} : {ex.Message} ", Severity.Error);
            }
        
    }
        
    private void Cancel()
    {
        MudDialog.Cancel();
    }
    
}
