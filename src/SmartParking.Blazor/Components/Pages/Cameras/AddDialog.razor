@using Microsoft.Extensions.Localization
@using SmartParking.Cameras
@using SmartParking.Enums
@using SmartParking.Garages
@using SmartParking.Localization
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@inject IDialogService DialogService
@inject IStringLocalizer<SmartParkingResource> L
@inject IGarageAppService GaragesAppService

<div class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["New Camera"]</MudText>
        </TitleContent>
        <DialogContent>
            
                    <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                        <MudGrid>
                            <MudItem sm="6">
                                <MudSelect @bind-Value="@cameraDto.GarageId"
                                           Variant="Variant.Text"
                                           Label="@L["Garage Name"]"
                                           Placeholder="Choose"
                                           Clearable="_clearable">
                                    @foreach (var garage in Garages)
                                    {
                                        <MudSelectItem Value="garage.Id">@garage.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>


                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="cameraDto.GarageId"
                                              For="@(() => cameraDto.GarageId)"
                                              Immediate="true"
                                              Disabled=true
                                              Label="@L["GarageId"]" />
                            </MudItem>

                            <MudItem sm="4">
                                <MudTextField @bind-Value="cameraDto.Name"
                                              For="@(() => cameraDto.Name)"
                                              Immediate="true"
                                              Required="true"
                                              Label="@L["Name"]" />
                            </MudItem>
                            <MudItem sm="4">
                                <MudTextField @bind-Value="cameraDto.Model"
                                              For="@(() => cameraDto.Model)"
                                              Immediate="true"
                                              Label="@L["Model"]" />
                            </MudItem>
                            <MudItem sm="4">
                                <MudTextField @bind-Value="cameraDto.MainType"
                                              For="@(() => cameraDto.MainType)"
                                              Immediate="true"
                                              Label="@L["MainType"]" />
                            </MudItem>
                            <MudItem sm="4">
                                <MudTextField @bind-Value="cameraDto.BrandName"
                                              For="@(() => cameraDto.BrandName)"
                                              Immediate="true"
                                              Label="@L["BrandName"]" />
                            </MudItem>
                            <MudItem sm="4">
                                <MudTextField @bind-Value="cameraDto.Code"
                                              For="@(() => cameraDto.Code)"
                                              Immediate="true"
                                              Label="@L["Code"]" />

                            </MudItem>
                            <MudItem sm="4">
                    <MudTextField @bind-Value="cameraDto.CameraIP"
                                  For="@(() => cameraDto.CameraIP)"
                                  Immediate="true"
                                              Label="@L["CameraIP"]" />

                </MudItem>
                            <MudItem sm="4">
                    <MudTextField @bind-Value="cameraDto.MacAddress"
                                  For="@(() => cameraDto.MacAddress)"
                                  Immediate="true"
                                              Label="@L["MacAddress"]" />

                </MudItem>
                            <MudItem sm="4">
                                <MudTextField @bind-Value="cameraDto.Type"
                                              For="@(() => cameraDto.Type)"
                                              Immediate="true"
                                              Required="true"
                                              Label="@L["Type"]" />

                            </MudItem>

                      
                            <MudItem sm="9" md="9" Class="d-inline-flex justify-content-center">
                                <div Class="d-flex flex-row justify-content-between">


                                    <MudRadioGroup @bind-Value="@cameraDto.Status" Class="d-inline-flex align-content-center">
                                        <MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">@L["Active"]</MudRadio>
                                        <MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Secondary">@L["InActive"]</MudRadio>
                                        <MudRadio Value="@(Enums.Status.Deleted)" Color="MudBlazor.Color.Warning">@L["Deleted"]</MudRadio>
                                    </MudRadioGroup>
                                </div>
                            </MudItem>
                        </MudGrid>
                    </MudForm>
                   
        </DialogContent>
        <DialogActions >
            <div class="overflow-hidden px-5 w-100">


            <MudGrid >

                <MudItem sm="6" >

                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="Submit">@L["Create"]</MudButton>
                </MudItem>
                <MudItem sm="6" >

                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Tertiary" OnClick="Cancel">@L["Cancel"]</MudButton>
                </MudItem>
            </MudGrid>
            </div>
        </DialogActions>
        
    </MudDialog>

</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>

@code {
    [Inject] ISnackbar Snackbar { get; set; }
    [Inject] ICamerasAppService CamerasAppService { get; set; } // Assuming you have a service to handle the camera creation

    private MudForm form;
    private CreateUpdateCameraDto cameraDto = new CreateUpdateCameraDto();
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }
    bool _clearable;
    public List<GarageDto> Garages { get; set; } = new List<GarageDto>();

    protected override async Task OnInitializedAsync()
    {
        var result = await GaragesAppService.GetListAsync(new PagedAndSortedResultRequestDto
            {
                MaxResultCount = 100,
                SkipCount = (1 - 1) * 100
            });
        Garages = result.Items.ToList();
        await base.OnInitializedAsync();
    }
    private async Task Submit()
    {
        if (form.IsValid)
        {
            // Call your service to create the camera
            try
            {
                await CamerasAppService.CreateAsync(cameraDto);
            }
            catch (UserFriendlyException ex)
            {
                Snackbar.Add("DuplicateCameraIP", Severity.Error);
                return;
            }
            catch(Exception e)
            {
                Snackbar.Add("Fill Requried Items", Severity.Error);
                return;
            }
            Snackbar.Add("Camera created successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
            
        }
        else
        {
            Snackbar.Add("Please fix the validation errors.", Severity.Error);
        }
    }
    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
