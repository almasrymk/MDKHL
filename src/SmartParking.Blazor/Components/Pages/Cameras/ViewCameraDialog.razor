@using Microsoft.Extensions.Localization
@using SmartParking.Cameras
@using SmartParking.Enums
@using SmartParking.Garages
@using SmartParking.Localization
@using System.Globalization
@using Volo.Abp.Application.Dtos
@inject ICamerasAppService CamerasAppService
@inject IGarageAppService GaragesAppService

@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar

<div class="modal-wrapper">
	<MudDialog class="mud-modal" >
		<TitleContent>
			<MudText Typo="Typo.h6">@Camera.Name</MudText>
		</TitleContent>
		<DialogContent>



			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>

					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Camera.Name"
									  For="@(() => Camera.Name)"
									  Immediate="true"
									  Disabled=true
									  Label="@L["Name"]" />
					</MudItem>
						<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Camera.DeviceId"
									  Immediate="true"
									  Disabled=true
									  Label="@L["Code"]" />
					</MudItem>

					@if (CultureInfo.CurrentCulture.Name == "en")
					{
						<MudItem sm="6" md="6">
							<MudTextField @bind-Value="Camera.BrandName.EnglishName"
										  Immediate="true"
										  Disabled=true
										  Label="@L["BrandName"]" />
						</MudItem>
						<MudItem sm="6" md="6">
							<MudTextField @bind-Value="Camera.Model.EnglishName"
										  Immediate="true"
										  Disabled=true
										  Label="@L["Model"]" />
						</MudItem>
					}
					else
					{
						<MudItem sm="6" md="6">
							<MudTextField @bind-Value="Camera.BrandName.ArabicName"
										  Immediate="true"
										  Disabled=true
										  Label="@L["BrandName"]" />
						</MudItem>
						<MudItem sm="6" md="6">
							<MudTextField @bind-Value="Camera.Model.ArabicName"
										  Immediate="true"
										  Disabled=true
										  Label="@L["Model"]" />
						</MudItem>
					}


					
					
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Camera.CameraIP"
									  For="@(() => Camera.CameraIP)"
									  Immediate="true"
									  Disabled=true
									  Label="@L["CameraIP"]" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Camera.MacAddress"
									  For="@(() => Camera.MacAddress)"
									  Immediate="true"
									  Disabled=true
									  Label="@L["MacAddress"]" />
					</MudItem>

					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Camera.Garage.Code"
									  For="@(() => Camera.Garage.Code)"
									  Immediate="true"
									  Disabled=true
									  Label="@L["Garage"]" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Camera.CameraType"
									  For="@(() => Camera.CameraType)"
									  Immediate="true"
									  Disabled=true
									  Label="@L["Type"]" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Camera.Status"
									  For="@(() => Camera.Status)"
									  Immediate="true"
									  Disabled=true
									  Label="@L["Status"]" />
					</MudItem>
				</MudGrid>
			</MudForm>



		</DialogContent>
		<DialogActions>
			<MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="OnCloseViewOnly">@L["Back"]</MudButton>
		</DialogActions>


	</MudDialog>

</div>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>

@code {
	[CascadingParameter]
	private MudDialogInstance MudDialogAdd { get; set; }
	[Parameter] public CameraDto Camera { get; set; }
	[Parameter]
	public int UpdatedId { get; set; }
	bool _clearable;
	private MudForm form;

	protected override async Task OnInitializedAsync()
	{
		var result = await GaragesAppService.GetListAsync(new PagedAndSortedResultRequestDto
			{
				MaxResultCount = 100,
				SkipCount = (1 - 1) * 100
			});
		await base.OnInitializedAsync();
	}

	

	private void OnCloseViewOnly()
	{
		MudDialogAdd.Cancel();

	}

}
