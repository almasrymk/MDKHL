@using Microsoft.Extensions.Localization
@using SmartParking.Cameras
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Enums
@using SmartParking.Garages
@using SmartParking.Localization
@using System.Globalization
@using Volo.Abp.Application.Dtos
@inject ICamerasAppService CamerasAppService
@inject IGarageAppService GaragesAppService

@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar

<div class="modal-wrapper">
	<MudDialog class="mud-modal">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["Details"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>

					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Dispenser.Name"
									  For="@(() => Dispenser.Name)"
									  Immediate="true"
									  Disabled=true
									  Label="@L["Name"]" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Dispenser.DeviceId"
									  Immediate="true"
									  Disabled=true
									  Label="@L["Code"]" />
					</MudItem>

					

					<MudItem sm="6" md="6">
						<MudTextField T="string"
									  Value="@L[$"{Dispenser.CameraType}"]"
									  Immediate="true"
									  Disabled=true
									  Label="@L["CameraType"]" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField T="string"
									  Value="@L[$"{Dispenser.Status}"]"
									  Immediate="true"
									  Disabled=true
									  Label="@L["Status"]" />
					</MudItem>
				</MudGrid>
			</MudForm>



		</DialogContent>
		<DialogActions>
			<DialogActionComponent ButtonTwoColor="MudBlazor.Color.Dark"
								   ButtonTwoLabel="@L["Back"]"
								   ButtonTwoClick="OnCloseViewOnly"
								   ButtonTwoVariant="MudBlazor.Variant.Filled" />
		</DialogActions>


	</MudDialog>

</div>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>
