@using Microsoft.Extensions.Localization
@using SmartParking.Cameras
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Enums
@using SmartParking.Garages
@using SmartParking.Invoices
@using SmartParking.Localization
@using System.Globalization
@using SmartParking.Organizations
@using Volo.Abp.Application.Dtos
@using Volo.Abp.MultiTenancy
@inject ICamerasAppService CamerasAppService
@inject IGarageAppService GaragesAppService
@inject IOrganizationsAppService OrganizationAppService
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject ICurrentTenant CurrentTenant
@inject IGarageAppService GaragesAppService
@inject IInvoiceAppService InvoiceAppService
@inject NavigationManager Navigation 
@inject IJSRuntime JSRuntime
<div class="modal-wrapper">
	<MudDialog class="mud-modal">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["Details"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>

					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Dispenser.Name"
									  For="@(() => Dispenser.Name)"
									  Immediate="true"
									  Disabled=true
									  Label="@L["Name"]" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Dispenser.DeviceId"
									  Immediate="true"
									  Disabled=true
									  Label="@L["Code"]" />
					</MudItem>
					@if(CurrentTenant.Id == null )
					{
						@if(CultureInfo.CurrentCulture.Name == "en")
						{
							<MudItem sm="6" md="6">
								<MudTextField @bind-Value="organization.EnglishName"
											  Immediate="true"
											  Disabled=true
											  Label="@L["OrganizationName"]" />
							</MudItem>
						}
						else
						{
							<MudItem sm="6" md="6">
								<MudTextField @bind-Value="organization.ArabicName"
											  Immediate="true"
											  Disabled=true
											  Label="@L["OrganizationName"]" />
							</MudItem>
						}
						
						
					}
					@if (CultureInfo.CurrentCulture.Name == "en")
					{
						<MudItem sm="6" md="6">
							<MudTextField @bind-Value="garage.NameEn"
										  Immediate="true"
										  Disabled=true
										  Label="@L["GarageName"]" />
						</MudItem>
					}
					else
					{
						<MudItem sm="6" md="6">
							<MudTextField @bind-Value="garage.NameAr"
										  Immediate="true"
										  Disabled=true
										  Label="@L["GarageName"]" />
						</MudItem>
					}
		


					<MudItem sm="6" md="6">
						<MudTextField T="string"
									  Value="@L[$"{Dispenser.CameraType}"]"
									  Immediate="true"
									  Disabled=true
									  Label="@L["CameraType"]" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField T="string"
									  Value="@L[$"{Dispenser.Status}"]"
									  Immediate="true"
									  Disabled=true
									  Label="@L["Status"]" />
					</MudItem>
				</MudGrid>
			</MudForm>

			@if(Dispenser.CameraType == WatcherType.Exit)
			{
				<MudIconButton OnClick="HandleDownload"
				Icon="@Icons.Material.Filled.QrCode2"
				Variant="Variant.Filled"
				Color="MudBlazor.Color.Primary"
				Size="MudBlazor.Size.Small"
				Class="mx-1" />
			}

		</DialogContent>
		<DialogActions>
			<DialogActionComponent ButtonTwoColor="MudBlazor.Color.Dark"
								   ButtonTwoLabel="@L["Back"]"
								   ButtonTwoClick="OnCloseViewOnly"
								   ButtonTwoVariant="MudBlazor.Variant.Filled" />
		</DialogActions>


	</MudDialog>

</div>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>
