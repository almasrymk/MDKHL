@using Microsoft.Extensions.Localization
@using SmartParking.Cameras
@using SmartParking.Localization
@inject ICamerasAppService CamerasAppService
@inject IDialogService Dialog
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@page "/cameras"


<h3>@L["Cameras"]</h3>

<SPDataGrid PageName="cameras" Data="@itemData" TotalItemsInTable="TotalItem" OnFiltering="HandleFilter" OnClickRowEdit="OnClickRowEdit" OnClickRowView="OnClickRowView" OnPageChanged="FetchTableData" OnSearching="HandleSearch" OnAdd="@(() => OpenDialogAsync(_backdropClick))" OnClickRowDelete="OnClickRowDelete"></SPDataGrid>




