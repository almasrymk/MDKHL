@using Microsoft.Extensions.Localization
@using SmartParking.Cameras
@using SmartParking.Localization
@inject ICamerasAppService CamerasAppService
@inject IDialogService Dialog
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

@page "/cameras"


<PageTitle>@L["Cameras"]</PageTitle>
<MudText Typo="Typo.h5" Class="mb-2">@L["Cameras"]</MudText>

<SPDataGrid PageName=@L["Cameras"] Data="@itemData" TotalItemsInTable="TotalItem" OnFiltering="HandleFilter" OnClickRowEdit="OnClickRowEdit" OnClickRowView="OnClickRowView" OnPageChanged="FetchTableData" OnSearching="HandleSearch" OnAdd="@(() => OpenDialogAsync(_backdropClick))" OnClickRowDelete="OnClickRowDelete" ShowAssign="false" OnClickAssign="AssignGarage"></SPDataGrid>


