@using SmartParking.Cameras
@inject ICamerasAppService CamerasAppService
@page "/cameras"
@using Customs

<div>
    <MudDataGrid Elevation="0" Class="bg-transparent custom-data-grid" T="CameraDto" MultiSelection="true" Items="@cameras" SortMode="SortMode.Multiple" Filterable="true" 
                 Hideable="true" RowClick="@RowClicked" RowContextMenuClick="RowRightClicked" SelectedItemsChanged="@SelectedItemsChanged">
        <ToolBarContent>
            <MudTextField Elevation="2" @bind-Value="_searchString" Placeholder="Search For Cameras" Adornment="Adornment.End" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="MudBlazor.Size.Medium" Class="mt-0 data-grid-search"></MudTextField>
            <MudSpacer />
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="CreateNew">
                CREATE NEW
                <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Size="MudBlazor.Size.Small" Class="ms-1" />
            </MudButton>
        </ToolBarContent>
        <Columns>
            <SelectColumn T="CameraDto" />
            <PropertyColumn Property="x => x.Id" Title="ID" />
            <PropertyColumn Property="x => x.MacAddress" Title="MacAddress" />
            <PropertyColumn Property="x => x.Type" Title="Type" />
            <PropertyColumn Property="x => x.Status" Title="Status" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="CameraDto" />
        </PagerContent>
    </MudDataGrid>
</div>

@code {
    private string _searchString = string.Empty;

    private async Task RowClicked(DataGridRowClickEventArgs<CameraDto> args)
    {
        // Handle row click
    }

    private async Task RowRightClicked(DataGridRowClickEventArgs<CameraDto> args)
    {
        // Handle right-click row actions
    }

    private async Task SelectedItemsChanged(HashSet<CameraDto> selectedItems)
    {
        // Handle selected item changes
    }

    private void CreateNew()
    {
        // Logic to create a new camera
    }
}