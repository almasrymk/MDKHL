@page "/cameras"
@using SmartParking.Cameras
@inject ICamerasAppService CamerasAppService
@inject IDialogService Dialog

<div>
    <MudDataGrid Elevation="0" Class="bg-transparent custom-data-grid" T="CameraDto" MultiSelection="true" Items="@cameras" SortMode="SortMode.Multiple" Filterable="true"
                 Hideable="true" RowClick="@RowClicked" SelectedItemsChanged="@SelectedItemsChanged">
        <ToolBarContent>
            <MudTextField Elevation="2" @bind-Value="_searchString" Placeholder="Search For Cameras" Adornment="Adornment.End" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="MudBlazor.Size.Medium" Class="mt-0 data-grid-search"></MudTextField>
            <MudSpacer />
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateNewCamera">
                CREATE NEW
                <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Size="MudBlazor.Size.Small" Class="ms-1" />
            </MudButton>
        </ToolBarContent>
        <Columns>
            <SelectColumn T="CameraDto" />
            <PropertyColumn Property="x => x.Id" Title="ID" />
            <PropertyColumn Property="x => x.MacAddress" Title="MacAddress" />
            <PropertyColumn Property="x => x.Type" Title="Type" />
            <PropertyColumn Property="x => x.Status" Title="Status" />
            <TemplateColumn>
                <CellTemplate>
                    <MudIconButton Size="Small" Icon="@Icons.Material.Outlined.Edit" Color="Color.Primary" OnClick="@(() => EditCameraAsync(context))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="CameraDto" />
        </PagerContent>
    </MudDataGrid>
</div>

@code {
    private string _searchString = string.Empty;
    //private IEnumerable<CameraDto> cameras = new List<CameraDto>();

    // Edit Camera Dialog
    private async Task EditCameraAsync(CameraDto camera)
    {
        var parameters = new DialogParameters { { "Camera", camera } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };

        var dialog = Dialog.Show<EditCamera>("Edit Camera", parameters, options);
        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            var updatedCamera = (CameraDto)result.Data;
            // Handle the updated camera data (save changes, update UI, etc.)
        }
    }

  

    private async Task RowClicked(DataGridRowClickEventArgs<CameraDto> args)
    {
        // Handle row click (optional)
    }

    private async Task SelectedItemsChanged(HashSet<CameraDto> selectedItems)
    {
        // Handle selection changes (optional)
    }
}
