@using Microsoft.Extensions.Localization
@using SmartParking.Cameras
@using SmartParking.Enums
@using SmartParking.Garages
@using SmartParking.Localization
@using System.Globalization
@using System.Security.Authentication
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@using Volo.Abp.Validation
@inject ICamerasAppService CamerasAppService
@inject IGarageAppService GaragesAppService
@inject NavigationManager Navigation
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
<PageTitle>@L["Edit Camera"]</PageTitle>

<div class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["Edit"] @Camera.Name</MudText>
		</TitleContent>
		<DialogContent>



			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>
					@if (CultureInfo.CurrentCulture.Name == "en")
					{
					<MudItem sm="6">
						<MudSelect @bind-Value="@Camera.GarageId"
								   Variant="Variant.Text"
								   Label="@L["GarageNameEn"]"
								   Placeholder="Choose">
							@foreach (var garage in Garages)
							{
								<MudSelectItem Value="garage.Id">@garage.NameEn</MudSelectItem>
							}
						</MudSelect>
					</MudItem>
					}
					else

					{

						<MudItem sm="6">
							<MudSelect @bind-Value="@Camera.GarageId"
									   Variant="Variant.Text"
									   Label="@L["GarageNameAr"]"
									   Placeholder="Choose"
									   >
								@foreach (var garage in Garages)
								{
									<MudSelectItem Value="garage.Id">@garage.NameAr</MudSelectItem>
								}
							</MudSelect>
						</MudItem>
					}

					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Camera.GarageId"
									  For="@(() => Camera.GarageId)"
									  Immediate="true"
									  Disabled=true
									  Label="@L["GarageId"]" />
					</MudItem>




					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Camera.Name"
									  For="@(() => Camera.Name)"
									  Immediate="true"
									  Disabled=true
									  Label="@L["Name"]" />
					</MudItem>


					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Camera.Model"
									  For="@(() => Camera.Model)"
									  Immediate="true"
									  Disabled=true
									  Label="@L["Model"]" />
					</MudItem>
					
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Camera.DeviceId"
									  Immediate="true"
									  Disabled=true
									  Label="@L["Code"]" />
					</MudItem>

					
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Camera.BrandName"
									  For="@(() => Camera.BrandName)"
									  Immediate="true"
									  Disabled=true
									  Label="@L["BrandName"]" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Camera.CameraIP"
									  For="@(() => Camera.CameraIP)"
									  Immediate="true"
									  Disabled=true
									  Label="@L["CameraIP"]" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Camera.MacAddress"
									  For="@(() => Camera.MacAddress)"
									  Immediate="true"
									  Disabled=true
									  Label="@L["MacAddress"]" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="UpdatedId"
									  For="@(() => UpdatedId)"
									  Immediate="true"
									  Disabled=true
									  Label="@L["Id"]" />
					</MudItem>
					<MudItem sm="6" md="6" Class="d-inline-flex justify-content-center">
						<div Class="d-flex flex-row justify-content-between">


							<MudRadioGroup @bind-Value="@Camera.CameraType" Class="d-inline-flex align-content-center">
								<MudRadio Value="@(Enums.CameraType.Entry)" Color="MudBlazor.Color.Primary">@L["Entry"]</MudRadio>
								<MudRadio Value="@(Enums.CameraType.Exit)" Color="MudBlazor.Color.Error">@L["Exit"]</MudRadio>
							</MudRadioGroup>
						</div>
					</MudItem>
					<MudItem sm="6" md="6">
						<div Class="d-flex flex-row justify-content-between">


							<MudRadioGroup @bind-Value="@Camera.Status" Class="d-inline-flex align-content-center">
								<MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">@L["Active"]</MudRadio>
								<MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Error">@L["Inactive"]</MudRadio>
							</MudRadioGroup>
						</div>
						
					</MudItem>
				</MudGrid>
			</MudForm>



		</DialogContent>
		
			

			

		<DialogActions>
			<MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="CancelEdit">@L["Back"]</MudButton>
			<MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="SubmitEdit">@L["Edit"]</MudButton>
		</DialogActions>

			

		
		
	</MudDialog>

</div>

<style>
	.mud-modal {
		border-radius: 0 20px 0 20px;
	}
</style>

@code {
	[CascadingParameter]
	private MudDialogInstance MudDialogAdd { get; set; }
	[Parameter] public CreateUpdateCameraDto Camera { get; set; }
	[Parameter]
	public int UpdatedId { get; set; }
	public List<GarageDto> Garages { get; set; } = new List<GarageDto>();
	bool _clearable;
	private MudForm form;
	private int OrgId { get; set; }
	private int GarageId { get; set; }

	protected override async Task OnInitializedAsync()
	{
		var result = await GaragesAppService.GetListAsync(new PagedAndSortedResultRequestDto
			{
				MaxResultCount = 100,
				SkipCount = (1 - 1) * 100
			});
		Garages = result.Items.ToList();
		var garage = Garages.Find(x=>x.Id==Camera.GarageId);
		GarageId = Camera.GarageId;
		Camera.OrganizationId = garage.OrganizationId;
		await base.OnInitializedAsync();
	}

	private async Task SubmitEdit()
	{
		var successedMessage = L["Camera Updated Successfully"];
		var errorMessage = L["Can't Update Camera"];
		var validationErrorMessage = L["PleaseFixTheValidationErrors"];
		try
		{
			if (Camera.GarageId != GarageId)
			{
				var newGarage = Garages.Find(x => x.Id == Camera.GarageId);
				Camera.OrganizationId = newGarage.OrganizationId;
				Camera.TenantId = newGarage.TenantId;
			}

			await CamerasAppService.UpdateAsync(UpdatedId, Camera);
			MudDialogAdd.Close(DialogResult.Ok(true));
			Snackbar.Add($"{successedMessage}", Severity.Success);
			await Task.Delay(1000);
			Navigation.NavigateTo("/cameras", forceLoad: true);


		}
		catch (AbpValidationException validationException)
		{
			foreach (var validationError in validationException.ValidationErrors)
			{
				ShowSnackbar($"{validationErrorMessage}: {validationError.MemberNames.First()} - {validationError.ErrorMessage}", Severity.Error);
			}
		}
		catch (BusinessException ex)
		{

			ShowSnackbar($"{errorMessage}: {ex.Code} + ", Severity.Error);
		}
		catch (AuthenticationException ex)
		{
			ShowSnackbar($"{errorMessage} : : {ex.Message} + ", Severity.Error);
		}
		catch (Exception ex)
		{

			ShowSnackbar($"{errorMessage}: {ex.Message} + ", Severity.Error);
		}
	}
	/// <summary>
	/// Displays a snackbar notification with the specified message and severity.
	/// </summary>
	/// <param name="message">The message to display in the snackbar.</param>
	/// <param name="severity">The severity level of the snackbar (e.g., Success, Error).</param>
	void ShowSnackbar(string message, Severity severity)
	{
		Snackbar.Clear();
		Snackbar.Add(message, severity, c => c.SnackbarVariant = Variant.Filled);
	}

	private async Task CancelEdit()
	{
		MudDialogAdd.Cancel();


	}
}

	
}
