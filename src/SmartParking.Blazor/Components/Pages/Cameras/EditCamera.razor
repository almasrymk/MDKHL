@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Cameras
@using SmartParking.Enums
@using SmartParking.Garages
@using SmartParking.Localization
@using System.Globalization
@using System.Security.Authentication
@using SmartParking.Lookups.CameraBrands
@using SmartParking.Lookups.CameraMainType
@using SmartParking.Lookups.CameraModel
@using Volo.Abp
@using Volo.Abp.Application.Dtos
@using Volo.Abp.Validation
@using SmartParking.Currency
@using SmartParking.Lookups
@using SmartParking.Organizations
@using SmartParking.Packages
@using SmartParking.Validations
@using Volo.Abp.MultiTenancy
@inject ICamerasAppService CamerasAppService
@inject IGarageAppService GaragesAppService
@inject NavigationManager Navigation
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject ICameraBrandAppService CameraBrandAppService 
@inject ICameraModelAppService CameraModelAppService 
@inject ICameraMainTypeAppService CameraMainTypeAppService 
	@if(isLoaded)
	{
<PageTitle>@L["Edit Camera"]</PageTitle>

<div class="modal-wrapper">

	<MudDialog class="mud-modal">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["Edit"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>
				
					<MudItem sm="12" md="12">
						<MudText Class="text-bold">@L["CameraAccessData"]</MudText>
					</MudItem>					
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Camera.UserName"
									  Immediate="true"
									  Required
									  RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
									  Placeholder="@L["UserName"]"
									  Label="@L["UserName"]" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Camera.Password"
									  Immediate="true"
									  
									  Placeholder="@L["Password"]"
									  Required
									  RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
									  Label="@L["Password"]" />
					</MudItem>
					<MudDivider Style="border-top:1px solid #505254; margin:15px 0px;" />
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Camera.Name"
						For="@(() => Camera.Name)"
						Immediate="true"
						Label="@L["Name"]"
						Required
						RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
					</MudItem>

					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Camera.DeviceId"
						Immediate="true"
						Label="@L["Code"]" 
						Required="true"
						RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
					</MudItem>
				
					
					<MudItem sm="6" md ="6">
						<MudSelect @bind-Value="@Camera.BrandNameId" Label="@L["BrandName"]" HelperText=@L["Helper Text"] Placeholder=@L["Choose"] Required>
							<MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
							@foreach (var type in CameraBrands)
							{
								@if (CultureInfo.CurrentCulture.Name == "en")
								{
									<MudSelectItem Value="@type.Id">
										@type.EnglishName
									</MudSelectItem>
								}
								else
								{
									<MudSelectItem  Value="@type.Id">
										@type.ArabicName
									</MudSelectItem>
								}
							}
						</MudSelect>
					</MudItem>

					<MudItem sm="6" md="6">
						<MudSelect 
						@bind-Value="@Camera.ModelId" Variant="Variant.Text" 	Label="@L["Model"]" HelperText=@L["Helper Text"] Placeholder=@L["Choose"]   Required>
							<MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
							@foreach (var cameraModel in CameraModels)
							{
								@if (CultureInfo.CurrentCulture.Name == "en")
								{
									<MudSelectItem  Value="cameraModel.Id">@cameraModel.EnglishName</MudSelectItem>
								}
								else
								{
									<MudSelectItem Value="cameraModel.Id">@cameraModel.ArabicName</MudSelectItem>
								}
							}
						</MudSelect>
					</MudItem>

					<MudItem sm="6">
						<MudSelect @bind-Value="@Camera.MainTypeId" 	Variant="Variant.Text" 	Label="@L["MainType"]" HelperText=@L["Helper Text"] 	Placeholder=@L["Choose"] Required>
							<MudSelectItem Value="0" Disabled="true">@L["Choose"]</MudSelectItem>
							@foreach (var cameraMainType in CameraMainTypes)
							{
								@if (CultureInfo.CurrentCulture.Name == "en")
								{
									<MudSelectItem Value="cameraMainType.Id">@cameraMainType.EnglishName</MudSelectItem>
								}
								else
								{
									<MudSelectItem Value="cameraMainType.Id">@cameraMainType.ArabicName</MudSelectItem>
								}
							}
						</MudSelect>
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Camera.CameraIP"
						For="@(() => Camera.CameraIP)"
						Immediate="true"
						Label="@L["CameraIP"]" 
						Required="true"
						RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="Camera.MacAddress"
						For="@(() => Camera.MacAddress)"
						Immediate="true"
						Label="@L["MacAddress"]" 
						Required="true"
						RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
					</MudItem>

					@if (CultureInfo.CurrentCulture.Name == "en")
					{
						<MudItem sm="6">
							<MudSelect @bind-Value="@Camera.GarageId"
							Variant="Variant.Text"
							Label="@L["EnGarageName"]"
							Required
							RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))"
							Placeholder="Choose">
								<MudSelectItem Value="0" Disabled>@L["Choose"]</MudSelectItem>

								@foreach (var garage in Garages)
								{
									<MudSelectItem Value="garage.Id">@garage.NameEn</MudSelectItem>
								}
							</MudSelect>
						</MudItem>
					}
					else

					{

						<MudItem sm="6">
							<MudSelect @bind-Value="@Camera.GarageId"
							Variant="Variant.Text"
							Label="@L["ArGarageName"]"
							Placeholder="Choose">
								<MudSelectItem Value="0" Disabled>@L["Choose"]</MudSelectItem>

								@foreach (var garage in Garages)
								{
									<MudSelectItem Value="garage.Id">@garage.NameAr</MudSelectItem>
								}
							</MudSelect>
						</MudItem>
					}

					<MudItem sm="6" md="6" Class="d-inline-flex justify-content-center">
						<div Class="d-flex flex-row justify-content-between">


							<MudRadioGroup @bind-Value="@Camera.CameraType" Class="d-inline-flex align-content-center">
								<MudRadio Value="@(Enums.CameraType.Entry)" Color="MudBlazor.Color.Primary">@L["Entry"]</MudRadio>
								<MudRadio Value="@(Enums.CameraType.Exit)" Color="MudBlazor.Color.Error">@L["Exit"]</MudRadio>
							</MudRadioGroup>
						</div>
					</MudItem>

					<MudItem sm="6" md="6" Class="d-inline-flex justify-content-center">
						<div Class="d-flex flex-row justify-content-between">
							<MudRadioGroup @bind-Value="@Camera.Status" Class="d-inline-flex align-content-center">

								<MudRadio Value="@(Enums.Status.Active)" Color="MudBlazor.Color.Primary">@L["Active"]</MudRadio>
								<MudRadio Value="@(Enums.Status.Inactive)" Color="MudBlazor.Color.Secondary">@L["InActive"]</MudRadio>
							</MudRadioGroup>
						</div>
					</MudItem>
					
				</MudGrid>
			</MudForm>
		</DialogContent>
		<DialogActions>
					<DialogActionComponent ButtonOneLabel="@L["Back"]"
										   ButtonOneClick="CancelEdit"
										   ButtonOneVariant="MudBlazor.Variant.Filled"
										   ButtonOneColor="MudBlazor.Color.Dark"
										   ButtonTwoColor="MudBlazor.Color.Primary"
										   ButtonTwoLabel="@L["Save"]"
										   ButtonTwoClick="SubmitEdit"
										   ButtonTwoVariant="MudBlazor.Variant.Filled" />
		</DialogActions>

	</MudDialog>
	

</div>
}
<style>
	.mud-modal {
	border-radius: 0 20px 0 20px;
	}
</style>

