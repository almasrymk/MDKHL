@using Microsoft.Extensions.Localization
@using SmartParking.GarageTransactions
@using SmartParking.Localization
@using SmartParking.Permissions.GarageTransactionPermissions
@using Volo.Abp.MultiTenancy
@inject IGarageTransactionsAppService GarageTransactionsAppService
@inject IDialogService Dialog
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ICurrentTenant CurrentTenant

@page "/garagetransactions"
@attribute [Authorize(GarageTransactionPermissions.Default)]
<PageTitle>@L["GarageTransactions"]</PageTitle>
<MudText Typo="Typo.h5" Class="mb-2">@L["GarageTransactions"]</MudText>

<SPDataGrid PageName=@L["GarageTransactions"] Data="@itemData" TotalItemsInTable="TotalItem" OnFiltering="HandleFilter" OnClickRowEdit="OnClickRowEdit"  OnClickRowView="OnClickRowView" OnPageChanged="FetchTableData" OnSearching="HandleSearch" OnAdd="@(() => CreateGarageTransaction(_backdropClick))" ShowAdd="false" ShowEdit="false"  OnClickRowDelete="OnClickRowDelete"></SPDataGrid>







