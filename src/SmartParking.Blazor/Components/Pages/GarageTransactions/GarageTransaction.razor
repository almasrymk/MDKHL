@using Microsoft.Extensions.Localization
@using SmartParking.GarageTransactions
@using SmartParking.Localization
@inject IGarageTransactionsAppService GarageTransactionsAppService
@inject IDialogService Dialog
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@page "/garageTransactions"

<PageTitle>@L["GarageTransactions"]</PageTitle>
<MudText Typo="Typo.h5" Class="mb-2">@L["GarageTransactions"]</MudText>

<SPDataGrid PageName=@L["GarageTransactions"] Data="@itemData" TotalItemsInTable="TotalItem" OnFiltering="HandleFilter" OnClickRowEdit="OnClickRowEdit" OnClickRowView="OnClickRowView" OnPageChanged="FetchTableData" OnSearching="HandleSearch" OnAdd="@(() => CreateGarageTransaction(_backdropClick))" OnClickRowDelete="OnClickRowDelete"></SPDataGrid>







