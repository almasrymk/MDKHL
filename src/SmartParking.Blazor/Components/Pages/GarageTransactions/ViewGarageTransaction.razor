@using Microsoft.Extensions.Localization
@using SmartParking.Cameras
@using SmartParking.GarageTransactions
@using SmartParking.Garages
@using SmartParking.Localization
@using SmartParking.Lookups.LicenceType
@using SmartParking.Organizations
@using System.Globalization
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject IGarageAppService GaragesAppService
@inject IOrganizationsAppService OrganizationsAppService
@inject ICamerasAppService CamerasAppService
<div class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@GarageTransaction.PlateNumber</MudText>
		</TitleContent>
		<DialogContent>



			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>

					<MudItem sm="6" md="6">
						<MudTextField
						Value="@L[$"{GarageTransaction.CameraType}"]"
						Immediate="true"
						Disabled=true
						Label="@L["TransactionType"]" />
					</MudItem>

					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="GarageTransaction.PlateNumber"
						For="@(() => GarageTransaction.PlateNumber)"
						Immediate="true"
						Disabled=true
						Label="@L["PlateNumber"]" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField
						Value="GarageTransaction.SnapTime.Value.ToString()"
						Immediate="true"
						Disabled=true
						Label="@L["SnapTime"]" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField 
						Value="GarageTransaction.AccurateTime.Value.ToString()"
						Immediate="true"
						Disabled=true
						Label="@L["AccurateTime"]" />
					</MudItem>

					<MudItem sm="6" md="6">
						<MudTextField
						Value="OrgName"
						Immediate="true"
						Disabled=true
						Label="@L["OrganizationName"]" />
					</MudItem>

					<MudItem sm="6" md="6">
						<MudTextField 
						Value="GarageName"
						Immediate="true"
						Disabled=true
						Label="@L["Garage Name"]" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField
						Value="@L[$"{CustomerCategory}"]"
						Immediate="true"
						Disabled=true
						Label="@L["customer category"]" />
					</MudItem> 

					<MudItem sm="6" md="6">
						<MudTextField @bind-Value="cameraCode"
						For="@(() => cameraCode)"
						Immediate="true"
						Disabled=true
						Label="@L["CameraId"]" />
					</MudItem>

					<MudItem sm="12" md="12" class="d-flex justify-center">
						<div class="zoom-container"
						@onmousemove="SetZoomOrigin"
						@onmouseleave="ResetZoom">
							<img src="@GarageTransaction.VehiclePicture"
							alt="Vehicle Image"
							style="transform-origin: @TransformOrigin; transform: @Scale;" />
						</div>
					</MudItem>


				</MudGrid>
			</MudForm>



		</DialogContent>
		<DialogActions>
			<MudButton Style="@($" background:{Colors.Gray.Lighten4};")" Variant="Variant.Filled" OnClick="OnCloseViewOnly">@L["Back"]</MudButton>
		</DialogActions>


	</MudDialog>

</div>

<style>
	.zoom-container 
	{
	position: relative;
	display: inline-block;
	overflow: hidden;
	width: 400px; /* Container width */
	height: 300px; /* Container height */
	cursor: zoom-in;
	}

	.zoom-container img 
	{
	width: 100%;
	height: 100%;
	transition: transform 0.3s ease, transform-origin 0.3s ease;
	transform: scale(1);
	}

	.zoom-container:hover img {
	transform: scale(2); /* Adjust the scale for zoom level */
	}
</style>

@code {
	[CascadingParameter]
	private MudDialogInstance MudDialogAdd { get; set; }
	[Parameter] public CreateUpdateGarageTransactionDto GarageTransaction { get; set; }
	string cameraCode = "";
	string OrgName="";
	string GarageName = "";
	string CustomerCategory = "";
	bool _clearable;
	private MudForm form;

	private string TransformOrigin { get; set; } = "center center";
	private string Scale { get; set; } = "scale(1)";

	private void SetZoomOrigin(MouseEventArgs e)
	{
		// Calculate the position of the mouse relative to the container
		double xPercent = e.OffsetX / 400 * 100; // 400 is the container width
		double yPercent = e.OffsetY / 300 * 100; // 300 is the container height

		TransformOrigin = $"{xPercent}% {yPercent}%";
		Scale = "scale(2)"; // Zoom level when hovered
	}

	private void ResetZoom(MouseEventArgs e)
	{
		TransformOrigin = "center center";
		Scale = "scale(1)"; // Reset zoom when mouse leaves
	}

	protected override async Task OnInitializedAsync()
	{
		var organization = await OrganizationsAppService.GetAsync(GarageTransaction.OrganizationID);

		var Garage =await GaragesAppService.GetAsync(GarageTransaction.GarageId);
		@if (CultureInfo.CurrentCulture.Name == "en")
		{
			OrgName = organization.EnglishName;
			GarageName = Garage.NameEn;
		}else{
			OrgName = organization.ArabicName;
			GarageName = Garage.NameAr;
		}
		var Camera = await CamerasAppService.GetAsync(GarageTransaction.CameraId);
		cameraCode = Camera.DeviceId;
		CustomerCategory = GarageTransaction.CustomerCategory.ToString();
		Console.WriteLine(GarageTransaction.AccurateTime.Value.ToString());
		await base.OnInitializedAsync();



	}



	private void OnCloseViewOnly()
	{
		MudDialogAdd.Cancel();

	}

}
