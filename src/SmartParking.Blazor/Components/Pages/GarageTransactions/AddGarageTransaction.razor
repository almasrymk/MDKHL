@using Microsoft.Extensions.Localization
@using SmartParking.GarageTransactions
@using SmartParking.Localization
@using SmartParking.Blazor.Components.Shared
@inject IDialogService DialogService
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@inject ISnackbar Snackbar 
@inject IGarageTransactionsAppService GarageTransactionsAppService 
<div class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Add NEW"]</MudText>
        </TitleContent>
        <DialogContent>
            <MudGrid>
                <MudItem sm="8">
                   
                    <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                        <MudGrid>



                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="garageTransactionDto.OrganizationID"
                                              For="@(() => garageTransactionDto.OrganizationID)"
                                              Immediate="true"
                                              Required="true"
                                              Label="@L["OrganizationID"]" />
                            </MudItem>

                            <MudItem sm="4">
                                <MudTextField @bind-Value="garageTransactionDto.GarageId"
                                              For="@(() => garageTransactionDto.GarageId)"
                                              Immediate="true"
                                              Required="true"
                                              Label="@L["GarageId"]" />
                            </MudItem>

                            <MudItem sm="4">
                                <MudTextField @bind-Value="garageTransactionDto.CameraId"
                                              For="@(() => garageTransactionDto.CameraId)"
                                              Immediate="true"
                                              Required="true"
                                              Label="@L["CameraId"]" />
                            </MudItem>

                            <MudItem sm="6" md="6">
                                <MudTextField @bind-Value="garageTransactionDto.PlateNumber"
                                              For="@(() => garageTransactionDto.PlateNumber)"
                                              Immediate="true"
                                              Required="true"
                                              Label="@L["PlateNumber"]" />
                            </MudItem>

                            <MudItem sm="4">
                                <MudTextField @bind-Value="garageTransactionDto.SnapTime"
                                              For="@(() => garageTransactionDto.SnapTime)"
                                              Immediate="true"
                                              Required="true"
                                              Label="@L["SnapTime"]" />
                            </MudItem>

                            <MudItem sm="4">
                                <MudTextField @bind-Value="garageTransactionDto.AccurateTime"
                                              For="@(() => garageTransactionDto.AccurateTime)"
                                              Immediate="true"
                                              Required="true"
                                              Label="@L["AccurateTime"]" />
                            </MudItem>

                         

                            <MudItem sm="4">
                                <MudTextField @bind-Value="garageTransactionDto.VehiclePicture"
                                              For="@(() => garageTransactionDto.VehiclePicture)"
                                              Immediate="true"
                                              Required="true"
                                              Label="@L["VehiclePicture"]" />
                            </MudItem>

                        </MudGrid>
                    </MudForm>
                    
                </MudItem>
            </MudGrid>
        </DialogContent>
       <DialogActions>
    <DialogActionComponent 
        ButtonOneColor="MudBlazor.Color.Dark" 
        ButtonTwoColor="MudBlazor.Color.Primary" 
        ButtonOneLabel="@L["Back"]" 
        ButtonTwoLabel="@L["Create"]" 
        ButtonOneClick="Cancel" 
        ButtonTwoClick="Submit" 
        ButtonOneVariant="MudBlazor.Variant.Filled" 
        ButtonTwoVariant="MudBlazor.Variant.Filled" />
</DialogActions>


    </MudDialog>

</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>

