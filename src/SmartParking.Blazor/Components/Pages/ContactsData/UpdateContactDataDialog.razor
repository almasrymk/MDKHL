@using AutoMapper
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Organizations
@using Volo.Abp.MultiTenancy
@using static MudBlazor.CategoryTypes
@inject ISnackbar Snackbar
@inject IStringLocalizer<SmartParkingResource> L
@inject NavigationManager Navigation
@inject IContactInfoAppService ContactInfoAppService
@inject ICurrentTenant CurrentTenant
@inject IMapper Mapper
<PageTitle>@L["UpdateContactData"]</PageTitle>

<MudItem class="modal-wrapper">
    <MudDialog class="mud-modal">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Edit"]</MudText>
        </TitleContent>
        <DialogContent>
            <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
                <MudGrid>
                    <MudItem sm="6">
                        <MudTextField @bind-Value="ContactDataDto.Name"
                                      For="@(() => ContactDataDto.Name)"
                                      Immediate="true"
                                      Required
                                      Variant="Variant.Text"
                                      Label="@L["Name"]"
                                      InputType="InputType.Text"
                                      Placeholder="@L["Type Here"]" 
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>

                    <MudItem sm="6">
                        <MudTextField @bind-Value="ContactDataDto.ContactMail"
                                      For="@(() => ContactDataDto.ContactMail)"
                                      Immediate="true"
                                      Required
                                      Variant="Variant.Text"
                                      Label="@L["Contact Email"]"
                                      InputType="InputType.Text"
                                      Placeholder="@L["Type Here"]" 
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>
                    <MudItem sm="6">
                        <MudTextField @bind-Value="ContactDataDto.WhatsAppNum"
                                      For="@(() => ContactDataDto.WhatsAppNum)"
                                      Immediate="true"
                                      Required
                                      Label="@L["WhatsAppNum"]"
                                      InputType="InputType.Text"
                                      Placeholder="@L["Type Here"]" 
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>

                    <MudItem sm="6">
                        <MudTextField @bind-Value="ContactDataDto.PhoneNum"
                                      For="@(() => ContactDataDto.PhoneNum)"
                                      Immediate="true"
                                      Required
                                      Variant="Variant.Text"
                                      Label="@L["MobileNumber"]"
                                      InputType="InputType.Text"
                                      Placeholder="@L["Type Here"]" 
                                      RequiredError="@(LocalizationHelper.GetLocalizedString("EmptyValidation"))" />
                    </MudItem>

                </MudGrid>
            </MudForm>

        </DialogContent>

        <DialogActions>
            <MudButton Color="MudBlazor.Color.Dark" Variant="Variant.Filled" OnClick="Cancel">@L["Back"]</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" Disabled="@(form == null || !form.IsValid)" OnClick="Submit">@L["Create"]</MudButton>
        </DialogActions>
    </MudDialog>

</MudItem>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>
