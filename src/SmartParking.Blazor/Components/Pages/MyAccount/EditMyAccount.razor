@page "/edit-my-account"
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.LookUps
@inject IStringLocalizer<SmartParkingResource> L
@using SmartParking.Currency
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.State
@using SmartParking.Organizations
@using SmartParking.SubscriptionTypes
@using SmartParking.Subscriptions
@using System.Globalization
@using SmartParking.Validations
@using Volo.Abp.Application.Dtos
@using Volo.Abp.Identity
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Users
@layout Shared.ProfileLayout
@inject IOrganizationsAppService OrganizationAppService
@inject ISnackbar Snackbar
@inject IStateAppService StateAppService
@inject ICitiesAppService CitiesAppService
@inject ICountriesAppService CountriesAppService
@inject IIdentityUserAppService IdentityUserAppService;
@inject UserManager<Volo.Abp.Identity.IdentityUser> UserManager;
@inject SignInManager<Volo.Abp.Identity.IdentityUser> signInManager
@inject NavigationManager Navigation
@inject IDialogService Dialog
@inject ISubscriptionAppService SubscriptionAppService
@inject ICurrentTenant currenttenant
@inject ICurrentUser currentUser
@inject IAuthorizationService AuthorizationService

@attribute [Authorize]
@inherits AbpCrudPageBase<IOrganizationsAppService, OrganizationDto, int, PagedAndSortedResultRequestDto, CreateUpdateOrganiztionDto>
<PageTitle>@L["EditMyAccount"]</PageTitle>
<div>
    <MudGrid>
        <MudItem sm="12">
            <MudPaper Class="h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" Style="background-color: #F2F2F2;">
                <h3 Color="fw-bold">@L["Main Data"]</h3>
                <MudForm Class="flex-grow-1 mt-4">
                    <MudGrid>
                        <MudItem sm="12">
                            <div class="d-flex justify-content-center align-items-center px-5 position-relative pb-6">
                                @if (_organizationPicture != null)
                                {
                                    <MudImage Src="@(_organizationPicture ?? "images/MDHKL_04.png")" Class="bg_w_foto " Width="200" Height="200" Alt="@L["OrganizationLogo"]" />
                                }
                                else
                                {
                                    <MudImage Src="images/MDHKL_04.png" Class="bg_w_foto " Width="200" Height="200" Alt="@L["OrganizationLogo"]" />
                                }
                                <MudFileUpload T="IBrowserFile" Accept=".png, .jpg, .jpeg, .gif, .bmp, .webp" FilesChanged="OnImageUpload" MaximumFileCount="1">
                                    <ActivatorContent>
                                        <MudFab Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.CameraAlt" Size="MudBlazor.Size.Medium" Class="rounded-circle" />
                                    </ActivatorContent>
                                </MudFileUpload>
                            </div>

                        </MudItem>

                        <MudItem sm="6">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="_createUpdateOrganization.EnglishName" Placeholder=@L["Type Here"] Label=@L["EnglishName"] />
                        </MudItem>
                        <MudItem sm="6">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="_createUpdateOrganization.ArabicName" Placeholder=@L["Type Here"] Label=@L["ArabicName"] />
                        </MudItem>

                        <MudItem sm="4">
                            <MudDatePicker IsDateDisabledFunc="@((DateTime dt) => dt.Date < DateTime.Today)" Required="true" Label=@L["CR Expiry Date"] Placeholder=@L["Time Placeholder"]
                                           @bind-Date="_crExpiryDate" ShowToolbar="false" />
                        </MudItem>

                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="_createUpdateOrganization.CommercialRegistrationNumber" Placeholder=@L["Type Here"] Label=@L["CommercialRegistrationNumber"] />
                        </MudItem> 
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="_createUpdateOrganization.TaxNumber" Placeholder=@L["Type Here"] Label=@L["TaxNumber"] />
                        </MudItem>
                        <MudDivider Style="border-top:1px solid #505254; margin:10px 0px;" />

                        <MudItem sm="4">
                            <MudNumericField Required="true" Validation="@(new Func<int, string>(NumbersValidations.validateNumber0to9999))" @bind-Value="_createUpdateOrganization.BuildingNumber" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["BuidlingNumber"]" />
                        </MudItem>

                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="_createUpdateOrganization.StreetName" Placeholder="@L["Type Here"]" Label="@L["StreetName"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField Validation="@(new Func<int, string>(NumbersValidations.ValidateNumber1111to9999))"
                                             Required="true" @bind-Value="_createUpdateOrganization.SecondaryNumber" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["SecondaryNumber"]" />
                        </MudItem>

                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="_createUpdateOrganization.District" Placeholder="@L["Type Here"]" Label="@L["District"]" />
                        </MudItem>
                        <MudItem sm="4">
                            <MudNumericField Required="true" Validation="@(new Func<int, string>(NumbersValidations.ValidateNumber11111to99999))" @bind-Value="_createUpdateOrganization.PostalCode" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["PostalCode"]" />
                        </MudItem>
                        <MudItem sm="8">
                            <MudTextField Disabled T="string" dir="rtl" InputType="InputType.Text" @bind-Value="_address" Placeholder="@L["Type Here"]" Label="@L["Address"]" />
                        </MudItem>
                        <MudDivider Style="border-top:1px solid #505254; margin:10px 0px;" />
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="_createUpdateOrganization.PhoneNumber" Placeholder=@L["Type Here"] Label=@L["Contact Phone"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="_createUpdateOrganization.WhatsAppNum" Placeholder=@L["Type Here"] Label=@L["Whatsapp Num"] />
                        </MudItem>
                        <MudItem sm="4">
                            <MudTextField Required="true" T="string" InputType="InputType.Text" @bind-Value="_createUpdateOrganization.Email" Placeholder=@L["Type Here"] Label=@L["Contact Email"] />
                        </MudItem>

                        <MudDivider Style="border-top:1px solid #505254; margin:10px 0px;" />
                        <MudItem sm="4">
                            <MudSelect Variant="Variant.Text"
                                       Label=@L["Country"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       @bind-Value="@_countrySelectValue">
                                @foreach (var country in _countries)
                                {
                                    if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="country.Id.ToString()">@country.EnglishName</MudSelectItem>
                                    }
                                    else
                                    {
                                        <MudSelectItem Value="country.Id.ToString()">@country.ArabicName</MudSelectItem>
                                    }
                                }

                            </MudSelect>
                        </MudItem>
                        <MudItem sm="4">
                            <MudSelect Variant="Variant.Text"
                                       Label=@L["Region"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       @bind-Value="@_regionSelectValue">
                                @foreach (var region in _regions)
                                {
                                    if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="region.Id.ToString()">@region.EnglishName</MudSelectItem>

                                    }
                                    else
                                    {
                                        <MudSelectItem Value="region.Id.ToString()">@region.ArabicName</MudSelectItem>

                                    }
                                }

                            </MudSelect>
                        </MudItem>
                        <MudItem sm="4">
                            <MudSelect Variant="Variant.Text"
                                       Label=@L["State"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       @bind-Value="@_stateSelectValue">
                                @foreach (var state in _states)
                                {
                                    if (CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="state.Id.ToString()">@state.EnglishName</MudSelectItem>
                                
                                    }
                                    else
                                    {
                                        <MudSelectItem Value="state.Id.ToString()">@state.ArabicName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem sm="4">
                            <MudSelect Variant="Variant.Text"
                                       Label=@L["City"]
                                       Placeholder=@L["Choose"]
                                       HelperText=@L["Helper Text"]
                                       @bind-Value="@_citySelectValue">
                                @foreach (var city in _cities)
                                {
                                    if(CultureInfo.CurrentCulture.Name == "en")
                                    {
                                        <MudSelectItem Value="city.Id.ToString()">@city.EnglishName</MudSelectItem>
                                    }
                                    else
                                    {
                                        <MudSelectItem Value="city.Id.ToString()">@city.ArabicName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </MudItem>

                       
                       
                      
                        <MudItem sm="4">
                            <MudSwitch Label=@L["Status Active"] LabelPosition="LabelPosition.Start" Disabled="!HasChangeStatusPermission" @bind-Value="_status" Color="MudBlazor.Color.Primary" />
                        </MudItem>
                       
                        <MudDivider Style="border-top:1px solid #505254; margin:10px 0px;" />
                        <MudItem sm="4">
                            <div style="display: flex; flex-direction: column;font-weight:bold">
                                <label style="font-size: 0.75rem; margin-bottom: 4px;">
                                    @L["FirstHourPrice"]
                                    @((MarkupString)CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "15px"))
                                </label>
                                <MudNumericField T="decimal" Immediate="true" @bind-Value="_createUpdateOrganization.FirstHourPrice"
                                                 Min="0" HideSpinButtons="true" Placeholder="@L["Type Here"]" />
                            </div>
                        </MudItem>

                        <MudItem sm="4">
                            <div style="display: flex; flex-direction: column;font-weight:bold">
                                <label style="font-size: 0.75rem; margin-bottom: 4px;">
                                    @L["SecondHourPrice"]
                                    @((MarkupString)CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "15px"))
                                </label>
                                <MudNumericField T="decimal" Immediate="true" @bind-Value="_createUpdateOrganization.SecondHourPrice"
                                                 Min="0" HideSpinButtons="true" Placeholder="@L["Type Here"]" />
                            </div>
                        </MudItem>

                        <MudItem sm="4">
                            <div style="display: flex; flex-direction: column;font-weight:bold">
                                <label style="font-size: 0.75rem; margin-bottom: 4px;">
                                    @L["ThirdHourPrice"]
                                    @((MarkupString)CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "15px"))
                                </label>
                                <MudNumericField T="decimal" Immediate="true" @bind-Value="_createUpdateOrganization.ThirdHourPrice"
                                                 Min="0" HideSpinButtons="true" Placeholder="@L["Type Here"]" />
                            </div>
                        </MudItem>

                        <MudItem sm="4">
                            <div style="display: flex; flex-direction: column;font-weight:bold">
                                <label style="font-size: 0.75rem; margin-bottom: 4px;">
                                    @L["AdditionalHourPrice"]
                                    @((MarkupString)CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "15px"))
                                </label>
                                <MudNumericField T="decimal" Immediate="true" @bind-Value="_createUpdateOrganization.AdditionalHourPrice"
                                                 Min="0" HideSpinButtons="true" Placeholder="@L["Type Here"]" />
                            </div>
                        </MudItem>

                        <MudItem sm="4">
                            <div style="display: flex; flex-direction: column;font-weight:bold">
                                <label style="font-size: 0.75rem; margin-bottom: 4px;">
                                    @L["FullDayPrice"]
                                    @((MarkupString)CurrencyIcon.ToHtml("icon-Saudi_Riyal_Symbolsvg", "15px"))
                                </label>
                                <MudNumericField T="decimal" Immediate="true" @bind-Value="_createUpdateOrganization.FullDayPrice"
                                  Min="0" HideSpinButtons="true" Placeholder="@L["Type Here"]" />
                            </div>
                        </MudItem>


                        <MudItem sm="4">
                            <MudNumericField T="int" @bind-Value="_createUpdateOrganization.FreeMinutes" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label=@($"{L["FreeMinutes"]} ({L["Minutes"]})") />
                        </MudItem>

                        <MudItem sm="4">
                            <MudNumericField T="int" @bind-Value="_createUpdateOrganization.Graceperiod" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label=@($"{L["Graceperiod"]} ({L["Minutes"]})") />
                        </MudItem>
                        <MudItem sm="12">
                            <MudSwitch Label="@L["NumberOfHoursExceeded"]" LabelPosition="LabelPosition.End" @bind-Value="_createUpdateOrganization.IsNumberOfHoursExceeded" Color="MudBlazor.Color.Primary" />
                        </MudItem>
                        <MudItem sm="12">
                            <MudSwitch Label="@L["IsClose"]" LabelPosition="LabelPosition.End" @bind-Value="_createUpdateOrganization.IsClose" Color="MudBlazor.Color.Primary" />
                        </MudItem>

                        @if (_createUpdateOrganization.IsNumberOfHoursExceeded==true)
                        {
                            <MudItem sm="6">
                                <MudNumericField T="int" Immediate="true" Required="@_createUpdateOrganization.IsNumberOfHoursExceeded" @bind-Value="@_numberOfHours" Min="0" HideSpinButtons="true" Placeholder="@L["Type Here"]" Label="@L["NumberOfHours"]" />
                            </MudItem>
                        }
                        @if (_createUpdateOrganization.IsClose==true)
                        {
                            <MudItem sm="6">
                                <MudTimePicker Required="@_createUpdateOrganization.IsClose" Label="@L["ClosingHoursStart"]" Placeholder="@L["Type Here"]" TimeFormat="h:mm tt" @bind-Time="_closingHoursStart" ShowToolbar="false" />
                            </MudItem>
                            <MudItem sm="6">
                                <MudTimePicker Required="@_createUpdateOrganization.IsClose" Label="@L["ClosingHoursEnd"]" Placeholder="@L["Type Here"]" TimeFormat="h:mm tt" @bind-Time="_closingHoursEnd" ShowToolbar="false" />
                            </MudItem>

                        }


                    </MudGrid>

                    <div class="d-flex justify-content-between mt-5">
                        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Dark" OnClick="Cancel">@L["Cancel"]</MudButton>
                        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="Update">@L["Save"]</MudButton>
                    </div>
                </MudForm>

            </MudPaper>
        </MudItem>
    </MudGrid>
</div>

<style>
    .bg_w_foto {
        background: url(images/cities/<?php echo $city_name;
        ?>) no-repeat center center;
        -webkit-background-size: cover;
        -moz-background-size: cover;
        -o-background-size: cover;
        background-size: cover;
        display: flex;
        align-self: center;
    }
</style>