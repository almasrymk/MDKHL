@using Microsoft.Extensions.Localization
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Blazor.Customs
@using SmartParking.KeeperShifts
@using SmartParking.Localization
@using Volo.Abp.MultiTenancy
@using System.Globalization
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject ICurrentTenant CurrentTenant

<div class="modal-wrapper">
    <MudDialog Class="mud-modal w-100" Style="min-width: auto !important">
        <TitleContent>
            <MudText Class="fw-bold" Typo="Typo.h6">@L["UserShifts"]</MudText>
        </TitleContent>

        <DialogContent>
            <MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper">
                <MudGrid Spacing="2">
                    <MudItem sm="6" md="6">
                        <MudTextField T="string"
                                      Value="@(string.IsNullOrWhiteSpace(UserFullName) ? "—" : UserFullName)"
                                      Disabled="true"
                                      Label="@L["UserFullName"]" />
                    </MudItem>

                    <MudItem sm="6" md="6">
                        <MudTextField T="string"
                                      Value="@(string.IsNullOrWhiteSpace(Role) ? L["Staff"].Value : (L[Role].Value ?? Role))"
                                      Disabled="true"
                                      Label="@L["Role"]" />
                    </MudItem>

                    <DeviceDisplayComponent Role="@Role"
                                            Device="@Device"
                                            Devices="@Devices" />

                    <MudItem xs="12" sm="6" md="6">
                        <MudTextField T="string"
                                      Value="@(string.IsNullOrWhiteSpace(Garage) ? "—" : Garage)"
                                      Disabled="true"
                                      Label="@L["Garage"]" />
                    </MudItem>

                    @if (CurrentTenant.Id is null)
                    {
                        <MudItem xs="12" sm="6" md="6">
                            <MudTextField T="string"
                                          Disabled="true"
                                          Label="@L["Organization"]" />
                        </MudItem>
                    }
                </MudGrid>
            </MudForm>
        </DialogContent>

        <DialogActions>
            <DialogActionComponent
                ButtonTwoColor="MudBlazor.Color.Dark"
                ButtonTwoLabel="@L["Back"]"
                ButtonTwoClick="Cancel"
                ButtonTwoVariant="MudBlazor.Variant.Filled" />
        </DialogActions>
    </MudDialog>
</div>

<style>
    .mud-modal {
        border-radius: 0 20px 0 20px;
    }
</style>