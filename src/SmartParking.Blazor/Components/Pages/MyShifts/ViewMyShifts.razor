@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups.LicenceType
@using SmartParking.Organizations
@using System.Globalization
@using Volo.Abp.MultiTenancy
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ICurrentTenant CurrentTenant

@using SmartParking.KeeperShifts
<div class="modal-wrapper">
	<MudDialog class="mud-modal" MaxWidth="MaxWidth.Medium" FullWidth="true">
		<TitleContent>
			<MudText Typo="Typo.h6">@L["Details"]</MudText>
		</TitleContent>
		<DialogContent>
			<MudForm Class="flex-grow-1 mt-4 h-100 p-3 d-flex flex-column w-100 h-100 main-layout-paper" @ref="form">
				<MudGrid>
					<MudItem sm="6" md="6">
						@if (CultureInfo.CurrentCulture.Name == "ar")
						{
							<MudTextField @bind-Value="KeeperShiftDto.GarageNameAr"
										  For="@(() => KeeperShiftDto.GarageNameAr)"
										  Immediate="true"
										  Disabled=true
										  Label="@L["GarageName"]" />
						}
						else
						{
							<MudTextField @bind-Value="KeeperShiftDto.GarageNameEn"
										  For="@(() => KeeperShiftDto.GarageNameEn)"
										  Immediate="true"
										  Disabled=true
										  Label="@L["GarageName"]" />
						}

					</MudItem>
					<MudItem sm="6" md="6">
						@if (CultureInfo.CurrentCulture.Name == "ar")
						{
							<MudTextField @bind-Value="KeeperShiftDto.ArabicName"
										  For="@(() => KeeperShiftDto.ArabicName)"
										  Immediate="true"
										  Disabled=true
										  Label="@L["ShiftName"]" />
						}
						else
						{
							<MudTextField @bind-Value="KeeperShiftDto.EnglishName"
										  For="@(() => KeeperShiftDto.EnglishName)"
										  Immediate="true"
										  Disabled=true
										  Label="@L["ShiftName"]" />
						}
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField Value="KeeperShiftDto.StartDate.ToString()"
									  Disabled=true
									  Label="@L["StartDate"]" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField Value="KeeperShiftDto.EndDate.ToString()"
									  Disabled=true
									  Label="@L["EndDate"]" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField Value="KeeperShiftDto.StartTime.ToString()"
									  Disabled=true
									  Label="@L["StartTime"]" />
					</MudItem>
					<MudItem sm="6" md="6">
						<MudTextField Value="KeeperShiftDto.EndTime.ToString()"
									  Disabled=true
									  Label="@L["EndTime"]" />
					</MudItem>
				</MudGrid>
			</MudForm>
		</DialogContent>
		<DialogActions>
			<div class="d-flex align-items-center justify-content-between">

				<MudButton Color="MudBlazor.Color.Dark" Variant="Variant.Filled" OnClick="OnCloseViewOnly">@L["Back"]</MudButton>
				@* @if (GarageTransaction.IsIn && GarageTransaction.IsPending == false && GarageTransaction.CanCheckout == true)
				{
					<MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="Checkout"> @L["Checkout"]</MudButton>
				} *@
			</div>
		</DialogActions>


	</MudDialog>

</div>
@code {
	[CascadingParameter]
	private IMudDialogInstance MudDialogAdd { get; set; }
	[Parameter] public KeeperShiftDto KeeperShiftDto { get; set; }
	private MudForm form;
	protected override Task OnInitializedAsync()
	{
		return base.OnInitializedAsync();
	}

	private void OnCloseViewOnly()
	{
		MudDialogAdd.Cancel();
	}
}
