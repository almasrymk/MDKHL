@using System.Globalization
@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups.LicenceType
@using SmartParking.Organizations
@using Volo.Abp.MultiTenancy
@inject IStringLocalizer<SmartParkingResource> L
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ICurrentTenant CurrentTenant
@inject IKeeperShiftsAppService KeeperShiftsAppService
@using SmartParking.KeeperShifts
<MudGrid class="row">
	<MudItem md="8">
		<MudItem sm="12" md="12">
			@if (CultureInfo.CurrentCulture.Name == "ar")
			{
				<MudTextField @bind-Value="KeeperShiftDto.ShiftNameAr"
				For="@(() => KeeperShiftDto.ShiftNameAr)"
				Immediate="true"
				Disabled=true
				Label="@L["ShiftName"]" />
			}
			else
			{
				<MudTextField @bind-Value="KeeperShiftDto.ShiftNameEn"
				For="@(() => KeeperShiftDto.ShiftNameEn)"
				Immediate="true"
				Disabled=true
				Label="@L["ShiftName"]" />
			}
		</MudItem>
		<MudItem sm="3" md="3">
			<MudTextField Value="KeeperShiftDto.StartDate.ToString()"
			Disabled=true
			Label="@L["StartDate"]" />
		</MudItem>
		<MudItem sm="3" md="3">
			<MudTextField Value="KeeperShiftDto.EndDate.ToString()"
			Disabled=true
			Label="@L["EndDate"]" />
		</MudItem>
		<MudItem sm="3" md="3">
			<MudTextField Value="KeeperShiftDto.StartTime.ToString()"
			Disabled=true
			Label="@L["StartTime"]" />
		</MudItem>
		<MudItem sm="3" md="3">
			<MudTextField Value="KeeperShiftDto.EndTime.ToString()"
			Disabled=true
			Label="@L["EndTime"]" />
		</MudItem>
	</MudItem>
	<MudItem md="4">
		<MudButton Color="MudBlazor.Color.Dark" Variant="Variant.Filled">@L["StartShift"]</MudButton>
		<MudButton Color="MudBlazor.Color.Dark" Variant="Variant.Filled">@L["EndShift"]</MudButton>
	</MudItem>
</MudGrid>
@code {
	public KeeperShiftDto KeeperShiftDto { get; set; } = new();
	protected override async Task OnInitializedAsync()
	{
		KeeperShiftDto = await KeeperShiftsAppService.GetAsync(1);
		
		await base.OnInitializedAsync();
    }
}
