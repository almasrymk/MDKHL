@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.State
@inject IStateAppService StateAppService
@inject IStringLocalizer<SmartParkingResource> L
<MudItem sm="4">
    <MudSelect Variant="Variant.Text"
               Label="@L["State"]"
               Placeholder="@L["Choose"]"
               Clearable="true"
               @bind-Value="name"
               OnClose="ChangeSelect"
               ReadOnly="Read">
        @foreach (var state in states)
        {
            <MudSelectItem Value="state.Id.ToString()">@state.EnglishName</MudSelectItem>
        }
    </MudSelect>
</MudItem>

@code {
    IList<StateLookupDto> states = new List<StateLookupDto>();
    [Parameter] public EventCallback<string> SelectValueChanged { get; set; }
    [Parameter] public string state { get; set; }
    [Parameter] public bool ReadOnly { get; set; } = false;
    private bool Read;
    private string name;
    private async Task ChangeSelect()
    {
        int parsedValue;
        if (int.TryParse(name, out parsedValue))
        {
            // The value is a number (integer)
            await SelectValueChanged.InvokeAsync(name);
        }
        else
        {
            // The value is a string
            await SelectValueChanged.InvokeAsync("0");

        }

    }
    protected override Task OnParametersSetAsync()
    {
        if (state.IsNullOrEmpty() == false)
        {
            name = state;
        }
        Read = ReadOnly;
        return base.OnParametersSetAsync();
    }
    protected override async Task OnInitializedAsync()
    {
        states = await StateAppService.GetStateLookupAsync();
        await base.OnInitializedAsync();

    }
}
