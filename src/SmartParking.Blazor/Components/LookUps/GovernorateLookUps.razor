@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.City
@inject ICitiesAppService CitiesAppService
@inject IStringLocalizer<SmartParkingResource> L

<MudItem sm="4">
    <MudSelect Variant="Variant.Text"
               Label="@L["Governorate"]"
               Placeholder="Choose"
               Clearable="true"
               ValueChanged="@((int value)=> SelectValueChanged.InvokeAsync(value))">
        @foreach (var government in governments)
        {
            <MudSelectItem Value="government.Id">@government.EnglishName</MudSelectItem>
        }
    </MudSelect>
</MudItem>

@code {
    IReadOnlyList<GovernorateLookupDto> governments = new List<GovernorateLookupDto>();
    [Parameter]
    public EventCallback<int> SelectValueChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        governments = await CitiesAppService.GetGovernmentLookupAsync();

    }
}
