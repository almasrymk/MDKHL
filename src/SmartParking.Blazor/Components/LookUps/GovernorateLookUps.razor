@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.City
@inject ICitiesAppService CitiesAppService
@inject IStringLocalizer<SmartParkingResource> L

<MudItem sm="4">
    <MudSelect Variant="Variant.Text"
               Label="@L["Governorate"]"
               Placeholder="@L["Choose"]"
               Clearable="true"
               ValueChanged="@((int value)=> SelectValueChanged.InvokeAsync(value))">
        @foreach (var governorate in governorates)
        {
            <MudSelectItem  T="int" Value="governorate.Id">@governorate.EnglishName</MudSelectItem>
        }
    </MudSelect>
</MudItem>

@code {
    IList<GovernorateLookupDto> governorates = new List<GovernorateLookupDto>();
    [Parameter] public EventCallback<int> SelectValueChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        governorates = await CitiesAppService.GetGovernmentLookupAsync();

    }
}
