@using SmartParking.Lookups
@using SmartParking.Lookups.City
 @inject ICitiesAppService CitiesAppService
<MudItem sm="4">
    <MudSelect @bind-Value="SelectValue"
               Variant="Variant.Text"
               Label="Governorate"
               Placeholder="Choose"
               Clearable="true">
        @foreach (var governorate in governorates)
        {
            <MudSelectItem Value="governorate.Id">@governorate.EnglishName</MudSelectItem>
        }
    </MudSelect>
</MudItem>

@code {
    IList<GovernmentLookupDto> governorates = new List<GovernmentLookupDto>();
    [Parameter] public int SelectValue { get; set; }
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        governorates = await CitiesAppService.GetGovernmentLookupAsync();

    }
}
