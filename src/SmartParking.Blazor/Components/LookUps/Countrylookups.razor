@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.Governorate
 @inject IGovernorateAppService GovernorateAppService
 @inject IStringLocalizer<SmartParkingResource> L
<MudItem sm="4">
    <MudSelect 
               Variant="Variant.Text"
               Label="@L["Country"]"
               Placeholder="@L["Choose"]"
               Clearable="true"
               @bind-Value="name"
               OnClose="ChangeSelect"
               ReadOnly="Read">
        @foreach (var country in countries)
        {
            <MudSelectItem  Value="country.Id.ToString()">@country.EnglishName</MudSelectItem>
        }
    </MudSelect>
</MudItem>

@code {
    IReadOnlyList<CountryLookupDto> countries = new List<CountryLookupDto>();
    [Parameter]
    public EventCallback<string> SelectValueChanged { get; set; }
    [Parameter] public string Country { get; set; }
    [Parameter] public bool ReadOnly { get; set; } = false;
    private bool Read;
    private string name;
    private async Task ChangeSelect()
    {
        int parsedValue;
        if (int.TryParse(name, out parsedValue))
        {
            // The value is a number (integer)
            await SelectValueChanged.InvokeAsync(name);
        }
        else
        {
            // The value is a string
            await SelectValueChanged.InvokeAsync("0");

        }

    }
    protected override Task OnParametersSetAsync()
    {
        name = Country;
        Read = ReadOnly;
        return base.OnParametersSetAsync();
    }
    protected override async Task OnInitializedAsync()
    {
        
        await base.OnInitializedAsync();
        countries = await GovernorateAppService.GetCountryLookupAsync();
        

    }
}
