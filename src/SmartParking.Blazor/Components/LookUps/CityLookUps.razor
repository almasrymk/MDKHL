@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.City
@inject ICitiesAppService CitiesAppService
@inject IStringLocalizer<SmartParkingResource> L
<MudItem sm="4">
    <MudSelect 
               Variant="Variant.Text"
               Label="@L["City"]"
               Placeholder="@L["Choose"]"
               Clearable="true"
               @bind-Value="name"
               OnClose="ChangeSelect"
               ReadOnly="Read">
        @foreach (var city in cities)
        {
            <MudSelectItem Value="city.Id.ToString()">@city.EnglishName</MudSelectItem>
        }
    </MudSelect>
</MudItem>

@code {
    IList<CityLookupDto> cities = new List<CityLookupDto>();
    [Parameter] public EventCallback<string> SelectValueChanged { get; set; }
    [Parameter] public string City { get; set; }
    [Parameter] public bool ReadOnly { get; set; } = false;
    private bool Read;
    private string name;
    private async Task ChangeSelect()
    {
        int parsedValue;
        if (int.TryParse(name, out parsedValue))
        {
            // The value is a number (integer)
            await SelectValueChanged.InvokeAsync(name);
        }
        else
        {
            // The value is a string
            await SelectValueChanged.InvokeAsync("0");

        }

    }
    protected override Task OnParametersSetAsync()
    {
        if (City.IsNullOrEmpty() == false)
        {
            name = City;
        }
        Read = ReadOnly;
        return base.OnParametersSetAsync();
    }
    protected override async Task OnInitializedAsync()
    {
        cities = await CitiesAppService.GetCityLookupAsync();
        await base.OnInitializedAsync();

    }
}
