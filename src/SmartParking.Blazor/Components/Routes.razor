@using Microsoft.AspNetCore.SignalR.Client
@using SmartParking.Blazor.Components.Shared
@using SmartParking.Enums
@using Volo.Abp.AspNetCore.Components.Web.LeptonXLiteTheme.Themes.LeptonXLite
@using Volo.Abp.AspNetCore.Components.Web.Theming.Routing
@using Microsoft.Extensions.Options
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Users
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IOptions<AbpRouterOptions> RouterOptions
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICurrentTenant currenttenant
@inject ICurrentUser _currentUser
@inject ISnackbar snackbar
@inject NotificationService NotificationService
<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="RouterOptions.Value.AdditionalAssemblies">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Shared.MainLayout)">
            <NotAuthorized>
                <SmartParking.Blazor.Components.Pages.Login></SmartParking.Blazor.Components.Pages.Login>
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
</Router>
@code {
    protected override async Task OnInitializedAsync()
    {
        HubConnection? hub = await NotificationService.StartConnectionAsync(Navigation, snackbar);
        hub.On<string, string>("ReceiveExportNotification", (status, message) =>
            {
               
                SnackBar.ShowSnackbar(snackbar, message, status == EventStatus.Complete.ToString() ? Severity.Success : Severity.Info);

                //Console.WriteLine($"Received SignalR Event: Status={status}, Message={message}");
            });

        try
        {
            await hub.StartAsync();
            Console.WriteLine("SignalR Connected!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR Connection Failed: {ex.Message}");
        }
        await base.OnInitializedAsync();
    }

}