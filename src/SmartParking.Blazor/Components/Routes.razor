@using SmartParking.Enums
@using Volo.Abp.AspNetCore.Components.Web.LeptonXLiteTheme.Themes.LeptonXLite
@using Volo.Abp.AspNetCore.Components.Web.Theming.Routing
@using Microsoft.Extensions.Options
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Users
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IOptions<AbpRouterOptions> RouterOptions
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICurrentTenant currenttenant
@inject ICurrentUser _currentUser

<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="RouterOptions.Value.AdditionalAssemblies">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Shared.MainLayout)">
            <NotAuthorized>
               
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
</Router>
@code {
    private bool isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
        var currentUri = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();


        // Avoid redirect loop if already on the login page
        if (!isAuthenticated && currentUri != "login")
        {
            Navigation.NavigateTo("/login", true);
        }
        if (((currenttenant.Id != null || _currentUser.IsInRole(Enums.RolesType.Organization.ToString())) && (currentUri.Contains("organizations") || currentUri == "subscriptions") || currentUri == "packages") || (_currentUser.IsAuthenticated && currentUri == "login"))
        {

            Navigation.NavigateTo("/", true);

        }
        if ((_currentUser.IsInRole(RolesType.Mdkhl.ToString()) || _currentUser.IsInRole("admin")) )
        {
          
            if (currentUri == "/my-account")
            {
                Navigation.NavigateTo("/edit-profile", true);

            }
            if (currentUri == "/contact-data")
            {
                Navigation.NavigateTo("/", true);
            }

        }
    }

    
}