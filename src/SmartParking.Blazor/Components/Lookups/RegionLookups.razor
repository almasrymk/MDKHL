@using Microsoft.Extensions.Localization
@using SmartParking.Localization
@using SmartParking.Lookups
@using SmartParking.Lookups.State
@inject IStateAppService StateAppService
@inject IStringLocalizer<SmartParkingResource> L

<MudItem sm="4">
    <MudSelect Variant="Variant.Text"
               Label="@L["Region"]"
               Placeholder="@L["Choose"]"
               Clearable="true"
               Required
               ValueChanged="@((int value)=> SelectValueChanged.InvokeAsync(value))">
        @foreach (var region in regions)
        {
            <MudSelectItem T="int" Value="region.Id">@region.EnglishName</MudSelectItem>
        }
    </MudSelect>
</MudItem>

@code {
    IList<RegionLookupDto> regions = new List<RegionLookupDto>();
    [Parameter] public EventCallback<int> SelectValueChanged { get; set; }
    [Parameter] public string Region { get; set; }

    
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        regions = await StateAppService.GetRegionLookupAsync();

    }
}
